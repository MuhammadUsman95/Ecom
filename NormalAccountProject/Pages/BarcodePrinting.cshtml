@page "/BarcodePrinting"
@model NormalAccountProject.Pages.BarcodePrintingModel
@{
    ViewData["Title"] = "Barcode Printing";
}

<link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;500;600;700;800&family=Rubik:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/jsbarcode/3.11.6/JsBarcode.all.min.js"></script>

<style>
    :root {
        --bg: #f0f3f8;
        --surface: #ffffff;
        --surface2: #f8f9fc;
        --surface3: #eef1f8;
        --border: #eef0f6;
        --border2: #e2e6f0;
        --border3: #d4d9e8;
        --blue: #4e9dff;
        --blue-dark: #2d7dd2;
        --blue-g: rgba(78,157,255,.10);
        --blue-g2: rgba(78,157,255,.06);
        --teal: #00c9a7;
        --coral: #ff6b6b;
        --amber: #f59e0b;
        --green: #10b981;
        --danger: #ef4444;
        --purple: #8b5cf6;
        --text: #1e2a3a;
        --text2: #5a6478;
        --text3: #9ba3b8;
        --font-h: 'Rubik', sans-serif;
        --font-b: 'Nunito', sans-serif;
        --font-m: 'JetBrains Mono', monospace;
        --r: 8px;
        --r2: 12px;
        --r3: 16px;
        --sh: 0 2px 12px rgba(0,0,0,.06);
        --sh2: 0 4px 24px rgba(0,0,0,.09);
        --sh3: 0 8px 40px rgba(0,0,0,.12);
    }

    *, *::before, *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    .sr-root {
        font-family: var(--font-b);
        color: var(--text);
        background: var(--bg);
        min-height: calc(100vh - 60px);
        padding: 24px 28px 20px;
        overflow-y: auto;
        overflow-x: hidden;
        scrollbar-width: thin;
        scrollbar-color: var(--border2) transparent;
    }

    .sr-inner {
        max-width: 1400px;
        margin: 0 auto;
    }

    /* ── PAGE HEADER ── */
    .page-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 22px;
        animation: fadeDown .4s ease both;
    }

    .ph-left {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .ph-icon {
        width: 46px;
        height: 46px;
        background: linear-gradient(135deg, var(--blue) 0%, var(--blue-dark) 100%);
        border-radius: var(--r2);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        font-size: 18px;
        box-shadow: 0 4px 16px rgba(78,157,255,.35);
        flex-shrink: 0;
    }

    .ph-title {
        font-family: var(--font-h);
        font-size: 21px;
        font-weight: 700;
        color: var(--text);
        line-height: 1.1;
    }

        .ph-title span {
            color: var(--blue);
        }

    .ph-breadcrumb {
        display: flex;
        align-items: center;
        gap: 5px;
        font-family: var(--font-m);
        font-size: 10px;
        color: var(--text3);
        letter-spacing: .4px;
        margin-top: 3px;
    }

        .ph-breadcrumb i {
            font-size: 7px;
            color: var(--text3);
        }

        .ph-breadcrumb .bc-cur {
            color: var(--blue);
            font-weight: 500;
        }

    .status-pill {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 4px 12px;
        border-radius: 20px;
        font-family: var(--font-m);
        font-size: 10.5px;
        font-weight: 500;
    }

    .pill-live {
        background: rgba(16,185,129,.10);
        color: var(--green);
        border: 1px solid rgba(16,185,129,.25);
    }

        .pill-live::before {
            content: '';
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: var(--green);
            animation: blink 1.8s ease-in-out infinite;
        }

    @@keyframes blink {
        0%, 100% {
            opacity: 1
        }

        50% {
            opacity: .3
        }
    }

    /* ── DIVIDER ── */
    .divider {
        display: flex;
        gap: 3px;
        height: 3px;
        margin-bottom: 20px;
        border-radius: 3px;
        overflow: hidden;
    }

        .divider span:nth-child(1) {
            flex: 3;
            background: var(--blue);
        }

        .divider span:nth-child(2) {
            flex: 1;
            background: var(--teal);
            opacity: .6;
        }

        .divider span:nth-child(3) {
            flex: 8;
            background: var(--border2);
        }

    /* ── MAIN LAYOUT ── */
    .main-layout {
        display: grid;
        grid-template-columns: 340px 1fr;
        gap: 16px;
        align-items: start;
    }

    /* ── FORM CARD ── */
    .form-card {
        background: var(--surface);
        border-radius: var(--r3);
        border: 1px solid var(--border2);
        box-shadow: var(--sh2);
        overflow: hidden;
        animation: slideUp .35s cubic-bezier(.22,1,.36,1) both;
    }

    .fc-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 14px 22px;
        background: var(--surface2);
        border-bottom: 1px solid var(--border2);
        border-top: 3px solid var(--blue);
    }

    .fc-header-left {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .fc-icon {
        width: 32px;
        height: 32px;
        border-radius: var(--r);
        background: var(--blue-g);
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--blue);
        font-size: 13px;
    }

    .fc-title {
        font-family: var(--font-h);
        font-size: 14px;
        font-weight: 600;
        color: var(--text);
    }

    .fc-sub {
        font-size: 11px;
        color: var(--text3);
        font-weight: 500;
        margin-top: 1px;
    }

    .fc-body {
        padding: 24px 26px;
        max-height: 72vh;
        overflow-y: auto;
        scrollbar-width: thin;
        scrollbar-color: var(--border2) transparent;
    }

        .fc-body::-webkit-scrollbar {
            width: 4px;
        }

        .fc-body::-webkit-scrollbar-thumb {
            background: var(--border2);
            border-radius: 10px;
        }

    /* ── SECTION LABEL ── */
    .sec-label {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 14px;
        padding-bottom: 10px;
        border-bottom: 1px dashed var(--border2);
    }

    .sec-label-bar {
        width: 3px;
        height: 14px;
        border-radius: 3px;
        flex-shrink: 0;
    }

    .slb-blue {
        background: linear-gradient(180deg, var(--blue), var(--teal));
    }

    .slb-teal {
        background: linear-gradient(180deg, var(--teal), var(--blue));
    }

    .slb-amber {
        background: linear-gradient(180deg, var(--amber), var(--coral));
    }

    .sec-label-txt {
        font-family: var(--font-m);
        font-size: 9.5px;
        font-weight: 500;
        color: var(--text3);
        letter-spacing: 2px;
        text-transform: uppercase;
    }

    /* ── FORM ROWS ── */
    .frow {
        display: grid;
        gap: 14px;
        margin-bottom: 14px;
    }

    .frow-1 {
        grid-template-columns: 1fr;
    }

    .frow-2 {
        grid-template-columns: 1fr 1fr;
    }

    /* ── FLOAT LABELS ── */
    .fg {
        position: relative;
    }

        .fg .fc {
            padding: 22px 14px 8px;
        }

        .fg select.fc {
            padding: 22px 14px 8px;
        }

        .fg.always-up .fl {
            top: 7px;
            transform: none;
            font-size: 9px;
            font-family: var(--font-m);
            color: var(--text3);
            letter-spacing: 1px;
            text-transform: uppercase;
            font-weight: 500;
        }

        .fg.always-up .fc:focus ~ .fl {
            color: var(--blue);
        }

    .fl {
        position: absolute;
        left: 14px;
        top: 50%;
        transform: translateY(-50%);
        font-family: var(--font-b);
        font-size: 13px;
        font-weight: 600;
        color: var(--text3);
        pointer-events: none;
        transition: top .18s, transform .18s, font-size .18s, color .18s, letter-spacing .18s;
        white-space: nowrap;
    }

    .fg .fc:focus ~ .fl, .fg.has-value .fl {
        top: 7px;
        transform: none;
        font-size: 9px;
        font-family: var(--font-m);
        color: var(--blue);
        letter-spacing: 1px;
        text-transform: uppercase;
        font-weight: 500;
    }

    .fg .fc::placeholder {
        color: transparent;
    }

    /* ── INPUT BASE ── */
    .fc {
        border: 1px solid var(--border2);
        border-radius: var(--r);
        padding: 10px 14px;
        font-size: 13.5px;
        font-family: var(--font-b);
        font-weight: 600;
        color: var(--text) !important;
        background: var(--surface);
        transition: border-color .2s, box-shadow .2s, background .2s;
        outline: none;
        width: 100%;
        -webkit-text-fill-color: var(--text) !important;
        caret-color: var(--blue);
    }

        .fc:focus {
            border-color: var(--blue);
            box-shadow: 0 0 0 3px var(--blue-g);
            background: #fff;
        }

    select.fc {
        appearance: auto;
        cursor: pointer;
    }

        select.fc option {
            background: #fff;
            color: var(--text);
        }

    /* ── INFO CHIP ── */
    .info-chip {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 9px 13px;
        background: var(--blue-g2);
        border: 1px solid rgba(78,157,255,.20);
        border-radius: var(--r);
        margin-bottom: 14px;
    }

        .info-chip i {
            color: var(--blue);
            font-size: 12px;
        }

        .info-chip span {
            font-family: var(--font-m);
            font-size: 10px;
            color: var(--text2);
            letter-spacing: .5px;
        }

    /* ── SELECTED PRODUCT CHIP ── */
    .product-chip {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 9px 13px;
        background: rgba(0,201,167,.06);
        border: 1px solid rgba(0,201,167,.22);
        border-radius: var(--r);
        margin-bottom: 14px;
    }

        .product-chip i {
            color: var(--teal);
            font-size: 12px;
        }

    .product-chip-label {
        font-size: 10px;
        font-family: var(--font-m);
        color: var(--text3);
        letter-spacing: .5px;
        margin-bottom: 2px;
    }

    .product-chip-name {
        font-size: 13px;
        font-weight: 600;
        color: var(--text);
    }

    .product-chip-code {
        font-size: 10px;
        font-family: var(--font-m);
        color: var(--teal);
        margin-top: 1px;
    }

    /* ── QTY STEPPER ── */
    .qty-wrap {
        position: relative;
        display: flex;
        align-items: center;
    }

    .qty-input {
        text-align: center !important;
        padding: 22px 44px 8px !important;
        font-size: 18px !important;
        font-family: var(--font-m) !important;
        font-weight: 500;
        letter-spacing: 1px;
    }

    .qty-btn {
        position: absolute;
        width: 34px;
        height: 34px;
        background: var(--surface2);
        border: 1px solid var(--border2);
        border-radius: var(--r);
        color: var(--text2);
        font-size: 15px;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all .15s;
        top: 50%;
        transform: translateY(-50%);
    }

        .qty-btn:hover {
            background: var(--blue);
            color: #fff;
            border-color: var(--blue);
        }

    .qty-btn-minus {
        left: 8px;
    }

    .qty-btn-plus {
        right: 8px;
    }

    .qty-hint {
        font-family: var(--font-m);
        font-size: 9.5px;
        color: var(--text3);
        margin-top: 5px;
        text-align: center;
        letter-spacing: .5px;
    }

        .qty-hint i {
            color: var(--blue);
            margin-right: 3px;
        }

    /* ── BUTTONS ── */
    .btn-row {
        display: flex;
        flex-direction: column;
        gap: 8px;
        padding-top: 18px;
        border-top: 1px solid var(--border2);
        margin-top: 4px;
    }

    .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        width: 100%;
        padding: 11px 20px;
        font-family: var(--font-b);
        font-size: 13px;
        font-weight: 700;
        border-radius: var(--r);
        border: none;
        cursor: pointer;
        transition: all .2s ease;
    }

    .btn-primary {
        background: linear-gradient(135deg, var(--blue) 0%, var(--blue-dark) 100%);
        color: #fff;
        box-shadow: 0 3px 14px rgba(78,157,255,.30);
    }

        .btn-primary:hover {
            transform: translateY(-1px);
            box-shadow: 0 6px 20px rgba(78,157,255,.42);
        }

        .btn-primary:disabled {
            opacity: .5;
            cursor: not-allowed;
            transform: none !important;
        }

    .btn-secondary {
        background: var(--surface2);
        color: var(--text2);
        border: 1px solid var(--border2);
    }

        .btn-secondary:hover {
            background: var(--surface3);
            color: var(--text);
        }

        .btn-secondary:disabled {
            opacity: .4;
            cursor: not-allowed;
        }

    /* ── PREVIEW CARD ── */
    .preview-card {
        background: var(--surface);
        border-radius: var(--r3);
        border: 1px solid var(--border2);
        box-shadow: var(--sh2);
        overflow: hidden;
        animation: slideUp .35s cubic-bezier(.22,1,.36,1) .08s both;
    }

    .gc-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 14px 22px;
        background: var(--surface2);
        border-bottom: 1px solid var(--border2);
        border-top: 3px solid var(--blue);
    }

    .gc-header-left {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .gc-icon {
        width: 32px;
        height: 32px;
        border-radius: var(--r);
        background: var(--blue-g);
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--blue);
        font-size: 13px;
    }

    .gc-title {
        font-family: var(--font-h);
        font-size: 14px;
        font-weight: 600;
        color: var(--text);
    }

    .gc-badge {
        background: var(--blue-g);
        color: var(--blue-dark);
        font-family: var(--font-m);
        font-size: 10.5px;
        font-weight: 500;
        padding: 3px 10px;
        border-radius: 20px;
        border: 1px solid rgba(78,157,255,.20);
    }

    .pill-ready {
        background: rgba(0,201,167,.10);
        color: var(--teal);
        border: 1px solid rgba(0,201,167,.25);
        display: none;
    }

        .pill-ready.show {
            display: inline-flex;
        }

    .preview-body {
        padding: 20px;
        min-height: 400px;
    }

    /* ── EMPTY STATE ── */
    .empty-state {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        min-height: 360px;
        gap: 14px;
    }

    .empty-icon {
        width: 60px;
        height: 60px;
        background: var(--surface2);
        border-radius: var(--r2);
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--text3);
        font-size: 22px;
        border: 1px solid var(--border2);
    }

    .empty-title {
        font-family: var(--font-h);
        font-size: 15px;
        font-weight: 600;
        color: var(--text2);
    }

    .empty-sub {
        font-family: var(--font-m);
        font-size: 10px;
        color: var(--text3);
        letter-spacing: .5px;
        text-align: center;
    }

    /* ── BARCODE GRID ── */
    .barcode-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
        gap: 14px;
    }

    .bc-label {
        background: #ffffff;
        border-radius: 10px;
        border: 1.5px solid var(--border3);
        padding: 14px 12px 10px;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 6px;
        box-shadow: var(--sh);
        animation: bcPop .25s cubic-bezier(.22,.68,0,1.2) both;
        transition: transform .2s, box-shadow .2s;
        cursor: pointer;
        position: relative;
        overflow: hidden;
    }

        .bc-label::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 3px;
            background: linear-gradient(90deg, var(--blue), var(--teal));
        }

        .bc-label:hover {
            transform: translateY(-3px);
            box-shadow: var(--sh2);
        }

    .bc-label-num {
        position: absolute;
        top: 8px;
        right: 10px;
        font-family: var(--font-m);
        font-size: 8px;
        color: #999;
    }

    .bc-product-name {
        font-family: var(--font-b);
        font-size: 10.5px;
        font-weight: 700;
        color: #111827;
        text-align: center;
        line-height: 1.3;
        max-width: 160px;
        word-break: break-word;
    }

    .bc-svg-wrap {
        width: 100%;
        display: flex;
        justify-content: center;
    }

        .bc-svg-wrap svg {
            max-width: 160px;
            width: 100%;
            height: auto;
        }

    .bc-code-text {
        font-family: var(--font-m);
        font-size: 9px;
        font-weight: 600;
        color: #444;
        letter-spacing: 1px;
        text-align: center;
    }

    /* ── FOOTER ── */
    .pg-footer {
        margin-top: 18px;
        padding-top: 14px;
        border-top: 1px solid var(--border2);
        text-align: center;
        font-family: var(--font-m);
        font-size: 10.5px;
        color: var(--text3);
        letter-spacing: .5px;
    }

        .pg-footer strong {
            color: var(--blue);
            font-weight: 500;
        }

        .pg-footer .heart {
            color: var(--coral);
        }

    /* ── KEYFRAMES ── */
    @@keyframes fadeDown {
        from {
            opacity: 0;
            transform: translateY(-16px)
        }

        to {
            opacity: 1;
            transform: translateY(0)
        }
    }

    @@keyframes slideUp {
        from {
            opacity: 0;
            transform: translateY(20px)
        }

        to {
            opacity: 1;
            transform: translateY(0)
        }
    }

    @@keyframes bcPop {
        from {
            opacity: 0;
            transform: scale(.88)
        }

        to {
            opacity: 1;
            transform: scale(1)
        }
    }

    /* ── RESPONSIVE ── */
    @@media (max-width: 900px) {
        .main-layout {
            grid-template-columns: 1fr;
        }

        .sr-root {
            padding: 14px;
        }
    }

    /* ── PRINT ── */
    @@media print {
        body * {
            visibility: hidden !important;
        }

        #printArea, #printArea * {
            visibility: visible !important;
        }

        #printArea {
            position: fixed !important;
            top: 0 !important;
            left: 0 !important;
            width: 100% !important;
            background: #fff !important;
            padding: 10px !important;
        }

        .print-grid {
            display: grid !important;
            grid-template-columns: repeat(4, 1fr) !important;
            gap: 8px !important;
        }

        .print-label {
            border: 1px solid #ddd !important;
            border-radius: 6px !important;
            padding: 10px 8px 8px !important;
            display: flex !important;
            flex-direction: column !important;
            align-items: center !important;
            gap: 4px !important;
            page-break-inside: avoid;
            background: #fff !important;
            border-top: 3px solid #4e9dff !important;
        }

        .print-product-name {
            font-size: 9pt !important;
            font-weight: 700 !important;
            color: #111 !important;
            text-align: center !important;
        }

        .print-code {
            font-size: 7.5pt !important;
            color: #444 !important;
            letter-spacing: .5px !important;
        }
    }
</style>

<div class="sr-root">
    <div class="sr-inner">

        <!-- PAGE HEADER -->
        <div class="page-header">
            <div class="ph-left">
                <div class="ph-icon"><i class="fas fa-barcode"></i></div>
                <div>
                    <div class="ph-title">Barcode <span>Printing</span></div>
                    <div class="ph-breadcrumb">
                        Utility
                        <i class="fas fa-chevron-right"></i>
                        <span class="bc-cur">Barcode</span>
                    </div>
                </div>
            </div>
            <div class="status-pill pill-live">Ready</div>
        </div>

        <div class="divider"><span></span><span></span><span></span></div>

        <!-- MAIN LAYOUT -->
        <div class="main-layout">

            <!-- LEFT: FORM -->
            <div class="form-card">
                <div class="fc-header">
                    <div class="fc-header-left">
                        <div class="fc-icon"><i class="fas fa-qrcode"></i></div>
                        <div>
                            <div class="fc-title">Barcode Config</div>
                            <div class="fc-sub">Select product & set quantity</div>
                        </div>
                    </div>
                    <div class="status-pill pill-live">Live</div>
                </div>

                <div class="fc-body">

                    <div class="sec-label">
                        <div class="sec-label-bar slb-blue"></div>
                        <span class="sec-label-txt">Product Lookup</span>
                    </div>

                    <div class="info-chip">
                        <i class="fas fa-circle-info"></i>
                        <span>Select a product to generate its barcode</span>
                    </div>

                    <div class="frow frow-1">
                        <div class="fg always-up">
                            <select id="ProductCode" class="fc">
                                <option value="">— Select Product —</option>
                            </select>
                            <label class="fl" for="ProductCode">Product</label>
                        </div>
                    </div>

                    <!-- Selected product chip -->
                    <div id="selectedProductChip" class="product-chip" style="display:none;">
                        <i class="fas fa-box-open"></i>
                        <div>
                            <div class="product-chip-label">SELECTED PRODUCT</div>
                            <div class="product-chip-name" id="selectedProductName"></div>
                            <div class="product-chip-code" id="selectedProductCode"></div>
                        </div>
                    </div>

                    <div class="sec-label" style="margin-top:6px;">
                        <div class="sec-label-bar slb-teal"></div>
                        <span class="sec-label-txt">Quantity</span>
                    </div>

                    <div class="frow frow-1">
                        <div>
                            <div class="qty-wrap">
                                <button class="qty-btn qty-btn-minus" id="qtyMinus" type="button">
                                    <i class="fas fa-minus" style="font-size:11px;"></i>
                                </button>
                                <input type="number" id="Qty" class="fc qty-input" value="1" min="1" max="200">
                                <label class="fl" for="Qty" style="display:none;"></label>
                                <button class="qty-btn qty-btn-plus" id="qtyPlus" type="button">
                                    <i class="fas fa-plus" style="font-size:11px;"></i>
                                </button>
                            </div>
                            <div class="qty-hint"><i class="fas fa-circle-info"></i> Max 200 labels per batch</div>
                        </div>
                    </div>

                    <div class="btn-row">
                        <button class="btn btn-primary" id="generateBtn">
                            <i class="fas fa-qrcode"></i> Generate Barcode
                        </button>
                        <button class="btn btn-secondary" id="printBtn" disabled>
                            <i class="fas fa-print"></i> Print Labels
                        </button>
                    </div>

                </div>
            </div>

            <!-- RIGHT: PREVIEW -->
            <div class="preview-card">
                <div class="gc-header">
                    <div class="gc-header-left">
                        <div class="gc-icon"><i class="fas fa-eye"></i></div>
                        <div><div class="gc-title">Barcode Preview</div></div>
                        <div class="gc-badge" id="labelCountBadge">0 labels</div>
                    </div>
                    <div style="display:flex;align-items:center;gap:8px;">
                        <div class="status-pill pill-ready" id="readyPill">
                            <i class="fas fa-check" style="font-size:8px;"></i> Ready to Print
                        </div>
                    </div>
                </div>

                <div class="preview-body" id="previewBody">
                    <div class="empty-state" id="emptyState">
                        <div class="empty-icon"><i class="fas fa-barcode"></i></div>
                        <div class="empty-title">No Barcodes Generated</div>
                        <div class="empty-sub">Select a product, set quantity<br>and click Generate Barcode</div>
                    </div>
                    <div id="barcodeGrid" class="barcode-grid" style="display:none;"></div>
                </div>
            </div>

        </div>

        <!-- Hidden Print Area -->
        <div id="printArea" style="display:none;"></div>

        <div class="pg-footer">
            Developed with <span class="heart">♥</span> by <strong>UT Designer</strong>
        </div>

    </div>
</div>

<script>
    let userId = localStorage.getItem("userId") || "";
    let productList = [];
    const SW = { background: '#ffffff', color: '#1e2a3a', confirmButtonColor: '#4e9dff', cancelButtonColor: '#f8f9fc' };

    function initFloatLabels() {
        document.querySelectorAll('.fg:not(.always-up)').forEach(g => {
            const el = g.querySelector('input:not([type="checkbox"]):not([type="file"]),textarea,select');
            if (!el) return;
            const chk = () => g.classList.toggle('has-value', el.value !== '');
            el.addEventListener('input', chk);
            el.addEventListener('change', chk);
            chk();
        });
    }

    window.addEventListener("load", async function () {
        initFloatLabels();
        await loadProducts();
    });

    async function loadProducts() {
        try {
            const res = await jQuery.ajax({
                type: 'POST',
                url: '@Url.Action("nLoadBarcodePrintingData", "BarcodePrinting")',
                data: JSON.stringify({ UserId: userId }),
                contentType: 'application/json'
            });
            if (res.statusId === 1) {
                productList = res.ProductList || [];
                const sel = document.getElementById("ProductCode");
                sel.innerHTML = '<option value="">— Select Product —</option>';
                productList.forEach(p => {
                    const opt = document.createElement("option");
                    opt.value = p.ProductCode || p.productCode || "";
                    opt.setAttribute("data-name", p.ProductName || p.productName || "");
                    opt.textContent = `${p.ProductCode || p.productCode || ""} — ${p.ProductName || p.productName || ""}`;
                    sel.appendChild(opt);
                });
                if (productList.length === 0) toastr.warning("No products found in database.");
            } else {
                toastr.warning(res.MessageCaption || "No products found.");
            }
        } catch (e) {
            console.error("Load products error:", e);
            toastr.error("Error loading products.");
        }
    }

    document.getElementById("ProductCode").addEventListener("change", function () {
        const code = this.value;
        const chip = document.getElementById("selectedProductChip");
        if (!code) { chip.style.display = "none"; return; }
        const opt  = this.options[this.selectedIndex];
        const name = opt.getAttribute("data-name") || "";
        document.getElementById("selectedProductName").textContent = name;
        document.getElementById("selectedProductCode").textContent = "CODE: " + code;
        chip.style.display = "flex";
    });

    document.getElementById("qtyMinus").addEventListener("click", function () {
        const inp = document.getElementById("Qty"), val = parseInt(inp.value) || 1;
        if (val > 1) inp.value = val - 1;
    });
    document.getElementById("qtyPlus").addEventListener("click", function () {
        const inp = document.getElementById("Qty"), val = parseInt(inp.value) || 1;
        if (val < 200) inp.value = val + 1;
    });
    document.getElementById("Qty").addEventListener("input", function () {
        let v = parseInt(this.value) || 1;
        if (v < 1) v = 1;
        if (v > 200) v = 200;
        this.value = v;
    });

    document.getElementById("generateBtn").addEventListener("click", function () {
        const code = document.getElementById("ProductCode").value.trim();
        const qty  = parseInt(document.getElementById("Qty").value) || 1;
        if (!code) { Swal.fire({ icon: 'warning', title: 'Validation', text: 'Please select a product.', ...SW }); return; }
        if (qty < 1 || qty > 200) { Swal.fire({ icon: 'warning', title: 'Validation', text: 'Quantity must be between 1 and 200.', ...SW }); return; }
        const opt  = document.getElementById("ProductCode").options[document.getElementById("ProductCode").selectedIndex];
        const name = opt.getAttribute("data-name") || "Product";
        generateBarcodes(code, name, qty);
    });

    function generateBarcodes(code, productName, qty) {
        if (!code || code.trim() === "") { toastr.error("Invalid product code."); return; }
        const grid  = document.getElementById("barcodeGrid");
        const empty = document.getElementById("emptyState");
        const badge = document.getElementById("labelCountBadge");
        const ready = document.getElementById("readyPill");
        grid.innerHTML = ""; grid.style.display = "none"; empty.style.display = "flex";
        setTimeout(() => {
            for (let i = 0; i < qty; i++) { grid.appendChild(createBarcodeCard(code, productName, i + 1, qty)); }
            grid.querySelectorAll('svg.barcode-svg').forEach(svg => {
                try { JsBarcode(svg, code, { format: "CODE128", lineColor: "#111827", background: "#ffffff", width: 1.6, height: 48, displayValue: false, margin: 2 }); }
                catch (e) { console.error("Barcode render error:", e); }
            });
            empty.style.display = "none"; grid.style.display = "grid";
            badge.textContent = `${qty} label${qty > 1 ? 's' : ''}`;
            ready.classList.add("show");
            document.getElementById("printBtn").disabled = false;
            buildPrintArea(code, productName, qty);
        }, 80);
    }

    function createBarcodeCard(code, productName, num, total) {
        const card = document.createElement("div");
        card.className = "bc-label";
        card.style.animationDelay = `${(num - 1) * 0.04}s`;
        card.innerHTML = `
            <div class="bc-label-num">${num}/${total}</div>
            <div class="bc-product-name">${productName}</div>
            <div class="bc-svg-wrap"><svg class="barcode-svg"></svg></div>
            <div class="bc-code-text">${code}</div>`;
        return card;
    }

    function buildPrintArea(code, productName, qty) {
        const area = document.getElementById("printArea");
        let html = `<div class="print-grid">`;
        for (let i = 0; i < qty; i++) {
            html += `<div class="print-label">
                <div class="print-product-name">${productName}</div>
                <svg class="print-bc-svg print-barcode-svg" style="width:120px;height:auto;"></svg>
                <div class="print-code">${code}</div>
            </div>`;
        }
        html += `</div>`;
        area.innerHTML = html; area.style.display = "block";
        area.querySelectorAll('.print-barcode-svg').forEach(svg => {
            try { JsBarcode(svg, code, { format: "CODE128", lineColor: "#000000", background: "#ffffff", width: 1.4, height: 44, displayValue: false, margin: 1 }); }
            catch (e) { console.error("Print barcode error:", e); }
        });
        area.style.display = "none";
    }

    document.getElementById("printBtn").addEventListener("click", function () {
        const area = document.getElementById("printArea");
        area.style.display = "block";
        window.print();
        setTimeout(() => { area.style.display = "none"; }, 1000);
    });
</script>
