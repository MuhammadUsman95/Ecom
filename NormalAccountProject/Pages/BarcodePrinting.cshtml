@page "/BarcodePrinting"
@model NormalAccountProject.Pages.BarcodePrintingModel
@{
    ViewData["Title"] = "Barcode Printing";
}

<link href="https://fonts.googleapis.com/css2?family=Syne:wght@600;700;800&family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/jsbarcode/3.11.6/JsBarcode.all.min.js"></script>

<style>
    :root {
        --bg: #0a0c12;
        --bg2: #0f1220;
        --surface: #141828;
        --surface2: #1a2035;
        --surface3: #1f2640;
        --border: rgba(255,255,255,.06);
        --border2: rgba(255,255,255,.11);
        --border3: rgba(255,255,255,.18);
        --accent: #6c63ff;
        --accent2: #4f46e5;
        --accent-g: rgba(108,99,255,.15);
        --gold: #f0b429;
        --gold-g: rgba(240,180,41,.12);
        --teal: #14b8a6;
        --danger: #f43f5e;
        --success: #10b981;
        --text: #e8eaf2;
        --text2: #9198b0;
        --text3: #5a6182;
        --font-h: 'Syne',sans-serif;
        --font-b: 'Plus Jakarta Sans',sans-serif;
        --font-m: 'JetBrains Mono',monospace;
        --r: 10px;
        --r2: 14px;
        --r3: 18px;
        --sh: 0 4px 32px rgba(0,0,0,.45);
        --sh2: 0 8px 48px rgba(0,0,0,.6);
    }

    *, *::before, *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    .vr-wrap {
        font-family: var(--font-b);
        color: var(--text);
        background: var(--bg);
        min-height: calc(100vh - 60px);
        position: relative;
        overflow: hidden;
    }

        .vr-wrap::before {
            content: '';
            position: fixed;
            top: -200px;
            right: -200px;
            width: 550px;
            height: 550px;
            background: radial-gradient(circle,rgba(108,99,255,.07) 0%,transparent 65%);
            pointer-events: none;
            z-index: 0;
        }

        .vr-wrap::after {
            content: '';
            position: fixed;
            bottom: -150px;
            left: -150px;
            width: 450px;
            height: 450px;
            background: radial-gradient(circle,rgba(20,184,166,.05) 0%,transparent 65%);
            pointer-events: none;
            z-index: 0;
        }

    .vr-bg-grid {
        position: fixed;
        inset: 0;
        z-index: 0;
        pointer-events: none;
        background-image: linear-gradient(rgba(255,255,255,.02) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.02) 1px,transparent 1px);
        background-size: 40px 40px;
    }

    .vr-inner {
        position: relative;
        z-index: 1;
        padding: 20px 24px;
    }

    .top-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 20px;
        padding-bottom: 16px;
        border-bottom: 1px solid var(--border2);
    }

    .top-bar-left {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .icon-box {
        width: 44px;
        height: 44px;
        background: linear-gradient(135deg,var(--accent) 0%,var(--accent2) 100%);
        border-radius: var(--r);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        font-size: 17px;
        box-shadow: 0 4px 20px rgba(108,99,255,.4);
        flex-shrink: 0;
    }

    .page-title {
        font-family: var(--font-h);
        font-size: 21px;
        font-weight: 800;
        color: var(--text);
        letter-spacing: -.3px;
        line-height: 1.1;
    }

        .page-title span {
            color: var(--accent);
        }

    .breadcrumb {
        display: flex;
        align-items: center;
        gap: 5px;
        font-family: var(--font-m);
        font-size: 10px;
        color: var(--text3);
        letter-spacing: .5px;
        margin-top: 3px;
    }

        .breadcrumb i {
            font-size: 7px;
        }

        .breadcrumb span {
            color: var(--gold);
        }

    .pill {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 3px 10px;
        border-radius: 20px;
        font-family: var(--font-m);
        font-size: 10.5px;
        font-weight: 500;
        border: 1px solid transparent;
    }

    .pill-gold {
        background: var(--gold-g);
        color: var(--gold);
        border-color: rgba(240,180,41,.25);
    }

    .pill-accent {
        background: var(--accent-g);
        color: #a09eff;
        border-color: rgba(108,99,255,.25);
    }

    .accent-line {
        display: flex;
        gap: 2px;
        margin-bottom: 18px;
        height: 2px;
    }

        .accent-line span:nth-child(1) {
            flex: 2;
            background: var(--accent);
            border-radius: 2px;
        }

        .accent-line span:nth-child(2) {
            flex: 1;
            background: var(--teal);
            border-radius: 2px;
            opacity: .6;
        }

        .accent-line span:nth-child(3) {
            flex: 3;
            background: var(--border);
            border-radius: 2px;
        }

    .main-layout {
        display: grid;
        grid-template-columns: 340px 1fr;
        gap: 16px;
        align-items: start;
    }

    .form-card {
        background: var(--surface);
        border-radius: var(--r3);
        border: 1px solid var(--border2);
        box-shadow: var(--sh2);
        overflow: hidden;
        animation: fadeUp .3s ease both;
    }

    .form-card-header {
        padding: 12px 22px;
        background: linear-gradient(90deg,var(--surface2) 0%,rgba(108,99,255,.08) 100%);
        border-bottom: 1px solid var(--border2);
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .form-card-header-left {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .header-dots {
        display: flex;
        gap: 5px;
    }

    .h-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
    }

    .h-dot-1 {
        background: #f43f5e;
    }

    .h-dot-2 {
        background: #f59e0b;
    }

    .h-dot-3 {
        background: #10b981;
    }

    .form-card-title {
        font-family: var(--font-m);
        font-size: 10.5px;
        font-weight: 500;
        color: var(--text3);
        letter-spacing: 1.5px;
        text-transform: uppercase;
    }

    .form-body {
        padding: 22px 24px;
    }

    .section-label {
        display: flex;
        align-items: center;
        gap: 9px;
        font-family: var(--font-m);
        font-size: 9.5px;
        color: var(--text3);
        letter-spacing: 2px;
        text-transform: uppercase;
        margin-bottom: 14px;
        padding-bottom: 10px;
        border-bottom: 1px solid var(--border);
        font-weight: 500;
    }

    .section-label-bar {
        width: 3px;
        height: 12px;
        background: linear-gradient(180deg,var(--accent),var(--teal));
        border-radius: 3px;
        flex-shrink: 0;
    }

    .section-label-text {
        color: var(--text2);
    }

    .form-row {
        display: grid;
        gap: 12px;
        margin-bottom: 14px;
    }

    .form-row-1 {
        grid-template-columns: 1fr;
    }

    .float-group {
        position: relative;
    }

        .float-group .form-control {
            padding: 22px 13px 7px;
        }

        .float-group select.form-control {
            padding: 22px 13px 7px;
        }

    .float-label {
        position: absolute;
        left: 13px;
        top: 50%;
        transform: translateY(-50%);
        font-family: var(--font-b);
        font-size: 13px;
        font-weight: 500;
        color: var(--text3);
        pointer-events: none;
        transition: top .18s,transform .18s,font-size .18s,color .18s,letter-spacing .18s;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        max-width: calc(100% - 26px);
    }

    .float-group .form-control:focus ~ .float-label,
    .float-group.has-value .float-label {
        top: 7px;
        transform: none;
        font-size: 9px;
        font-family: var(--font-m);
        color: var(--accent);
        letter-spacing: 1px;
        text-transform: uppercase;
        font-weight: 500;
    }

    .float-group.always-float .float-label {
        top: 7px;
        transform: none;
        font-size: 9px;
        font-family: var(--font-m);
        color: var(--text3);
        letter-spacing: 1px;
        text-transform: uppercase;
        font-weight: 500;
    }

    .float-group.always-float .form-control:focus ~ .float-label {
        color: var(--accent);
    }

    .float-group .form-control::placeholder {
        color: transparent;
    }

    .form-control {
        border: 1px solid var(--border2);
        border-radius: var(--r);
        padding: 9px 13px;
        font-size: 13.5px;
        font-family: var(--font-b);
        color: #e8eaf2 !important;
        background: var(--bg2);
        transition: border-color .18s,box-shadow .18s,background .18s;
        outline: none;
        width: 100%;
        -webkit-text-fill-color: #e8eaf2 !important;
        caret-color: #6c63ff;
    }

        .form-control:focus {
            border-color: var(--accent);
            box-shadow: 0 0 0 3px rgba(108,99,255,.14);
            background: var(--surface);
        }

        .form-control:-webkit-autofill,
        .form-control:-webkit-autofill:hover,
        .form-control:-webkit-autofill:focus {
            -webkit-text-fill-color: #e8eaf2 !important;
            -webkit-box-shadow: 0 0 0px 1000px var(--bg2) inset !important;
            transition: background-color 5000s ease-in-out 0s;
        }

    select.form-control {
        appearance: auto;
        cursor: pointer;
    }

        select.form-control option {
            background: var(--surface);
            color: #e8eaf2;
        }

    .qty-wrap {
        position: relative;
        display: flex;
        align-items: center;
    }

    .qty-input {
        text-align: center;
        padding: 12px 44px !important;
        font-size: 18px !important;
        font-family: var(--font-m) !important;
        font-weight: 500;
        letter-spacing: 1px;
    }

    .qty-btn {
        position: absolute;
        width: 36px;
        height: 36px;
        background: var(--surface3);
        border: 1px solid var(--border2);
        border-radius: 8px;
        color: var(--text2);
        font-size: 16px;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all .15s;
        top: 50%;
        transform: translateY(-50%);
    }

        .qty-btn:hover {
            background: var(--accent);
            color: #fff;
            border-color: var(--accent);
        }

    .qty-btn-minus {
        left: 8px;
    }

    .qty-btn-plus {
        right: 8px;
    }

    .btn-row {
        display: flex;
        flex-direction: column;
        gap: 8px;
        padding-top: 16px;
        border-top: 1px solid var(--border);
        margin-top: 4px;
    }

    .btn-generate {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 9px;
        width: 100%;
        padding: 13px;
        background: linear-gradient(135deg,var(--accent) 0%,var(--accent2) 100%);
        color: #fff;
        border: none;
        border-radius: var(--r);
        font-family: var(--font-b);
        font-size: 14px;
        font-weight: 700;
        cursor: pointer;
        transition: all .2s ease;
        box-shadow: 0 4px 20px rgba(108,99,255,.45);
        letter-spacing: .2px;
    }

        .btn-generate:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 28px rgba(108,99,255,.55);
        }

        .btn-generate:active {
            transform: translateY(0);
        }

        .btn-generate:disabled {
            opacity: .5;
            cursor: not-allowed;
            transform: none !important;
        }

    .btn-print {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 9px;
        width: 100%;
        padding: 11px;
        background: var(--surface2);
        color: var(--text2);
        border: 1px solid var(--border2);
        border-radius: var(--r);
        font-family: var(--font-b);
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        transition: all .2s ease;
    }

        .btn-print:hover {
            background: var(--gold-g);
            color: var(--gold);
            border-color: rgba(240,180,41,.3);
        }

        .btn-print:disabled {
            opacity: .4;
            cursor: not-allowed;
        }

    .info-chip {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 9px 13px;
        background: var(--accent-g);
        border: 1px solid rgba(108,99,255,.22);
        border-radius: var(--r);
        margin-bottom: 14px;
    }

        .info-chip i {
            color: var(--accent);
            font-size: 12px;
        }

        .info-chip span {
            font-family: var(--font-m);
            font-size: 10px;
            color: var(--text2);
            letter-spacing: .5px;
        }

    .preview-card {
        background: var(--surface);
        border-radius: var(--r3);
        border: 1px solid var(--border2);
        box-shadow: var(--sh2);
        overflow: hidden;
        animation: fadeUp .3s ease .1s both;
    }

    .preview-header {
        padding: 12px 20px;
        background: linear-gradient(90deg,var(--surface2) 0%,rgba(108,99,255,.06) 100%);
        border-bottom: 1px solid var(--border2);
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .preview-header-left {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .preview-title {
        font-family: var(--font-m);
        font-size: 10.5px;
        font-weight: 500;
        color: var(--text3);
        text-transform: uppercase;
        letter-spacing: 1.5px;
    }

    .preview-body {
        padding: 20px;
        min-height: 400px;
    }

    .empty-state {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        min-height: 360px;
        gap: 14px;
    }

    .empty-icon-wrap {
        width: 70px;
        height: 70px;
        background: var(--surface2);
        border-radius: var(--r2);
        display: flex;
        align-items: center;
        justify-content: center;
        border: 1px solid var(--border2);
    }

        .empty-icon-wrap i {
            font-size: 26px;
            color: var(--text3);
        }

    .empty-title {
        font-family: var(--font-h);
        font-size: 15px;
        font-weight: 700;
        color: var(--text2);
    }

    .empty-sub {
        font-family: var(--font-m);
        font-size: 10px;
        color: var(--text3);
        letter-spacing: .5px;
        text-align: center;
    }

    .barcode-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill,minmax(180px,1fr));
        gap: 14px;
    }

    .bc-label {
        background: #ffffff;
        border-radius: 10px;
        border: 1.5px solid var(--border3);
        padding: 14px 12px 10px;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 6px;
        box-shadow: 0 2px 14px rgba(0,0,0,.35);
        animation: bcPop .25s cubic-bezier(.22,.68,0,1.2) both;
        transition: transform .2s,box-shadow .2s;
        cursor: pointer;
        position: relative;
        overflow: hidden;
    }

        .bc-label::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 3px;
            background: linear-gradient(90deg,var(--accent),var(--teal));
        }

        .bc-label:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 28px rgba(0,0,0,.5);
        }

    .bc-label-num {
        position: absolute;
        top: 8px;
        right: 10px;
        font-family: var(--font-m);
        font-size: 8px;
        color: #999;
        font-weight: 500;
    }

    .bc-product-name {
        font-family: 'Plus Jakarta Sans',sans-serif;
        font-size: 10.5px;
        font-weight: 700;
        color: #111827;
        text-align: center;
        line-height: 1.3;
        max-width: 160px;
        word-break: break-word;
    }

    .bc-svg-wrap {
        width: 100%;
        display: flex;
        justify-content: center;
    }

        .bc-svg-wrap svg {
            max-width: 160px;
            width: 100%;
            height: auto;
        }

    .bc-code-text {
        font-family: 'JetBrains Mono',monospace;
        font-size: 9px;
        font-weight: 600;
        color: #444;
        letter-spacing: 1px;
        text-align: center;
    }

    .count-badge {
        background: var(--accent-g);
        color: #a09eff;
        font-family: var(--font-m);
        font-size: 10.5px;
        padding: 3px 10px;
        border-radius: 20px;
        border: 1px solid rgba(108,99,255,.22);
    }

    .page-footer {
        margin-top: 16px;
        padding-top: 12px;
        border-top: 1px solid var(--border);
        text-align: center;
        font-family: var(--font-m);
        font-size: 10px;
        color: var(--text3);
        letter-spacing: .5px;
    }

        .page-footer strong {
            color: var(--accent);
            font-weight: 500;
        }

    @@keyframes fadeUp {
        from {
            opacity: 0;
            transform: translateY(10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes bcPop {
        from {
            opacity: 0;
            transform: scale(.88);
        }

        to {
            opacity: 1;
            transform: scale(1);
        }
    }

    /* ── PRINT ── */
    @@media print {
        body * {
            visibility: hidden !important;
        }

        #printArea, #printArea * {
            visibility: visible !important;
        }

        #printArea {
            position: fixed !important;
            top: 0 !important;
            left: 0 !important;
            width: 100% !important;
            background: #fff !important;
            padding: 10px !important;
        }

        .print-grid {
            display: grid !important;
            grid-template-columns: repeat(4, 1fr) !important;
            gap: 8px !important;
            page-break-inside: auto;
        }

        .print-label {
            border: 1px solid #ddd !important;
            border-radius: 6px !important;
            padding: 10px 8px 8px !important;
            display: flex !important;
            flex-direction: column !important;
            align-items: center !important;
            gap: 4px !important;
            page-break-inside: avoid;
            break-inside: avoid;
            background: #fff !important;
            border-top: 3px solid #6c63ff !important;
        }

        .print-product-name {
            font-family: 'Plus Jakarta Sans', sans-serif !important;
            font-size: 9pt !important;
            font-weight: 700 !important;
            color: #111 !important;
            text-align: center !important;
            line-height: 1.3 !important;
        }

        .print-code {
            font-family: 'JetBrains Mono', monospace !important;
            font-size: 7.5pt !important;
            color: #444 !important;
            letter-spacing: .5px !important;
        }

        .print-bc-svg {
            width: 120px !important;
        }
    }
</style>

<div class="vr-wrap">
    <div class="vr-bg-grid"></div>
    <div class="vr-inner">

        <!-- Top Bar -->
        <div class="top-bar">
            <div class="top-bar-left">
                <div class="icon-box"><i class="fas fa-barcode"></i></div>
                <div>
                    <div class="page-title">Barcode <span>Printing</span></div>
                    <div class="breadcrumb">Utility <i class="fas fa-chevron-right"></i> <span>Barcode</span></div>
                </div>
            </div>
            <div class="pill pill-gold">
                <i class="fas fa-circle" style="font-size:6px;"></i> Ready
            </div>
        </div>

        <div class="accent-line"><span></span><span></span><span></span></div>

        <!-- Main 2-col Layout -->
        <div class="main-layout">

            <!-- LEFT: FORM -->
            <div class="form-card">
                <div class="form-card-header">
                    <div class="form-card-header-left">
                        <div class="header-dots">
                            <div class="h-dot h-dot-1"></div>
                            <div class="h-dot h-dot-2"></div>
                            <div class="h-dot h-dot-3"></div>
                        </div>
                        <div class="form-card-title">barcode_config.form</div>
                    </div>
                </div>

                <div class="form-body">

                    <div class="section-label">
                        <div class="section-label-bar"></div>
                        <span class="section-label-text">Product Lookup</span>
                    </div>

                    <div class="info-chip">
                        <i class="fas fa-circle-info"></i>
                        <span>Select a product to generate its barcode</span>
                    </div>

                    <div class="form-row form-row-1">
                        <div class="float-group always-float">
                            <select id="ProductCode" class="form-control">
                                <option value="">— Select Product —</option>
                            </select>
                            <label class="float-label" for="ProductCode">Product</label>
                        </div>
                    </div>

                    <!-- Selected product display -->
                    <div id="selectedProductChip" style="display:none;margin-bottom:14px;">
                        <div style="display:flex;align-items:center;gap:8px;padding:9px 13px;background:rgba(16,185,129,.08);border:1px solid rgba(16,185,129,.22);border-radius:var(--r);">
                            <i class="fas fa-box-open" style="color:#34d399;font-size:12px;"></i>
                            <div>
                                <div style="font-size:10px;font-family:var(--font-m);color:var(--text3);letter-spacing:.5px;margin-bottom:2px;">SELECTED PRODUCT</div>
                                <div id="selectedProductName" style="font-size:13px;font-weight:600;color:var(--text);"></div>
                                <div id="selectedProductCode" style="font-size:10px;font-family:var(--font-m);color:#34d399;margin-top:1px;"></div>
                            </div>
                        </div>
                    </div>

                    <div class="section-label" style="margin-top:4px;">
                        <div class="section-label-bar" style="background:linear-gradient(180deg,var(--gold),var(--teal));"></div>
                        <span class="section-label-text">Quantity</span>
                    </div>

                    <div class="form-row form-row-1">
                        <div>
                            <div class="qty-wrap">
                                <button class="qty-btn qty-btn-minus" id="qtyMinus" type="button">
                                    <i class="fas fa-minus" style="font-size:11px;"></i>
                                </button>
                                <input type="number" id="Qty" class="form-control qty-input" value="1" min="1" max="200">
                                <button class="qty-btn qty-btn-plus" id="qtyPlus" type="button">
                                    <i class="fas fa-plus" style="font-size:11px;"></i>
                                </button>
                            </div>
                            <div style="font-family:var(--font-m);font-size:9.5px;color:var(--text3);margin-top:6px;text-align:center;letter-spacing:.5px;">
                                <i class="fas fa-circle-info" style="color:var(--accent);margin-right:4px;"></i>
                                Max 200 labels per batch
                            </div>
                        </div>
                    </div>

                    <div class="btn-row">
                        <button class="btn-generate" id="generateBtn">
                            <i class="fas fa-qrcode"></i>
                            Generate Barcode
                        </button>
                        <button class="btn-print" id="printBtn" disabled>
                            <i class="fas fa-print"></i>
                            Print Labels
                        </button>
                    </div>

                </div>
            </div>

            <!-- RIGHT: PREVIEW -->
            <div class="preview-card">
                <div class="preview-header">
                    <div class="preview-header-left">
                        <div class="header-dots">
                            <div class="h-dot h-dot-1"></div>
                            <div class="h-dot h-dot-2"></div>
                            <div class="h-dot h-dot-3"></div>
                        </div>
                        <div class="preview-title">barcode_preview.report</div>
                    </div>
                    <div style="display:flex;align-items:center;gap:8px;">
                        <div class="count-badge" id="labelCountBadge">0 labels</div>
                        <div class="pill pill-accent" id="readyPill" style="display:none;">
                            <i class="fas fa-check" style="font-size:8px;"></i> Ready to Print
                        </div>
                    </div>
                </div>

                <div class="preview-body" id="previewBody">
                    <div class="empty-state" id="emptyState">
                        <div class="empty-icon-wrap">
                            <i class="fas fa-barcode"></i>
                        </div>
                        <div class="empty-title">No Barcodes Generated</div>
                        <div class="empty-sub">Select a product, set quantity<br>and click Generate Barcode</div>
                    </div>
                    <div id="barcodeGrid" class="barcode-grid" style="display:none;"></div>
                </div>
            </div>

        </div>

        <!-- Hidden Print Area -->
        <div id="printArea" style="display:none;"></div>

        <div class="page-footer">
            Developed with <span style="color:var(--danger);">♥</span> by <strong>UT Designer</strong>
        </div>
    </div>
</div>

<script>
    let userId = localStorage.getItem("userId") || "";
    let productList = [];
    const SW = { background: '#0f1220', color: '#e8eaf2', confirmButtonColor: '#6c63ff', cancelButtonColor: '#1a2035' };

    /* ── Float Labels ── */
    function initFloatLabels() {
        document.querySelectorAll('.float-group:not(.always-float)').forEach(g => {
            const el = g.querySelector('input,textarea,select');
            if (!el) return;
            const chk = () => g.classList.toggle('has-value', el.value !== '');
            el.addEventListener('input', chk);
            el.addEventListener('change', chk);
            chk();
        });
    }

    /* ── Load Products on Page Load ── */
    window.addEventListener("load", async function () {
        initFloatLabels();
        await loadProducts();
    });

    /* ── ✅ FIXED: JS now reads res.MessageCaption instead of res.message ── */
    async function loadProducts() {
        try {
            const res = await jQuery.ajax({
                type: 'POST',
                url: '@Url.Action("nLoadBarcodePrintingData", "BarcodePrinting")',
                data: JSON.stringify({ UserId: userId }),
                contentType: 'application/json'
            });

            if (res.statusId === 1) {
                productList = res.ProductList || [];

                const sel = document.getElementById("ProductCode");
                sel.innerHTML = '<option value="">— Select Product —</option>';

                productList.forEach(p => {
                         const opt = document.createElement("option");
                        opt.value = p.ProductCode || p.productCode || "";
                        opt.setAttribute("data-name", p.ProductName || p.productName || "");
                        opt.textContent = `${p.ProductCode || p.productCode || ""} — ${p.ProductName || p.productName || ""}`;
                    sel.appendChild(opt);
                });

                if (productList.length === 0) {
                    toastr.warning("No products found in database.");
                }
            } else {
                // ✅ FIXED: using MessageCaption
                toastr.warning(res.MessageCaption || "No products found.");
            }
        } catch (e) {
            console.error("Load products error:", e);
            toastr.error("Error loading products. Check console for details.");
        }
    }

    /* ── Product Select Change ── */
    document.getElementById("ProductCode").addEventListener("change", function () {
        const code = this.value;
        const chip = document.getElementById("selectedProductChip");
        if (!code) { chip.style.display = "none"; return; }

        const opt  = this.options[this.selectedIndex];
        const name = opt.getAttribute("data-name") || "";

        document.getElementById("selectedProductName").textContent = name;
        document.getElementById("selectedProductCode").textContent = "CODE: " + code;
        chip.style.display = "block";
    });

    /* ── Qty Stepper ── */
    document.getElementById("qtyMinus").addEventListener("click", function () {
        const inp = document.getElementById("Qty");
        const val = parseInt(inp.value) || 1;
        if (val > 1) inp.value = val - 1;
    });

    document.getElementById("qtyPlus").addEventListener("click", function () {
        const inp = document.getElementById("Qty");
        const val = parseInt(inp.value) || 1;
        if (val < 200) inp.value = val + 1;
    });

    document.getElementById("Qty").addEventListener("input", function () {
        let v = parseInt(this.value) || 1;
        if (v < 1)   v = 1;
        if (v > 200) v = 200;
        this.value = v;
    });

    /* ── Generate ── */
    document.getElementById("generateBtn").addEventListener("click", function () {
        const code = document.getElementById("ProductCode").value.trim();
        const qty  = parseInt(document.getElementById("Qty").value) || 1;

        if (!code) {
            Swal.fire({ icon: 'warning', title: 'Validation', text: 'Please select a product.', ...SW });
            return;
        }
        if (qty < 1 || qty > 200) {
            Swal.fire({ icon: 'warning', title: 'Validation', text: 'Quantity must be between 1 and 200.', ...SW });
            return;
        }

        const opt  = document.getElementById("ProductCode").options[document.getElementById("ProductCode").selectedIndex];
        const name = opt.getAttribute("data-name") || "Product";

        generateBarcodes(code, name, qty);
    });

    function generateBarcodes(code, productName, qty) {
        // ✅ Guard: do not proceed if code is empty
        if (!code || code.trim() === "") {
            toastr.error("Invalid product code.");
            return;
        }

        const grid  = document.getElementById("barcodeGrid");
        const empty = document.getElementById("emptyState");
        const badge = document.getElementById("labelCountBadge");
        const ready = document.getElementById("readyPill");

        grid.innerHTML    = "";
        grid.style.display = "none";
        empty.style.display = "flex";

        setTimeout(() => {
            for (let i = 0; i < qty; i++) {
                const card = createBarcodeCard(code, productName, i + 1, qty);
                grid.appendChild(card);
            }

            // Render barcodes into SVGs
            grid.querySelectorAll('svg.barcode-svg').forEach(svg => {
                try {
                    JsBarcode(svg, code, {
                        format:       "CODE128",
                        lineColor:    "#111827",
                        background:   "#ffffff",
                        width:        1.6,
                        height:       48,
                        displayValue: false,
                        margin:       2
                    });
                } catch (e) {
                    console.error("Barcode render error:", e);
                }
            });

            empty.style.display = "none";
            grid.style.display  = "grid";
            badge.textContent   = `${qty} label${qty > 1 ? 's' : ''}`;
            ready.style.display = "inline-flex";

            document.getElementById("printBtn").disabled = false;

            buildPrintArea(code, productName, qty);

        }, 80);
    }

    function createBarcodeCard(code, productName, num, total) {
        const card = document.createElement("div");
        card.className = "bc-label";
        card.style.animationDelay = `${(num - 1) * 0.04}s`;
        card.innerHTML = `
            <div class="bc-label-num">${num}/${total}</div>
            <div class="bc-product-name">${productName}</div>
            <div class="bc-svg-wrap">
                <svg class="barcode-svg"></svg>
            </div>
            <div class="bc-code-text">${code}</div>
        `;
        return card;
    }

    /* ── Build Print Area ── */
    function buildPrintArea(code, productName, qty) {
        const area = document.getElementById("printArea");
        let html = `<div class="print-grid">`;
        for (let i = 0; i < qty; i++) {
            html += `
                <div class="print-label">
                    <div class="print-product-name">${productName}</div>
                    <svg class="print-bc-svg print-barcode-svg" style="width:120px;height:auto;"></svg>
                    <div class="print-code">${code}</div>
                </div>`;
        }
        html += `</div>`;
        area.innerHTML = html;
        area.style.display = "block";

        area.querySelectorAll('.print-barcode-svg').forEach(svg => {
            try {
                JsBarcode(svg, code, {
                    format:       "CODE128",
                    lineColor:    "#000000",
                    background:   "#ffffff",
                    width:        1.4,
                    height:       44,
                    displayValue: false,
                    margin:       1
                });
            } catch (e) {
                console.error("Print barcode error:", e);
            }
        });

        area.style.display = "none";
    }

    /* ── Print ── */
    document.getElementById("printBtn").addEventListener("click", function () {
        const area = document.getElementById("printArea");
        area.style.display = "block";
        window.print();
        setTimeout(() => { area.style.display = "none"; }, 1000);
    });
</script>
