@page "/SaleInvoice"
@model NormalAccountProject.Pages.CategoryModel
@{
    ViewData["Title"] = "SaleInvoice";
}

<style>
    @@import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;1,9..40,300&display=swap');

    * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    .so-root {
        font-family: 'DM Sans', sans-serif;
        background: #f4f4f4;
        padding: 20px 24px;
        min-height: 100vh;
        color: #1a1a1a;
        font-size: 13px;
    }

    /* TOP BAR */
    .so-topbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 16px;
        padding-bottom: 14px;
        border-bottom: 1px solid rgba(0,0,0,.10);
    }

    .so-topbar-left {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .so-icon-box {
        width: 44px;
        height: 44px;
        background: #1a1a1a;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        font-size: 18px;
        flex-shrink: 0;
    }

    .so-page-title {
        font-size: 22px;
        font-weight: 700;
        color: #1a1a1a;
        letter-spacing: -0.4px;
    }

        .so-page-title span {
            color: #777;
            font-weight: 400;
        }

    .so-breadcrumb {
        display: flex;
        align-items: center;
        gap: 5px;
        font-family: 'IBM Plex Mono',monospace;
        font-size: 10px;
        color: #aaa;
        margin-top: 2px;
    }

        .so-breadcrumb span {
            color: #b08d57;
        }

    .so-grid-btn {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 8px 18px;
        font-family: 'DM Sans',sans-serif;
        font-size: 13px;
        font-weight: 500;
        border-radius: 9px;
        border: 1px solid rgba(0,0,0,.15);
        background: #fff;
        color: #444;
        cursor: pointer;
        transition: all .15s;
    }

        .so-grid-btn:hover {
            background: #f0f0f0;
        }

    /* ACCENT LINE */
    .so-accent-line {
        display: flex;
        gap: 2px;
        margin-bottom: 18px;
        height: 2px;
    }

        .so-accent-line span:nth-child(1) {
            flex: 2;
            background: #1a1a1a;
            border-radius: 2px;
        }

        .so-accent-line span:nth-child(2) {
            flex: 1;
            background: #5a7a6e;
            border-radius: 2px;
            opacity: .6;
        }

        .so-accent-line span:nth-child(3) {
            flex: 3;
            background: rgba(0,0,0,.10);
            border-radius: 2px;
        }

    /* SHELL */
    .so-shell {
        background: #ffffff;
        border: 1px solid rgba(0,0,0,.10);
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 4px 28px rgba(0,0,0,.06),0 0 0 1px rgba(0,0,0,.04);
    }

    /* TITLEBAR */
    .so-titlebar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 10px 18px;
        background: #fafafa;
        border-bottom: 1px solid rgba(0,0,0,.08);
    }

    .so-dots {
        display: flex;
        gap: 6px;
    }

    .so-dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
    }

    .so-dot-r {
        background: #f05e5e;
    }

    .so-dot-y {
        background: #f0c05e;
    }

    .so-dot-g {
        background: #5ec47c;
    }

    .so-fname {
        font-family: 'IBM Plex Mono',monospace;
        font-size: 10.5px;
        color: #aaa;
        letter-spacing: 0.5px;
    }

    .so-live {
        display: flex;
        align-items: center;
        gap: 5px;
        font-family: 'IBM Plex Mono',monospace;
        font-size: 10px;
        color: #3B6D11;
        background: #EAF3DE;
        border: 1px solid #97C459;
        border-radius: 20px;
        padding: 3px 10px;
    }

    .so-live-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: #639922;
        animation: solivepulse 2s infinite;
    }

    @@keyframes solivepulse {
        0%, 100% {
            opacity: 1
        }

        50% {
            opacity: .35
        }
    }

    /* BODY */
    .so-body {
        padding: 22px 24px;
    }

    /* SECTION LABEL */
    .so-section-label {
        display: flex;
        align-items: center;
        gap: 9px;
        font-family: 'IBM Plex Mono',monospace;
        font-size: 9px;
        text-transform: uppercase;
        letter-spacing: 2px;
        color: #888;
        margin-bottom: 16px;
        padding-bottom: 10px;
        border-bottom: 1px solid rgba(0,0,0,.07);
    }

    .so-section-bar {
        width: 3px;
        height: 13px;
        border-radius: 3px;
        flex-shrink: 0;
        background: linear-gradient(180deg,#1a1a1a,#5a7a6e);
    }

    /* GRID */
    .so-row {
        display: grid;
        gap: 14px;
        margin-bottom: 16px;
    }

    .so-row-3 {
        grid-template-columns: 160px 200px 1fr;
    }

    /* FIELD */
    .so-field {
        display: flex;
        flex-direction: column;
        gap: 5px;
    }

    .so-label {
        font-family: 'IBM Plex Mono',monospace;
        font-size: 9px;
        text-transform: uppercase;
        letter-spacing: 1.5px;
        color: #aaa;
        display: flex;
        align-items: center;
        gap: 5px;
    }

    .so-label-dot {
        width: 5px;
        height: 5px;
        border-radius: 50%;
        flex-shrink: 0;
    }

        .so-label-dot.orange {
            background: #b08d57;
        }

        .so-label-dot.green {
            background: #2e7d5e;
        }

        .so-label-dot.red {
            background: #c0392b;
        }

        .so-label-dot.blue {
            background: #2980b9;
        }

        .so-label-dot.gray {
            background: #aaa;
        }

    /* INPUT */
    .so-input {
        border: 1px solid rgba(0,0,0,.13);
        border-radius: 9px;
        padding: 9px 12px;
        font-family: 'DM Sans',sans-serif;
        font-size: 13px;
        color: #1a1a1a;
        background: #fff;
        outline: none;
        width: 100%;
        transition: border-color .15s,box-shadow .15s;
    }

        .so-input:focus {
            border-color: #1a1a1a;
            box-shadow: 0 0 0 3px rgba(26,26,26,.08);
        }

        .so-input::placeholder {
            color: #ccc;
        }

    select.so-input {
        cursor: pointer;
        appearance: auto;
    }

    /* BILL NO */
    .so-bill-no {
        background: #1a1a1a;
        border-radius: 9px;
        padding: 9px 14px;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    .so-bill-no-lbl {
        font-family: 'IBM Plex Mono',monospace;
        font-size: 7.5px;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        color: rgba(255,255,255,.45);
        margin-bottom: 2px;
    }

    .so-bill-no-val {
        font-family: 'IBM Plex Mono',monospace;
        font-size: 15px;
        font-weight: 500;
        color: #fff;
        letter-spacing: -0.3px;
    }

    /* SEARCH */
    .so-search-wrap {
        position: relative;
    }

    .so-search-icon {
        position: absolute;
        right: 9px;
        top: 50%;
        transform: translateY(-50%);
        background: #1a1a1a;
        color: #fff;
        border-radius: 7px;
        width: 27px;
        height: 27px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 12px;
        cursor: pointer;
        border: none;
        transition: background .14s;
    }

        .so-search-icon:hover {
            background: #333;
        }

    .so-search-wrap .so-input {
        padding-right: 46px;
    }

    .so-dropdown {
        position: absolute;
        top: 100%;
        left: 0;
        right: 0;
        background: #fff;
        border: 1px solid rgba(0,0,0,.12);
        border-radius: 10px;
        box-shadow: 0 8px 32px rgba(0,0,0,.12);
        z-index: 300;
        max-height: 200px;
        overflow-y: auto;
        display: none;
        margin-top: 4px;
    }

    .so-dd-item {
        padding: 9px 13px;
        font-size: 13px;
        cursor: pointer;
        border-bottom: 1px solid rgba(0,0,0,.06);
        display: flex;
        justify-content: space-between;
        align-items: center;
        transition: background .1s;
    }

        .so-dd-item:last-child {
            border-bottom: none;
        }

        .so-dd-item:hover {
            background: #f7f7f7;
        }

    .so-dd-code {
        font-family: 'IBM Plex Mono',monospace;
        font-size: 10px;
        color: #aaa;
    }

    .so-dd-price {
        font-family: 'IBM Plex Mono',monospace;
        font-size: 10px;
        color: #b08d57;
    }

    /* BARCODE ROW */
    .so-barcode-row {
        display: grid;
        grid-template-columns: 1fr 90px 130px 100px 120px;
        gap: 12px;
        margin-bottom: 12px;
        align-items: end;
    }

    .so-barcode-wrap {
        position: relative;
    }

        .so-barcode-wrap .so-input {
            padding-left: 36px;
        }

    .so-barcode-ico {
        position: absolute;
        left: 12px;
        top: 50%;
        transform: translateY(-50%);
        color: #ccc;
        font-size: 13px;
        pointer-events: none;
    }

    .so-add-btn {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 9px 16px;
        font-family: 'DM Sans',sans-serif;
        font-size: 12.5px;
        font-weight: 600;
        border-radius: 9px;
        background: #1a1a1a;
        color: #fff;
        border: none;
        cursor: pointer;
        white-space: nowrap;
        transition: background .15s;
    }

        .so-add-btn:hover {
            background: #333;
        }

    /* TABLE */
    .so-table-wrap {
        border: 1px solid rgba(0,0,0,.09);
        border-radius: 12px;
        overflow: hidden;
        margin-bottom: 16px;
    }

    .so-table {
        width: 100%;
        border-collapse: collapse;
    }

        .so-table thead th {
            background: #1a1a1a;
            color: rgba(255,255,255,.70);
            padding: 9px 11px;
            font-family: 'IBM Plex Mono',monospace;
            font-size: 9px;
            text-transform: uppercase;
            letter-spacing: 1.3px;
            font-weight: 400;
            text-align: left;
            border-right: 1px solid rgba(255,255,255,.07);
            white-space: nowrap;
        }

            .so-table thead th:last-child {
                border-right: none;
            }

        .so-table tbody tr {
            border-bottom: 1px solid rgba(0,0,0,.06);
        }

            .so-table tbody tr:last-child {
                border-bottom: none;
            }

            .so-table tbody tr:hover {
                background: #fafafa;
            }

        .so-table tbody td {
            padding: 6px 8px;
            vertical-align: middle;
        }

    .so-td-inp {
        border: 1px solid transparent;
        border-radius: 7px;
        padding: 6px 9px;
        font-size: 12.5px;
        font-family: 'DM Sans',sans-serif;
        color: #1a1a1a;
        background: transparent;
        outline: none;
        width: 100%;
        transition: all .14s;
    }

        .so-td-inp:focus {
            border-color: #1a1a1a;
            background: #fff;
            box-shadow: 0 0 0 2px rgba(26,26,26,.08);
        }

        .so-td-inp[readonly] {
            background: #f7f7f7;
            color: #888;
            cursor: default;
        }

            .so-td-inp[readonly]:focus {
                border-color: transparent;
                box-shadow: none;
            }

    .so-del-btn {
        width: 28px;
        height: 28px;
        border-radius: 7px;
        border: 1px solid rgba(192,57,43,.22);
        background: rgba(192,57,43,.06);
        color: #c0392b;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 11px;
        cursor: pointer;
        transition: all .14s;
    }

        .so-del-btn:hover {
            background: #c0392b;
            color: #fff;
            border-color: #c0392b;
        }

    /* EMPTY */
    .so-empty-row td {
        padding: 44px 20px;
        text-align: center;
        color: #bbb;
        font-size: 12.5px;
    }

    /* TOTALS */
    .so-totals-grid {
        display: grid;
        grid-template-columns: repeat(4,1fr);
        gap: 12px;
        margin-bottom: 18px;
    }

    .so-total-card {
        background: #fafafa;
        border: 1px solid rgba(0,0,0,.09);
        border-radius: 11px;
        padding: 13px 16px;
    }

    .so-total-lbl {
        font-family: 'IBM Plex Mono',monospace;
        font-size: 8.5px;
        text-transform: uppercase;
        letter-spacing: 1.3px;
        color: #bbb;
        display: flex;
        align-items: center;
        gap: 5px;
        margin-bottom: 6px;
    }

    .so-total-val {
        font-family: 'IBM Plex Mono',monospace;
        font-size: 17px;
        font-weight: 500;
        color: #1a1a1a;
    }

        .so-total-val .so-cur {
            font-size: 9.5px;
            color: #bbb;
            margin-left: 3px;
            font-weight: 400;
        }

        .so-total-val.danger {
            color: #c0392b;
        }

    /* BUTTONS */
    .so-btn-row {
        display: flex;
        align-items: center;
        gap: 9px;
        padding-top: 16px;
        border-top: 1px solid rgba(0,0,0,.07);
    }

    .so-btn {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 9px 22px;
        font-family: 'DM Sans',sans-serif;
        font-size: 13px;
        font-weight: 600;
        border-radius: 9px;
        border: 1px solid transparent;
        cursor: pointer;
        transition: all .17s;
    }

    .so-btn-save {
        background: #1a1a1a;
        color: #fff;
        border-color: #1a1a1a;
    }

        .so-btn-save:hover {
            background: #333;
        }

    .so-btn-cancel {
        background: #fff;
        color: #666;
        border-color: rgba(0,0,0,.14);
    }

        .so-btn-cancel:hover {
            background: #f5f5f5;
            color: #1a1a1a;
        }

    /* FOOTER */
    .so-footer {
        margin-top: 18px;
        padding-top: 12px;
        border-top: 1px solid rgba(0,0,0,.07);
        text-align: center;
        font-family: 'IBM Plex Mono',monospace;
        font-size: 10px;
        color: #ccc;
        letter-spacing: .5px;
    }

        .so-footer strong {
            color: #888;
            font-weight: 500;
        }
</style>

<div class="so-root">

    <!-- TOP BAR -->
    <div class="so-topbar">
        <div class="so-topbar-left">
            <div class="so-icon-box">🧾</div>
            <div>
                <div class="so-page-title">SaleInvoice</div>
                <div class="so-breadcrumb">Sales &rsaquo; <span>SaleInvoice Entry</span></div>
            </div>
        </div>
        <button class="so-grid-btn">⊞ Grid</button>
    </div>

    <div class="so-accent-line"><span></span><span></span><span></span></div>

    <!-- FORM SHELL -->
    <div class="so-shell">
        <div class="so-titlebar">
            <div style="display:flex;align-items:center;gap:14px;">
                <div class="so-dots">
                    <div class="so-dot so-dot-r"></div>
                    <div class="so-dot so-dot-y"></div>
                    <div class="so-dot so-dot-g"></div>
                </div>
                <span class="so-fname">Sale Invoice</span>
            </div>
            <div class="so-live"><div class="so-live-dot"></div>Live</div>
        </div>

        <div class="so-body">
            <input type="hidden" id="soInvId" value="0">

            <div class="so-row so-row-3">
                <div>
                    <div class="so-bill-no">
                        <div class="so-bill-no-lbl">Bill No</div>
                        <div class="so-bill-no-val" id="soBillNo">008601/CO</div>
                    </div>
                </div>
                <div class="so-field">
                    <div class="so-label"><div class="so-label-dot orange"></div>Bill Date</div>
                    <input type="date" id="soBillDate" class="so-input">
                </div>
                <div class="so-field">
                    <div class="so-label"><div class="so-label-dot green"></div>Customer</div>
                    <div class="so-search-wrap">
                        <input type="text" id="soCustName" class="so-input"
                               placeholder="Search customer…" autocomplete="off"
                               oninput="soSearchCust(this.value)">
                        <button class="so-search-icon" onclick="soToggleCustDD()" title="Browse">🔍</button>
                        <div id="soCustDD" class="so-dropdown"></div>
                    </div>
                </div>
            </div>

            <!-- BARCODE ROW -->
            <div class="so-barcode-row">
                <div class="so-field">
                    <div class="so-label"><div class="so-label-dot gray"></div>Barcode / Product</div>
                    <div class="so-barcode-wrap">
                        <span class="so-barcode-ico">▦</span>
                        <input type="text" id="soBarcodeInp" class="so-input"
                               placeholder="Scan or type…"
                               oninput="soSearchProd(this.value)"
                               onkeydown="soHandleBarcode(event)">
                        <div id="soProdDD" class="so-dropdown"></div>
                    </div>
                </div>
                <div class="so-field">
                    <div class="so-label"><div class="so-label-dot green"></div>Qty</div>
                    <input type="number" id="soQtyInp" class="so-input" value="0" min="0" oninput="soCalcBar()">
                </div>
                <div class="so-field">
                    <div class="so-label"><div class="so-label-dot orange"></div>Price</div>
                    <input type="number" id="soPriceInp" class="so-input" value="0" min="0" oninput="soCalcBar()">
                </div>
                <div class="so-field">
                    <div class="so-label"><div class="so-label-dot red"></div>Disc Amt</div>
                    <input type="number" id="soDiscAmtInp" class="so-input" value="0" min="0"
                           style="color:#c0392b;" oninput="soCalcBar()">
                </div>
                <div class="so-field">
                    <div class="so-label"><div class="so-label-dot blue"></div>Net Amt</div>
                    <div style="display:flex;gap:7px;align-items:center;">
                        <input type="number" id="soNetAmtInp" class="so-input" value="0" readonly
                               style="color:#c0392b;">
                        <button class="so-add-btn" onclick="soAddRowFromBar()">● Add</button>
                    </div>
                </div>
            </div>

            <!-- ITEMS TABLE -->
            <div class="so-table-wrap">
                <table class="so-table">
                    <thead>
                        <tr>
                            <th style="width:32px;">#</th>
                            <th style="width:110px;">Barcode</th>
                            <th>Item</th>
                            <th style="width:75px;">Qty</th>
                            <th style="width:115px;">Price</th>
                            <th style="width:100px;">Amount</th>
                            <th style="width:100px;">Disc Amt</th>
                            <th style="width:108px;">Net Amt</th>
                            <th style="width:36px;"></th>
                        </tr>
                    </thead>
                    <tbody id="soItemsBody">
                        <tr class="so-empty-row" id="soEmptyRow">
                            <td colspan="9">No records to display</td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <!-- SUMMARY CARDS -->
            <div class="so-totals-grid">
                <div class="so-total-card">
                    <div class="so-total-lbl"><div style="width:5px;height:5px;border-radius:50%;background:#aaa;flex-shrink:0;"></div>Total Qty</div>
                    <div class="so-total-val" id="soSumQty">0 <span class="so-cur">units</span></div>
                </div>
                <div class="so-total-card">
                    <div class="so-total-lbl"><div style="width:5px;height:5px;border-radius:50%;background:#b08d57;flex-shrink:0;"></div>Total Amount</div>
                    <div class="so-total-val" id="soSumAmt">0.00 <span class="so-cur">PKR</span></div>
                </div>
                <div class="so-total-card">
                    <div class="so-total-lbl"><div style="width:5px;height:5px;border-radius:50%;background:#c0392b;flex-shrink:0;"></div>Total Discount</div>
                    <div class="so-total-val danger" id="soSumDisc">0.00 <span class="so-cur" style="color:#c0392b;">PKR</span></div>
                </div>
                <div class="so-total-card">
                    <div class="so-total-lbl"><div style="width:5px;height:5px;border-radius:50%;background:#aaa;flex-shrink:0;"></div>Net Payable</div>
                    <div class="so-total-val" id="soSumNet">0.00 <span class="so-cur">PKR</span></div>
                </div>
            </div>

            <!-- BUTTONS -->
            <div class="so-btn-row">
                <button class="so-btn so-btn-save" id="soSaveBtn" onclick="soSaveOrder()">💾 Save Order</button>
                <button class="so-btn so-btn-cancel" onclick="soClearForm()">✕ Cancel</button>
            </div>
        </div>
    </div>

    <div class="so-footer">Developed with ♥ by <strong>UT Designer</strong></div>
</div>

<script>
    // ── State ────────────────────────────────────────────────────────────────
    let soBillNum = 8601;
    let soSelProd = null;
    let SO_CUSTOMERS = [];   // loaded from API
    let SO_PRODUCTS  = [];   // loaded from API

    // ── Bootstrap ─────────────────────────────────────────────────────────────
    document.addEventListener('DOMContentLoaded', () => {
        document.getElementById('soBillDate').value = new Date().toISOString().split('T')[0];
        soLoadCustomers();
        soLoadProducts();
    });

    // ── Load Customers from SP (nsCategoryId=1) ───────────────────────────────
    async function soLoadCustomers() {
        try {
            const res  = await fetch('/SaleInvoice/GetCustomers?nCategoryId=0&nsCategoryId=1');
            const json = await res.json();
            if (json.success) SO_CUSTOMERS = json.data || [];
        } catch (e) { console.error('Customer load failed', e); }
    }

    // ── Load Products from SP (nsCategoryId=0) ───────────────────────────────
    async function soLoadProducts() {
        try {
            const res  = await fetch('/SaleInvoice/GetProducts?nCategoryId=0&nsCategoryId=0');
            const json = await res.json();
            if (json.success) SO_PRODUCTS = json.data || [];
        } catch (e) { console.error('Product load failed', e); }
    }

    // ── Helpers ───────────────────────────────────────────────────────────────
    function soEscH(s) { return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }
    function soEscQ(s) { return String(s).replace(/'/g,"\\'"); }

    // ── Customer Search ───────────────────────────────────────────────────────
    function soSearchCust(v) {
        const dd = document.getElementById('soCustDD');
        if (!v.trim()) { dd.style.display = 'none'; return; }
        const filtered = SO_CUSTOMERS.filter(c =>
            c.customerName.toLowerCase().includes(v.toLowerCase()) ||
            String(c.customerCode).toLowerCase().includes(v.toLowerCase())
        );
        soRenderCustDD(filtered);
    }
    function soToggleCustDD() {
        const dd = document.getElementById('soCustDD');
        dd.style.display === 'block' ? dd.style.display = 'none' : soRenderCustDD(SO_CUSTOMERS);
    }
    function soRenderCustDD(list) {
        const dd = document.getElementById('soCustDD');
        dd.innerHTML = !list.length
            ? '<div style="padding:12px;text-align:center;color:#bbb;font-size:12px;">No customers found</div>'
            : list.map(c => `<div class="so-dd-item" onclick="soSelCust('${soEscQ(String(c.customerCode))}','${soEscQ(c.customerName)}')">
                <span>${c.customerName}</span>
                <span class="so-dd-code">${c.customerCode}</span>
              </div>`).join('');
        dd.style.display = 'block';
    }
    function soSelCust(code, name) {
        document.getElementById('soCustName').value = name;
        document.getElementById('soCustDD').style.display = 'none';
    }

    // ── Product Search ────────────────────────────────────────────────────────
    function soSearchProd(v) {
        const dd = document.getElementById('soProdDD');
        if (!v.trim()) { dd.style.display = 'none'; soSelProd = null; return; }
        const filtered = SO_PRODUCTS.filter(p =>
            p.product.toLowerCase().includes(v.toLowerCase()) ||
            String(p.productCode).toLowerCase().includes(v.toLowerCase())
        );
        soRenderProdDD(filtered);
    }
    function soRenderProdDD(list) {
        const dd = document.getElementById('soProdDD');
        dd.innerHTML = !list.length
            ? '<div style="padding:12px;text-align:center;color:#bbb;font-size:12px;">No products found</div>'
            : list.map(p => `<div class="so-dd-item" onclick="soFillBar('${soEscQ(String(p.productCode))}','${soEscQ(p.product)}',${p.price},${p.discountAmount})">
                <span>${p.product}</span>
                <span class="so-dd-price">${p.productCode} · Rs.${p.price}</span>
              </div>`).join('');
        dd.style.display = 'block';
    }
    function soFillBar(code, name, price, discAmt) {
        soSelProd = { code, name, price, discAmt };
        document.getElementById('soBarcodeInp').value  = name;
        document.getElementById('soPriceInp').value    = price;
        document.getElementById('soQtyInp').value      = 1;
        document.getElementById('soDiscAmtInp').value  = discAmt || 0;
        document.getElementById('soProdDD').style.display = 'none';
        soCalcBar();
    }

    // ── Bar Calculations ──────────────────────────────────────────────────────
    function soCalcBar() {
        const qty     = parseFloat(document.getElementById('soQtyInp').value)     || 0;
        const price   = parseFloat(document.getElementById('soPriceInp').value)   || 0;
        const discAmt = parseFloat(document.getElementById('soDiscAmtInp').value) || 0;
        const amt     = qty * price;
        document.getElementById('soNetAmtInp').value = Math.max(0, amt - discAmt).toFixed(2);
    }

    function soHandleBarcode(e) {
        if (e.key !== 'Enter') return;
        const v = document.getElementById('soBarcodeInp').value.trim();
        if (!v) return;
        const f = SO_PRODUCTS.find(p => String(p.productCode).toLowerCase() === v.toLowerCase());
        if (f) soFillBar(f.productCode, f.product, f.price, f.discountAmount);
        else   soAddRowFromBar();
    }

    function soAddRowFromBar() {
        const code    = soSelProd ? soSelProd.code  : document.getElementById('soBarcodeInp').value.trim();
        const name    = soSelProd ? soSelProd.name  : '';
        const price   = parseFloat(document.getElementById('soPriceInp').value)   || 0;
        const qty     = parseFloat(document.getElementById('soQtyInp').value)     || 1;
        const discAmt = parseFloat(document.getElementById('soDiscAmtInp').value) || 0;
        if (!code && !name) return;
        soAddRow(code, name, qty, price, discAmt);
        // Reset bar fields
        document.getElementById('soBarcodeInp').value  = '';
        document.getElementById('soQtyInp').value      = 0;
        document.getElementById('soPriceInp').value    = '0';
        document.getElementById('soDiscAmtInp').value  = '0';
        document.getElementById('soNetAmtInp').value   = '0.00';
        soSelProd = null;
    }

    // ── Table Row ─────────────────────────────────────────────────────────────
    function soAddRow(code = '', name = '', qty = 1, price = 0, discAmt = 0) {
        const tbody = document.getElementById('soItemsBody');
        document.getElementById('soEmptyRow')?.remove();
        const amt = qty * price;
        const net = Math.max(0, amt - discAmt);
        const tr  = document.createElement('tr');
        tr.innerHTML = `
            <td><span style="font-family:'IBM Plex Mono',monospace;font-size:10px;color:#bbb;">${tbody.rows.length + 1}</span></td>
            <td><input class="so-td-inp" type="text" value="${soEscH(code)}" placeholder="Code" oninput="soCalcTotals()"></td>
            <td><input class="so-td-inp" type="text" value="${soEscH(name)}" placeholder="Item name" style="min-width:130px;" oninput="soCalcTotals()"></td>
            <td><input class="so-td-inp so-qty"   type="number" value="${qty}"              min="1" style="text-align:right;" oninput="soCalcRow(this);soCalcTotals()"></td>
            <td><input class="so-td-inp so-price" type="number" value="${price}"            min="0" style="text-align:right;" oninput="soCalcRow(this);soCalcTotals()"></td>
            <td><input class="so-td-inp so-amt"   type="number" value="${amt.toFixed(2)}"   readonly style="text-align:right;"></td>
            <td><input class="so-td-inp so-damt"  type="number" value="${discAmt.toFixed(2)}" min="0" style="text-align:right;color:#c0392b;" oninput="soCalcFromAmt(this);soCalcTotals()"></td>
            <td><input class="so-td-inp so-net"   type="number" value="${net.toFixed(2)}"   readonly style="text-align:right;font-weight:500;"></td>
            <td><button class="so-del-btn" onclick="soDelRow(this)" title="Remove">✕</button></td>`;
        tbody.appendChild(tr);
        soRenum();
        soCalcTotals();
    }

    function soDelRow(btn)  { btn.closest('tr').remove(); soRenum(); soCalcTotals(); soCheckEmpty(); }
    function soRenum()      { [...document.getElementById('soItemsBody').rows].forEach((r,i) => { const s = r.cells[0]?.querySelector('span'); if (s) s.textContent = i + 1; }); }
    function soCheckEmpty() {
        const tbody = document.getElementById('soItemsBody');
        if (!tbody.rows.length) {
            const tr = document.createElement('tr');
            tr.id = 'soEmptyRow'; tr.className = 'so-empty-row';
            tr.innerHTML = '<td colspan="9">No records to display</td>';
            tbody.appendChild(tr);
        }
    }

    function soCalcRow(inp) {
        const tr    = inp.closest('tr');
        const qty   = parseFloat(tr.querySelector('.so-qty')?.value)   || 0;
        const price = parseFloat(tr.querySelector('.so-price')?.value) || 0;
        const damt  = parseFloat(tr.querySelector('.so-damt')?.value)  || 0;
        const amt   = qty * price;
        tr.querySelector('.so-amt').value = amt.toFixed(2);
        tr.querySelector('.so-net').value = Math.max(0, amt - damt).toFixed(2);
    }
    function soCalcFromAmt(inp) {
        const tr  = inp.closest('tr');
        const amt = parseFloat(tr.querySelector('.so-amt')?.value) || 0;
        const d   = parseFloat(inp.value) || 0;
        tr.querySelector('.so-net').value = Math.max(0, amt - d).toFixed(2);
    }

    function soCalcTotals() {
        let qty = 0, amt = 0, disc = 0, net = 0;
        document.querySelectorAll('#soItemsBody tr:not(.so-empty-row)').forEach(tr => {
            qty  += parseFloat(tr.querySelector('.so-qty')?.value)   || 0;
            amt  += parseFloat(tr.querySelector('.so-amt')?.value)   || 0;
            disc += parseFloat(tr.querySelector('.so-damt')?.value)  || 0;
            net  += parseFloat(tr.querySelector('.so-net')?.value)   || 0;
        });
        document.getElementById('soSumQty').innerHTML  = qty  + ' <span class="so-cur">units</span>';
        document.getElementById('soSumAmt').innerHTML  = amt.toFixed(2)  + ' <span class="so-cur">PKR</span>';
        document.getElementById('soSumDisc').innerHTML = disc.toFixed(2) + ' <span class="so-cur" style="color:#c0392b;">PKR</span>';
        document.getElementById('soSumNet').innerHTML  = net.toFixed(2)  + ' <span class="so-cur">PKR</span>';
    }

    // ── Save ──────────────────────────────────────────────────────────────────
    async function soSaveOrder() {
        const cust = document.getElementById('soCustName').value.trim();
        if (!cust) { alert('Customer required.'); return; }
        const rows = document.querySelectorAll('#soItemsBody tr:not(.so-empty-row)');
        if (!rows.length) { alert('Add at least one item.'); return; }

        const items = [...rows].map(tr => ({
            productCode: tr.cells[1].querySelector('input').value,
            productName: tr.cells[2].querySelector('input').value,
            qty:         parseFloat(tr.querySelector('.so-qty').value)   || 0,
            price:       parseFloat(tr.querySelector('.so-price').value) || 0,
            amount:      parseFloat(tr.querySelector('.so-amt').value)   || 0,
            discAmt:     parseFloat(tr.querySelector('.so-damt').value)  || 0,
            netAmount:   parseFloat(tr.querySelector('.so-net').value)   || 0,
        }));

        const payload = {
            invoiceId:     parseInt(document.getElementById('soInvId').value) || 0,
            invoiceNo:     document.getElementById('soBillNo').textContent,
            invoiceDate:   document.getElementById('soBillDate').value,
            customerName:  cust,
            totalSubtotal: parseFloat(document.getElementById('soSumAmt').textContent)  || 0,
            totalDiscount: parseFloat(document.getElementById('soSumDisc').textContent) || 0,
            grandTotal:    parseFloat(document.getElementById('soSumNet').textContent)  || 0,
            items
        };

        try {
            const res  = await fetch('/SaleInvoice/SaveInvoice', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });
            const json = await res.json();
            if (json.success) { alert(json.message); soClearForm(); }
            else              { alert('Error: ' + json.message); }
        } catch (e) { alert('Save failed: ' + e.message); }
    }

    // ── Clear ─────────────────────────────────────────────────────────────────
    function soClearForm() {
        document.getElementById('soCustName').value  = '';
        document.getElementById('soInvId').value     = '0';
        document.getElementById('soItemsBody').innerHTML = '';
        document.getElementById('soSaveBtn').innerHTML   = '💾 Save Order';
        soBillNum++;
        document.getElementById('soBillNo').textContent = String(soBillNum).padStart(6, '0') + '/CO';
        soCheckEmpty();
        soCalcTotals();
    }

    // ── Close dropdowns on outside click ─────────────────────────────────────
    document.addEventListener('click', function (e) {
        if (!e.target.closest('#soCustName') && !e.target.closest('.so-search-icon') && !e.target.closest('#soCustDD'))
            document.getElementById('soCustDD').style.display = 'none';
        if (!e.target.closest('#soBarcodeInp') && !e.target.closest('#soProdDD'))
            document.getElementById('soProdDD').style.display = 'none';
    });
</script>
