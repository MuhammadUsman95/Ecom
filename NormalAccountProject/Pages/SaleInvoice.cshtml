@page
@model NormalAccountProject.Pages.SaleInvoiceModel
@{
}

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<style>
    /* ══════════════════════════════════════════════
       RESET & BASE
    ══════════════════════════════════════════════ */
    *, *::before, *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0
    }

    :root {
        --dark: #1e1e2d;
        --dark2: #2b2b3b;
        --dark3: #3a3a50;
        --accent: #4361ee;
        --accent2: #3a0ca3;
        --red: #e63946;
        --green: #2dc653;
        --amber: #f4a261;
        --surface: #ffffff;
        --surface2: #f8f9fb;
        --surface3: #f1f3f7;
        --border: #e4e6ef;
        --border2: #d1d5e0;
        --text: #1e1e2d;
        --text2: #5a607a;
        --text3: #9499b0;
        --shadow: 0 2px 8px rgba(0,0,0,.08);
        --shadow2: 0 4px 20px rgba(0,0,0,.12);
    }

    .si-root {
        font-family: 'Inter',Arial,sans-serif;
        font-size: 13px;
        background: var(--surface2);
        color: var(--text);
        min-height: 100vh;
        display: flex;
        flex-direction: column;
    }

    /* ══════════════════════════════════════════════
       TOP NAV BAR
    ══════════════════════════════════════════════ */
    .si-topbar {
        background: linear-gradient(135deg, var(--dark) 0%, var(--dark2) 100%);
        color: #fff;
        padding: 0 18px;
        height: 42px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-shrink: 0;
        box-shadow: 0 2px 10px rgba(0,0,0,.25);
        position: sticky;
        top: 0;
        z-index: 100;
    }

    .topbar-left {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .topbar-icon {
        width: 28px;
        height: 28px;
        background: var(--accent);
        border-radius: 6px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 12px;
        color: #fff;
        box-shadow: 0 2px 8px rgba(67,97,238,.4);
    }

    .si-page-title {
        font-size: 14px;
        font-weight: 700;
        color: #fff;
        letter-spacing: .2px;
    }

    .btn-gv {
        background: rgba(255,255,255,.12);
        color: #fff;
        border: 1px solid rgba(255,255,255,.2);
        border-radius: 5px;
        padding: 5px 12px;
        font-size: 11.5px;
        font-weight: 500;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 5px;
        transition: all .2s;
        backdrop-filter: blur(4px);
    }

        .btn-gv:hover {
            background: rgba(255,255,255,.2);
            border-color: rgba(255,255,255,.35);
        }

    .si-bc {
        font-size: 11.5px;
        color: rgba(255,255,255,.5);
        display: flex;
        align-items: center;
        gap: 5px;
    }

        .si-bc span {
            color: rgba(255,255,255,.85);
            font-weight: 500;
        }

    /* ══════════════════════════════════════════════
       FORM BODY
    ══════════════════════════════════════════════ */
    .si-body {
        background: var(--surface);
        margin: 14px;
        border-radius: 10px;
        border: 1px solid var(--border);
        box-shadow: var(--shadow2);
        overflow: hidden;
        flex: 1;
    }

    /* ── FORM HEADER STRIP ── */
    .form-head {
        background: linear-gradient(135deg, var(--dark) 0%, var(--dark3) 100%);
        padding: 12px 20px;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .form-head-left {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .form-head-icon {
        width: 34px;
        height: 34px;
        background: rgba(255,255,255,.12);
        border-radius: 7px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        font-size: 14px;
    }

    .form-head-title {
        color: #fff;
        font-size: 14px;
        font-weight: 700;
    }

    .form-head-sub {
        color: rgba(255,255,255,.5);
        font-size: 11px;
        margin-top: 1px;
    }

    .live-pill {
        display: flex;
        align-items: center;
        gap: 5px;
        background: rgba(45,198,83,.15);
        border: 1px solid rgba(45,198,83,.3);
        color: #2dc653;
        padding: 4px 10px;
        border-radius: 20px;
        font-size: 10.5px;
        font-weight: 600;
    }

    .live-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: #2dc653;
        animation: pulse 1.8s ease-in-out infinite;
    }

    @@keyframes pulse {
        0%, 100% {
            opacity: 1
        }

        50% {
            opacity: .3
        }
    }

    /* ── FORM CONTENT ── */
    .form-body {
        padding: 16px 20px 14px;
    }

    /* ── SECTION LABEL ── */
    .sec-hdr {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 12px;
        padding-bottom: 8px;
        border-bottom: 1px solid var(--border);
    }

    .sec-bar {
        width: 3px;
        height: 16px;
        border-radius: 3px;
        flex-shrink: 0;
    }

        .sec-bar.blue {
            background: linear-gradient(180deg,var(--accent),#4cc9f0);
        }

        .sec-bar.teal {
            background: linear-gradient(180deg,#2dc653,#4cc9f0);
        }

        .sec-bar.amber {
            background: linear-gradient(180deg,var(--amber),var(--red));
        }

    .sec-ttl-txt {
        font-size: 10px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1.5px;
        color: var(--text2);
    }

    /* ══════════════════════════════════════════════
       FIELD GROUPS
    ══════════════════════════════════════════════ */
    .fi-row {
        display: flex;
        gap: 10px;
        margin-bottom: 12px;
        align-items: flex-end;
        flex-wrap: wrap;
    }

    .fi {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .fi-lbl {
        font-size: 10px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .8px;
        color: var(--text3);
        line-height: 1;
    }

        .fi-lbl.red {
            color: var(--red);
        }

    .fi input,
    .fi select,
    .fi textarea {
        border: 1.5px solid var(--border);
        border-radius: 6px;
        padding: 0 10px;
        font-size: 12.5px;
        font-family: inherit;
        font-weight: 500;
        color: var(--text);
        background: var(--surface2);
        outline: none;
        height: 34px;
        transition: border-color .18s, background .18s, box-shadow .18s;
    }

        .fi input:focus, .fi select:focus, .fi textarea:focus {
            border-color: var(--accent);
            background: var(--surface);
            box-shadow: 0 0 0 3px rgba(67,97,238,.1);
        }

        .fi input[readonly] {
            background: #f4f5f8;
            color: var(--text2);
            cursor: default;
            border-color: var(--border);
        }

            .fi input[readonly]:focus {
                box-shadow: none;
                border-color: var(--border);
            }

    .fi textarea {
        height: 56px;
        resize: vertical;
        padding: 8px 10px;
        line-height: 1.4;
    }

    /* input + search btn combo */
    .fi-sb {
        display: flex;
        align-items: center;
    }

        .fi-sb input {
            border-right: none;
            border-radius: 6px 0 0 6px;
            flex: 1;
        }

        .fi-sb .sbtn {
            height: 34px;
            width: 34px;
            background: var(--dark);
            color: #fff;
            border: 1.5px solid var(--dark);
            border-radius: 0 6px 6px 0;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 11.5px;
            flex-shrink: 0;
            transition: background .15s;
        }

            .fi-sb .sbtn:hover {
                background: var(--accent);
            }

    /* ══════════════════════════════════════════════
       SEARCHABLE DROPDOWN
    ══════════════════════════════════════════════ */
    .sd {
        position: relative;
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .sd-iw {
        display: flex;
        align-items: center;
    }

    .sd-disp {
        border: 1.5px solid var(--border);
        border-right: none;
        border-radius: 6px 0 0 6px;
        padding: 0 10px;
        font-size: 12.5px;
        font-family: inherit;
        font-weight: 500;
        color: var(--text3);
        background: var(--surface2);
        height: 34px;
        cursor: pointer;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        flex: 1;
        user-select: none;
        transition: border-color .18s,background .18s,box-shadow .18s;
        display: flex;
        align-items: center;
    }

        .sd-disp.hv {
            color: var(--text);
            background: var(--surface);
        }

    .sd.open .sd-disp {
        border-color: var(--accent);
        background: var(--surface);
        box-shadow: 0 0 0 3px rgba(67,97,238,.1);
    }

    .sd-obtn {
        height: 34px;
        width: 34px;
        background: var(--dark);
        color: #fff;
        border: 1.5px solid var(--dark);
        border-radius: 0 6px 6px 0;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 11.5px;
        flex-shrink: 0;
        transition: background .15s;
    }

        .sd-obtn:hover {
            background: var(--accent);
        }

    .sd-panel {
        display: none;
        position: absolute;
        top: calc(100% + 4px);
        left: 0;
        min-width: 220px;
        width: 100%;
        background: var(--surface);
        border: 1.5px solid var(--border);
        border-radius: 8px;
        box-shadow: 0 8px 28px rgba(0,0,0,.14);
        z-index: 9999;
        overflow: hidden;
    }

    .sd.open .sd-panel {
        display: block;
        animation: sdIn .15s ease;
    }

    @@keyframes sdIn {
        from {
            opacity: 0;
            transform: translateY(-4px)
        }

        to {
            opacity: 1;
            transform: translateY(0)
        }
    }

    .sd-sr {
        display: flex;
        align-items: center;
        padding: 8px 10px;
        background: var(--surface2);
        border-bottom: 1px solid var(--border);
        gap: 7px;
    }

        .sd-sr i {
            color: var(--text3);
            font-size: 11px;
        }

    .sd-si {
        border: none;
        outline: none;
        background: transparent;
        font-family: inherit;
        font-size: 12.5px;
        font-weight: 500;
        color: var(--text);
        width: 100%;
    }

        .sd-si::placeholder {
            color: var(--text3);
        }

    .sd-list {
        max-height: 168px;
        overflow-y: auto;
        scrollbar-width: thin;
        scrollbar-color: var(--border2) transparent;
    }

        .sd-list::-webkit-scrollbar {
            width: 4px;
        }

        .sd-list::-webkit-scrollbar-thumb {
            background: var(--border2);
            border-radius: 10px;
        }

    .sd-opt {
        padding: 8px 12px;
        font-size: 12.5px;
        font-weight: 500;
        color: var(--text2);
        cursor: pointer;
        border-bottom: 1px solid var(--border);
        transition: background .1s,color .1s;
        display: flex;
        align-items: center;
        gap: 8px;
    }

        .sd-opt::before {
            content: '';
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: var(--border2);
            flex-shrink: 0;
            transition: background .1s;
        }

        .sd-opt:last-child {
            border-bottom: none;
        }

        .sd-opt:hover, .sd-opt.hi {
            background: var(--dark);
            color: #fff;
        }

            .sd-opt:hover::before, .sd-opt.hi::before {
                background: var(--accent);
            }

        .sd-opt.sel {
            background: rgba(67,97,238,.07);
            color: var(--accent);
            font-weight: 600;
        }

            .sd-opt.sel::before {
                background: var(--accent);
            }

    .sd-empty {
        padding: 14px;
        text-align: center;
        font-size: 12px;
        color: var(--text3);
    }

    /* ══════════════════════════════════════════════
       ENTRY PANEL
    ══════════════════════════════════════════════ */
    .entry-panel {
        background: var(--surface2);
        border: 1.5px solid var(--border);
        border-radius: 8px;
        padding: 12px 14px;
        margin-bottom: 14px;
        display: flex;
        gap: 8px;
        align-items: flex-end;
        flex-wrap: wrap;
    }

    .btn-add {
        background: linear-gradient(135deg,var(--dark) 0%,var(--dark3) 100%);
        color: #fff;
        border: none;
        border-radius: 6px;
        padding: 0 18px;
        height: 34px;
        font-size: 12.5px;
        font-weight: 700;
        cursor: pointer;
        white-space: nowrap;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        gap: 6px;
        align-self: flex-end;
        transition: all .18s;
        box-shadow: 0 2px 8px rgba(30,30,45,.25);
        letter-spacing: .2px;
    }

        .btn-add:hover {
            background: linear-gradient(135deg,var(--accent) 0%,var(--accent2) 100%);
            box-shadow: 0 4px 14px rgba(67,97,238,.35);
            transform: translateY(-1px);
        }

        .btn-add i {
            font-size: 10px;
        }

    /* ══════════════════════════════════════════════
       TABLE AREA
    ══════════════════════════════════════════════ */
    .tbl-toolbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 8px;
    }

    .tbl-toolbar-left {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .tbl-title {
        font-size: 11px;
        font-weight: 700;
        color: var(--text2);
        text-transform: uppercase;
        letter-spacing: .8px;
    }

    .btn-del-sel {
        background: var(--surface);
        color: var(--red);
        border: 1.5px solid rgba(230,57,70,.3);
        border-radius: 5px;
        padding: 5px 12px;
        font-size: 11.5px;
        font-weight: 600;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 5px;
        transition: all .15s;
    }

        .btn-del-sel:hover {
            background: var(--red);
            color: #fff;
            border-color: var(--red);
        }

    .si-tw {
        border: 1.5px solid var(--border);
        border-radius: 8px;
        overflow: hidden;
        margin-bottom: 14px;
        box-shadow: var(--shadow);
    }

    .si-tbl {
        width: 100%;
        border-collapse: collapse;
        font-size: 12px;
    }

        .si-tbl thead th {
            background: linear-gradient(135deg,var(--dark) 0%,var(--dark2) 100%);
            color: rgba(255,255,255,.85);
            padding: 10px 10px;
            font-size: 10.5px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .8px;
            white-space: nowrap;
            border-right: 1px solid rgba(255,255,255,.08);
            text-align: left;
        }

            .si-tbl thead th:last-child {
                border-right: none;
            }

            .si-tbl thead th.tc {
                text-align: center;
            }

            .si-tbl thead th input[type="checkbox"] {
                accent-color: var(--accent);
                width: 14px;
                height: 14px;
            }

        .si-tbl tbody tr {
            border-bottom: 1px solid var(--border);
            transition: background .12s;
        }

            .si-tbl tbody tr:nth-child(even) {
                background: #fafbfd;
            }

            .si-tbl tbody tr:hover {
                background: rgba(67,97,238,.04);
            }

            .si-tbl tbody tr:last-child {
                border-bottom: none;
            }

        .si-tbl tbody td {
            padding: 9px 10px;
            color: var(--text2);
            font-size: 12px;
            font-weight: 500;
            border-right: 1px solid var(--border);
            text-align: center;
        }

            .si-tbl tbody td:last-child {
                border-right: none;
            }

            .si-tbl tbody td.tl {
                text-align: left;
                font-weight: 600;
                color: var(--text);
            }

            .si-tbl tbody td input[type="checkbox"] {
                accent-color: var(--accent);
                width: 13px;
                height: 13px;
            }

    .no-rec {
        padding: 30px;
        text-align: center;
        color: var(--text3);
        font-size: 12.5px;
    }

        .no-rec i {
            font-size: 28px;
            display: block;
            margin-bottom: 8px;
            color: var(--border2);
        }

    .rdel {
        background: none;
        border: 1.5px solid var(--border2);
        border-radius: 5px;
        width: 24px;
        height: 24px;
        cursor: pointer;
        color: var(--text3);
        font-size: 10px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transition: all .15s;
    }

        .rdel:hover {
            background: var(--red);
            color: #fff;
            border-color: var(--red);
        }

    /* table footer */
    .si-tbl tfoot td {
        padding: 9px 10px;
        background: linear-gradient(135deg,var(--dark) 0%,var(--dark2) 100%);
        color: rgba(255,255,255,.9);
        font-weight: 700;
        font-size: 12px;
        text-align: center;
        border-top: 2px solid var(--dark3);
        border-right: 1px solid rgba(255,255,255,.08);
    }

        .si-tbl tfoot td:last-child {
            border-right: none;
        }

        .si-tbl tfoot td.tlbl {
            text-align: left;
            font-size: 10.5px;
            letter-spacing: .8px;
            text-transform: uppercase;
            color: rgba(255,255,255,.6);
            font-weight: 600;
        }

        .si-tbl tfoot td.accent-val {
            color: #7dd3fc;
            font-size: 13px;
        }

    /* ══════════════════════════════════════════════
       SUMMARY STRIP
    ══════════════════════════════════════════════ */
    .si-sum {
        display: flex;
        gap: 0;
        border: 1.5px solid var(--border);
        border-radius: 8px;
        overflow: hidden;
        margin-bottom: 4px;
        box-shadow: var(--shadow);
    }

    .sum-card {
        flex: 1;
        padding: 12px 14px;
        border-right: 1px solid var(--border);
        background: var(--surface2);
        transition: background .15s;
    }

        .sum-card:last-child {
            border-right: none;
            background: rgba(67,97,238,.05);
        }

        .sum-card:hover {
            background: var(--surface3);
        }

    .sum-lbl {
        font-size: 9.5px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1px;
        color: var(--text3);
        margin-bottom: 5px;
    }

        .sum-lbl.red {
            color: var(--red);
        }

    .sum-val {
        font-size: 17px;
        font-weight: 700;
        color: var(--text);
        font-variant-numeric: tabular-nums;
        letter-spacing: -.3px;
    }

    .sum-card:last-child .sum-val {
        color: var(--accent);
    }

    .sum-input-wrap {
        display: flex;
        align-items: center;
        gap: 5px;
        margin-top: 2px;
    }

    .sum-input {
        border: 1.5px solid var(--border2);
        border-radius: 5px;
        padding: 3px 8px;
        font-size: 13px;
        font-weight: 700;
        font-family: inherit;
        color: var(--text);
        background: var(--surface);
        width: 80px;
        outline: none;
        transition: border-color .15s,box-shadow .15s;
    }

        .sum-input:focus {
            border-color: var(--accent);
            box-shadow: 0 0 0 3px rgba(67,97,238,.1);
        }

    .sum-pct {
        font-size: 11px;
        color: var(--text3);
    }

    /* ══════════════════════════════════════════════
       ACTION BUTTONS
    ══════════════════════════════════════════════ */
    .si-actions {
        background: linear-gradient(135deg,var(--dark) 0%,var(--dark2) 100%);
        padding: 12px 20px;
        display: flex;
        align-items: center;
        gap: 10px;
        border-top: 1px solid var(--dark3);
        flex-shrink: 0;
    }

    .btn-save {
        background: var(--accent);
        color: #fff;
        border: none;
        border-radius: 6px;
        padding: 9px 22px;
        font-size: 13px;
        font-weight: 700;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 7px;
        transition: all .18s;
        box-shadow: 0 3px 12px rgba(67,97,238,.4);
        letter-spacing: .2px;
    }

        .btn-save:hover {
            background: #3452d4;
            transform: translateY(-1px);
            box-shadow: 0 5px 18px rgba(67,97,238,.5);
        }

    .btn-cancel {
        background: rgba(255,255,255,.1);
        color: rgba(255,255,255,.85);
        border: 1.5px solid rgba(255,255,255,.2);
        border-radius: 6px;
        padding: 9px 22px;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 7px;
        transition: all .18s;
    }

        .btn-cancel:hover {
            background: rgba(255,255,255,.18);
            color: #fff;
        }

    .actions-spacer {
        flex: 1;
    }

    .actions-hint {
        font-size: 11px;
        color: rgba(255,255,255,.3);
    }

    /* ══════════════════════════════════════════════
       WIDTHS
    ══════════════════════════════════════════════ */
    .w-inv {
        width: 130px
    }

    .w-dt {
        width: 140px
    }

    .w-ref {
        width: 115px
    }

    .w-cu {
        width: 240px
    }

    .w-rem {
        width: 420px
    }

    .w-pr {
        flex: 3;
        min-width: 170px
    }

    .w-qt {
        width: 72px
    }

    .w-rt {
        width: 90px
    }

    .w-dp {
        width: 70px
    }

    .w-da {
        width: 90px
    }

    .w-na {
        width: 92px
    }

    @@media(max-width:900px) {
        .si-body {
            margin: 8px;
            border-radius: 8px;
        }

        .form-body {
            padding: 12px 14px 10px;
        }

        .fi-row {
            flex-wrap: wrap;
        }

        .si-sum {
            flex-wrap: wrap;
        }

        .sum-card {
            min-width: 48%;
        }
    }
</style>

<div class="si-root">

    <!-- ══ TOP BAR ══ -->
    <div class="si-topbar">
        <div class="topbar-left">
            <div class="topbar-icon"><i class="fas fa-file-invoice"></i></div>
            <span class="si-page-title">Sale Invoice</span>
            <button class="btn-gv"><i class="fas fa-table-list"></i> Grid View</button>
        </div>
        <div class="si-bc">
            Home <i class="fas fa-chevron-right" style="font-size:9px;opacity:.4"></i>
            <span>Sale Invoice</span>
        </div>
    </div>

    <!-- ══ FORM CARD ══ -->
    <div class="si-body">

        <!-- Form Header -->
        <div class="form-head">
            <div class="form-head-left">
                <div class="form-head-icon"><i class="fas fa-file-invoice-dollar"></i></div>
                <div>
                    <div class="form-head-title">New Sale Invoice</div>
                    <div class="form-head-sub">Fill in the details below to create an invoice</div>
                </div>
            </div>
            <div class="live-pill"><div class="live-dot"></div> Live</div>
        </div>

        <!-- Form Content -->
        <div class="form-body">

            <!-- ── SECTION: Invoice Details ── -->
            <div class="sec-hdr" style="margin-top:2px;">
                <div class="sec-bar blue"></div>
                <span class="sec-ttl-txt">Invoice Details</span>
            </div>

            <div class="fi-row">
                <div class="fi w-inv">
                    <span class="fi-lbl">Bill No</span>
                    <input type="text" id="invoiceNo" readonly placeholder="Loading…">
                </div>
                <div class="fi w-dt">
                    <span class="fi-lbl">Bill Date</span>
                    <input type="date" id="date">
                </div>
                <div class="fi w-ref">
                    <span class="fi-lbl">Ref. #</span>
                    <input type="text" id="refNo" placeholder="Optional">
                </div>

                <!-- Customer Searchable Dropdown -->
                <div class="sd w-cu" id="cuWrap">
                    <span class="fi-lbl">Customer</span>
                    <div class="sd-iw">
                        <div class="sd-disp" id="cuDisp" tabindex="0"
                             onclick="toggleSD('cuWrap')">
                            Select a customer…
                        </div>
                        <button class="sd-obtn" onclick="toggleSD('cuWrap')" type="button">
                            <i class="fas fa-magnifying-glass"></i>
                        </button>
                    </div>
                    <input type="hidden" id="customerCode">
                    <div class="sd-panel">
                        <div class="sd-sr">
                            <i class="fas fa-magnifying-glass"></i>
                            <input class="sd-si" id="cuSrch" placeholder="Type to search customer…"
                                   oninput="filterSD('cuWrap','cuSrch','cuList')">
                        </div>
                        <div class="sd-list" id="cuList"></div>
                    </div>
                </div>
            </div>

            <div class="fi-row">
                <div class="fi w-rem">
                    <span class="fi-lbl">Remarks</span>
                    <textarea id="remarks" placeholder="Add any notes or remarks…"></textarea>
                </div>
            </div>

            <!-- ── SECTION: Product Entry ── -->
            <div class="sec-hdr">
                <div class="sec-bar teal"></div>
                <span class="sec-ttl-txt">Add Product Entry</span>
            </div>

            <div class="entry-panel">

                <!-- Product Searchable Dropdown -->
                <div class="sd w-pr" id="prWrap">
                    <span class="fi-lbl">Product / Barcode</span>
                    <div class="sd-iw">
                        <div class="sd-disp" id="prDisp" tabindex="0"
                             onclick="toggleSD('prWrap')" style="width:100%">
                            Select a product…
                        </div>
                        <button class="sd-obtn" onclick="toggleSD('prWrap')" type="button">
                            <i class="fas fa-magnifying-glass"></i>
                        </button>
                    </div>
                    <input type="hidden" id="productCode">
                    <div class="sd-panel">
                        <div class="sd-sr">
                            <i class="fas fa-magnifying-glass"></i>
                            <input class="sd-si" id="prSrch" placeholder="Type to search product…"
                                   oninput="filterSD('prWrap','prSrch','prList')">
                        </div>
                        <div class="sd-list" id="prList"></div>
                    </div>
                </div>

                <div class="fi w-qt">
                    <span class="fi-lbl">Qty</span>
                    <input type="number" id="qty" min="1" value="0">
                </div>
                <div class="fi w-rt">
                    <span class="fi-lbl">Rate</span>
                    <input type="number" id="salesPrice" readonly value="0">
                </div>
                <div class="fi w-dp">
                    <span class="fi-lbl">Disc %</span>
                    <input type="number" id="discPct" value="0" min="0" max="100">
                </div>
                <div class="fi w-da">
                    <span class="fi-lbl red">Disc Amt</span>
                    <input type="number" id="discount" readonly value="0">
                </div>
                <div class="fi w-na">
                    <span class="fi-lbl">Net Amt</span>
                    <input type="number" id="netAmount" readonly value="0">
                </div>
                <button class="btn-add" onclick="addRow()" type="button">
                    <i class="fas fa-plus"></i> Add
                </button>
            </div>

            <!-- ── SECTION: Invoice Entries ── -->
            <div class="sec-hdr">
                <div class="sec-bar amber"></div>
                <span class="sec-ttl-txt">Invoice Entries</span>
            </div>

            <!-- Toolbar -->
            <div class="tbl-toolbar">
                <div class="tbl-toolbar-left">
                    <button class="btn-del-sel" onclick="deleteSelected()" type="button">
                        <i class="fas fa-trash-can"></i>
                        Delete Selected (<span id="selCnt">0</span>)
                    </button>
                </div>
            </div>

            <!-- Table -->
            <div class="si-tw">
                <table class="si-tbl">
                    <thead>
                        <tr>
                            <th style="width:36px;text-align:center">
                                <input type="checkbox" id="chkAll" onchange="toggleAll(this)">
                            </th>
                            <th style="width:36px" class="tc">#</th>
                            <th style="min-width:200px">Product / Item</th>
                            <th class="tc" style="width:64px">Qty</th>
                            <th class="tc" style="width:90px">Rate</th>
                            <th class="tc" style="width:94px">Amount</th>
                            <th class="tc" style="width:66px">Disc %</th>
                            <th class="tc" style="width:90px">Disc Amt</th>
                            <th class="tc" style="width:94px">Net Amt</th>
                            <th style="width:36px"></th>
                        </tr>
                    </thead>
                    <tbody id="tableBody">
                        <tr id="emptyRow">
                            <td colspan="10">
                                <div class="no-rec">
                                    <i class="fas fa-box-open"></i>
                                    No products added yet — use the form above to add entries
                                </div>
                            </td>
                        </tr>
                    </tbody>
                    <tfoot id="tfoot" style="display:none">
                        <tr>
                            <td colspan="3" class="tlbl">Grand Total</td>
                            <td id="ftQ">0</td>
                            <td></td>
                            <td id="ftA">0.00</td>
                            <td></td>
                            <td id="ftD">0.00</td>
                            <td id="ftN" class="accent-val">0.00</td>
                            <td></td>
                        </tr>
                    </tfoot>
                </table>
            </div>

            <!-- ── SUMMARY ── -->
            <div class="si-sum">
                <div class="sum-card">
                    <div class="sum-lbl">Bill Gross Amount</div>
                    <div class="sum-val" id="sumGross">0.00</div>
                </div>
                <div class="sum-card">
                    <div class="sum-lbl">Bill Disc %</div>
                    <div class="sum-input-wrap">
                        <input type="number" class="sum-input" id="billDiscPct"
                               value="0" min="0" max="100" oninput="recalcBill()">
                        <span class="sum-pct">%</span>
                    </div>
                </div>
                <div class="sum-card">
                    <div class="sum-lbl">Bill Disc Amount</div>
                    <div class="sum-val" id="sumDiscAmt">0.00</div>
                </div>
                <div class="sum-card">
                    <div class="sum-lbl red">Bill Net Amount</div>
                    <div class="sum-val" id="sumNet">0.00</div>
                </div>
            </div>

        </div><!-- /.form-body -->
    </div><!-- /.si-body -->
    <!-- ══ SAVE / CANCEL ══ -->
    <div class="si-actions">
        <button class="btn-save" onclick="saveForm()" type="button">
            <i class="fas fa-floppy-disk"></i> Save Invoice
        </button>
        <button class="btn-cancel" onclick="cancelForm()" type="button">
            <i class="fas fa-xmark"></i> Cancel
        </button>
        <div class="actions-spacer"></div>
        <span class="actions-hint"><i class="fas fa-lock" style="margin-right:4px;"></i>All data is saved securely</span>
    </div>

</div><!-- /.si-root -->


<script>
    /* ══════════════════════════════════════
       SEARCHABLE DROPDOWN ENGINE
    ══════════════════════════════════════ */
    const _sd = {};

    function buildSD(wrapId, listId, items, vk, lk) {
        _sd[wrapId] = items.map(i => ({ v: String(i[vk]), l: i[lk] }));
        renderSD(wrapId, listId, _sd[wrapId]);
    }

    function renderSD(wrapId, listId, items) {
        const el = document.getElementById(listId);
        el.innerHTML = '';
        if (!items.length) {
            el.innerHTML = '<div class="sd-empty"><i class="fas fa-search" style="margin-right:5px"></i>No results found.</div>';
            return;
        }
        items.forEach(it => {
            const d = document.createElement('div');
            d.className = 'sd-opt';
            d.textContent = it.l;
            d.dataset.v = it.v;
            d.onmouseenter = () => d.classList.add('hi');
            d.onmouseleave = () => d.classList.remove('hi');
            d.onclick = () => pickSD(wrapId, it.v, it.l);
            el.appendChild(d);
        });
    }

    function filterSD(wrapId, srchId, listId) {
        const q = document.getElementById(srchId).value.toLowerCase();
        renderSD(wrapId, listId, (_sd[wrapId] || []).filter(i => i.l.toLowerCase().includes(q)));
    }

    function toggleSD(wrapId) {
        const w = document.getElementById(wrapId);
        const was = w.classList.contains('open');
        closeAllSD();
        if (!was) {
            w.classList.add('open');
            const si = wrapId === 'cuWrap' ? 'cuSrch' : 'prSrch';
            const li = wrapId === 'cuWrap' ? 'cuList'  : 'prList';
            setTimeout(() => {
                const s = document.getElementById(si);
                if (s) { s.value = ''; s.focus(); }
                renderSD(wrapId, li, _sd[wrapId] || []);
            }, 30);
        }
    }

    function closeAllSD() {
        document.querySelectorAll('.sd.open').forEach(w => w.classList.remove('open'));
    }
    document.addEventListener('click', e => { if (!e.target.closest('.sd')) closeAllSD(); });

    function pickSD(wrapId, val, label) {
        const w = document.getElementById(wrapId);
        const d = w.querySelector('.sd-disp');
        d.textContent = label;
        d.classList.add('hv');
        if (wrapId === 'cuWrap') {
            document.getElementById('customerCode').value = val;
        } else {
            document.getElementById('productCode').value = val;
            onProd(val);
        }
        // mark selected
        w.querySelectorAll('.sd-opt').forEach(o => o.classList.toggle('sel', o.dataset.v === val));
        closeAllSD();
    }

    /* ══════════════════════════════════════
       STATE
    ══════════════════════════════════════ */
    let pMap = {}, rCnt = 0, rows = [], gross = 0;

    const SW = {
        background: '#ffffff', color: '#1e1e2d',
        confirmButtonColor: '#4361ee', cancelButtonColor: '#6c757d'
    };

    /* ══════════════════════════════════════
       INIT
    ══════════════════════════════════════ */
    document.addEventListener('DOMContentLoaded', () => {
        document.getElementById('date').valueAsDate = new Date();
        loadNo(); loadCust(); loadProd();
    });

    /* ══════════════════════════════════════
       API LOADERS
    ══════════════════════════════════════ */
    async function loadNo() {
        try {
            const r = await fetch('/SaleInvoice/nLoadSaleInvoiceNo',
                { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: '{}' });
            const d = await r.json();
            document.getElementById('invoiceNo').value =
                (d.statusId === 1 && d.invoiceNo) ? d.invoiceNo : 'N/A';
        } catch { document.getElementById('invoiceNo').value = 'Error'; }
    }

    async function loadCust() {
        try {
            const r = await fetch('/SaleInvoice/nLoadSaleInvoiceCustomerDropDown',
                { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: '{}' });
            const d = await r.json();
            if (d.statusId === 1 && d.customers)
                buildSD('cuWrap', 'cuList', d.customers, 'customerCode', 'customerName');
        } catch (e) { console.error(e); }
    }

    async function loadProd() {
        try {
            const r = await fetch('/SaleInvoice/nLoadSaleInvoiceProductDropDown',
                { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: '{}' });
            const d = await r.json();
            if (d.statusId === 1 && d.products) {
                d.products.forEach(p => {
                    pMap[String(p.productCode)] = {
                        salesPrice: parseFloat(p.salesPrice) || 0,
                        discountAmount: parseFloat(p.discountAmount) || 0,
                        productName: p.productName
                    };
                });
                buildSD('prWrap', 'prList', d.products, 'productCode', 'productName');
            }
        } catch (e) { console.error(e); }
    }

    /* ══════════════════════════════════════
       PRODUCT LOGIC
    ══════════════════════════════════════ */
    function onProd(code) {
        if (code && pMap[code]) {
            document.getElementById('salesPrice').value = pMap[code].salesPrice.toFixed(2);
            document.getElementById('qty').value = 1;
            document.getElementById('discPct').value = 0;
            recalcEntry();
            document.getElementById('qty').focus();
        } else clearEntry();
    }

    document.getElementById('qty').addEventListener('input', recalcEntry);
    document.getElementById('discPct').addEventListener('input', recalcEntry);
    document.getElementById('qty').addEventListener('keydown', e => {
        if (e.key === 'Enter') { e.preventDefault(); document.getElementById('discPct').focus(); }
    });
    document.getElementById('discPct').addEventListener('keydown', e => {
        if (e.key === 'Enter') { e.preventDefault(); addRow(); }
    });

    function recalcEntry() {
        const q = parseFloat(document.getElementById('qty').value) || 0;
        const r = parseFloat(document.getElementById('salesPrice').value) || 0;
        const p = parseFloat(document.getElementById('discPct').value) || 0;
        const a = q * r, disc = a * p / 100;
        document.getElementById('discount').value  = disc.toFixed(2);
        document.getElementById('netAmount').value = (a - disc).toFixed(2);
    }

    function clearEntry() {
        ['qty','salesPrice','discPct','discount','netAmount'].forEach(id =>
            document.getElementById(id).value = 0
        );
    }

    /* ══════════════════════════════════════
       ADD ROW
    ══════════════════════════════════════ */
    function addRow() {
        const pCode = document.getElementById('productCode').value;
        const pName = document.getElementById('prDisp').textContent.trim();
        const qty   = parseFloat(document.getElementById('qty').value) || 0;
        const rate  = parseFloat(document.getElementById('salesPrice').value) || 0;
        const dp    = parseFloat(document.getElementById('discPct').value) || 0;
        const disc  = parseFloat(document.getElementById('discount').value) || 0;
        const net   = parseFloat(document.getElementById('netAmount').value) || 0;
        const amt   = qty * rate;

        if (!pCode) { showAlert('warning', 'Product Missing', 'Please select a product.'); return; }
        if (qty <= 0) { showAlert('warning', 'Invalid Qty', 'Please enter a valid quantity.'); return; }
        if (rate <= 0) { showAlert('warning', 'Invalid Rate', 'Unit rate is 0. Please check product data.'); return; }

        const er = document.getElementById('emptyRow'); if (er) er.remove();
        rCnt++;
        const tb = document.getElementById('tableBody');
        const tr = document.createElement('tr');
        tr.id = 'r' + rCnt;
        tr.style.animation = 'sdIn .2s ease';
        tr.innerHTML = `
          <td style="text-align:center"><input type="checkbox" class="rc" onchange="updSel()"></td>
          <td style="text-align:center;color:var(--text3);font-size:11px">${rCnt}</td>
          <td class="tl">${pName}</td>
          <td style="text-align:center">${qty}</td>
          <td style="text-align:center">${rate.toFixed(2)}</td>
          <td style="text-align:center">${amt.toFixed(2)}</td>
          <td style="text-align:center">${dp.toFixed(2)}</td>
          <td style="text-align:center;color:var(--red)">${disc.toFixed(2)}</td>
          <td style="text-align:center;color:var(--accent);font-weight:700">${net.toFixed(2)}</td>
          <td style="text-align:center">
            <button class="rdel"
              onclick="delRow('r${rCnt}',${qty},${amt},${disc},${net})" type="button" title="Remove">
              <i class="fas fa-xmark"></i>
            </button>
          </td>`;
        tb.appendChild(tr);
        document.getElementById('tfoot').style.display = '';
        updTotals(qty, amt, disc, net);
        rows.push({ id:'r'+rCnt, productCode:parseInt(pCode), qty, salesPrice:rate,
                    amount:amt, discountAmount:disc, netAmount:net });

        // reset
        const pd = document.getElementById('prDisp');
        pd.textContent = 'Select a product…'; pd.classList.remove('hv');
        document.getElementById('productCode').value = '';
        clearEntry();
    }

    /* ══════════════════════════════════════
       DELETE ROW
    ══════════════════════════════════════ */
    function delRow(id, qty, amt, disc, net) {
        const r = document.getElementById(id); if (!r) return;
        r.style.opacity = '0'; r.style.transition = 'opacity .2s';
        setTimeout(() => {
            r.remove();
            updTotals(-qty, -amt, -disc, -net);
            rows = rows.filter(d => d.id !== id);
            const tb = document.getElementById('tableBody');
            if (!tb.children.length) {
                const er = document.createElement('tr'); er.id = 'emptyRow';
                er.innerHTML = `<td colspan="10"><div class="no-rec">
                  <i class="fas fa-box-open"></i>
                  No products added yet — use the form above to add entries
                </div></td>`;
                tb.appendChild(er);
                document.getElementById('tfoot').style.display = 'none';
            }
            updSel();
        }, 200);
    }

    function toggleAll(cb) {
        document.querySelectorAll('.rc').forEach(c => c.checked = cb.checked);
        updSel();
    }
    function updSel() {
        document.getElementById('selCnt').textContent =
            document.querySelectorAll('.rc:checked').length;
    }
    function deleteSelected() {
        const checked = [...document.querySelectorAll('.rc:checked')];
        if (!checked.length) { showAlert('info', 'Nothing Selected', 'Please check rows to delete.'); return; }
        Swal.fire({
            icon:'warning', title:`Delete ${checked.length} row(s)?`,
            text:'This cannot be undone.',
            showCancelButton:true, confirmButtonText:'Yes, Delete',
            cancelButtonText:'Cancel', confirmButtonColor:'#e63946',
            cancelButtonColor:'#6c757d', ...SW
        }).then(res => {
            if (res.isConfirmed) {
                checked.forEach(cb => {
                    const tr = cb.closest('tr'), id = tr.id;
                    const d = rows.find(r => r.id === id);
                    if (d) delRow(id, d.qty, d.amount, d.discountAmount, d.netAmount);
                });
                document.getElementById('chkAll').checked = false;
            }
        });
    }

    /* ══════════════════════════════════════
       TOTALS
    ══════════════════════════════════════ */
    function updTotals(qty, amt, disc, net) {
        const fq = document.getElementById('ftQ'), fa = document.getElementById('ftA'),
              fd = document.getElementById('ftD'), fn = document.getElementById('ftN');
        fq.textContent = (parseFloat(fq.textContent) || 0) + qty;
        fa.textContent = ((parseFloat(fa.textContent) || 0) + amt).toFixed(2);
        fd.textContent = ((parseFloat(fd.textContent) || 0) + disc).toFixed(2);
        fn.textContent = ((parseFloat(fn.textContent) || 0) + net).toFixed(2);
        gross = parseFloat(fa.textContent) || 0;
        document.getElementById('sumGross').textContent = gross.toFixed(2);
        recalcBill();
    }

    function recalcBill() {
        const p = parseFloat(document.getElementById('billDiscPct').value) || 0;
        const d = gross * p / 100;
        document.getElementById('sumDiscAmt').textContent = d.toFixed(2);
        document.getElementById('sumNet').textContent = (gross - d).toFixed(2);
    }

    /* ══════════════════════════════════════
       SAVE
    ══════════════════════════════════════ */
    async function saveForm() {
        if (document.getElementById('tableBody').querySelector('#emptyRow')) {
            showAlert('warning', 'No Products', 'Please add at least one product.');
            return;
        }
        const invNo = document.getElementById('invoiceNo').value;
        const date  = document.getElementById('date').value;
        const cc    = document.getElementById('customerCode').value;
        const rem   = document.getElementById('remarks').value;
        if (!date) { showAlert('warning', 'Date Required', 'Please select a bill date.'); return; }
        if (!cc)   { showAlert('warning', 'Customer Required', 'Please select a customer.'); return; }

        const payload = {
            invoiceNo: invNo, customerCode: parseInt(cc), date, remarks: rem,
            totalAmount:   parseFloat(document.getElementById('sumGross').textContent)   || 0,
            totalDiscount: parseFloat(document.getElementById('sumDiscAmt').textContent) || 0,
            netAmount:     parseFloat(document.getElementById('sumNet').textContent)     || 0,
            details: rows.map(d => ({
                productCode: d.productCode, qty: d.qty, salesPrice: d.salesPrice,
                amount: d.amount, discountAmount: d.discountAmount, netAmount: d.netAmount
            }))
        };

        try {
            const res  = await fetch('/SaleInvoice/nSaveSaleInvoice', {
                method: 'POST', headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });
            const data = await res.json();
            if (data.statusId === 1) {
                Swal.fire({
                    icon: 'success', title: 'Invoice Saved!',
                    text: 'Your invoice has been saved successfully.',
                    confirmButtonText: 'OK', timer: 2500,
                    timerProgressBar: true, ...SW
                }).then(() => location.reload());
            } else {
                Swal.fire({
                    icon: 'error', title: 'Save Failed',
                    text: data.message || 'An error occurred while saving.',
                    confirmButtonText: 'OK', confirmButtonColor: '#e63946', ...SW
                });
            }
        } catch (e) {
            console.error(e);
            showAlert('error', 'Network Error', 'Could not reach the server. Please try again.');
        }
    }

    /* ══════════════════════════════════════
       CANCEL
    ══════════════════════════════════════ */
    function cancelForm() {
        Swal.fire({
            icon: 'question', title: 'Discard Changes?',
            text: 'All unsaved data will be lost.',
            showCancelButton: true, confirmButtonText: 'Yes, Discard',
            cancelButtonText: 'Keep Editing',
            confirmButtonColor: '#e63946', cancelButtonColor: '#4361ee', ...SW
        }).then(r => { if (r.isConfirmed) location.reload(); });
    }

    /* ══════════════════════════════════════
       HELPER
