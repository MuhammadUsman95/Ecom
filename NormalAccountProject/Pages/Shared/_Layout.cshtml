            <nav class="navbar-mobile" id="mobileMenu">
                <div class="navbar-mobile__content">
                    <!-- Section label + items injected by JS -->
                    <ul class="navbar-mobile__list" id="mobileNavList">
                        <li><a href="#"><div class="skel-block" style="width:28px;height:28px;border-radius:7px;flex-shrink:0;"></div><div class="skel-block" style="width:110px;height:11px;border-radius:6px;"></div></a></li>
                        <li><a href="#"><div class="skel-block" style="width:28px;height:28px;border-radius:7px;flex-shrink:0;"></div><div class="skel-block" style="width:90px;height:11px;border-radius:6px;"></div></a></li>
                        <li><a href="#"><div class="skel-block" style="width:28px;height:28px;border-radius:7px;flex-shrink:0;"></div><div class="skel-block" style="width:100px;height:11px;border-radius:6px;"></div></a></li>
                    </ul>
