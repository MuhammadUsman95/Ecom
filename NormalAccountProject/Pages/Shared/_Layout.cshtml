    <!-- Custom Layout Script -->
    <script>
        // Mobile menu functionality
        document.addEventListener('DOMContentLoaded', function() {
            // Mobile menu toggle
            const mobileMenuToggle = document.getElementById('mobileMenuToggle');
            const mobileMenu = document.getElementById('mobileMenu');
            const mobileOverlay = document.getElementById('mobileOverlay');

            if (mobileMenuToggle && mobileMenu) {
                mobileMenuToggle.addEventListener('click', function() {
                    this.classList.toggle('is-active');
                    mobileMenu.classList.toggle('show');
                    mobileOverlay.classList.toggle('show');
                    document.body.style.overflow = mobileMenu.classList.contains('show') ? 'hidden' : '';
                });

                // Close menu when clicking overlay
                mobileOverlay.addEventListener('click', function() {
                    mobileMenuToggle.classList.remove('is-active');
                    mobileMenu.classList.remove('show');
                    mobileOverlay.classList.remove('show');
                    document.body.style.overflow = '';
                });

                // Close menu when clicking a link
                const mobileLinks = mobileMenu.querySelectorAll('a:not(#mobileLogoutBtn)');
                mobileLinks.forEach(link => {
                    link.addEventListener('click', function() {
                        mobileMenuToggle.classList.remove('is-active');
                        mobileMenu.classList.remove('show');
                        mobileOverlay.classList.remove('show');
                        document.body.style.overflow = '';
                    });
                });
            }

            // Load user name from localStorage
            const userId = localStorage.getItem('userId') || 'Guest User';
            const userNameElements = document.querySelectorAll('#userName, #userNameDropdown');
            userNameElements.forEach(el => {
                el.textContent = userId;
            });

            // Logout functionality - Desktop
            const logoutBtn = document.getElementById('logoutBtn');
            if (logoutBtn) {
                logoutBtn.addEventListener('click', function(e) {
                    e.preventDefault();
                    if (confirm('Are you sure you want to logout?')) {
                        localStorage.clear();
                        window.location.href = '/Login';
                    }
                });
            }

            // Logout functionality - Mobile
            const mobileLogoutBtn = document.getElementById('mobileLogoutBtn');
            if (mobileLogoutBtn) {
                mobileLogoutBtn.addEventListener('click', function(e) {
                    e.preventDefault();
                    if (confirm('Are you sure you want to logout?')) {
                        localStorage.clear();
                        window.location.href = '/Login';
                    }
                });
            }

            // Set active menu item based on current page
            const currentPath = window.location.pathname.toLowerCase();

            // Remove all active classes first
            document.querySelectorAll('.navbar__list li, .navbar-mobile__list li').forEach(li => {
                li.classList.remove('active');
            });

            // Define menu mapping
            const menuMapping = {
                '/home': 'Home',
                '/vendorregistration': 'VendorRegistration',
                '/ordermanagement': 'OrderManagement',
                '/product': 'Product'
            };

            // Find matching menu item
            let matchFound = false;

            // Check exact matches first
            for (const [path, pageId] of Object.entries(menuMapping)) {
                if (currentPath === path || currentPath.startsWith(path + '/')) {
                    // Desktop menu
                    const desktopLinks = document.querySelectorAll('.navbar__list a[href*="' + pageId + '"]');
                    desktopLinks.forEach(link => {
                        const parentLi = link.closest('li');
                        if (parentLi) {
                            parentLi.classList.add('active');
                            matchFound = true;
                        }
                    });

                    // Mobile menu
                    const mobileLinks = document.querySelectorAll('.navbar-mobile__list a[href*="' + pageId + '"]');
                    mobileLinks.forEach(link => {
                        const parentLi = link.closest('li');
                        if (parentLi) {
                            parentLi.classList.add('active');
                            matchFound = true;
                        }
                    });
                    break;
                }
            }

            // If no match found, activate Home by default
            if (!matchFound) {
                const homeLinks = document.querySelectorAll('a[href="/Home"]');
                homeLinks.forEach(link => {
                    const parentLi = link.closest('li');
                    if (parentLi) {
                        parentLi.classList.add('active');
                    }
                });
            }

            // Handle orientation change for mobile
            window.addEventListener('orientationchange', function() {
                if (mobileMenu.classList.contains('show')) {
                    mobileMenuToggle.classList.remove('is-active');
                    mobileMenu.classList.remove('show');
                    mobileOverlay.classList.remove('show');
                    document.body.style.overflow = '';
                }
            });

            // Prevent zoom on double tap for iOS
            let lastTouchEnd = 0;
            document.addEventListener('touchend', function(event) {
                const now = (new Date()).getTime();
                if (now - lastTouchEnd <= 300) {
                    event.preventDefault();
                }
                lastTouchEnd = now;
            }, false);
        });
    </script>
</body>
</html>
