            </div>

            <div class="menu-sidebar__content">
                <!-- ── Groups built by JS ── -->
                <div id="desktopNavContainer">
                    <!-- Skeleton -->
                    <ul class="navbar__list" style="padding:0 0 4px;">
                        <li><a href="#"><div class="nav-icon skel-block"></div><span class="skel-block" style="width:110px;height:11px;display:block;border-radius:6px;"></span></a></li>
                        <li><a href="#"><div class="nav-icon skel-block"></div><span class="skel-block" style="width:90px;height:11px;display:block;border-radius:6px;"></span></a></li>
