<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title>@ViewData["Title"] - E-Commerce Portal</title>

    @await Html.PartialAsync("_CommonScripts")

    <link href="css/font-face.css" rel="stylesheet" media="all">
    <link href="vendor/fontawesome-7.0.1/css/all.min.css" rel="stylesheet" media="all">
    <link href="vendor/mdi-font/css/material-design-iconic-font.min.css" rel="stylesheet" media="all">
    <link href="vendor/bootstrap-5.3.8.min.css" rel="stylesheet" media="all">
    <link href="css/aos.css" rel="stylesheet" media="all">
    <link href="vendor/css-hamburgers/hamburgers.min.css" rel="stylesheet" media="all">
    <link href="css/swiper-bundle-11.2.10.min.css" rel="stylesheet" media="all">
    <link href="vendor/perfect-scrollbar/perfect-scrollbar-1.5.6.min.css" rel="stylesheet" media="all">
    <link href="css/theme.css" rel="stylesheet" media="all">
    <link href="https://fonts.googleapis.com/css2?family=Syne:wght@600;700;800&family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">

    <!-- ✅ Toastr CSS -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css">

    <style>
        :root {
            --bg: #f4f4f4;
            --bg2: #ffffff;
            --surface: #ffffff;
            --surface2: #f9f9f9;
            --surface3: #efefef;
            --border: rgba(0,0,0,.07);
            --border2: rgba(0,0,0,.12);
            --border3: rgba(0,0,0,.18);
            --accent: #474544;
            --accent2: #2e2d2c;
            --accent-g: rgba(71,69,68,.10);
            --accent-glow: rgba(71,69,68,.20);
            --accent-dim: rgba(71,69,68,.08);
            --active-nav: rgba(71,69,68,.08);
            --gold: #b08d57;
            --gold-g: rgba(176,141,87,.10);
            --teal: #5a7a6e;
            --danger: #d94f4f;
            --success: #10b981;
            --text: #1a1a1a;
            --text2: #5c5a58;
            --text3: #9a9896;
            --font-h: 'Syne', sans-serif;
            --font-b: 'Plus Jakarta Sans', sans-serif;
            --font-m: 'JetBrains Mono', monospace;
            --r: 10px;
            --r2: 14px;
            --r3: 18px;
            --sh: 0 4px 32px rgba(0,0,0,.08);
            --sh2: 0 8px 48px rgba(0,0,0,.12);
            --sidebar-w: 240px;
            --header-h: 56px;
        }

        *, *::before, *::after {
            box-sizing: border-box;
            -webkit-tap-highlight-color: transparent;
            margin: 0;
            padding: 0;
        }

        html {
            touch-action: manipulation;
        }

        body {
            font-family: var(--font-b);
            background: var(--bg);
            color: var(--text);
        }

        ::-webkit-scrollbar {
            width: 4px;
        }

        ::-webkit-scrollbar-track {
            background: transparent;
        }

        ::-webkit-scrollbar-thumb {
            background: var(--surface3);
            border-radius: 10px;
        }

        .menu-sidebar {
            background: var(--surface);
            width: var(--sidebar-w);
            position: fixed;
            height: 100vh;
            top: 0;
            left: 0;
            z-index: 1000;
            display: flex;
            flex-direction: column;
            border-right: 1px solid var(--border2);
            box-shadow: 4px 0 24px rgba(0,0,0,.08);
            transition: transform .3s ease;
            animation: sidebarIn .35s ease both;
        }

        .sidebar-logo {
            background: var(--surface2);
            padding: 18px;
            border-bottom: 1px solid var(--border2);
            display: flex;
            align-items: center;
            gap: 12px;
            flex-shrink: 0;
            position: relative;
            overflow: hidden;
        }

            .sidebar-logo::after {
                content: '';
                position: absolute;
                top: 0;
                left: -100%;
                width: 200%;
                height: 100%;
                background: linear-gradient(90deg, transparent, rgba(0,0,0,.02), transparent);
                animation: sheen 5s infinite;
            }

        @@keyframes sheen {
            0% {
                left: -100%
            }

            100% {
                left: 100%
            }
        }

        .sidebar-logo-icon {
            width: 40px;
            height: 40px;
            background: linear-gradient(135deg, var(--accent) 0%, var(--accent2) 100%);
            border-radius: var(--r);
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            font-size: 16px;
            flex-shrink: 0;
            box-shadow: 0 4px 16px rgba(71,69,68,.25);
            position: relative;
            z-index: 1;
        }

        .sidebar-logo-text {
            position: relative;
            z-index: 1;
        }

            .sidebar-logo-text .name {
                font-family: var(--font-h);
                font-size: 16px;
                font-weight: 800;
                color: var(--text);
                letter-spacing: -.2px;
                line-height: 1;
                text-decoration: none;
                display: block;
            }

                .sidebar-logo-text .name span {
                    color: var(--accent);
                }

            .sidebar-logo-text .sub {
                font-family: var(--font-m);
                font-size: 9px;
                color: var(--text3);
                letter-spacing: 1px;
                margin-top: 3px;
            }

        .menu-sidebar__content {
            flex: 1;
            overflow-y: auto;
            overflow-x: hidden;
            padding: 14px 0;
            scrollbar-width: thin;
            scrollbar-color: var(--surface3) transparent;
        }

        .nav-section-label {
            font-family: var(--font-m);
            font-size: 9px;
            color: var(--text3);
            letter-spacing: 2px;
            text-transform: uppercase;
            padding: 10px 22px 6px;
            opacity: 0;
            animation: navLabelIn .4s ease forwards;
        }

        .navbar__list {
            list-style: none;
            padding: 0;
            margin: 0;
        }

            .navbar__list > li {
                margin: 2px 10px;
                opacity: 0;
                transform: translateX(-12px);
                animation: navItemIn .35s ease forwards;
            }

                .navbar__list > li > a {
                    display: flex;
                    align-items: center;
                    gap: 11px;
                    padding: 10px 14px;
                    color: var(--text2);
                    font-size: 13px;
                    font-weight: 500;
                    border-radius: var(--r);
                    text-decoration: none;
                    transition: background .2s, color .2s, border-color .2s, transform .18s, box-shadow .2s;
                    border: 1px solid transparent;
                    font-family: var(--font-b);
                }

                    .navbar__list > li > a i {
                        font-size: 14px;
                        width: 20px;
                        text-align: center;
                        flex-shrink: 0;
                        opacity: .55;
                        transition: opacity .2s, color .2s, transform .2s;
                    }

                    .navbar__list > li > a:hover {
                        background: var(--surface2);
                        color: var(--text);
                        border-color: var(--border2);
                        transform: translateX(3px);
                    }

                        .navbar__list > li > a:hover i {
                            opacity: 1;
                            transform: scale(1.15);
                        }

                .navbar__list > li.active > a {
                    background: var(--active-nav);
                    color: var(--accent);
                    border-color: rgba(71,69,68,.18);
                    font-weight: 600;
                    box-shadow: 0 2px 10px rgba(71,69,68,.10);
                }

                    .navbar__list > li.active > a i {
                        opacity: 1;
                        color: var(--accent);
                    }

        .sidebar-footer {
            padding: 12px 10px;
            border-top: 1px solid var(--border);
            flex-shrink: 0;
        }

            .sidebar-footer a {
                display: flex;
                align-items: center;
                gap: 10px;
                padding: 9px 14px;
                color: rgba(217,79,79,.7);
                font-size: 13px;
                font-weight: 600;
                border-radius: var(--r);
                text-decoration: none;
                transition: all .2s;
                font-family: var(--font-b);
            }

                .sidebar-footer a:hover {
                    background: rgba(217,79,79,.08);
                    color: var(--danger);
                }

                .sidebar-footer a i {
                    font-size: 14px;
                    width: 20px;
                    text-align: center;
                }

        .page-container {
            padding-left: var(--sidebar-w);
            min-height: 100vh;
            overflow: hidden;
            transition: padding-left .3s ease;
            animation: fadeIn .4s ease .1s both;
        }

        .header-desktop {
            background: var(--surface);
            border-bottom: 1px solid var(--border2);
            height: var(--header-h);
            display: flex;
            align-items: center;
            position: sticky;
            top: 0;
            z-index: 999;
            box-shadow: 0 2px 12px rgba(0,0,0,.06);
        }

        .header-wrap {
            display: flex;
            justify-content: flex-end;
            align-items: center;
            padding: 0 24px;
            width: 100%;
            gap: 12px;
        }

        .header-page-info {
            flex: 1;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .header-page-dot {
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: var(--accent);
            box-shadow: 0 0 6px var(--accent-glow);
            animation: pulse 2.5s ease-in-out infinite;
        }

        @@keyframes pulse {
            0%, 100% {
                box-shadow: 0 0 4px var(--accent-glow);
                transform: scale(1);
            }

            50% {
                box-shadow: 0 0 10px var(--accent-glow);
                transform: scale(1.3);
            }
        }

        .header-page-name {
            font-family: var(--font-m);
            font-size: 11px;
            color: var(--text3);
            letter-spacing: .5px;
        }

            .header-page-name span {
                color: var(--accent);
            }

        .account-wrap {
            position: relative;
        }

        .account-item {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 6px 14px 6px 6px;
            border-radius: var(--r);
            cursor: pointer;
            transition: all .22s ease;
            border: 1px solid var(--border2);
            background: var(--surface2);
        }

            .account-item:hover, .account-item.open {
                background: var(--active-nav);
                border-color: rgba(71,69,68,.22);
                box-shadow: 0 2px 10px rgba(0,0,0,.06);
            }

        .account-avatar {
            width: 34px;
            height: 34px;
            border-radius: 8px;
            background: linear-gradient(135deg, var(--accent) 0%, var(--accent2) 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            font-size: 14px;
            flex-shrink: 0;
            box-shadow: 0 2px 8px rgba(71,69,68,.20);
        }

        .account-name {
            font-size: 13px;
            font-weight: 600;
            color: var(--text);
            font-family: var(--font-b);
        }

        .account-chevron {
            font-size: 9px;
            color: var(--text3);
            transition: transform .25s ease;
            margin-left: 2px;
        }

        .account-item.open .account-chevron {
            transform: rotate(180deg);
        }

        .account-dropdown {
            position: absolute;
            top: calc(100% + 10px);
            right: 0;
            background: var(--surface);
            border: 1px solid var(--border2);
            border-radius: var(--r2);
            box-shadow: 0 12px 48px rgba(0,0,0,.14), 0 2px 8px rgba(0,0,0,.06);
            min-width: 250px;
            overflow: hidden;
            opacity: 0;
            visibility: hidden;
            transform: translateY(-8px) scale(.97);
            transition: all .25s cubic-bezier(.2,.8,.2,1);
            z-index: 9999;
        }

            .account-dropdown.show {
                opacity: 1;
                visibility: visible;
                transform: translateY(0) scale(1);
            }

        .dropdown-header {
            padding: 18px 20px;
            background: linear-gradient(135deg, var(--surface2) 0%, rgba(71,69,68,.04) 100%);
            border-bottom: 1px solid var(--border);
            display: flex;
            align-items: center;
            gap: 14px;
        }

        .dropdown-avatar {
            width: 44px;
            height: 44px;
            border-radius: var(--r);
            background: linear-gradient(135deg, var(--accent) 0%, var(--accent2) 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            font-size: 18px;
            flex-shrink: 0;
            box-shadow: 0 3px 12px rgba(71,69,68,.25);
        }

        .dropdown-user-info {
            display: flex;
            flex-direction: column;
            gap: 3px;
        }

        .dropdown-user-name {
            font-family: var(--font-h);
            font-size: 15px;
            font-weight: 700;
            color: var(--text);
        }

        .dropdown-user-role {
            font-family: var(--font-m);
            font-size: 10px;
            color: var(--text3);
            letter-spacing: .5px;
        }

        .dropdown-menu-items {
            padding: 6px 0;
        }

        .dropdown-menu-item {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 11px 20px;
            color: var(--text2);
            font-size: 13px;
            font-weight: 500;
            text-decoration: none;
            transition: all .15s ease;
            font-family: var(--font-b);
        }

            .dropdown-menu-item:hover {
                background: var(--surface2);
                color: var(--text);
            }

            .dropdown-menu-item i {
                font-size: 14px;
                width: 18px;
                text-align: center;
                opacity: .55;
                transition: opacity .15s;
            }

            .dropdown-menu-item:hover i {
                opacity: 1;
            }

        .dropdown-divider {
            height: 1px;
            background: var(--border);
            margin: 2px 16px;
        }

        .dropdown-logout {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px 20px;
            color: rgba(217,79,79,.75);
            font-size: 13px;
            font-weight: 600;
            text-decoration: none;
            transition: all .15s ease;
            font-family: var(--font-b);
        }

            .dropdown-logout:hover {
                background: rgba(217,79,79,.06);
                color: var(--danger);
            }

            .dropdown-logout i {
                font-size: 14px;
                width: 18px;
                text-align: center;
            }

        .header-mobile {
            background: var(--surface);
            border-bottom: 1px solid var(--border2);
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            z-index: 1001;
            height: 56px;
            display: flex;
            align-items: center;
        }

        .header-mobile-inner {
            display: flex;
            justify-content: space-between;
            align-items: center;
            width: 100%;
            padding: 0 16px;
        }

        .mobile-logo {
            display: flex;
            align-items: center;
            gap: 10px;
            text-decoration: none;
        }

        .mobile-logo-icon {
            width: 34px;
            height: 34px;
            background: linear-gradient(135deg, var(--accent) 0%, var(--accent2) 100%);
            border-radius: var(--r);
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            font-size: 14px;
            box-shadow: 0 3px 10px rgba(71,69,68,.25);
        }

        .mobile-logo-text {
            font-family: var(--font-h);
            font-size: 15px;
            font-weight: 800;
            color: var(--text);
        }

            .mobile-logo-text span {
                color: var(--accent);
            }

        .hamburger-btn {
            padding: 0;
            background: var(--surface2);
            border: 1px solid var(--border2);
            border-radius: var(--r);
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            width: 40px;
            height: 40px;
            transition: background .2s, border-color .2s;
            position: relative;
            z-index: 1002;
            touch-action: manipulation;
            -webkit-user-select: none;
            user-select: none;
            outline: none;
            -webkit-appearance: none;
            appearance: none;
        }

            .hamburger-btn:hover, .hamburger-btn:active {
                background: var(--active-nav);
                border-color: rgba(71,69,68,.2);
            }

        .hamburger-icon {
            width: 20px;
            height: 16px;
            position: relative;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            pointer-events: none;
        }

            .hamburger-icon span {
                display: block;
                width: 100%;
                height: 2px;
                background: var(--text2);
                border-radius: 2px;
                transition: all .28s cubic-bezier(.4,.0,.2,1);
                transform-origin: center;
                pointer-events: none;
            }

        .hamburger-btn.is-active .hamburger-icon span:nth-child(1) {
            transform: translateY(7px) rotate(45deg);
        }

        .hamburger-btn.is-active .hamburger-icon span:nth-child(2) {
            opacity: 0;
            transform: scaleX(0);
        }

        .hamburger-btn.is-active .hamburger-icon span:nth-child(3) {
            transform: translateY(-7px) rotate(-45deg);
        }

        .navbar-mobile {
            position: fixed;
            top: 56px;
            left: 0;
            bottom: 0;
            width: 280px;
            max-width: 85vw;
            background: var(--surface);
            transform: translateX(-100%);
            transition: transform .3s cubic-bezier(.4,.0,.2,1);
            overflow-y: auto;
            overflow-x: hidden;
            z-index: 1000;
            border-right: 1px solid var(--border2);
            box-shadow: 4px 0 24px rgba(0,0,0,.10);
            display: flex;
            flex-direction: column;
        }

            .navbar-mobile.show {
                transform: translateX(0);
            }

        .navbar-mobile__list {
            list-style: none;
            padding: 14px 10px;
            margin: 0;
            flex: 1;
        }

            .navbar-mobile__list li {
                margin: 2px 0;
            }

                .navbar-mobile__list li a {
                    display: flex;
                    align-items: center;
                    gap: 11px;
                    padding: 11px 14px;
                    color: var(--text2);
                    font-size: 13px;
                    font-weight: 500;
                    border-radius: var(--r);
                    text-decoration: none;
                    transition: all .2s;
                    border: 1px solid transparent;
                    font-family: var(--font-b);
                }

                    .navbar-mobile__list li a i {
                        font-size: 14px;
                        width: 20px;
                        text-align: center;
                        opacity: .55;
                    }

                    .navbar-mobile__list li a:hover {
                        background: var(--surface2);
                        color: var(--text);
                        border-color: var(--border2);
                    }

                .navbar-mobile__list li.active a {
                    background: var(--active-nav);
                    color: var(--accent);
                    border-color: rgba(71,69,68,.18);
                    font-weight: 600;
                }

                    .navbar-mobile__list li.active a i {
                        opacity: 1;
                        color: var(--accent);
                    }

            .navbar-mobile__list .mobile-section-label {
                font-family: var(--font-m);
                font-size: 9px;
                color: var(--text3);
                letter-spacing: 2px;
                text-transform: uppercase;
                padding: 10px 14px 5px;
                display: block;
            }

        .mobile-nav-footer {
            padding: 12px 10px;
            border-top: 1px solid var(--border);
        }

            .mobile-nav-footer a {
                display: flex;
                align-items: center;
                gap: 10px;
                padding: 10px 14px;
                color: rgba(217,79,79,.7);
                font-size: 13px;
                font-weight: 600;
                border-radius: var(--r);
                text-decoration: none;
                transition: all .2s;
                font-family: var(--font-b);
            }

                .mobile-nav-footer a:hover {
                    background: rgba(217,79,79,.08);
                    color: var(--danger);
                }

                .mobile-nav-footer a i {
                    font-size: 14px;
                    width: 20px;
                    text-align: center;
                }

        .mobile-overlay {
            position: fixed;
            top: 56px;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0,0,0,.3);
            z-index: 999;
            backdrop-filter: blur(4px);
            -webkit-backdrop-filter: blur(4px);
            opacity: 0;
            visibility: hidden;
            transition: opacity .3s ease, visibility .3s ease;
        }

            .mobile-overlay.show {
                opacity: 1;
                visibility: visible;
            }

        .main-content {
            overflow: visible !important;
            display: contents;
        }

        .section__content--p30 {
            padding: 0;
            overflow: visible !important;
        }

        .nav-group-divider {
            height: 1px;
            background: var(--border);
            margin: 8px 22px 4px;
            opacity: 0;
            animation: fadeIn .4s ease .2s forwards;
        }

        @@keyframes fadeIn {
            from {
                opacity: 0
            }

            to {
                opacity: 1
            }
        }

        @@keyframes fadeUp {
            from {
                opacity: 0;
                transform: translateY(8px)
            }

            to {
                opacity: 1;
                transform: translateY(0)
            }
        }

        @@keyframes navItemIn {
            from {
                opacity: 0;
                transform: translateX(-12px)
            }

            to {
                opacity: 1;
                transform: translateX(0)
            }
        }

        @@keyframes navLabelIn {
            from {
                opacity: 0;
                transform: translateY(-4px)
            }

            to {
                opacity: 1;
                transform: translateY(0)
            }
        }

        @@keyframes sidebarIn {
            from {
                opacity: 0;
                transform: translateX(-20px)
            }

            to {
                opacity: 1;
                transform: translateX(0)
            }
        }

        @@media (max-width: 991px) {
            body {
                padding-top: 56px;
                overflow: auto !important;
            }

            .page-container {
                padding-left: 0;
                overflow: auto !important;
            }

            .menu-sidebar {
                transform: translateX(-100%);
            }

            .header-desktop {
                display: none !important;
            }
        }

        @@media print {
            .header-mobile, .menu-sidebar, .navbar-mobile, .mobile-overlay {
                display: none !important;
            }

            .page-container {
                padding-left: 0 !important;
            }

            body {
                padding-top: 0 !important;
            }
        }
    </style>
</head>

<body>
    <div class="page-wrapper">

        <header class="header-mobile d-block d-lg-none">
            <div class="header-mobile-inner">
                <a class="mobile-logo" href="/Home">
                    <div class="mobile-logo-icon"><i class="fas fa-shopping-cart"></i></div>
                    <div class="mobile-logo-text">Admin Panel </div>
                </a>
                <button class="hamburger-btn" id="mobileMenuToggle" type="button" aria-label="Toggle menu" aria-expanded="false">
                    <div class="hamburger-icon"><span></span><span></span><span></span></div>
                </button>
            </div>
        </header>

        <nav class="navbar-mobile" id="mobileMenu" aria-hidden="true">
            <ul class="navbar-mobile__list" id="mobileNavList">
                <li><a href="#"><i class="fas fa-circle-notch fa-spin"></i>Loading...</a></li>
            </ul>
            <div class="mobile-nav-footer">
                <a href="#" id="mobileLogoutBtn"><i class="fas fa-arrow-right-from-bracket"></i>Logout</a>
            </div>
        </nav>
        <div class="mobile-overlay" id="mobileOverlay"></div>

        <aside class="menu-sidebar d-none d-lg-flex">
            <div class="sidebar-logo">
                <div class="sidebar-logo-icon"><i class="fas fa-store"></i></div>
                <div class="sidebar-logo-text">
                    <a href="/Home" class="name">Admin Panel</a>
                </div>
            </div>
            <div class="menu-sidebar__content">
                <nav class="navbar-sidebar" id="desktopNavContainer"></nav>
            </div>
            <div class="sidebar-footer">
                <a href="#" id="logoutBtn"><i class="fas fa-arrow-right-from-bracket"></i>Logout</a>
            </div>
        </aside>

        <div class="page-container">
            <header class="header-desktop d-none d-lg-flex">
                <div class="header-wrap">
                    <div class="header-page-info">
                        <div class="header-page-dot"></div>
                        <div class="header-page-name" id="headerPageName"><span>Dashboard</span></div>
                    </div>
                    <div class="account-wrap">
                        <div class="account-item" id="accountToggle">
                            <div class="account-avatar"><i class="fas fa-user"></i></div>
                            <div class="account-name" id="userName">Loading...</div>
                            <i class="fas fa-chevron-down account-chevron"></i>
                        </div>
                        <div class="account-dropdown" id="accountDropdown">
                            <div class="dropdown-header">
                                <div class="dropdown-avatar"><i class="fas fa-user"></i></div>
                                <div class="dropdown-user-info">
                                    <div class="dropdown-user-name" id="userNameDropdown">Loading...</div>
                                    <div class="dropdown-user-role">// administrator</div>
                                </div>
                            </div>
                            <div class="dropdown-menu-items">
                                <a href="#" class="dropdown-menu-item"><i class="fas fa-gear"></i> Settings</a>
                                <a href="#" class="dropdown-menu-item"><i class="fas fa-circle-question"></i> Help & Support</a>
                            </div>
                            <div class="dropdown-divider"></div>
                            <a href="#" class="dropdown-logout" id="logoutBtnDropdown">
                                <i class="fas fa-arrow-right-from-bracket"></i> Sign Out
                            </a>
                        </div>
                    </div>
                </div>
            </header>

            <div class="main-content">
                @RenderBody()
            </div>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════
         SCRIPTS — SAHI ORDER:
         1. vanilla-utils.js
         2. Bootstrap
         3. Baaki libraries
         4. jQuery  ← sabse aakhir mein load (conflict fix)
         5. Toastr  ← jQuery ke baad
         ═══════════════════════════════════════════ -->
    <script src="js/vanilla-utils.js"></script>
    <script src="vendor/bootstrap-5.3.8.bundle.min.js"></script>
    <script src="vendor/perfect-scrollbar/perfect-scrollbar-1.5.6.min.js"></script>
    <script src="vendor/chartjs/chart.umd.js-4.5.0.min.js"></script>
    <script src="js/bootstrap5-init.js"></script>
    <script src="js/main-vanilla.js"></script>
    <script src="js/swiper-bundle-11.2.10.min.js"></script>
    <script src="js/aos.js"></script>
    <script src="js/modern-plugins.js"></script>
    <script src="js/Layout.js"></script>

    <!-- ✅ jQuery — SABSE AAKHIR mein (vanilla scripts ke baad, conflict nahi hoga) -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>

    <!-- ✅ Toastr — jQuery ke baad -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>

    <!-- ✅ Toastr Config -->
    <script>
        toastr.options = {
            closeButton: true,
            progressBar: true,
            positionClass: "toast-top-right",
            timeOut: 3000
        };
    </script>

    <script>
        document.addEventListener('DOMContentLoaded', async function () {

            const userId = localStorage.getItem('userId') || 'admin';
            document.querySelectorAll('#userName, #userNameDropdown')
                .forEach(el => el.textContent = userId);

            const mobileToggle  = document.getElementById('mobileMenuToggle');
            const mobileMenu    = document.getElementById('mobileMenu');
            const mobileOverlay = document.getElementById('mobileOverlay');

            function closeMobileMenu() {
                mobileToggle?.classList.remove('is-active');
                mobileToggle?.setAttribute('aria-expanded', 'false');
                mobileMenu?.classList.remove('show');
                mobileMenu?.setAttribute('aria-hidden', 'true');
                mobileOverlay?.classList.remove('show');
                document.body.style.overflow = '';
            }

            function openMobileMenu() {
                mobileToggle?.classList.add('is-active');
                mobileToggle?.setAttribute('aria-expanded', 'true');
                mobileMenu?.classList.add('show');
                mobileMenu?.setAttribute('aria-hidden', 'false');
                mobileOverlay?.classList.add('show');
                document.body.style.overflow = 'hidden';
            }

            closeMobileMenu();

            async function loadUserMenu() {
                try {
                    const res  = await fetch(`/Login/GetMenu?userId=${encodeURIComponent(userId)}`);
                    const json = await res.json();
                    if (!json.success || !json.data?.length) { showFallbackMenu(); return; }
                    buildNavItems(json.data);
                } catch (err) {
                    console.error('Menu load error:', err);
                    showFallbackMenu();
                }
            }

            function buildNavItems(items) {
                const desktopContainer = document.getElementById('desktopNavContainer');
                const mobileUl         = document.getElementById('mobileNavList');
                const groups = {
                    0: { label: 'Main Menu',   items: [] },
                    1: { label: 'Setup',       items: [] },
                    2: { label: 'Transaction', items: [] }
                };
                items.forEach(item => {
                    if (!item.menuName || !item.menuUrl || item.menuUrl === '#') return;
                    const t = item.menuType ?? 0;
                    (groups[t] ?? groups[0]).items.push(item);
                });

                if (desktopContainer) {
                    desktopContainer.innerHTML = '';
                    let idx = 0;
                    Object.values(groups).forEach((group, gi) => {
                        if (!group.items.length) return;
                        if (gi > 0) {
                            const d = document.createElement('div');
                            d.className = 'nav-group-divider';
                            desktopContainer.appendChild(d);
                        }
                        const lbl = document.createElement('div');
                        lbl.className = 'nav-section-label';
                        lbl.textContent = group.label;
                        lbl.style.animationDelay = `${idx * 0.04}s`;
                        desktopContainer.appendChild(lbl);
                        const ul = document.createElement('ul');
                        ul.className = 'list-unstyled navbar__list';
                        group.items.forEach(item => {
                            if (!item.menuName || !item.menuUrl || item.menuUrl === '#') return;
                            const li = document.createElement('li');
                            li.innerHTML = `<a href="${item.menuUrl}"><i class="${item.menuIcon}"></i>${item.menuName}</a>`;
                            li.style.animationDelay = `${0.08 + idx * 0.055}s`;
                            ul.appendChild(li);
                            idx++;
                        });
                        if (ul.children.length > 0) desktopContainer.appendChild(ul);
                    });
                }

                if (mobileUl) {
                    mobileUl.innerHTML = '';
                    Object.values(groups).forEach(group => {
                        if (!group.items.length) return;
                        const lLi = document.createElement('li');
                        lLi.innerHTML = `<span class="mobile-section-label">${group.label}</span>`;
                        lLi.style.cssText = 'margin:0;padding:0;';
                        mobileUl.appendChild(lLi);
                        group.items.forEach(item => {
                            if (!item.menuName || !item.menuUrl || item.menuUrl === '#') return;
                            const li = document.createElement('li');
                            li.innerHTML = `<a href="${item.menuUrl}"><i class="${item.menuIcon}"></i>${item.menuName}</a>`;
                            mobileUl.appendChild(li);
                        });
                    });
                }
                setActiveNavItem();
            }

            function showFallbackMenu() {
                buildNavItems([
                    { menuName: 'Dashboard',        menuUrl: '/Home',               menuIcon: 'fas fa-gauge-high', menuType: 0 },
                    { menuName: 'Slider',           menuUrl: '/Slider',             menuIcon: 'fas fa-images',     menuType: 1 },
                    { menuName: 'Category',         menuUrl: '/Category',           menuIcon: 'fas fa-th-large',   menuType: 1 },
                    { menuName: 'Product',          menuUrl: '/Product',            menuIcon: 'fas fa-box-open',   menuType: 1 },
                    { menuName: 'Vendor',           menuUrl: '/VendorRegistration', menuIcon: 'fas fa-store',      menuType: 1 },
                    { menuName: 'Barcode Printing', menuUrl: '/BarcodePrinting',    menuIcon: 'fas fa-barcode',    menuType: 1 }
                ]);
            }

            function setActiveNavItem() {
                const path = window.location.pathname.toLowerCase();
                document.querySelectorAll('.navbar__list li, .navbar-mobile__list li').forEach(li => li.classList.remove('active'));
                document.querySelectorAll('.navbar__list a, .navbar-mobile__list a').forEach(a => {
                    const href = a.getAttribute('href')?.toLowerCase();
                    if (href && href !== '#' && (path === href || path.startsWith(href + '/'))) {
                        a.closest('li')?.classList.add('active');
                        const el = document.getElementById('headerPageName');
                        if (el) el.innerHTML = `<span>${a.textContent.trim()}</span>`;
                    }
                });
            }

            mobileToggle?.addEventListener('click', function (e) {
                e.preventDefault();
                e.stopPropagation();
                mobileMenu.classList.contains('show') ? closeMobileMenu() : openMobileMenu();
            });
            mobileOverlay?.addEventListener('click', closeMobileMenu);
            window.addEventListener('orientationchange', closeMobileMenu);
            mobileMenu?.addEventListener('click', function (e) {
                const link = e.target.closest('a');
                if (link && link.id !== 'mobileLogoutBtn') closeMobileMenu();
            });

            await loadUserMenu();

            const accountToggle   = document.getElementById('accountToggle');
            const accountDropdown = document.getElementById('accountDropdown');
            if (accountToggle && accountDropdown) {
                accountToggle.addEventListener('click', function (e) {
                    e.stopPropagation();
                    const isOpen = accountDropdown.classList.toggle('show');
                    accountToggle.classList.toggle('open', isOpen);
                });
                document.addEventListener('click', function () {
                    accountDropdown.classList.remove('show');
                    accountToggle.classList.remove('open');
                });
                accountDropdown.addEventListener('click', e => e.stopPropagation());
            }

            function doLogout(e) {
                e.preventDefault();
                if (confirm('Are you sure you want to logout?')) {
                    localStorage.clear();
                    window.location.href = '/Login';
                }
            }
            document.getElementById('logoutBtn')?.addEventListener('click', doLogout);
            document.getElementById('logoutBtnDropdown')?.addEventListener('click', doLogout);
            document.getElementById('mobileLogoutBtn')?.addEventListener('click', doLogout);
        });
    </script>

</body>
</html>
