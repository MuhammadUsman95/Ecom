<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title>@ViewData["Title"] - E-Commerce Portal</title>

    @await Html.PartialAsync("_CommonScripts")

    <link href="css/font-face.css" rel="stylesheet" media="all">
    <link href="vendor/fontawesome-7.0.1/css/all.min.css" rel="stylesheet" media="all">
    <link href="vendor/mdi-font/css/material-design-iconic-font.min.css" rel="stylesheet" media="all">
    <link href="vendor/bootstrap-5.3.8.min.css" rel="stylesheet" media="all">
    <link href="css/aos.css" rel="stylesheet" media="all">
    <link href="vendor/css-hamburgers/hamburgers.min.css" rel="stylesheet" media="all">
    <link href="css/swiper-bundle-11.2.10.min.css" rel="stylesheet" media="all">
    <link href="vendor/perfect-scrollbar/perfect-scrollbar-1.5.6.min.css" rel="stylesheet" media="all">
    <link href="css/theme.css" rel="stylesheet" media="all">
    <link href="https://fonts.googleapis.com/css2?family=Syne:wght@600;700;800&family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">

    <style>
        /* ════════════════════════════════════════
                           UNIFIED DESIGN TOKENS — Category Theme
                           Matches: Category.cshtml · Home.cshtml
                        ════════════════════════════════════════ */
        :root {
            --bg: #0a0c12;
            --bg2: #0f1220;
            --surface: #141828;
            --surface2: #1a2035;
            --surface3: #1f2640;
            --border: rgba(255,255,255,.06);
            --border2: rgba(255,255,255,.11);
            --border3: rgba(255,255,255,.18);
            --accent: #6c63ff;
            --accent2: #4f46e5;
            --accent-g: rgba(108,99,255,.15);
            --accent-glow: rgba(108,99,255,.28);
            --accent-dim: rgba(108,99,255,.14);
            --active-nav: rgba(108,99,255,.18);
            --gold: #f0b429;
            --gold-g: rgba(240,180,41,.12);
            --teal: #14b8a6;
            --danger: #f43f5e;
            --success: #10b981;
            --text: #e8eaf2;
            --text2: #9198b0;
            --text3: #5a6182;
            --font-h: 'Syne', sans-serif;
            --font-b: 'Plus Jakarta Sans', sans-serif;
            --font-m: 'JetBrains Mono', monospace;
            --r: 10px;
            --r2: 14px;
            --r3: 18px;
            --sh: 0 4px 32px rgba(0,0,0,.45);
            --sh2: 0 8px 48px rgba(0,0,0,.6);
            --sidebar-w: 240px;
            --header-h: 56px;
        }

        *, *::before, *::after {
            box-sizing: border-box;
            -webkit-tap-highlight-color: transparent;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: var(--font-b);
            background: var(--bg);
            color: var(--text);
            overflow: hidden !important;
        }

        /* ─── Scrollbar ─── */
        ::-webkit-scrollbar {
            width: 4px;
        }

        ::-webkit-scrollbar-track {
            background: transparent;
        }

        ::-webkit-scrollbar-thumb {
            background: var(--surface3);
            border-radius: 10px;
        }

        /* ════════════════════════════
                           SIDEBAR
                        ════════════════════════════ */
        .menu-sidebar {
            background: var(--surface);
            width: var(--sidebar-w);
            position: fixed;
            height: 100vh;
            top: 0;
            left: 0;
            z-index: 1000;
            display: flex;
            flex-direction: column;
            border-right: 1px solid var(--border2);
            box-shadow: 4px 0 32px rgba(0,0,0,.4);
            transition: transform .3s ease;
        }

        /* ── Logo ── */
        .sidebar-logo {
            background: var(--surface2);
            padding: 18px 18px;
            border-bottom: 1px solid var(--border2);
            display: flex;
            align-items: center;
            gap: 12px;
            flex-shrink: 0;
            position: relative;
            overflow: hidden;
        }

            .sidebar-logo::after {
                content: '';
                position: absolute;
                top: 0;
                left: -100%;
                width: 200%;
                height: 100%;
                background: linear-gradient(90deg, transparent, rgba(255,255,255,.03), transparent);
                animation: sheen 5s infinite;
            }

        @@keyframes sheen {
            0% {
                left: -100%
            }

            100% {
                left: 100%
            }
        }

        .sidebar-logo-icon {
            width: 40px;
            height: 40px;
            background: linear-gradient(135deg, var(--accent) 0%, var(--accent2) 100%);
            border-radius: var(--r);
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            font-size: 16px;
            flex-shrink: 0;
            box-shadow: 0 4px 20px rgba(108,99,255,.4);
            position: relative;
            z-index: 1;
        }

        .sidebar-logo-text {
            position: relative;
            z-index: 1;
        }

            .sidebar-logo-text .name {
                font-family: var(--font-h);
                font-size: 16px;
                font-weight: 800;
                color: var(--text);
                letter-spacing: -.2px;
                line-height: 1;
                text-decoration: none;
                display: block;
            }

                .sidebar-logo-text .name span {
                    color: var(--accent);
                }

            .sidebar-logo-text .sub {
                font-family: var(--font-m);
                font-size: 9px;
                color: var(--text3);
                letter-spacing: 1px;
                margin-top: 3px;
            }

        /* ── Nav ── */
        .menu-sidebar__content {
            flex: 1;
            overflow-y: auto;
            overflow-x: hidden;
            padding: 14px 0;
            scrollbar-width: thin;
            scrollbar-color: var(--surface3) transparent;
        }

        .nav-section-label {
            font-family: var(--font-m);
            font-size: 9px;
            color: var(--text3);
            letter-spacing: 2px;
            text-transform: uppercase;
            padding: 10px 22px 6px;
        }

        .navbar__list {
            list-style: none;
            padding: 0;
            margin: 0;
        }

            .navbar__list > li {
                margin: 2px 10px;
            }

                .navbar__list > li > a {
                    display: flex;
                    align-items: center;
                    gap: 11px;
                    padding: 10px 14px;
                    color: var(--text2);
                    font-size: 13px;
                    font-weight: 500;
                    border-radius: var(--r);
                    text-decoration: none;
                    transition: all .2s ease;
                    border: 1px solid transparent;
                    font-family: var(--font-b);
                }

                    .navbar__list > li > a i {
                        font-size: 14px;
                        width: 20px;
                        text-align: center;
                        flex-shrink: 0;
                        opacity: .65;
                        transition: opacity .2s, color .2s;
                    }

                    .navbar__list > li > a:hover {
                        background: var(--surface2);
                        color: var(--text);
                        border-color: var(--border2);
                    }

                        .navbar__list > li > a:hover i {
                            opacity: 1;
                        }

                .navbar__list > li.active > a {
                    background: var(--active-nav);
                    color: #c5d4ff;
                    border-color: rgba(108,99,255,.3);
                    font-weight: 600;
                    box-shadow: 0 2px 14px rgba(108,99,255,.2);
                }

                    .navbar__list > li.active > a i {
                        opacity: 1;
                        color: var(--accent);
                    }

        /* ── Sidebar footer ── */
        .sidebar-footer {
            padding: 12px 10px;
            border-top: 1px solid var(--border);
            flex-shrink: 0;
        }

            .sidebar-footer a {
                display: flex;
                align-items: center;
                gap: 10px;
                padding: 9px 14px;
                color: rgba(244,63,94,.7);
                font-size: 13px;
                font-weight: 600;
                border-radius: var(--r);
                text-decoration: none;
                transition: all .2s;
                font-family: var(--font-b);
            }

                .sidebar-footer a:hover {
                    background: rgba(244,63,94,.1);
                    color: var(--danger);
                }

                .sidebar-footer a i {
                    font-size: 14px;
                    width: 20px;
                    text-align: center;
                }

        /* ════════════════════════════
                           PAGE CONTAINER
                        ════════════════════════════ */
        .page-container {
            padding-left: var(--sidebar-w);
            min-height: 100vh;
            overflow: hidden !important;
            transition: padding-left .3s ease;
            animation: fadeIn .3s ease;
        }

        /* ════════════════════════════
                           HEADER DESKTOP
                        ════════════════════════════ */
        .header-desktop {
            background: var(--surface2);
            border-bottom: 1px solid var(--border2);
            height: var(--header-h);
            display: flex;
            align-items: center;
            position: sticky;
            top: 0;
            z-index: 999;
            box-shadow: 0 2px 20px rgba(0,0,0,.3);
        }

        .header-wrap {
            display: flex;
            justify-content: flex-end;
            align-items: center;
            padding: 0 24px;
            width: 100%;
            gap: 12px;
        }

        .header-page-info {
            flex: 1;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .header-page-dot {
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: var(--accent);
            box-shadow: 0 0 8px var(--accent-glow);
        }

        .header-page-name {
            font-family: var(--font-m);
            font-size: 11px;
            color: var(--text3);
            letter-spacing: .5px;
        }

            .header-page-name span {
                color: var(--accent);
            }

        /* Account */
        .account-wrap {
            position: relative;
        }

        .account-item {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 7px 12px;
            border-radius: var(--r);
            cursor: pointer;
            transition: all .2s;
            border: 1px solid var(--border2);
            background: var(--surface3);
        }

            .account-item:hover {
                background: var(--active-nav);
                border-color: rgba(108,99,255,.3);
            }

        .account-avatar {
            width: 30px;
            height: 30px;
            border-radius: 8px;
            background: var(--active-nav);
            border: 1px solid rgba(108,99,255,.3);
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--accent);
            font-size: 13px;
            flex-shrink: 0;
        }

        .account-name {
            font-size: 13px;
            font-weight: 600;
            color: var(--text2);
            font-family: var(--font-b);
        }

        .account-chevron {
            font-size: 10px;
            color: var(--text3);
            transition: transform .2s;
        }

        .account-item.open .account-chevron {
            transform: rotate(180deg);
        }

        /* Dropdown */
        .account-dropdown {
            position: absolute;
            top: calc(100% + 8px);
            right: 0;
            background: var(--surface);
            border: 1px solid var(--border2);
            border-radius: var(--r2);
            box-shadow: var(--sh2);
            min-width: 220px;
            overflow: hidden;
            display: none;
            z-index: 9999;
            animation: fadeUp .2s ease both;
        }

            .account-dropdown.show {
                display: block;
            }

        .dropdown-header {
            padding: 16px 18px;
            background: var(--surface2);
            border-bottom: 1px solid var(--border);
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .dropdown-avatar {
            width: 38px;
            height: 38px;
            border-radius: var(--r);
            background: var(--active-nav);
            border: 1px solid rgba(108,99,255,.3);
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--accent);
            font-size: 16px;
            flex-shrink: 0;
        }

        .dropdown-user-name {
            font-family: var(--font-h);
            font-size: 14px;
            font-weight: 700;
            color: var(--text);
        }

        .dropdown-user-role {
            font-family: var(--font-m);
            font-size: 9.5px;
            color: var(--text3);
            letter-spacing: .5px;
            margin-top: 2px;
        }

        .dropdown-logout {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 13px 18px;
            color: rgba(244,63,94,.8);
            font-size: 13px;
            font-weight: 600;
            text-decoration: none;
            transition: all .2s;
            font-family: var(--font-b);
        }

            .dropdown-logout:hover {
                background: rgba(244,63,94,.08);
                color: var(--danger);
            }

            .dropdown-logout i {
                font-size: 14px;
            }

        /* ════════════════════════════
                           MOBILE HEADER
                        ════════════════════════════ */
        .header-mobile {
            background: var(--surface2);
            border-bottom: 1px solid var(--border2);
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            z-index: 1001;
            height: 56px;
            display: flex;
            align-items: center;
        }

        .header-mobile-inner {
            display: flex;
            justify-content: space-between;
            align-items: center;
            width: 100%;
            padding: 0 16px;
        }

        .mobile-logo {
            display: flex;
            align-items: center;
            gap: 10px;
            text-decoration: none;
        }

        .mobile-logo-icon {
            width: 34px;
            height: 34px;
            background: linear-gradient(135deg, var(--accent) 0%, var(--accent2) 100%);
            border-radius: var(--r);
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            font-size: 14px;
            box-shadow: 0 3px 12px rgba(108,99,255,.35);
        }

        .mobile-logo-text {
            font-family: var(--font-h);
            font-size: 15px;
            font-weight: 800;
            color: var(--text);
        }

            .mobile-logo-text span {
                color: var(--accent);
            }

        /* Hamburger */
        .hamburger {
            padding: 6px;
            background: var(--surface3);
            border: 1px solid var(--border2);
            border-radius: var(--r);
            cursor: pointer;
            display: inline-flex;
            flex-direction: column;
            gap: 5px;
            align-items: center;
            justify-content: center;
            width: 38px;
            height: 38px;
            transition: all .2s;
        }

            .hamburger:hover {
                background: var(--active-nav);
                border-color: rgba(108,99,255,.3);
            }

            .hamburger span {
                display: block;
                width: 18px;
                height: 2px;
                background: var(--text2);
                border-radius: 2px;
                transition: all .25s ease;
            }

            .hamburger.is-active span:nth-child(1) {
                transform: translateY(7px) rotate(45deg);
            }

            .hamburger.is-active span:nth-child(2) {
                opacity: 0;
                transform: scaleX(0);
            }

            .hamburger.is-active span:nth-child(3) {
                transform: translateY(-7px) rotate(-45deg);
            }

        /* Mobile nav */
        .navbar-mobile {
            position: fixed;
            top: 56px;
            left: 0;
            right: 0;
            bottom: 0;
            background: var(--surface);
            transform: translateX(-100%);
            transition: transform .28s ease;
            overflow-y: auto;
            z-index: 1000;
            border-right: 1px solid var(--border2);
            display: flex;
            flex-direction: column;
            max-width: 280px;
        }

            .navbar-mobile.show {
                transform: translateX(0);
            }

        .navbar-mobile__list {
            list-style: none;
            padding: 14px 10px;
            margin: 0;
            flex: 1;
        }

            .navbar-mobile__list li {
                margin: 2px 0;
            }

                .navbar-mobile__list li a {
                    display: flex;
                    align-items: center;
                    gap: 11px;
                    padding: 11px 14px;
                    color: var(--text2);
                    font-size: 13px;
                    font-weight: 500;
                    border-radius: var(--r);
                    text-decoration: none;
                    transition: all .2s;
                    border: 1px solid transparent;
                    font-family: var(--font-b);
                }

                    .navbar-mobile__list li a i {
                        font-size: 14px;
                        width: 20px;
                        text-align: center;
                        opacity: .65;
                    }

                    .navbar-mobile__list li a:hover {
                        background: var(--surface2);
                        color: var(--text);
                        border-color: var(--border2);
                    }

                .navbar-mobile__list li.active a {
                    background: var(--active-nav);
                    color: #c5d4ff;
                    border-color: rgba(108,99,255,.3);
                    font-weight: 600;
                }

                    .navbar-mobile__list li.active a i {
                        opacity: 1;
                        color: var(--accent);
                    }

        .mobile-nav-footer {
            padding: 12px 10px;
            border-top: 1px solid var(--border);
        }

            .mobile-nav-footer a {
                display: flex;
                align-items: center;
                gap: 10px;
                padding: 10px 14px;
                color: rgba(244,63,94,.7);
                font-size: 13px;
                font-weight: 600;
                border-radius: var(--r);
                text-decoration: none;
                transition: all .2s;
                font-family: var(--font-b);
            }

                .mobile-nav-footer a:hover {
                    background: rgba(244,63,94,.1);
                    color: var(--danger);
                }

                .mobile-nav-footer a i {
                    font-size: 14px;
                    width: 20px;
                    text-align: center;
                }

        .mobile-overlay {
            display: none;
            position: fixed;
            top: 56px;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0,0,0,.65);
            z-index: 999;
            backdrop-filter: blur(3px);
        }

            .mobile-overlay.show {
                display: block;
            }

        /* ════════════════════════════
                           MAIN CONTENT
                        ════════════════════════════ */
        .main-content {
            overflow: visible !important;
            display: contents;
        }

        .section__content--p30 {
            padding: 0;
            overflow: visible !important;
        }

        /* ─── Animations ─── */
        @@keyframes fadeIn {
            from {
                opacity: 0
            }

            to {
                opacity: 1
            }
        }

        @@keyframes fadeUp {
            from {
                opacity: 0;
                transform: translateY(8px)
            }

            to {
                opacity: 1;
                transform: translateY(0)
            }
        }

        /* ════════════════════════════
                           RESPONSIVE
                        ════════════════════════════ */
        @@media (max-width: 1024px) {
            .page-container {
                padding-left: 0;
            }

            .menu-sidebar {
                transform: translateX(-100%);
            }
        }

        @@media (max-width: 991px) {
            body {
                padding-top: 56px;
                overflow: auto !important;
            }

            .page-container {
                padding-left: 0;
                overflow: auto !important;
            }

            .header-desktop {
                display: none !important;
            }
        }

        @@media print {
            .header-mobile, .menu-sidebar {
                display: none !important;
            }

            .page-container {
                padding-left: 0 !important;
            }

            body {
                padding-top: 0 !important;
            }
        }
    </style>
</head>

<body>
    <div class="page-wrapper">

        <!-- ─── MOBILE HEADER ─── -->
        <header class="header-mobile d-block d-lg-none">
            <div class="header-mobile-inner">
                <a class="mobile-logo" href="/Home">
                    <div class="mobile-logo-icon"><i class="fas fa-shopping-cart"></i></div>
                    <div class="mobile-logo-text">Hello <span>B17</span></div>
                </a>
                <button class="hamburger" id="mobileMenuToggle" type="button">
                    <span></span><span></span><span></span>
                </button>
            </div>

            <!-- ② MOBILE NAV — SP se dynamically fill hoga -->
            <nav class="navbar-mobile" id="mobileMenu">
                <ul class="navbar-mobile__list" id="mobileNavList">
                    <li class="nav-skeleton"><a href="#"><i class="fas fa-circle-notch fa-spin"></i>Loading...</a></li>
                </ul>
                <div class="mobile-nav-footer">
                    <a href="#" id="mobileLogoutBtn"><i class="fas fa-arrow-right-from-bracket"></i>Logout</a>
                </div>
            </nav>
            <div class="mobile-overlay" id="mobileOverlay"></div>
        </header>
        <!-- END MOBILE HEADER -->
        <!-- ─── SIDEBAR ─── -->
        <aside class="menu-sidebar d-none d-lg-flex">
            <div class="sidebar-logo">
                <div class="sidebar-logo-icon"><i class="fas fa-shopping-cart"></i></div>
                <div class="sidebar-logo-text">
                    <a href="/Home" class="name">Hello <span>B17</span></a>
                    <div class="sub">// e-commerce portal</div>
                </div>
            </div>

            <!-- ① DESKTOP NAV — SP se dynamically fill hoga -->
            <div class="menu-sidebar__content">
                <nav class="navbar-sidebar">
                    <div class="nav-section-label">Main Menu</div>
                    <ul class="list-unstyled navbar__list" id="desktopNavList">
                        <li class="nav-skeleton"><a href="#"><i class="fas fa-circle-notch fa-spin"></i>Loading...</a></li>
                    </ul>
                </nav>
            </div>

            <div class="sidebar-footer">
                <a href="#" id="logoutBtn"><i class="fas fa-arrow-right-from-bracket"></i>Logout</a>
            </div>
        </aside>
        <!-- END SIDEBAR -->
        <!-- ─── PAGE CONTAINER ─── -->
        <div class="page-container">

            <!-- HEADER DESKTOP -->
            <header class="header-desktop d-none d-lg-flex">
                <div class="header-wrap">
                    <div class="header-page-info">
                        <div class="header-page-dot"></div>
                        <div class="header-page-name" id="headerPageName"><span>Dashboard</span></div>
                    </div>
                    <div class="account-wrap">
                        <div class="account-item js-item-menu" id="accountToggle">
                            <div class="account-avatar"><i class="fas fa-user"></i></div>
                            <div class="account-name" id="userName">Loading...</div>
                            <i class="fas fa-chevron-down account-chevron"></i>
                        </div>
                        <div class="account-dropdown js-dropdown" id="accountDropdown">
                            <div class="dropdown-header">
                                <div class="dropdown-avatar"><i class="fas fa-user"></i></div>
                                <div>
                                    <div class="dropdown-user-name" id="userNameDropdown">Loading...</div>
                                    <div class="dropdown-user-role">// administrator</div>
                                </div>
                            </div>
                            <a href="#" class="dropdown-logout" id="logoutBtnDropdown">
                                <i class="fas fa-arrow-right-from-bracket"></i> Sign Out
                            </a>
                        </div>
                    </div>
                </div>
            </header>
            <!-- END HEADER DESKTOP -->
            <!-- MAIN CONTENT -->
            <div class="main-content">
                @RenderBody()
            </div>
            <!-- END MAIN CONTENT -->

        </div>
        <!-- END PAGE CONTAINER -->

    </div>

    <!-- Scripts -->
    <script src="js/vanilla-utils.js"></script>
    <script src="vendor/bootstrap-5.3.8.bundle.min.js"></script>
    <script src="vendor/perfect-scrollbar/perfect-scrollbar-1.5.6.min.js"></script>
    <script src="vendor/chartjs/chart.umd.js-4.5.0.min.js"></script>
    <script src="js/bootstrap5-init.js"></script>
    <script src="js/main-vanilla.js"></script>
    <script src="js/swiper-bundle-11.2.10.min.js"></script>
    <script src="js/aos.js"></script>
    <script src="js/modern-plugins.js"></script>
    <script src="js/Layout.js"></script>

    <!-- ③ DYNAMIC MENU SCRIPT -->
    <script>
        document.addEventListener('DOMContentLoaded', async function () {

            /* ════════════════════════════════
               1. USER INFO  (localStorage se)
            ════════════════════════════════ */
            const userId = localStorage.getItem('userId') || 'admin';
            document.querySelectorAll('#userName, #userNameDropdown')
                    .forEach(el => el.textContent = userId);


            /* ════════════════════════════════
               2. SP CALL  →  Menu build karo
            ════════════════════════════════ */
            async function loadUserMenu() {
                try {
                    const res  = await fetch(`/Login/GetMenu?userId=${encodeURIComponent(userId)}`);
                    const json = await res.json();

                    if (!json.success || !json.data?.length) {
                        showFallbackMenu();
                        return;
                    }

                    buildNavItems(json.data);

                } catch (err) {
                    console.error('Menu load error:', err);
                    showFallbackMenu();
                }
            }

            /* ── Nav items DOM se banao ── */
            function buildNavItems(items) {
                const desktopUl = document.getElementById('desktopNavList');
                const mobileUl  = document.getElementById('mobileNavList');

                const makeItem = (item) => {
                    const li = document.createElement('li');
                    li.innerHTML = `<a href="${item.menuUrl}">
                                        <i class="${item.menuIcon}"></i>
                                        ${item.menuName}
                                    </a>`;
                    return li;
                };

                if (desktopUl) {
                    desktopUl.innerHTML = '';
                    items.forEach(item => desktopUl.appendChild(makeItem(item)));
                }

                if (mobileUl) {
                    mobileUl.innerHTML = '';
                    items.forEach(item => mobileUl.appendChild(makeItem(item)));
                }

                setActiveNavItem();
            }

            /* ── Fallback: SP fail ho to hardcoded menu ── */
            function showFallbackMenu() {
                const fallback = [
                    { menuName: 'Dashboard',        menuUrl: '/Home',               menuIcon: 'fas fa-gauge-high' },
                    { menuName: 'Slider',           menuUrl: '/Slider',             menuIcon: 'fas fa-images'     },
                    { menuName: 'Category',         menuUrl: '/Category',           menuIcon: 'fas fa-th-large'   },
                    { menuName: 'Product',          menuUrl: '/Product',            menuIcon: 'fas fa-box-open'   },
                    { menuName: 'Vendor',           menuUrl: '/VendorRegistration', menuIcon: 'fas fa-store'      },
                    { menuName: 'Barcode Printing', menuUrl: '/BarcodePrinting',    menuIcon: 'fas fa-barcode'    }
                ];
                buildNavItems(fallback);
            }


            /* ════════════════════════════════
               3. ACTIVE NAV ITEM  highlight
            ════════════════════════════════ */
            function setActiveNavItem() {
                const currentPath = window.location.pathname.toLowerCase();

                document.querySelectorAll('.navbar__list li, .navbar-mobile__list li')
                        .forEach(li => li.classList.remove('active'));

                document.querySelectorAll('.navbar__list a, .navbar-mobile__list a')
                        .forEach(a => {
                            const href = a.getAttribute('href')?.toLowerCase();
                            if (href && href !== '#' &&
                                (currentPath === href || currentPath.startsWith(href))) {
                                a.closest('li')?.classList.add('active');
                                const el = document.getElementById('headerPageName');
                                if (el) el.innerHTML = `<span>${a.textContent.trim()}</span>`;
                            }
                        });
            }


            /* ════════════════════════════════
               4. MENU LOAD — YE PEHLE CHALEGA
            ════════════════════════════════ */
            await loadUserMenu();


            /* ════════════════════════════════
               5. DESKTOP DROPDOWN
            ════════════════════════════════ */
            const accountToggle   = document.getElementById('accountToggle');
            const accountDropdown = document.getElementById('accountDropdown');

            if (accountToggle && accountDropdown) {
                accountToggle.addEventListener('click', function (e) {
                    e.stopPropagation();
                    const isOpen = accountDropdown.classList.toggle('show');
                    accountToggle.classList.toggle('open', isOpen);
                });
                document.addEventListener('click', () => {
                    accountDropdown.classList.remove('show');
                    accountToggle.classList.remove('open');
                });
                accountDropdown.addEventListener('click', e => e.stopPropagation());
            }


            /* ════════════════════════════════
               6. LOGOUT
            ════════════════════════════════ */
            function doLogout(e) {
                e.preventDefault();
                if (confirm('Are you sure you want to logout?')) {
                    localStorage.clear();
                    window.location.href = '/Login';
                }
            }
            document.getElementById('logoutBtn')?.addEventListener('click', doLogout);
            document.getElementById('logoutBtnDropdown')?.addEventListener('click', doLogout);
            document.getElementById('mobileLogoutBtn')?.addEventListener('click', doLogout);


            /* ════════════════════════════════
               7. MOBILE MENU
            ════════════════════════════════ */
            const mobileToggle  = document.getElementById('mobileMenuToggle');
            const mobileMenu    = document.getElementById('mobileMenu');
            const mobileOverlay = document.getElementById('mobileOverlay');

            function closeMobileMenu() {
                mobileToggle?.classList.remove('is-active');
                mobileMenu?.classList.remove('show');
                mobileOverlay?.classList.remove('show');
                document.body.style.overflow = '';
            }

            mobileToggle?.addEventListener('click', function () {
                const opening = !mobileMenu.classList.contains('show');
                this.classList.toggle('is-active', opening);
                mobileMenu.classList.toggle('show', opening);
                mobileOverlay.classList.toggle('show', opening);
                document.body.style.overflow = opening ? 'hidden' : '';
            });

            mobileOverlay?.addEventListener('click', closeMobileMenu);
            mobileMenu?.querySelectorAll('a:not(#mobileLogoutBtn)')
                      .forEach(a => a.addEventListener('click', closeMobileMenu));
            window.addEventListener('orientationchange', closeMobileMenu);


            /* ════════════════════════════════
               8. iOS double-tap fix
            ════════════════════════════════ */
            let lastTouch = 0;
            document.addEventListener('touchend', function (e) {
                const now = Date.now();
                if (now - lastTouch <= 300) e.preventDefault();
                lastTouch = now;
            }, { passive: false });

        });
    </script>

</body>
</html>
