<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title>@ViewData["Title"] </title>

    @await Html.PartialAsync("_CommonScripts")

    <link href="css/font-face.css" rel="stylesheet" media="all">
    <link href="vendor/fontawesome-7.0.1/css/all.min.css" rel="stylesheet" media="all">
    <link href="vendor/mdi-font/css/material-design-iconic-font.min.css" rel="stylesheet" media="all">
    <link href="vendor/bootstrap-5.3.8.min.css" rel="stylesheet" media="all">
    <link href="css/aos.css" rel="stylesheet" media="all">
    <link href="vendor/css-hamburgers/hamburgers.min.css" rel="stylesheet" media="all">
    <link href="css/swiper-bundle-11.2.10.min.css" rel="stylesheet" media="all">
    <link href="vendor/perfect-scrollbar/perfect-scrollbar-1.5.6.min.css" rel="stylesheet" media="all">
    <link href="css/theme.css" rel="stylesheet" media="all">
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;500;600;700;800&family=Rubik:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">

    <style>
        /* ════════════════════════════════════════════════════
                   STELLAR DASHBOARD — Blue Light Theme
                   Dark Sidebar + Light Content
                   MenuType: 0=Direct  1=Setup  2=Transaction
                ════════════════════════════════════════════════════ */
        :root {
            --sidebar-bg: #171c2a;
            --sidebar-bg2: #111622;
            --sidebar-w: 256px;
            --sidebar-border: rgba(255,255,255,.07);
            --sidebar-hover: rgba(255,255,255,.06);
            --header-h: 60px;
            --header-bg: #ffffff;
            --header-border: #eef0f6;
            --header-shadow: 0 2px 20px rgba(0,0,0,.07);
            --bg: #f0f3f8;
            --surface: #ffffff;
            --surface2: #f8f9fc;
            --surface3: #eef1f8;
            --border: #eef0f6;
            --border2: #e2e6f0;
            --blue: #4e9dff;
            --blue-dark: #2d7dd2;
            --blue-g: rgba(78,157,255,.12);
            --teal: #00c9a7;
            --coral: #ff6b6b;
            --amber: #f59e0b;
            --green: #10b981;
            --danger: #ef4444;
            --purple: #a78bfa;
            --text: #1e2a3a;
            --text2: #5a6478;
            --text3: #9ba3b8;
            --font-h: 'Rubik', sans-serif;
            --font-b: 'Nunito', sans-serif;
            --font-m: 'JetBrains Mono', monospace;
            --r: 8px;
            --r2: 12px;
            --r3: 16px;
            --sh: 0 2px 16px rgba(0,0,0,.06);
            --sh2: 0 8px 32px rgba(0,0,0,.14);
            /* Group theme colors */
            --c-setup: #4e9dff;
            --c-trans: #00c9a7;
            --c-direct: #a78bfa;
        }

        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: var(--font-b);
            background: var(--bg);
            color: var(--text);
            overflow: hidden !important;
        }

        ::-webkit-scrollbar {
            width: 4px;
            height: 4px;
        }

        ::-webkit-scrollbar-track {
            background: transparent;
        }

        ::-webkit-scrollbar-thumb {
            background: rgba(255,255,255,.10);
            border-radius: 10px;
        }

        /* ═══════════════════════════════════
                   SIDEBAR
                ═══════════════════════════════════ */
        .menu-sidebar {
            background: var(--sidebar-bg);
            width: var(--sidebar-w);
            position: fixed;
            height: 100vh;
            top: 0;
            left: 0;
            z-index: 1000;
            display: flex;
            flex-direction: column;
            transition: transform .32s cubic-bezier(.4,0,.2,1);
            overflow: hidden;
        }

            /* ambient glows */
            .menu-sidebar::before {
                content: '';
                position: absolute;
                top: -100px;
                right: -100px;
                width: 300px;
                height: 300px;
                background: radial-gradient(circle, rgba(78,157,255,.09) 0%, transparent 65%);
                pointer-events: none;
                z-index: 0;
            }

            .menu-sidebar::after {
                content: '';
                position: absolute;
                bottom: -80px;
                left: -60px;
                width: 240px;
                height: 240px;
                background: radial-gradient(circle, rgba(0,201,167,.06) 0%, transparent 65%);
                pointer-events: none;
                z-index: 0;
            }

        /* ── Logo ── */
        .sidebar-logo {
            background: var(--sidebar-bg2);
            padding: 0 18px;
            height: var(--header-h);
            border-bottom: 1px solid var(--sidebar-border);
            display: flex;
            align-items: center;
            gap: 12px;
            flex-shrink: 0;
            position: relative;
            z-index: 1;
            animation: fadeDown .4s ease both;
        }

        .sidebar-logo-icon {
            width: 38px;
            height: 38px;
            background: linear-gradient(135deg, var(--blue) 0%, var(--blue-dark) 100%);
            border-radius: var(--r);
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            font-size: 16px;
            flex-shrink: 0;
            box-shadow: 0 0 0 3px rgba(78,157,255,.20), 0 4px 14px rgba(78,157,255,.35);
            animation: logoPulse 3.5s ease-in-out infinite;
        }
        @@keyframes logoPulse {
            0%,100%

        {
            box-shadow: 0 0 0 3px rgba(78,157,255,.20), 0 4px 14px rgba(78,157,255,.35);
        }

        50% {
            box-shadow: 0 0 0 6px rgba(78,157,255,.08), 0 4px 18px rgba(78,157,255,.50);
        }

        }

        .sidebar-logo-text .name {
            font-family: var(--font-h);
            font-size: 16px;
            font-weight: 700;
            color: #fff;
            letter-spacing: -.2px;
            line-height: 1;
            text-decoration: none;
            display: block;
        }

        .sidebar-logo-text .sub {
            font-family: var(--font-m);
            font-size: 9px;
            color: rgba(255,255,255,.25);
            letter-spacing: 1.8px;
            margin-top: 3px;
            text-transform: uppercase;
        }

        /* ── Nav scroll container ── */
        .menu-sidebar__content {
            flex: 1;
            overflow-y: auto;
            overflow-x: hidden;
            padding: 12px 0 8px;
            scrollbar-width: thin;
            scrollbar-color: rgba(255,255,255,.06) transparent;
            position: relative;
            z-index: 1;
        }

        /* ── Group block ── */
        .nav-group {
            margin-bottom: 2px;
        }

        /* Group header (clickable toggle) */
        .nav-group-header {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 7px 14px 5px;
            cursor: pointer;
            user-select: none;
            transition: opacity .2s;
        }

            .nav-group-header:hover {
                opacity: .8;
            }

        /* Colored icon badge for group */
        .nav-group-icon {
            width: 18px;
            height: 18px;
            border-radius: 5px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 8px;
            font-weight: 700;
            flex-shrink: 0;
        }

            .nav-group-icon.setup {
                background: rgba(78,157,255,.18);
                color: var(--c-setup);
            }

            .nav-group-icon.transaction {
                background: rgba(0,201,167,.15);
                color: var(--c-trans);
            }

            .nav-group-icon.direct {
                background: rgba(167,139,250,.15);
                color: var(--c-direct);
            }

        /* Group title text */
        .nav-group-label {
            font-family: var(--font-m);
            font-size: 9px;
            font-weight: 600;
            letter-spacing: 2px;
            text-transform: uppercase;
            flex: 1;
        }

            .nav-group-label.setup {
                color: rgba(78,157,255,.55);
            }

            .nav-group-label.transaction {
                color: rgba(0,201,167,.50);
            }

            .nav-group-label.direct {
                color: rgba(167,139,250,.50);
            }

        /* Chevron rotate */
        .nav-group-chevron {
            font-size: 8px;
            color: rgba(255,255,255,.18);
            transition: transform .28s cubic-bezier(.4,0,.2,1);
        }

        .nav-group.collapsed .nav-group-chevron {
            transform: rotate(-90deg);
        }

        /* Thin accent line under group header */
        .nav-group-line {
            height: 1px;
            margin: 0 14px 6px;
            border-radius: 1px;
            opacity: .7;
        }

            .nav-group-line.setup {
                background: linear-gradient(90deg, rgba(78,157,255,.28), transparent);
            }

            .nav-group-line.transaction {
                background: linear-gradient(90deg, rgba(0,201,167,.24), transparent);
            }

            .nav-group-line.direct {
                background: linear-gradient(90deg, rgba(167,139,250,.22), transparent);
            }

        /* ── Animated items wrapper ── */
        .nav-group-items {
            overflow: hidden;
            transition: max-height .32s cubic-bezier(.4,0,.2,1), opacity .25s ease;
            max-height: 1000px;
            opacity: 1;
        }

        .nav-group.collapsed .nav-group-items {
            max-height: 0;
            opacity: 0;
        }

        /* ── Nav list ── */
        .navbar__list {
            list-style: none;
            padding: 0;
            margin: 0;
        }

            .navbar__list > li {
                margin: 1px 10px;
            }

                .navbar__list > li > a {
                    display: flex;
                    align-items: center;
                    gap: 10px;
                    padding: 9px 11px;
                    color: rgba(255,255,255,.48);
                    font-size: 13px;
                    font-weight: 600;
                    border-radius: var(--r);
                    text-decoration: none;
                    transition: background .18s ease, color .18s ease, transform .15s ease;
                    font-family: var(--font-b);
                    position: relative;
                }

                    /* Icon box */
                    .navbar__list > li > a .nav-icon {
                        width: 28px;
                        height: 28px;
                        border-radius: 7px;
                        display: flex;
                        align-items: center;
                        justify-content: center;
                        font-size: 12px;
                        flex-shrink: 0;
                        background: rgba(255,255,255,.06);
                        transition: background .2s, box-shadow .2s, color .2s;
                    }

                    .navbar__list > li > a .nav-text {
                        flex: 1;
                        white-space: nowrap;
                        overflow: hidden;
                        text-overflow: ellipsis;
                    }
                    /* arrow hint on hover */
                    .navbar__list > li > a .nav-arrow {
                        font-size: 8px;
                        color: rgba(255,255,255,.18);
                        opacity: 0;
                        transform: translateX(-4px);
                        transition: all .2s ease;
                    }

                    /* Hover */
                    .navbar__list > li > a:hover {
                        background: var(--sidebar-hover);
                        color: rgba(255,255,255,.85);
                        transform: translateX(2px);
                    }

                        .navbar__list > li > a:hover .nav-arrow {
                            opacity: 1;
                            transform: translateX(0);
                        }

                        .navbar__list > li > a:hover .nav-icon {
                            background: rgba(255,255,255,.10);
                        }

                /* ── Active item  ── */
                /* Left accent bar */
                .navbar__list > li.active > a::before {
                    content: '';
                    position: absolute;
                    left: -2px;
                    top: 20%;
                    bottom: 20%;
                    width: 3px;
                    border-radius: 0 3px 3px 0;
                }

                .navbar__list > li.active > a {
                    color: #ffffff;
                    font-weight: 700;
                    transform: translateX(2px);
                }

                    .navbar__list > li.active > a .nav-arrow {
                        opacity: 1;
                        transform: translateX(0);
                    }

        /* Setup group active */
        .nav-group.g-setup .navbar__list > li.active > a {
            background: rgba(78,157,255,.16);
        }

            .nav-group.g-setup .navbar__list > li.active > a .nav-icon {
                background: rgba(78,157,255,.26);
                color: var(--c-setup);
                box-shadow: 0 0 0 1px rgba(78,157,255,.30);
            }

            .nav-group.g-setup .navbar__list > li.active > a .nav-arrow {
                color: var(--c-setup);
            }

            .nav-group.g-setup .navbar__list > li.active > a::before {
                background: var(--c-setup);
            }

        /* Transaction group active */
        .nav-group.g-transaction .navbar__list > li.active > a {
            background: rgba(0,201,167,.14);
        }

            .nav-group.g-transaction .navbar__list > li.active > a .nav-icon {
                background: rgba(0,201,167,.22);
                color: var(--c-trans);
                box-shadow: 0 0 0 1px rgba(0,201,167,.28);
            }

            .nav-group.g-transaction .navbar__list > li.active > a .nav-arrow {
                color: var(--c-trans);
            }

            .nav-group.g-transaction .navbar__list > li.active > a::before {
                background: var(--c-trans);
            }

        /* Direct group active */
        .nav-group.g-direct .navbar__list > li.active > a {
            background: rgba(167,139,250,.14);
        }

            .nav-group.g-direct .navbar__list > li.active > a .nav-icon {
                background: rgba(167,139,250,.22);
                color: var(--c-direct);
                box-shadow: 0 0 0 1px rgba(167,139,250,.28);
            }

            .nav-group.g-direct .navbar__list > li.active > a .nav-arrow {
                color: var(--c-direct);
            }

            .nav-group.g-direct .navbar__list > li.active > a::before {
                background: var(--c-direct);
            }

        /* ── Item entry animation ── */
        @@keyframes navItemIn {
            from

        {
            opacity: 0;
            transform: translateX(-10px);
        }

        to {
            opacity: 1;
            transform: translateX(0);
        }

        }

        /* ── Sidebar footer ── */
        .sidebar-footer {
            padding: 10px;
            border-top: 1px solid var(--sidebar-border);
            flex-shrink: 0;
            position: relative;
            z-index: 1;
            background: var(--sidebar-bg2);
        }

            .sidebar-footer a {
                display: flex;
                align-items: center;
                gap: 10px;
                padding: 9px 13px;
                color: rgba(239,68,68,.55);
                font-size: 12.5px;
                font-weight: 600;
                border-radius: var(--r);
                text-decoration: none;
                transition: all .2s;
                font-family: var(--font-b);
            }

                .sidebar-footer a:hover {
                    background: rgba(239,68,68,.10);
                    color: var(--danger);
                }

                .sidebar-footer a .logout-icon {
                    width: 26px;
                    height: 26px;
                    border-radius: 6px;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    font-size: 11px;
                    background: rgba(239,68,68,.10);
                    color: rgba(239,68,68,.7);
                    transition: all .2s;
                }

                .sidebar-footer a:hover .logout-icon {
                    background: rgba(239,68,68,.18);
                    color: var(--danger);
                }

        /* ═══════════════════════════════════
                   PAGE CONTAINER
                ═══════════════════════════════════ */
        .page-container {
            padding-left: var(--sidebar-w);
            min-height: 100vh;
            overflow: hidden !important;
            transition: padding-left .32s cubic-bezier(.4,0,.2,1);
        }

        /* ═══════════════════════════════════
                   HEADER DESKTOP
                ═══════════════════════════════════ */
        .header-desktop {
            background: var(--header-bg);
            border-bottom: 1px solid var(--header-border);
            height: var(--header-h);
            display: flex;
            align-items: center;
            position: sticky;
            top: 0;
            z-index: 999;
            box-shadow: var(--header-shadow);
        }

        .header-wrap {
            display: flex;
            justify-content: flex-end;
            align-items: center;
            padding: 0 24px;
            width: 100%;
            gap: 10px;
        }

        .header-page-info {
            flex: 1;
            display: flex;
            align-items: center;
        }

        .header-breadcrumb {
            display: flex;
            align-items: center;
            gap: 6px;
        }

            .header-breadcrumb .bc-home {
                font-size: 13px;
                color: var(--text3);
                text-decoration: none;
                transition: color .2s;
            }

                .header-breadcrumb .bc-home:hover {
                    color: var(--blue);
                }

            .header-breadcrumb .bc-sep {
                font-size: 9px;
                color: var(--text3);
            }

            .header-breadcrumb .bc-current {
                font-family: var(--font-b);
                font-size: 13px;
                font-weight: 700;
                color: var(--text);
            }

        .header-actions {
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .hdr-search {
            display: flex;
            align-items: center;
            gap: 8px;
            background: var(--surface2);
            border: 1px solid var(--border2);
            border-radius: var(--r);
            padding: 0 12px;
            height: 38px;
            transition: all .2s;
        }

            .hdr-search:focus-within {
                border-color: var(--blue);
                box-shadow: 0 0 0 3px var(--blue-g);
                background: var(--surface);
            }

            .hdr-search i {
                font-size: 13px;
                color: var(--text3);
            }

            .hdr-search input {
                border: none;
                background: transparent;
                outline: none;
                font-family: var(--font-b);
                font-size: 13px;
                color: var(--text);
                width: 160px;
            }

                .hdr-search input::placeholder {
                    color: var(--text3);
                }

        .hdr-icon-btn {
            width: 38px;
            height: 38px;
            border-radius: var(--r);
            border: 1px solid var(--border2);
            background: var(--surface2);
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all .2s;
            color: var(--text2);
            font-size: 15px;
            position: relative;
            text-decoration: none;
        }

            .hdr-icon-btn:hover {
                background: var(--blue-g);
                border-color: var(--blue);
                color: var(--blue);
            }

        .hdr-badge {
            position: absolute;
            top: 6px;
            right: 6px;
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: var(--coral);
            border: 2px solid var(--surface);
            animation: badgePulse 2.2s ease-in-out infinite;
        }
        @@keyframes badgePulse {
            0%,100%

        {
            transform: scale(1);
        }

        50% {
            transform: scale(1.35);
        }

        }

        .account-wrap {
            position: relative;
        }

        .account-pill {
            display: flex;
            align-items: center;
            gap: 9px;
            padding: 5px 12px 5px 5px;
            border-radius: 50px;
            border: 1px solid var(--border2);
            background: var(--surface2);
            cursor: pointer;
            transition: all .2s;
        }

            .account-pill:hover {
                border-color: var(--blue);
                background: var(--blue-g);
            }

        .account-avatar {
            width: 30px;
            height: 30px;
            border-radius: 50%;
            background: linear-gradient(135deg, var(--blue) 0%, var(--blue-dark) 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            font-size: 12px;
            flex-shrink: 0;
        }

        .account-name {
            font-size: 13px;
            font-weight: 700;
            color: var(--text2);
            font-family: var(--font-b);
        }

        .account-chevron {
            font-size: 10px;
            color: var(--text3);
            transition: transform .25s;
        }

        .account-pill.open .account-chevron {
            transform: rotate(180deg);
        }

        .account-dropdown {
            position: absolute;
            top: calc(100% + 8px);
            right: 0;
            background: var(--surface);
            border: 1px solid var(--border2);
            border-radius: var(--r2);
            box-shadow: var(--sh2);
            min-width: 220px;
            overflow: hidden;
            display: none;
            z-index: 9999;
        }

            .account-dropdown.show {
                display: block;
                animation: dropIn .22s cubic-bezier(.4,0,.2,1) both;
            }
        @@keyframes dropIn {
            from

        {
            opacity: 0;
            transform: translateY(-8px) scale(.97);
        }

        to {
            opacity: 1;
            transform: translateY(0) scale(1);
        }

        }

        .dropdown-header {
            padding: 16px 18px;
            background: var(--surface2);
            border-bottom: 1px solid var(--border);
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .dropdown-avatar {
            width: 38px;
            height: 38px;
            border-radius: 50%;
            background: linear-gradient(135deg, var(--blue) 0%, var(--blue-dark) 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            font-size: 16px;
        }

        .dropdown-user-name {
            font-family: var(--font-h);
            font-size: 14px;
            font-weight: 600;
            color: var(--text);
        }

        .dropdown-user-role {
            font-family: var(--font-m);
            font-size: 9.5px;
            color: var(--text3);
            letter-spacing: .5px;
            margin-top: 2px;
        }

        .dropdown-logout {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 13px 18px;
            color: rgba(239,68,68,.8);
            font-size: 13px;
            font-weight: 600;
            text-decoration: none;
            transition: all .2s;
            font-family: var(--font-b);
        }

            .dropdown-logout:hover {
                background: rgba(239,68,68,.07);
                color: var(--danger);
            }

        /* ═══════════════════════════════════
                   MOBILE HEADER
                ═══════════════════════════════════ */
        .header-mobile {
            background: var(--sidebar-bg);
            border-bottom: 1px solid var(--sidebar-border);
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            z-index: 1001;
            height: 56px;
            display: flex;
            align-items: center;
        }

        .header-mobile-inner {
            display: flex;
            justify-content: space-between;
            align-items: center;
            width: 100%;
            padding: 0 16px;
        }

        .mobile-logo {
            display: flex;
            align-items: center;
            gap: 10px;
            text-decoration: none;
        }

        .mobile-logo-icon {
            width: 34px;
            height: 34px;
            background: linear-gradient(135deg, var(--blue) 0%, var(--blue-dark) 100%);
            border-radius: var(--r);
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            font-size: 14px;
        }

        .mobile-logo-text {
            font-family: var(--font-h);
            font-size: 15px;
            font-weight: 700;
            color: #fff;
        }

            .mobile-logo-text span {
                color: var(--blue);
            }

        .hamburger {
            padding: 6px;
            background: rgba(255,255,255,.08);
            border: 1px solid rgba(255,255,255,.12);
            border-radius: var(--r);
            cursor: pointer;
            display: inline-flex;
            flex-direction: column;
            gap: 5px;
            align-items: center;
            justify-content: center;
            width: 38px;
            height: 38px;
            transition: all .2s;
        }

            .hamburger:hover {
                background: rgba(255,255,255,.14);
            }

            .hamburger span {
                display: block;
                width: 18px;
                height: 2px;
                background: rgba(255,255,255,.8);
                border-radius: 2px;
                transition: all .25s ease;
            }

            .hamburger.is-active span:nth-child(1) {
                transform: translateY(7px) rotate(45deg);
            }

            .hamburger.is-active span:nth-child(2) {
                opacity: 0;
                transform: scaleX(0);
            }

            .hamburger.is-active span:nth-child(3) {
                transform: translateY(-7px) rotate(-45deg);
            }

        .navbar-mobile {
            position: fixed;
            top: 56px;
            left: 0;
            right: 0;
            bottom: 0;
            background: var(--sidebar-bg);
            transform: translateX(-100%);
            transition: transform .28s cubic-bezier(.4,0,.2,1);
            overflow-y: auto;
            z-index: 1000;
            display: flex;
            flex-direction: column;
            max-width: 290px;
        }

            .navbar-mobile.show {
                transform: translateX(0);
            }

        .navbar-mobile__content {
            flex: 1;
            padding: 14px 0 8px;
        }

        .navbar-mobile__list {
            list-style: none;
            padding: 0;
            margin: 0;
        }

            .navbar-mobile__list li {
                margin: 1px 10px;
            }

                .navbar-mobile__list li a {
                    display: flex;
                    align-items: center;
                    gap: 10px;
                    padding: 11px 12px;
                    color: rgba(255,255,255,.48);
                    font-size: 13px;
                    font-weight: 600;
                    border-radius: var(--r);
                    text-decoration: none;
                    transition: all .2s;
                    font-family: var(--font-b);
                }

                    .navbar-mobile__list li a .nav-icon {
                        width: 28px;
                        height: 28px;
                        border-radius: 7px;
                        display: flex;
                        align-items: center;
                        justify-content: center;
                        font-size: 12px;
                        flex-shrink: 0;
                        background: rgba(255,255,255,.06);
                        transition: all .2s;
                    }

                    .navbar-mobile__list li a:hover {
                        background: rgba(255,255,255,.06);
                        color: rgba(255,255,255,.88);
                    }

                .navbar-mobile__list li.active a {
                    background: rgba(78,157,255,.15);
                    color: #fff;
                }

                    .navbar-mobile__list li.active a .nav-icon {
                        background: rgba(78,157,255,.25);
                        color: var(--blue);
                    }

        .mobile-nav-section-label {
            font-family: var(--font-m);
            font-size: 9px;
            font-weight: 600;
            letter-spacing: 2px;
            text-transform: uppercase;
            padding: 10px 14px 5px;
            display: flex;
            align-items: center;
            gap: 7px;
        }

            .mobile-nav-section-label.setup {
                color: rgba(78,157,255,.50);
            }

            .mobile-nav-section-label.transaction {
                color: rgba(0,201,167,.46);
            }

            .mobile-nav-section-label.direct {
                color: rgba(167,139,250,.46);
            }

            .mobile-nav-section-label::before {
                content: '';
                display: block;
                width: 14px;
                height: 1px;
                border-radius: 1px;
                flex-shrink: 0;
            }

            .mobile-nav-section-label.setup::before {
                background: rgba(78,157,255,.40);
            }

            .mobile-nav-section-label.transaction::before {
                background: rgba(0,201,167,.38);
            }

            .mobile-nav-section-label.direct::before {
                background: rgba(167,139,250,.38);
            }

        .mobile-nav-footer {
            padding: 12px 10px;
            border-top: 1px solid var(--sidebar-border);
            background: var(--sidebar-bg2);
        }

            .mobile-nav-footer a {
                display: flex;
                align-items: center;
                gap: 10px;
                padding: 10px 14px;
                color: rgba(239,68,68,.7);
                font-size: 13px;
                font-weight: 600;
                border-radius: var(--r);
                text-decoration: none;
                transition: all .2s;
                font-family: var(--font-b);
            }

                .mobile-nav-footer a:hover {
                    background: rgba(239,68,68,.1);
                    color: var(--danger);
                }

                .mobile-nav-footer a .nav-icon {
                    width: 26px;
                    height: 26px;
                    border-radius: 6px;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    font-size: 11px;
                    background: rgba(239,68,68,.10);
                    color: rgba(239,68,68,.7);
                    transition: all .2s;
                }

                .mobile-nav-footer a:hover .nav-icon {
                    background: rgba(239,68,68,.18);
                    color: var(--danger);
                }

        .mobile-overlay {
            display: none;
            position: fixed;
            top: 56px;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0,0,0,.48);
            z-index: 999;
            backdrop-filter: blur(3px);
        }

            .mobile-overlay.show {
                display: block;
            }

        /* ─── Skeleton placeholders ─── */
        @@keyframes skelPulse {
            0%,100%

        {
            opacity: .3;
        }

        50% {
            opacity: .7;
        }

        }

        .skel-block {
            border-radius: 6px;
            background: rgba(255,255,255,.08);
            animation: skelPulse 1.5s ease-in-out infinite;
        }

        /* ═══════════════════════════════════
                   MAIN CONTENT
                ═══════════════════════════════════ */
        .main-content {
            overflow: visible !important;
            display: contents;
        }

        .section__content--p30 {
            padding: 0;
            overflow: visible !important;
        }

        /* ── Global keyframes ── */
        @@keyframes fadeDown {
            from

        {
            opacity: 0;
            transform: translateY(-14px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }

        }
        @@keyframes fadeUp {
            from

        {
            opacity: 0;
            transform: translateY(8px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }

        }

        /* ═══════════════════════════════════
                   RESPONSIVE
                ═══════════════════════════════════ */
        @@media (max-width: 1024px) {
            .page-container {
                padding-left: 0;
            }

            .menu-sidebar {
                transform: translateX(-100%);
            }
        }

        @@media (max-width: 991px) {
            body {
                padding-top: 56px;
                overflow: auto !important;
            }

            .page-container {
                padding-left: 0;
                overflow: auto !important;
            }

            .header-desktop {
                display: none !important;
            }
        }

        @@media print {
            .header-mobile, .menu-sidebar {
                display: none !important;
            }

            .page-container {
                padding-left: 0 !important;
            }

            body {
                padding-top: 0 !important;
            }
        }
    </style>
</head>

<body>
    <div class="page-wrapper">

        <!-- ─── MOBILE HEADER ─── -->
        <header class="header-mobile d-block d-lg-none">
            <div class="header-mobile-inner">
