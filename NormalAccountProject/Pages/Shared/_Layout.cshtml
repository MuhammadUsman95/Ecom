    <!-- Scripts -->
    <script src="js/vanilla-utils.js"></script>
    <script src="vendor/bootstrap-5.3.8.bundle.min.js"></script>
    <script src="vendor/perfect-scrollbar/perfect-scrollbar-1.5.6.min.js"></script>
    <script src="vendor/chartjs/chart.umd.js-4.5.0.min.js"></script>
    <script src="js/bootstrap5-init.js"></script>
    <script src="js/main-vanilla.js"></script>
    <script src="js/swiper-bundle-11.2.10.min.js"></script>
    <script src="js/aos.js"></script>
    <script src="js/modern-plugins.js"></script>
    <script src="js/Layout.js"></script>

    <!-- ════════════════════════════════════════════════════
         DYNAMIC MENU SCRIPT
         MenuType:
           0 = Direct   → shown under "Quick Access" (purple)
           1 = Setup    → shown under "Setup" (blue)
           2 = Transaction → shown under "Transactions" (teal)
    ════════════════════════════════════════════════════ -->
    <script>
        document.addEventListener('DOMContentLoaded', async function () {

            /* ── User identity ── */
            const userId = localStorage.getItem('userId') || 'admin';
            document.querySelectorAll('#userName, #userNameDropdown')
                    .forEach(el => el.textContent = userId);

            /* ══════════════════════════════════════
               GROUP CONFIG
               key   = menuType value from DB
               label = group title
               cls   = CSS class for color theming
               icon  = FontAwesome class for badge
            ══════════════════════════════════════ */
            const GROUP_CONFIG = {
                0: { label: 'Quick Access',   cls: 'direct',      icon: 'fas fa-bolt'         },
                1: { label: 'Setup',          cls: 'setup',        icon: 'fas fa-sliders'      },
                2: { label: 'Transactions',   cls: 'transaction',  icon: 'fas fa-arrows-rotate'}
            };

            /* ══════════════════════════════════════
               LOAD MENU FROM API
            ══════════════════════════════════════ */
            async function loadUserMenu() {
                try {
                    const res  = await fetch(`/Login/GetMenu?userId=${encodeURIComponent(userId)}`);
                    const json = await res.json();
                    if (!json.success || !json.data?.length) { showFallbackMenu(); return; }
                    buildMenu(json.data);
                } catch (err) {
                    console.error('Menu load error:', err);
                    showFallbackMenu();
                }
            }

            /* ══════════════════════════════════════
               FALLBACK MENU  (menuType hard-coded)
            ══════════════════════════════════════ */
            function showFallbackMenu() {
                buildMenu([
                    { menuName: 'Dashboard',        menuUrl: '/Home',               menuIcon: 'fas fa-gauge-high',  menuType: 0 },
                    { menuName: 'Slider',           menuUrl: '/Slider',             menuIcon: 'fas fa-images',      menuType: 1 },
                    { menuName: 'Category',         menuUrl: '/Category',           menuIcon: 'fas fa-th-large',    menuType: 1 },
                    { menuName: 'Product',          menuUrl: '/Product',            menuIcon: 'fas fa-box-open',    menuType: 1 },
                    { menuName: 'Product Info',     menuUrl: '/ProductInfo',        menuIcon: 'fas fa-tags',        menuType: 1 },
                    { menuName: 'Vendor',           menuUrl: '/VendorRegistration', menuIcon: 'fas fa-store',       menuType: 1 },
                    { menuName: 'Customer',         menuUrl: '/Customer',           menuIcon: 'fas fa-user-tie',    menuType: 1 },
                    { menuName: 'Barcode Printing', menuUrl: '/BarcodePrinting',    menuIcon: 'fas fa-barcode',     menuType: 1 },
                    { menuName: 'Purchase Invoice', menuUrl: '/PurchaseInvoice',    menuIcon: 'fas fa-cart-shopping',menuType: 2 },
                    { menuName: 'Sales Invoice',    menuUrl: '/SaleInvoice',        menuIcon: 'fas fa-file-invoice', menuType: 2 },
                ]);
            }

            /* ══════════════════════════════════════
               BUILD DESKTOP GROUPED MENU
            ══════════════════════════════════════ */
            function buildMenu(items) {
                /* --- Group items by menuType --- */
                const groups = {};
                items.forEach(item => {
                    const t = item.menuType ?? 0;
                    if (!groups[t]) groups[t] = [];
                    groups[t].push(item);
                });

                /* ── DESKTOP ── */
                const container = document.getElementById('desktopNavContainer');
                container.innerHTML = '';

                /* Render in order: 0 first, then 1, then 2 */
                [0, 1, 2].forEach(typeKey => {
                    if (!groups[typeKey] || groups[typeKey].length === 0) return;
                    const cfg = GROUP_CONFIG[typeKey] || GROUP_CONFIG[0];

                    const groupEl = document.createElement('div');
                    groupEl.className = `nav-group g-${cfg.cls}`;
                    groupEl.dataset.type = typeKey;

                    /* Group header */
                    groupEl.innerHTML = `
                        <div class="nav-group-header">
                            <div class="nav-group-icon ${cfg.cls}">
                                <i class="${cfg.icon}"></i>
                            </div>
                            <span class="nav-group-label ${cfg.cls}">${cfg.label}</span>
                            <i class="fas fa-chevron-down nav-group-chevron"></i>
                        </div>
                        <div class="nav-group-line ${cfg.cls}"></div>
                        <div class="nav-group-items">
                            <ul class="navbar__list" id="navList-${typeKey}"></ul>
                        </div>
                    `;
                    container.appendChild(groupEl);

                    /* Items */
                    const ul = groupEl.querySelector(`#navList-${typeKey}`);
                    groups[typeKey].forEach((item, idx) => {
                        const li = document.createElement('li');
                        li.style.setProperty('--delay', `${idx * 0.05}s`);
                        li.style.animation = `navItemIn .32s ease ${idx * 0.05}s both`;
                        li.innerHTML = `
                            <a href="${item.menuUrl}">
                                <div class="nav-icon"><i class="${item.menuIcon}"></i></div>
                                <span class="nav-text">${item.menuName}</span>
                                <i class="fas fa-chevron-right nav-arrow"></i>
                            </a>
                        `;
                        ul.appendChild(li);
                    });

                    /* Collapse toggle */
                    groupEl.querySelector('.nav-group-header').addEventListener('click', function () {
                        groupEl.classList.toggle('collapsed');
                        /* persist collapsed state */
                        try {
                            const key = `navCollapsed_${typeKey}`;
                            localStorage.setItem(key, groupEl.classList.contains('collapsed') ? '1' : '0');
                        } catch(e) {}
                    });

                    /* Restore collapsed state */
                    try {
                        const saved = localStorage.getItem(`navCollapsed_${typeKey}`);
                        if (saved === '1') groupEl.classList.add('collapsed');
                    } catch(e) {}
                });

                /* ── MOBILE ── */
                buildMobileMenu(groups);

                /* ── Set active ── */
                setActiveNavItem();
            }

            /* ══════════════════════════════════════
               BUILD MOBILE FLAT MENU
               (same groups but no toggle — always visible)
            ══════════════════════════════════════ */
            function buildMobileMenu(groups) {
                const mobileUl = document.getElementById('mobileNavList');
                mobileUl.innerHTML = '';

                [0, 1, 2].forEach(typeKey => {
                    if (!groups[typeKey] || groups[typeKey].length === 0) return;
                    const cfg = GROUP_CONFIG[typeKey] || GROUP_CONFIG[0];

                    /* Section label */
                    const labelLi = document.createElement('li');
                    labelLi.innerHTML = `
                        <div class="mobile-nav-section-label ${cfg.cls}">
                            ${cfg.label}
                        </div>
                    `;
                    mobileUl.appendChild(labelLi);

                    /* Items */
                    groups[typeKey].forEach(item => {
                        const li = document.createElement('li');
                        li.innerHTML = `
                            <a href="${item.menuUrl}">
                                <div class="nav-icon"><i class="${item.menuIcon}"></i></div>
                                <span>${item.menuName}</span>
                            </a>
                        `;
                        mobileUl.appendChild(li);
                    });
                });

                setActiveNavItem();
            }

            /* ══════════════════════════════════════
               ACTIVE NAV ITEM
            ══════════════════════════════════════ */
            function setActiveNavItem() {
                const cur = window.location.pathname.toLowerCase();
                document.querySelectorAll(
                    '.navbar__list li, .navbar-mobile__list li'
                ).forEach(li => li.classList.remove('active'));

                document.querySelectorAll(
                    '.navbar__list a, .navbar-mobile__list a'
                ).forEach(a => {
                    const href = (a.getAttribute('href') || '').toLowerCase();
                    if (href && href !== '#' && (cur === href || cur.startsWith(href + '/'))) {
                        a.closest('li')?.classList.add('active');
                        const pg = document.getElementById('headerPageName');
                        if (pg) pg.textContent = a.querySelector('.nav-text')?.textContent || a.textContent.trim();
                    }
                });
            }

            /* ── Load menu ── */
            await loadUserMenu();

            /* ══════════════════════════════════════
               ACCOUNT DROPDOWN
            ══════════════════════════════════════ */
            const accountToggle   = document.getElementById('accountToggle');
            const accountDropdown = document.getElementById('accountDropdown');

            if (accountToggle && accountDropdown) {
                accountToggle.addEventListener('click', function (e) {
                    e.stopPropagation();
                    const open = accountDropdown.classList.toggle('show');
                    accountToggle.classList.toggle('open', open);
                });
                document.addEventListener('click', () => {
                    accountDropdown.classList.remove('show');
                    accountToggle?.classList.remove('open');
                });
                accountDropdown.addEventListener('click', e => e.stopPropagation());
            }

            /* ══════════════════════════════════════
               LOGOUT
            ══════════════════════════════════════ */
            function doLogout(e) {
                e.preventDefault();
                if (confirm('Are you sure you want to logout?')) {
                    localStorage.clear();
                    window.location.href = '/Login';
                }
            }
            document.getElementById('logoutBtn')?.addEventListener('click', doLogout);
            document.getElementById('logoutBtnDropdown')?.addEventListener('click', doLogout);
            document.getElementById('mobileLogoutBtn')?.addEventListener('click', doLogout);

            /* ══════════════════════════════════════
               MOBILE NAV TOGGLE
            ══════════════════════════════════════ */
            const mobileToggle  = document.getElementById('mobileMenuToggle');
            const mobileMenu    = document.getElementById('mobileMenu');
            const mobileOverlay = document.getElementById('mobileOverlay');

            function closeMobileMenu() {
                mobileToggle?.classList.remove('is-active');
                mobileMenu?.classList.remove('show');
                mobileOverlay?.classList.remove('show');
                document.body.style.overflow = '';
            }

            mobileToggle?.addEventListener('click', function () {
                const opening = !mobileMenu.classList.contains('show');
                this.classList.toggle('is-active', opening);
                mobileMenu.classList.toggle('show', opening);
                mobileOverlay.classList.toggle('show', opening);
                document.body.style.overflow = opening ? 'hidden' : '';
            });

            mobileOverlay?.addEventListener('click', closeMobileMenu);
            mobileMenu?.querySelectorAll('a:not(#mobileLogoutBtn)').forEach(a => {
                a.addEventListener('click', closeMobileMenu);
            });
            window.addEventListener('orientationchange', closeMobileMenu);

            /* prevent iOS double-tap zoom */
            let lastTouch = 0;
            document.addEventListener('touchend', function (e) {
                const now = Date.now();
                if (now - lastTouch <= 300) e.preventDefault();
                lastTouch = now;
            }, { passive: false });

        });
    </script>

</body>
</html>
