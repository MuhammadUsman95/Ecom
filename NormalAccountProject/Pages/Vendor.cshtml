@page "/Vendor"
@model NormalAccountProject.Pages.VendorModel
@{
    ViewData["Title"] = "Vendor Registration";
}

<link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;500;600;700;800&family=Rubik:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">

<style>
    :root {
        --bg: #f0f3f8;
        --surface: #ffffff;
        --surface2: #f8f9fc;
        --surface3: #eef1f8;
        --border: #eef0f6;
        --border2: #e2e6f0;
        --border3: #d4d9e8;
        --blue: #4e9dff;
        --blue-dark: #2d7dd2;
        --blue-g: rgba(78,157,255,.10);
        --blue-g2: rgba(78,157,255,.06);
        --teal: #00c9a7;
        --coral: #ff6b6b;
        --amber: #f59e0b;
        --green: #10b981;
        --danger: #ef4444;
        --text: #1e2a3a;
        --text2: #5a6478;
        --text3: #9ba3b8;
        --font-h: 'Rubik', sans-serif;
        --font-b: 'Nunito', sans-serif;
        --font-m: 'JetBrains Mono', monospace;
        --r: 8px;
        --r2: 12px;
        --r3: 16px;
        --sh: 0 2px 12px rgba(0,0,0,.06);
        --sh2: 0 4px 24px rgba(0,0,0,.09);
    }

    *, *::before, *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    .sr-root {
        font-family: var(--font-b);
        color: var(--text);
        background: var(--bg);
        min-height: calc(100vh - 60px);
        padding: 24px 28px 20px;
        overflow-y: auto;
        overflow-x: hidden;
        scrollbar-width: thin;
        scrollbar-color: var(--border2) transparent;
    }

    .sr-inner {
        max-width: 1400px;
        margin: 0 auto;
    }

    .page-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 22px;
        animation: fadeDown .4s ease both;
    }

    .ph-left {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .ph-icon {
        width: 46px;
        height: 46px;
        background: linear-gradient(135deg, var(--blue) 0%, var(--blue-dark) 100%);
        border-radius: var(--r2);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        font-size: 18px;
        box-shadow: 0 4px 16px rgba(78,157,255,.35);
        flex-shrink: 0;
    }

    .ph-title {
        font-family: var(--font-h);
        font-size: 21px;
        font-weight: 700;
        color: var(--text);
        line-height: 1.1;
    }

        .ph-title span {
            color: var(--blue);
        }

    .ph-breadcrumb {
        display: flex;
        align-items: center;
        gap: 5px;
        font-family: var(--font-m);
        font-size: 10px;
        color: var(--text3);
        letter-spacing: .4px;
        margin-top: 3px;
    }

        .ph-breadcrumb i {
            font-size: 7px;
        }

        .ph-breadcrumb .bc-cur {
            color: var(--blue);
            font-weight: 500;
        }

    .view-toggle {
        display: flex;
        gap: 4px;
        background: var(--surface);
        padding: 4px;
        border-radius: var(--r);
        border: 1px solid var(--border2);
        box-shadow: var(--sh);
    }

    .vt-btn {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 8px 16px;
        font-family: var(--font-b);
        font-size: 12.5px;
        font-weight: 700;
        border-radius: 6px;
        border: none;
        cursor: pointer;
        transition: all .2s ease;
    }

    .vt-btn-ghost {
        background: transparent;
        color: var(--text2);
    }

        .vt-btn-ghost:hover {
            background: var(--surface3);
            color: var(--text);
        }

    .vt-btn-active {
        background: linear-gradient(135deg, var(--blue) 0%, var(--blue-dark) 100%);
        color: #fff;
        box-shadow: 0 2px 10px rgba(78,157,255,.30);
    }

        .vt-btn-active:hover {
            transform: translateY(-1px);
        }

    .divider {
        display: flex;
        gap: 3px;
        height: 3px;
        margin-bottom: 20px;
        border-radius: 3px;
        overflow: hidden;
    }

        .divider span:nth-child(1) {
            flex: 3;
            background: var(--blue);
        }

        .divider span:nth-child(2) {
            flex: 1;
            background: var(--teal);
            opacity: .6;
        }

        .divider span:nth-child(3) {
            flex: 8;
            background: var(--border2);
        }

    .form-card {
        background: var(--surface);
        border-radius: var(--r3);
        border: 1px solid var(--border2);
        box-shadow: var(--sh2);
        overflow: hidden;
        animation: slideUp .35s cubic-bezier(.22,1,.36,1) both;
    }

    .fc-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 14px 22px;
        background: var(--surface2);
        border-bottom: 1px solid var(--border2);
        border-top: 3px solid var(--blue);
    }

    .fc-header-left {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .fc-icon {
        width: 32px;
        height: 32px;
        border-radius: var(--r);
        background: var(--blue-g);
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--blue);
        font-size: 13px;
    }

    .fc-title {
        font-family: var(--font-h);
        font-size: 14px;
        font-weight: 600;
        color: var(--text);
    }

    .fc-sub {
        font-size: 11px;
        color: var(--text3);
        font-weight: 500;
        margin-top: 1px;
    }

    .status-pill {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 4px 12px;
        border-radius: 20px;
        font-family: var(--font-m);
        font-size: 10.5px;
        font-weight: 500;
    }

    .pill-live {
        background: rgba(16,185,129,.10);
        color: var(--green);
        border: 1px solid rgba(16,185,129,.25);
    }

        .pill-live::before {
            content: '';
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: var(--green);
            animation: blink 1.8s ease-in-out infinite;
        }
    @@keyframes blink {
        0%,100%

    {
        opacity: 1
    }

    50% {
        opacity: .3
    }

    }

    .fc-body {
        padding: 24px 26px;
        max-height: 68vh;
        overflow-y: auto;
        scrollbar-width: thin;
        scrollbar-color: var(--border2) transparent;
    }

        .fc-body::-webkit-scrollbar {
            width: 4px;
        }

        .fc-body::-webkit-scrollbar-thumb {
            background: var(--border2);
            border-radius: 10px;
        }

    .sec-label {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 14px;
        padding-bottom: 10px;
        border-bottom: 1px dashed var(--border2);
    }

    .sec-label-bar {
        width: 3px;
        height: 14px;
        border-radius: 3px;
        flex-shrink: 0;
    }

    .slb-blue {
        background: linear-gradient(180deg, var(--blue), var(--teal));
    }

    .sec-label-txt {
        font-family: var(--font-m);
        font-size: 9.5px;
        font-weight: 500;
        color: var(--text3);
        letter-spacing: 2px;
        text-transform: uppercase;
    }

    .frow {
        display: grid;
        gap: 14px;
        margin-bottom: 14px;
    }

    .frow-1 {
        grid-template-columns: 1fr;
    }

    .frow-2 {
        grid-template-columns: 1fr 1fr;
    }

    .fg {
        position: relative;
    }

        .fg .fc {
            padding: 22px 14px 8px;
        }

    .fl {
        position: absolute;
        left: 14px;
        top: 50%;
        transform: translateY(-50%);
        font-family: var(--font-b);
        font-size: 13px;
        font-weight: 600;
        color: var(--text3);
        pointer-events: none;
        transition: top .18s,transform .18s,font-size .18s,color .18s,letter-spacing .18s;
        white-space: nowrap;
    }

    .fg .fc:focus ~ .fl, .fg.has-value .fl {
        top: 7px;
        transform: none;
        font-size: 9px;
        font-family: var(--font-m);
        color: var(--blue);
        letter-spacing: 1px;
        text-transform: uppercase;
        font-weight: 500;
    }

    .fg .fc::placeholder {
        color: transparent;
    }

    .fc {
        border: 1px solid var(--border2);
        border-radius: var(--r);
        padding: 10px 14px;
        font-size: 13.5px;
        font-family: var(--font-b);
        font-weight: 600;
        color: var(--text) !important;
        background: var(--surface);
        transition: border-color .2s, box-shadow .2s, background .2s;
        outline: none;
        width: 100%;
        -webkit-text-fill-color: var(--text) !important;
        caret-color: var(--blue);
    }

        .fc:focus {
            border-color: var(--blue);
            box-shadow: 0 0 0 3px var(--blue-g);
            background: #fff;
        }

        .fc[readonly] {
            background: var(--surface2) !important;
            color: var(--text3) !important;
            -webkit-text-fill-color: var(--text3) !important;
            cursor: default;
            border-style: dashed;
        }

    .status-meta {
        font-family: var(--font-m);
        font-size: 9.5px;
        color: var(--text3);
        letter-spacing: 1px;
        text-transform: uppercase;
        margin-bottom: 8px;
        display: flex;
        align-items: center;
        gap: 5px;
    }

        .status-meta i {
            color: var(--blue);
        }

    .check-group {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 11px 16px;
        background: var(--surface2);
        border-radius: var(--r);
        border: 1px solid var(--border2);
        cursor: pointer;
        transition: all .2s;
        width: fit-content;
        user-select: none;
    }

        .check-group:hover {
            border-color: var(--blue);
            background: var(--blue-g2);
        }

    .check-input {
        width: 16px;
        height: 16px;
        cursor: pointer;
        accent-color: var(--blue);
    }

    .check-label {
        font-size: 13px;
        font-weight: 700;
        color: var(--text2);
        cursor: pointer;
        font-family: var(--font-b);
        transition: color .2s;
    }

    .check-group:hover .check-label {
        color: var(--blue);
    }

    .contact-pill {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        font-family: var(--font-m);
        font-size: 11px;
        color: var(--teal);
    }

    .btn-row {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
        padding-top: 20px;
        border-top: 1px solid var(--border2);
        margin-top: 6px;
    }

    .btn {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 10px 22px;
        font-family: var(--font-b);
        font-size: 13px;
        font-weight: 700;
        border-radius: var(--r);
        border: none;
        cursor: pointer;
        transition: all .2s ease;
    }

    .btn-primary {
        background: linear-gradient(135deg, var(--blue) 0%, var(--blue-dark) 100%);
        color: #fff;
        box-shadow: 0 3px 14px rgba(78,157,255,.30);
    }

        .btn-primary:hover {
            transform: translateY(-1px);
            box-shadow: 0 6px 20px rgba(78,157,255,.42);
        }

    .btn-secondary {
        background: var(--surface2);
        color: var(--text2);
        border: 1px solid var(--border2);
    }

        .btn-secondary:hover {
            background: var(--surface3);
            color: var(--text);
            border-color: var(--border3);
        }

    .grid-card {
        background: var(--surface);
        border-radius: var(--r3);
        border: 1px solid var(--border2);
        box-shadow: var(--sh2);
        overflow: hidden;
        animation: slideUp .35s cubic-bezier(.22,1,.36,1) both;
    }

    .gc-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 14px 22px;
        background: var(--surface2);
        border-bottom: 1px solid var(--border2);
        border-top: 3px solid var(--blue);
    }

    .gc-header-left {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .gc-icon {
        width: 32px;
        height: 32px;
        border-radius: var(--r);
        background: var(--blue-g);
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--blue);
        font-size: 13px;
    }

    .gc-title {
        font-family: var(--font-h);
        font-size: 14px;
        font-weight: 600;
        color: var(--text);
    }

    .gc-badge {
        background: var(--blue-g);
        color: var(--blue-dark);
        font-family: var(--font-m);
        font-size: 10.5px;
        font-weight: 500;
        padding: 3px 10px;
        border-radius: 20px;
        border: 1px solid rgba(78,157,255,.20);
    }

    .tbl-scroll {
        height: 60vh;
        overflow-y: auto;
        scrollbar-width: thin;
        scrollbar-color: var(--border2) transparent;
    }

        .tbl-scroll::-webkit-scrollbar {
            width: 4px;
        }

        .tbl-scroll::-webkit-scrollbar-thumb {
            background: var(--border2);
            border-radius: 10px;
        }

    .pro-tbl {
        width: 100%;
        border-collapse: collapse;
    }

        .pro-tbl thead th {
            background: var(--surface2);
            color: var(--text3);
            padding: 10px 16px;
            font-size: 10px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1px;
            white-space: nowrap;
            font-family: var(--font-b);
            position: sticky;
            top: 0;
            z-index: 10;
            border-bottom: 1px solid var(--border2);
            text-align: left;
        }

        .pro-tbl tbody tr {
            border-bottom: 1px solid var(--border);
            transition: background .12s;
        }

            .pro-tbl tbody tr:hover {
                background: var(--surface2);
            }

            .pro-tbl tbody tr:last-child {
                border-bottom: none;
            }

        .pro-tbl tbody td {
            padding: 11px 16px;
            font-size: 13px;
            color: var(--text2);
            white-space: nowrap;
            font-weight: 600;
        }

    .tbl-btn {
        width: 30px;
        height: 30px;
        border-radius: var(--r);
        border: 1px solid transparent;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 11px;
        transition: all .15s;
    }

    .tbl-edit {
        background: var(--blue-g);
        color: var(--blue);
        border-color: rgba(78,157,255,.20);
    }

        .tbl-edit:hover {
            background: var(--blue);
            color: #fff;
            border-color: var(--blue);
        }

    .tbl-del {
        background: rgba(239,68,68,.08);
        color: var(--danger);
        border-color: rgba(239,68,68,.20);
        margin-left: 4px;
    }

        .tbl-del:hover {
            background: var(--danger);
            color: #fff;
            border-color: var(--danger);
        }

    .badge {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        font-size: 10.5px;
        font-weight: 700;
        padding: 3px 10px;
        border-radius: 20px;
        font-family: var(--font-b);
    }

    .badge-active {
        background: rgba(16,185,129,.10);
        color: #059669;
        border: 1px solid rgba(16,185,129,.25);
    }

    .badge-inactive {
        background: rgba(239,68,68,.08);
        color: var(--danger);
        border: 1px solid rgba(239,68,68,.20);
    }

    .badge i {
        font-size: 6px;
    }

    .empty-state {
        padding: 70px 20px;
        text-align: center;
    }

    .empty-icon {
        width: 60px;
        height: 60px;
        background: var(--surface2);
        border-radius: var(--r2);
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--text3);
        font-size: 22px;
        margin: 0 auto 16px;
        border: 1px solid var(--border2);
    }

    .empty-title {
        font-family: var(--font-h);
        font-size: 15px;
        font-weight: 600;
        color: var(--text2);
        margin-bottom: 5px;
    }

    .empty-sub {
        font-size: 12px;
        color: var(--text3);
        font-weight: 500;
    }

    .pg-footer {
        margin-top: 18px;
        padding-top: 14px;
        border-top: 1px solid var(--border2);
        text-align: center;
        font-family: var(--font-m);
        font-size: 10.5px;
        color: var(--text3);
        letter-spacing: .5px;
    }

        .pg-footer strong {
            color: var(--blue);
            font-weight: 500;
        }

        .pg-footer .heart {
            color: var(--coral);
        }
    @@keyframes fadeDown {
        from

    {
        opacity: 0;
        transform: translateY(-16px)
    }

    to {
        opacity: 1;
        transform: translateY(0)
    }

    }
    @@keyframes slideUp {
        from

    {
        opacity: 0;
        transform: translateY(20px)
    }

    to {
        opacity: 1;
        transform: translateY(0)
    }

    }
    @@media (max-width: 768px) {
        .sr-root

    {
        padding: 14px;
    }

    .frow-2 {
        grid-template-columns: 1fr;
    }

    .page-header {
        flex-wrap: wrap;
        gap: 12px;
    }

    }
</style>

<div class="sr-root">
    <div class="sr-inner">
        <div class="page-header">
            <div class="ph-left">
                <div class="ph-icon"><i class="fas fa-truck"></i></div>
                <div>
                    <div class="ph-title">Vendor <span>Registry</span></div>
                    <div class="ph-breadcrumb">Setup <i class="fas fa-chevron-right"></i> <span class="bc-cur">Vendor</span></div>
                </div>
            </div>
            <div class="view-toggle">
                <button class="vt-btn vt-btn-ghost" id="gridViewToggleBtn"><i class="fas fa-table-cells"></i> Grid View</button>
                <button class="vt-btn vt-btn-active" id="formViewToggleBtn" style="display:none;"><i class="fas fa-pen-to-square"></i> Form View</button>
            </div>
        </div>
        <div class="divider"><span></span><span></span><span></span></div>

        <!-- FORM VIEW -->
        <div id="formViewContainer">
            <div class="form-card">
                <div class="fc-header">
                    <div class="fc-header-left">
                        <div class="fc-icon"><i class="fas fa-truck"></i></div>
                        <div><div class="fc-title">Vendor Registration</div><div class="fc-sub">Add or update a vendor</div></div>
                    </div>
                    <div class="status-pill pill-live">Live</div>
                </div>
                <div class="fc-body">
                    <div class="sec-label"><div class="sec-label-bar slb-blue"></div><span class="sec-label-txt">Vendor Details</span></div>
                    <div class="frow frow-2">
                        <div class="fg has-value">
                            <input type="text" id="VendorCode" class="fc" placeholder=" " readonly>
                            <label class="fl" for="VendorCode">Vendor Code (Auto)</label>
                        </div>
                        <div class="fg">
                            <input type="text" id="Vendor" class="fc" placeholder=" ">
                            <label class="fl" for="Vendor">Vendor Name</label>
                        </div>
                    </div>
                    <div class="frow frow-1">
                        <div class="fg">
                            <input type="text" id="ContactNo" class="fc" placeholder=" " maxlength="50">
                            <label class="fl" for="ContactNo">Contact No</label>
                        </div>
                    </div>
                    <div class="frow frow-1" style="margin-bottom:20px;">
                        <div>
                            <div class="status-meta"><i class="fas fa-toggle-on"></i> Vendor Status</div>
                            <div class="check-group">
                                <input type="checkbox" id="IsActive" class="check-input" checked>
                                <label class="check-label" for="IsActive">Mark as Active</label>
                            </div>
                        </div>
                    </div>
                    <div class="btn-row">
                        <button class="btn btn-primary" id="saveBtn"><i class="fas fa-floppy-disk"></i> Save Vendor</button>
                        <button class="btn btn-secondary" id="cancelBtn"><i class="fas fa-xmark"></i> Cancel</button>
                    </div>
                </div>
            </div>
        </div>

        <!-- GRID VIEW -->
        <div id="gridViewContainer" style="display:none;">
            <div class="grid-card">
                <div class="gc-header">
                    <div class="gc-header-left">
                        <div class="gc-icon"><i class="fas fa-table-list"></i></div>
                        <div><div class="gc-title">All Vendors</div></div>
                        <div class="gc-badge" id="TotalVendorsCount">0 records</div>
                    </div>
                    <div class="status-pill pill-live">Live Data</div>
                </div>
                <div class="tbl-scroll"><div id="VendorGridContainer"></div></div>
            </div>
        </div>

        <div class="pg-footer">Developed with <span class="heart">♥</span> by <strong>UT Designer</strong></div>
    </div>
</div>

<script>
    let userId = localStorage.getItem("userId") || "", GridViewDataList = [], IsUpdate = false;
    const SW = { background: '#ffffff', color: '#1e2a3a', confirmButtonColor: '#4e9dff', cancelButtonColor: '#f8f9fc' };

    function initFloatLabels() {
        document.querySelectorAll('.fg').forEach(g => {
            const el = g.querySelector('input:not([type="checkbox"]):not([type="file"]),textarea,select');
            if (!el) return;
            const chk = () => g.classList.toggle('has-value', el.value.trim() !== '');
            el.addEventListener('input', chk); el.addEventListener('change', chk); chk();
        });
    }

    function showFormView() {
        document.getElementById("formViewContainer").style.display = "block";
        document.getElementById("gridViewContainer").style.display = "none";
        document.getElementById("formViewToggleBtn").style.display = "none";
        document.getElementById("gridViewToggleBtn").style.display = "inline-flex";
        document.getElementById("gridViewToggleBtn").className = "vt-btn vt-btn-ghost";
        document.getElementById("Vendor").focus();
    }
    function showGridView() {
        document.getElementById("formViewContainer").style.display = "none";
        document.getElementById("gridViewContainer").style.display = "block";
        document.getElementById("gridViewToggleBtn").style.display = "none";
        document.getElementById("formViewToggleBtn").style.display = "inline-flex";
        document.getElementById("formViewToggleBtn").className = "vt-btn vt-btn-active";
    }
    document.getElementById("gridViewToggleBtn").addEventListener("click", showGridView);
    document.getElementById("formViewToggleBtn").addEventListener("click", showFormView);

    window.addEventListener("load", async function () {
        document.getElementById("VendorCode").value = "Auto-Generated";
        initFloatLabels(); await LoadGridViewData();
    });

    async function LoadGridViewData() {
        try {
            const r = await jQuery.ajax({ type: 'POST', url: '@Url.Action("nLoadGridViewData", "Vendor")', data: JSON.stringify({ Userid: userId }), contentType: 'application/json' });
            if (r.statusId === 1) { GridViewDataList = r.GridViewDataList || []; RenderGridView(); }
            else await Swal.fire({ icon: 'warning', title: 'Warning', text: r.message || 'Failed', ...SW });
        } catch { await Swal.fire({ icon: 'error', title: 'Error', text: 'Error loading data', ...SW }); }
    }

    function RenderGridView() {
        const c = document.getElementById("VendorGridContainer"), cnt = document.getElementById("TotalVendorsCount");
        if (!GridViewDataList.length) {
            c.innerHTML = `<div class="empty-state"><div class="empty-icon"><i class="fas fa-truck"></i></div><div class="empty-title">No Vendors Found</div><div class="empty-sub">Click "Form View" to add your first vendor.</div></div>`;
            cnt.textContent = "0 records"; return;
        }
        const t = document.createElement("table"); t.className = "pro-tbl";
        t.innerHTML = `<thead><tr><th>Actions</th><th>Code</th><th>Vendor Name</th><th>Contact No</th><th>Status</th></tr></thead>`;
        const tb = document.createElement("tbody");
        GridViewDataList.forEach(item => {
            const tr = document.createElement("tr");
            tr.innerHTML = `<td>
                <button class="tbl-btn tbl-edit" onclick="EditVendor('${item.VendorCode}')" title="Edit"><i class="fas fa-pen"></i></button>
                <button class="tbl-btn tbl-del"  onclick="DeleteVendor('${item.VendorCode}')" title="Delete"><i class="fas fa-trash-can"></i></button>
            </td>
            <td><span style="font-family:var(--font-m);font-size:11px;color:var(--text3);">${item.VendorCode || '—'}</span></td>
            <td style="font-weight:700;color:var(--text);">${item.Vendor || '—'}</td>
            <td><span class="contact-pill"><i class="fas fa-phone" style="font-size:9px;"></i> ${item.ContactNo || '—'}</span></td>
            <td>${item.IsActive
                ? '<span class="badge badge-active"><i class="fas fa-circle"></i> Active</span>'
                : '<span class="badge badge-inactive"><i class="fas fa-circle"></i> Inactive</span>'}</td>`;
            tb.appendChild(tr);
        });
        t.appendChild(tb); c.innerHTML = ""; c.appendChild(t);
        cnt.textContent = `${tb.rows.length} record${tb.rows.length !== 1 ? 's' : ''}`;
    }

    function EditVendor(code) {
        const vendor = GridViewDataList.find(v => String(v.VendorCode) === String(code));
        if (!vendor) { Swal.fire({ icon: 'error', title: 'Error', text: 'Not found.', ...SW }); return; }
        document.getElementById("VendorCode").value = vendor.VendorCode || '';
        document.getElementById("Vendor").value     = vendor.Vendor     || '';
        document.getElementById("ContactNo").value  = vendor.ContactNo  || '';
        document.getElementById("IsActive").checked = vendor.IsActive === true || vendor.IsActive === 1;
        IsUpdate = true;
        document.getElementById("saveBtn").innerHTML = '<i class="fas fa-floppy-disk"></i> Update Vendor';
        initFloatLabels(); showFormView();
    }

    async function DeleteVendor(code) {
        const r = await Swal.fire({ title: 'Delete Vendor?', text: 'Cannot be undone.', icon: 'warning', showCancelButton: true, confirmButtonText: 'Yes, Delete', cancelButtonText: 'Cancel', confirmButtonColor: '#ef4444', ...SW });
        if (!r.isConfirmed) return;
        Swal.fire({ title: 'Please wait', text: 'Deleting...', allowOutsideClick: false, allowEscapeKey: false, didOpen: () => Swal.showLoading(), ...SW });
        try {
            const res = await jQuery.ajax({ type: 'POST', url: '@Url.Action("nDeleteVendorData", "Vendor")', data: JSON.stringify({ Userid: userId, VendorCode: `${code}` }), contentType: 'application/json' });
            Swal.close();
            if (res.statusId === 1) { await Swal.fire({ icon: 'success', title: 'Deleted!', text: res.message || 'Vendor deleted.', ...SW }); await LoadGridViewData(); }
            else await Swal.fire({ icon: 'warning', title: 'Failed', text: res.message || 'Could not delete.', ...SW });
        } catch { Swal.close(); await Swal.fire({ icon: 'error', title: 'Error', text: 'An error occurred.', ...SW }); }
    }

    document.getElementById("saveBtn").addEventListener("click", async function () {
        const VendorCode = document.getElementById("VendorCode").value.trim();
        const Vendor = document.getElementById("Vendor").value.trim();
        const ContactNo = document.getElementById("ContactNo").value.trim();
        const isActive = document.getElementById("IsActive").checked;
        if (!Vendor) {
            await Swal.fire({ icon: 'warning', title: 'Validation', text: 'Vendor name is required.', returnFocus: false, ...SW, didClose: () => document.getElementById("Vendor").focus() });
            return;
        }
        Swal.fire({ title: 'Please wait', text: 'Saving...', allowOutsideClick: false, allowEscapeKey: false, didOpen: () => Swal.showLoading(), ...SW });
        try {
            const res = await jQuery.ajax({ type: 'POST', url: '@Url.Action("nSaveVendorData", "Vendor")', data: JSON.stringify({ Userid: userId, VendorCode: IsUpdate ? VendorCode : '', Vendor, ContactNo, IsActive: isActive, IsUpdate }), contentType: 'application/json' });
            Swal.close();
            if (res.statusId === 1) {
                if (!IsUpdate && res.generatedCode) { document.getElementById("VendorCode").value = res.generatedCode; initFloatLabels(); }
                await Swal.fire({ icon: 'success', title: IsUpdate ? 'Updated!' : 'Saved!', text: res.message || 'Vendor saved.', returnFocus: false, ...SW });
                nClearForm();
            } else await Swal.fire({ icon: 'warning', title: 'Failed', text: res.message || 'Could not save.', ...SW });
        } catch { Swal.close(); await Swal.fire({ icon: 'error', title: 'Error', text: 'An error occurred.', ...SW }); }
    });

    document.getElementById("cancelBtn").addEventListener("click", function () { nClearForm(); });

    async function nClearForm() {
        document.getElementById("VendorCode").value = "Auto-Generated";
        document.getElementById("Vendor").value = "";
        document.getElementById("ContactNo").value = "";
        document.getElementById("IsActive").checked = true;
        IsUpdate = false;
        document.getElementById("saveBtn").innerHTML = '<i class="fas fa-floppy-disk"></i> Save Vendor';
        initFloatLabels(); document.getElementById("Vendor").focus();
        await LoadGridViewData();
    }
</script>
