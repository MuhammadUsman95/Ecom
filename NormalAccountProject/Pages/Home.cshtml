@page
@model NormalAccountProject.Pages.HomeModel
@{
    ViewData["Title"] = "Dashboard";
}

<link href="https://fonts.googleapis.com/css2?family=Syne:wght@600;700;800&family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">

<style>
    :root {
        --bg: #0a0c12;
        --bg2: #0f1220;
        --surface: #141828;
        --surface2: #1a2035;
        --surface3: #1f2640;
        --border: rgba(255,255,255,.06);
        --border2: rgba(255,255,255,.11);
        --accent: #6c63ff;
        --accent2: #4f46e5;
        --accent-g: rgba(108,99,255,.15);
        --gold: #f0b429;
        --gold-g: rgba(240,180,41,.12);
        --teal: #14b8a6;
        --danger: #f43f5e;
        --success: #10b981;
        --text: #e8eaf2;
        --text2: #9198b0;
        --text3: #5a6182;
        --font-h: 'Syne', sans-serif;
        --font-b: 'Plus Jakarta Sans', sans-serif;
        --font-m: 'JetBrains Mono', monospace;
        --r: 10px;
        --r2: 14px;
        --r3: 18px;
        --sh: 0 4px 32px rgba(0,0,0,.5);
        --sh2: 0 8px 48px rgba(0,0,0,.65);
    }

    *, *::before, *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    /* ── ROOT ── */
    .db-root {
        font-family: var(--font-b);
        color: var(--text);
        background: var(--bg);
        min-height: calc(100vh - 60px);
        padding: 20px 24px 14px;
        overflow-y: auto;
        overflow-x: hidden;
        scrollbar-width: thin;
        scrollbar-color: var(--surface3) transparent;
        position: relative;
    }

        .db-root::before {
            content: '';
            position: fixed;
            inset: 0;
            background-image: linear-gradient(rgba(255,255,255,.02) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.02) 1px, transparent 1px);
            background-size: 40px 40px;
            pointer-events: none;
            z-index: 0;
        }
        /* Orbs */
        .db-root::after {
            content: '';
            position: fixed;
            top: -200px;
            right: -200px;
            width: 550px;
            height: 550px;
            background: radial-gradient(circle, rgba(108,99,255,.07) 0%, transparent 65%);
            pointer-events: none;
            z-index: 0;
        }

    .db-inner {
        position: relative;
        z-index: 1;
        max-width: 1500px;
        margin: 0 auto;
    }

    /* ── TOPBAR ── */
    .topbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 20px;
        padding-bottom: 16px;
        border-bottom: 1px solid var(--border2);
        animation: fadeDown .45s ease both;
    }

    .topbar-left {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .logo-mark {
        width: 44px;
        height: 44px;
        background: linear-gradient(135deg, var(--accent) 0%, var(--accent2) 100%);
        border-radius: var(--r);
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 4px 20px rgba(108,99,255,.4);
        flex-shrink: 0;
    }

        .logo-mark svg rect {
            fill: #fff;
        }

    .page-title {
        font-family: var(--font-h);
        font-size: 21px;
        font-weight: 800;
        color: var(--text);
        letter-spacing: -.3px;
        line-height: 1.1;
    }

        .page-title span {
            color: var(--accent);
        }

    .page-sub {
        font-family: var(--font-m);
        font-size: 10px;
        color: var(--text3);
        letter-spacing: .5px;
        margin-top: 3px;
    }

    .topbar-right {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .live-badge {
        display: flex;
        align-items: center;
        gap: 7px;
        background: var(--surface);
        border: 1px solid var(--border2);
        border-radius: 50px;
        padding: 7px 14px;
        font-family: var(--font-m);
        font-size: 12px;
        font-weight: 500;
        color: var(--text2);
    }

    .pulse-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: var(--success);
        animation: pulseDot 1.8s ease-in-out infinite;
    }

    @@keyframes pulseDot {
        0%, 100% {
            opacity: 1;
            transform: scale(1);
        }

        50% {
            opacity: .4;
            transform: scale(.65);
        }
    }

    .btn-refresh {
        display: flex;
        align-items: center;
        gap: 7px;
        background: linear-gradient(135deg, var(--accent) 0%, var(--accent2) 100%);
        color: #fff;
        border: none;
        border-radius: var(--r);
        padding: 9px 18px;
        font-size: 13px;
        font-weight: 600;
        font-family: var(--font-b);
        cursor: pointer;
        transition: all .2s ease;
        box-shadow: 0 3px 16px rgba(108,99,255,.4);
    }

        .btn-refresh:hover {
            transform: translateY(-1px);
            box-shadow: 0 6px 24px rgba(108,99,255,.5);
        }

        .btn-refresh:active {
            transform: translateY(0);
        }

        .btn-refresh svg {
            flex-shrink: 0;
        }

        .btn-refresh.spinning svg {
            animation: spin .8s linear infinite;
        }

    /* Accent line */
    .accent-line {
        display: flex;
        gap: 2px;
        margin-bottom: 20px;
        height: 2px;
    }

        .accent-line span:nth-child(1) {
            flex: 2;
            background: var(--accent);
            border-radius: 2px;
        }

        .accent-line span:nth-child(2) {
            flex: 1;
            background: var(--teal);
            border-radius: 2px;
            opacity: .6;
        }

        .accent-line span:nth-child(3) {
            flex: 5;
            background: var(--border);
            border-radius: 2px;
        }

    /* ── STAT CARDS ── */
    .cards-row {
        display: grid;
        grid-template-columns: repeat(5, 1fr);
        gap: 12px;
        margin-bottom: 18px;
    }

    .scard {
        background: var(--surface);
        border: 1px solid var(--border2);
        border-radius: var(--r3);
        padding: 18px 18px 16px;
        box-shadow: var(--sh);
        animation: cardUp .5s cubic-bezier(.22,.68,0,1.2) calc(var(--i) * 70ms) both;
        transition: transform .25s, box-shadow .25s, border-color .25s;
        position: relative;
        overflow: hidden;
    }

        .scard::before {
            content: '';
            position: absolute;
            inset: 0;
            background: linear-gradient(135deg, rgba(108,99,255,.04) 0%, transparent 60%);
            opacity: 0;
            transition: opacity .25s;
        }

        .scard:hover {
            transform: translateY(-4px);
            box-shadow: 0 12px 36px rgba(0,0,0,.5);
            border-color: var(--border3, rgba(255,255,255,.15));
        }

            .scard:hover::before {
                opacity: 1;
            }

    .scard-top {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        margin-bottom: 16px;
    }

    .scard-ico {
        width: 40px;
        height: 40px;
        border-radius: var(--r);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 17px;
        flex-shrink: 0;
    }

    .ico-blue {
        background: rgba(108,99,255,.15);
        color: var(--accent);
    }

    .ico-rose {
        background: rgba(244,63,94,.1);
        color: #fb7185;
    }

    .ico-sky {
        background: rgba(14,165,233,.1);
        color: #38bdf8;
    }

    .ico-emerald {
        background: rgba(16,185,129,.1);
        color: #34d399;
    }

    .ico-amber {
        background: rgba(240,180,41,.12);
        color: var(--gold);
    }

    .spark {
        width: 72px !important;
        height: 36px !important;
    }

    .scard-val {
        font-family: var(--font-m);
        font-size: 30px;
        font-weight: 500;
        line-height: 1;
        color: var(--text);
        letter-spacing: -.5px;
        min-height: 30px;
    }

    .scard-lbl {
        font-size: 10.5px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 1.2px;
        color: var(--text3);
        margin-top: 6px;
        min-height: 11px;
        font-family: var(--font-m);
    }

    /* skeleton */
    .sk {
        background: linear-gradient(90deg, var(--surface2) 25%, var(--surface3) 50%, var(--surface2) 75%);
        background-size: 400px 100%;
        animation: shimmer 1.2s infinite linear;
        border-radius: 6px;
        display: block;
    }

    /* ── MAIN GRID ── */
    .main-grid {
        display: grid;
        grid-template-columns: 1fr 300px;
        gap: 14px;
        margin-bottom: 16px;
    }

    .right-stack {
        display: flex;
        flex-direction: column;
        gap: 14px;
    }

    /* ── PANELS ── */
    .panel {
        background: var(--surface);
        border: 1px solid var(--border2);
        border-radius: var(--r3);
        box-shadow: var(--sh2);
        overflow: hidden;
        animation: panelUp .5s ease .3s both;
    }

    .panel-hd {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 13px 18px;
        background: linear-gradient(90deg, var(--surface2) 0%, rgba(108,99,255,.06) 100%);
        border-bottom: 1px solid var(--border2);
    }

    .panel-hd-left {
        display: flex;
        align-items: center;
        gap: 9px;
    }

    .panel-hd-right {
        display: flex;
        gap: 6px;
    }

    /* macOS dots in panel */
    .panel-dots {
        display: flex;
        gap: 5px;
    }

    .p-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
    }

    .p-dot-r {
        background: #f43f5e;
    }

    .p-dot-y {
        background: #f59e0b;
    }

    .p-dot-g {
        background: #10b981;
    }

    .panel-ttl {
        font-family: var(--font-m);
        font-size: 10.5px;
        font-weight: 500;
        color: var(--text3);
        text-transform: uppercase;
        letter-spacing: 1.5px;
    }

    .icon-btn {
        width: 30px;
        height: 30px;
        border: 1px solid var(--border2);
        border-radius: 7px;
        background: var(--surface2);
        color: var(--text3);
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all .2s;
    }

        .icon-btn:hover {
            background: var(--accent);
            color: #fff;
            border-color: var(--accent);
        }

    /* ── TABLE ── */
    .tbl-scroll {
        overflow-x: auto;
    }

    .dtable {
        width: 100%;
        border-collapse: collapse;
    }

        .dtable thead th {
            background: var(--surface2);
            color: var(--text3);
            font-size: 9.5px;
            font-weight: 500;
            text-transform: uppercase;
            letter-spacing: 1.2px;
            padding: 10px 15px;
            white-space: nowrap;
            border-bottom: 1px solid var(--border2);
            border-right: 1px solid var(--border);
            font-family: var(--font-m);
            text-align: left;
            position: sticky;
            top: 0;
            z-index: 5;
        }

            .dtable thead th:last-child {
                border-right: none;
            }

        .dtable tbody tr {
            border-bottom: 1px solid var(--border);
            transition: background .12s;
        }

            .dtable tbody tr:last-child {
                border-bottom: none;
            }

            .dtable tbody tr:hover {
                background: var(--surface2);
            }

        .dtable tbody td {
            padding: 11px 15px;
            font-size: 12.5px;
            color: var(--text2);
            white-space: nowrap;
        }

            .dtable tbody td:first-child {
                color: var(--text);
                font-weight: 500;
            }

    .text-end {
        text-align: right !important;
    }

    /* ── DONUT ── */
    .chart-area {
        padding: 18px;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 14px;
    }

    .donut-wrap {
        position: relative;
        width: 160px;
        height: 160px;
        flex-shrink: 0;
    }

    #donutChart {
        width: 160px !important;
        height: 160px !important;
    }

    .donut-center {
        position: absolute;
        inset: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        pointer-events: none;
    }

        .donut-center span {
            font-family: var(--font-m);
            font-size: 22px;
            font-weight: 500;
            color: var(--text);
            line-height: 1;
        }

        .donut-center small {
            font-size: 9.5px;
            color: var(--text3);
            margin-top: 3px;
            font-weight: 500;
            text-transform: uppercase;
            letter-spacing: .8px;
            font-family: var(--font-m);
        }

    .legend-list {
        width: 100%;
        display: flex;
        flex-direction: column;
        gap: 7px;
    }

    .leg-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        font-size: 12px;
        color: var(--text2);
        animation: fadeUp .35s ease both;
    }

    .leg-left {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .leg-swatch {
        width: 9px;
        height: 9px;
        border-radius: 3px;
        flex-shrink: 0;
    }

    .leg-label {
        font-weight: 500;
    }

    .leg-val {
        font-family: var(--font-m);
        font-size: 11.5px;
        color: var(--text);
        font-weight: 500;
    }

    /* ── SUMMARY ── */
    .sum-body {
        padding: 0;
    }

    .stable {
        width: 100%;
        border-collapse: collapse;
    }

        .stable tbody tr {
            border-bottom: 1px solid var(--border);
            transition: background .12s;
        }

            .stable tbody tr:last-child {
                border-bottom: none;
            }

            .stable tbody tr:hover {
                background: var(--surface2);
            }

        .stable tbody td {
            padding: 12px 18px;
            font-size: 13px;
            color: var(--text2);
            font-weight: 500;
        }

            .stable tbody td:last-child {
                text-align: right;
                font-family: var(--font-m);
                font-size: 17px;
                font-weight: 500;
                color: var(--text);
                letter-spacing: -.3px;
            }

    /* ── FOOTER ── */
    .db-footer {
        text-align: center;
        padding: 12px 0;
        font-family: var(--font-m);
        font-size: 10px;
        color: var(--text3);
        border-top: 1px solid var(--border);
        letter-spacing: .5px;
    }

        .db-footer strong {
            color: var(--accent);
            font-weight: 500;
        }

        .db-footer .heart {
            color: var(--danger);
        }

    /* ── KEYFRAMES ── */
    @@keyframes fadeDown {
        from {
            opacity: 0;
            transform: translateY(-20px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes cardUp {
        from {
            opacity: 0;
            transform: translateY(30px) scale(.96);
        }

        60% {
            transform: translateY(-5px) scale(1.01);
        }

        to {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }

    @@keyframes panelUp {
        from {
            opacity: 0;
            transform: translateY(20px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes fadeUp {
        from {
            opacity: 0;
            transform: translateY(8px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes spin {
        to {
            transform: rotate(360deg);
        }
    }

    @@keyframes shimmer {
        0% {
            background-position: -400px 0;
        }

        100% {
            background-position: 400px 0;
        }
    }

    @@keyframes numRise {
        from {
            opacity: 0;
            transform: translateY(10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* ── RESPONSIVE ── */
    @@media (max-width: 1200px) {
        .cards-row {
            grid-template-columns: repeat(3, 1fr);
        }
    }

    @@media (max-width: 960px) {
        .main-grid {
            grid-template-columns: 1fr;
        }

        .right-stack {
            flex-direction: row;
            flex-wrap: wrap;
        }

        .chart-panel, .sum-panel {
            flex: 1 1 260px;
        }
    }

    @@media (max-width: 640px) {
        .cards-row {
            grid-template-columns: repeat(2, 1fr);
        }

        .topbar {
            flex-wrap: wrap;
            gap: 12px;
        }
    }
</style>

<div class="db-root">
    <div class="db-inner">

        <!-- TOP BAR -->
        <header class="topbar">
            <div class="topbar-left">
                <div class="logo-mark">
                    <svg width="22" height="22" viewBox="0 0 22 22" fill="none">
                        <rect x="1" y="1" width="9" height="9" rx="2.5" />
                        <rect x="12" y="1" width="9" height="9" rx="2.5" opacity=".5" />
                        <rect x="1" y="12" width="9" height="9" rx="2.5" opacity=".5" />
                        <rect x="12" y="12" width="9" height="9" rx="2.5" />
                    </svg>
                </div>
                <div>
                    <h1 class="page-title">Live <span>Dashboard</span></h1>
                    <p class="page-sub">// business overview</p>
                </div>
            </div>
            <div class="topbar-right">
                <div class="live-badge">
                    <span class="pulse-dot"></span>
                    <span id="refreshTimer">5:00</span>
                </div>
                <button id="refreshBtn" class="btn-refresh">
                    <svg id="refreshIcon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8" />
                        <path d="M21 3v5h-5M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16" />
                        <path d="M8 16H3v5" />
                    </svg>
                    Refresh
                </button>
            </div>
        </header>

        <!-- Accent Line -->
        <div class="accent-line"><span></span><span></span><span></span></div>

        <!-- STAT CARDS -->
        <div class="cards-row">
            <div class="scard" style="--i:0">
                <div class="scard-top">
                    <span class="scard-ico ico-blue"><i class="zmdi zmdi-account-o"></i></span>
                    <canvas class="spark" id="spark1"></canvas>
                </div>
                <div class="scard-val" id="Card1TotalValue">—</div>
                <div class="scard-lbl" id="Card1Caption">Loading…</div>
            </div>
            <div class="scard" style="--i:1">
                <div class="scard-top">
                    <span class="scard-ico ico-rose"><i class="zmdi zmdi-store"></i></span>
                    <canvas class="spark" id="spark2"></canvas>
                </div>
                <div class="scard-val" id="Card2TotalValue">—</div>
                <div class="scard-lbl" id="Card2Caption">Loading…</div>
            </div>
            <div class="scard" style="--i:2">
                <div class="scard-top">
                    <span class="scard-ico ico-sky"><i class="zmdi zmdi-shopping-cart"></i></span>
                    <canvas class="spark" id="spark3"></canvas>
                </div>
                <div class="scard-val" id="Card3TotalValue">—</div>
                <div class="scard-lbl" id="Card3Caption">Loading…</div>
            </div>
            <div class="scard" style="--i:3">
                <div class="scard-top">
                    <span class="scard-ico ico-emerald"><i class="zmdi zmdi-check-circle"></i></span>
                    <canvas class="spark" id="spark4"></canvas>
                </div>
                <div class="scard-val" id="Card4TotalValue">—</div>
                <div class="scard-lbl" id="Card4Caption">Loading…</div>
            </div>
            <div class="scard" style="--i:4">
                <div class="scard-top">
                    <span class="scard-ico ico-amber"><i class="zmdi zmdi-trending-up"></i></span>
                    <canvas class="spark" id="spark5"></canvas>
                </div>
                <div class="scard-val" id="Card5TotalValue">—</div>
                <div class="scard-lbl" id="Card5Caption">Loading…</div>
            </div>
        </div>

        <!-- MAIN GRID -->
        <div class="main-grid">

            <!-- TABLE PANEL -->
            <div class="panel tbl-panel">
                <div class="panel-hd">
                    <div class="panel-hd-left">
                        <div class="panel-dots">
                            <div class="p-dot p-dot-r"></div>
                            <div class="p-dot p-dot-y"></div>
                            <div class="p-dot p-dot-g"></div>
                        </div>
                        <h2 class="panel-ttl">Recent Vendors</h2>
                    </div>
                    <div class="panel-hd-right">
                        <button class="icon-btn" title="Download">
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" /><polyline points="7 10 12 15 17 10" /><line x1="12" y1="15" x2="12" y2="3" /></svg>
                        </button>
                        <button class="icon-btn" title="Filter">
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" y1="6" x2="20" y2="6" /><line x1="8" y1="12" x2="16" y2="12" /><line x1="11" y1="18" x2="13" y2="18" /></svg>
                        </button>
                    </div>
                </div>
                <div class="tbl-scroll">
                    <table class="dtable">
                        <thead id="gridThead"></thead>
                        <tbody id="gridTbody"></tbody>
                    </table>
                </div>
            </div>

            <!-- RIGHT COLUMN -->
            <div class="right-stack">

                <!-- DONUT -->
                <div class="panel chart-panel">
                    <div class="panel-hd">
                        <div class="panel-hd-left">
                            <div class="panel-dots">
                                <div class="p-dot p-dot-r"></div>
                                <div class="p-dot p-dot-y"></div>
                                <div class="p-dot p-dot-g"></div>
                            </div>
                            <h2 class="panel-ttl">Distribution</h2>
                        </div>
                    </div>
                    <div class="chart-area">
                        <div class="donut-wrap">
                            <canvas id="donutChart"></canvas>
                            <div class="donut-center">
                                <span id="donutTotal">—</span>
                                <small>Total</small>
                            </div>
                        </div>
                        <div id="chartLegend" class="legend-list"></div>
                    </div>
                </div>

                <!-- SUMMARY -->
                <div class="panel sum-panel">
                    <div class="panel-hd">
                        <div class="panel-hd-left">
                            <div class="panel-dots">
                                <div class="p-dot p-dot-r"></div>
                                <div class="p-dot p-dot-y"></div>
                                <div class="p-dot p-dot-g"></div>
                            </div>
                            <h2 class="panel-ttl">Summary</h2>
                        </div>
                    </div>
                    <div class="sum-body">
                        <table class="stable"><tbody id="grid2Tbody"></tbody></table>
                    </div>
                </div>

            </div>
        </div>

        <footer class="db-footer">
            Developed with <span class="heart">♥</span> by <strong>UT Designer</strong>
        </footer>
    </div>
</div>

<script>
    let userId = localStorage.getItem("userId") || "";
    let autoTimer = null, countTimer = null, nextRefresh = null;
    let donutInstance = null;

    const COLORS = ['#6c63ff','#f43f5e','#38bdf8','#34d399','#f0b429','#14b8a6','#fb923c'];

    document.addEventListener("DOMContentLoaded", async () => {
        showSkeletons();
        await LoadData();
        startAutoRefresh();
    });

    document.getElementById("refreshBtn").addEventListener("click", async function () {
        const btn = this;
        btn.classList.add("spinning"); btn.disabled = true;
        showSkeletons();
        try { await LoadData(); startAutoRefresh(); notify("Refreshed successfully", "success"); }
        catch { notify("Refresh failed", "error"); }
        finally { btn.classList.remove("spinning"); btn.disabled = false; }
    });

    function showSkeletons() {
        for (let i = 1; i <= 5; i++) {
            const v = document.getElementById(`Card${i}TotalValue`);
            const l = document.getElementById(`Card${i}Caption`);
            if (v) v.innerHTML = '<span class="sk" style="width:90px;height:24px;"></span>';
            if (l) l.innerHTML = '<span class="sk" style="width:100px;height:10px;margin-top:6px;"></span>';
        }
    }

    function startCountdown() {
        clearInterval(countTimer);
        countTimer = setInterval(() => {
            const diff = nextRefresh - Date.now();
            if (diff <= 0) { document.getElementById("refreshTimer").textContent = "…"; return; }
            const m = Math.floor(diff / 60000), s = Math.floor((diff % 60000) / 1000);
            document.getElementById("refreshTimer").textContent = `${m}:${s.toString().padStart(2, '0')}`;
        }, 1000);
    }

    function startAutoRefresh() {
        clearInterval(autoTimer); nextRefresh = Date.now() + 300000; startCountdown();
        autoTimer = setInterval(async () => { await LoadData(); nextRefresh = Date.now() + 300000; notify("Auto-refreshed", "success"); }, 300000);
    }

    async function LoadData() {
        return new Promise((resolve, reject) => {
            jQuery.ajax({
                type: 'POST',
                url: '@Url.Action("nLoadDashboardData", "Dashboard")',
                data: JSON.stringify({ Userid: userId }),
                contentType: 'application/json',
                success(res) {
                    if (res.statusId !== 1) { notify("Data load failed: " + (res.message || "Unknown"), "error"); reject(); return; }
                    const delays = [0, 60, 120, 180, 240];
                    [1, 2, 3, 4, 5].forEach((n, i) => {
                        setTimeout(() => {
                            animateNum(`Card${n}TotalValue`, res[`Card${n}TotalValue`] || 0);
                            setLabel(`Card${n}Caption`, res[`Card${n}Caption`] || '');
                            drawSpark(`spark${n}`, COLORS[i]);
                        }, delays[i]);
                    });
                    setTimeout(() => {
                        renderGrid(res.Grid1Data);
                        renderSummary(res.Grid2Data);
                        if (res.GraphData?.length) drawDonut(res.GraphData);
                    }, 350);
                    resolve();
                },
                error(xhr, status, err) { notify("Server error: " + status, "error"); reject(err); }
            });
        });
    }

    function animateNum(id, end) {
        const el = document.getElementById(id);
        el.innerHTML = '';
        el.style.animation = 'numRise .4s ease both';
        let t0 = null;
        requestAnimationFrame(function step(t) {
            if (!t0) t0 = t;
            const p = Math.min((t - t0) / 1200, 1);
            const ease = p === 1 ? 1 : 1 - Math.pow(2, -10 * p);
            el.textContent = Math.floor(ease * end).toLocaleString();
            if (p < 1) requestAnimationFrame(step);
        });
    }

    function setLabel(id, text) {
        const el = document.getElementById(id);
        el.innerHTML = '';
        el.textContent = text;
    }

    function drawSpark(canvasId, color) {
        const canvas = document.getElementById(canvasId);
        if (!canvas) return;
        const ctx = canvas.getContext('2d');
        const W = canvas.width = 80, H = canvas.height = 40;
        const pts = Array.from({ length: 9 }, (_, i) => 6 + Math.abs(Math.sin(i * 1.4 + Math.random())) * 24);
        const grad = ctx.createLinearGradient(0, 0, 0, H);
        grad.addColorStop(0, color + '35');
        grad.addColorStop(1, color + '00');
        let f = 0, total = 36;
        function frame() {
            ctx.clearRect(0, 0, W, H);
            const drawn = Math.ceil((f / total) * (pts.length - 1));
            const sub = pts.slice(0, drawn + 1);
            if (sub.length < 2) { f++; if (f <= total) requestAnimationFrame(frame); return; }
            ctx.beginPath();
            sub.forEach((v, i) => { const x = (i / (pts.length - 1)) * W, y = H - v; i === 0 ? ctx.moveTo(x, y) : ctx.lineTo(x, y); });
            ctx.strokeStyle = color; ctx.lineWidth = 1.8; ctx.lineJoin = 'round'; ctx.lineCap = 'round'; ctx.stroke();
            const lx = ((sub.length - 1) / (pts.length - 1)) * W;
            ctx.lineTo(lx, H); ctx.lineTo(0, H); ctx.closePath(); ctx.fillStyle = grad; ctx.fill();
            const tx = ((sub.length - 1) / (pts.length - 1)) * W, ty = H - sub[sub.length - 1];
            ctx.beginPath(); ctx.arc(tx, ty, 2.5, 0, Math.PI * 2); ctx.fillStyle = color; ctx.fill();
            f++; if (f <= total) requestAnimationFrame(frame);
        }
        requestAnimationFrame(frame);
    }

    function drawDonut(data) {
        const canvas = document.getElementById('donutChart');
        if (!canvas) return;
        if (donutInstance) donutInstance.destroy();
        const labels = data.map(d => d.graphValue || d.GraphValue || '');
        const values = data.map(d => Number(d.graphCaption || d.GraphCaption || 0));
        const total = values.reduce((a, b) => a + b, 0);
        document.getElementById('donutTotal').textContent = total.toLocaleString();
        donutInstance = new Chart(canvas, {
            type: 'doughnut',
            data: {
                labels,
                datasets: [{
                    data: values,
                    backgroundColor: COLORS.slice(0, values.length),
                    borderWidth: 3,
                    borderColor: '#141828',
                    hoverBorderWidth: 4,
                    hoverOffset: 6
                }]
            },
            options: {
                cutout: '74%', responsive: true, maintainAspectRatio: true,
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        backgroundColor: '#1a2035',
                        borderColor: 'rgba(108,99,255,.3)',
                        borderWidth: 1,
                        padding: 10, cornerRadius: 8,
                        titleFont: { size: 12, weight: '600', family: 'Plus Jakarta Sans' },
                        bodyFont: { size: 11, family: 'Plus Jakarta Sans' },
                        titleColor: '#e8eaf2', bodyColor: '#9198b0'
                    }
                },
                animation: { animateRotate: true, animateScale: true, duration: 900, easing: 'easeInOutQuart' }
            }
        });
        const legend = document.getElementById('chartLegend');
        legend.innerHTML = '';
        labels.forEach((lbl, i) => {
            const pct = total > 0 ? ((values[i] / total) * 100).toFixed(1) : 0;
            const row = document.createElement('div');
            row.className = 'leg-row';
            row.style.animationDelay = `${.5 + i * .08}s`;
            row.innerHTML = `<div class="leg-left"><span class="leg-swatch" style="background:${COLORS[i]}"></span><span class="leg-label">${lbl}</span></div><span class="leg-val">${Number(values[i]).toLocaleString()} <span style="color:var(--text3);font-size:10px">${pct}%</span></span>`;
            legend.appendChild(row);
        });
    }

    function renderGrid(data) {
        if (!data || !data.length) return;
        const thead = document.getElementById('gridThead');
        const tbody = document.getElementById('gridTbody');
        thead.innerHTML = ''; tbody.innerHTML = '';
        const hr = document.createElement('tr');
        Object.keys(data[0]).forEach(k => {
            const th = document.createElement('th');
            th.textContent = k.replace(/([A-Z])/g, ' $1').trim();
            if (/amount|price|total|qty/i.test(k)) th.classList.add('text-end');
            hr.appendChild(th);
        });
        thead.appendChild(hr);
        data.forEach((row, idx) => {
            const tr = document.createElement('tr');
            tr.style.animation = `fadeUp .3s ease ${.4 + idx * .05}s both`;
            Object.entries(row).forEach(([k, v]) => {
                const td = document.createElement('td');
                td.textContent = v ?? '';
                if (/amount|price|total|qty/i.test(k)) td.classList.add('text-end');
                tr.appendChild(td);
            });
            tbody.appendChild(tr);
        });
    }

    function renderSummary(data) {
        if (!data || !data.length) return;
        const tbody = document.getElementById('grid2Tbody');
        tbody.innerHTML = '';
        data.forEach((row, idx) => {
            const keys = Object.keys(row);
            const tr = document.createElement('tr');
            tr.style.animation = `fadeUp .3s ease ${.5 + idx * .07}s both`;
            const td1 = document.createElement('td'); td1.textContent = row['Text'] ?? row[keys[0]] ?? '';
            const td2 = document.createElement('td'); td2.textContent = row['Value'] ?? row[keys[1]] ?? '';
            tr.appendChild(td1); tr.appendChild(td2);
            tbody.appendChild(tr);
        });
    }

    function notify(msg, type) {
        if (typeof toastr === 'undefined') return;
        toastr[type](msg, '', { timeOut: 2000, positionClass: 'toast-bottom-right' });
    }
</script>
