@page "/Product"
@model NormalAccountProject.Pages.ProductModel
@{
    ViewData["Title"] = "Product Registration";
}

<link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;500;600;700;800&family=Rubik:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">

<style>
    :root {
        --bg: #f0f3f8;
        --surface: #ffffff;
        --surface2: #f8f9fc;
        --surface3: #eef1f8;
        --border: #eef0f6;
        --border2: #e2e6f0;
        --border3: #d4d9e8;
        --blue: #4e9dff;
        --blue-dark: #2d7dd2;
        --blue-g: rgba(78,157,255,.10);
        --blue-g2: rgba(78,157,255,.06);
        --teal: #00c9a7;
        --coral: #ff6b6b;
        --amber: #f59e0b;
        --green: #10b981;
        --danger: #ef4444;
        --text: #1e2a3a;
        --text2: #5a6478;
        --text3: #9ba3b8;
        --font-h: 'Rubik', sans-serif;
        --font-b: 'Nunito', sans-serif;
        --font-m: 'JetBrains Mono', monospace;
        --r: 8px;
        --r2: 12px;
        --r3: 16px;
        --sh: 0 2px 12px rgba(0,0,0,.06);
        --sh2: 0 4px 24px rgba(0,0,0,.09);
    }

    *, *::before, *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    .sr-root {
        font-family: var(--font-b);
        color: var(--text);
        background: var(--bg);
        min-height: calc(100vh - 60px);
        padding: 24px 28px 20px;
        overflow-y: auto;
        overflow-x: hidden;
        scrollbar-width: thin;
        scrollbar-color: var(--border2) transparent;
    }

    .sr-inner {
        max-width: 1400px;
        margin: 0 auto;
    }

    .page-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 22px;
        animation: fadeDown .4s ease both;
    }

    .ph-left {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .ph-icon {
        width: 46px;
        height: 46px;
        background: linear-gradient(135deg, var(--blue) 0%, var(--blue-dark) 100%);
        border-radius: var(--r2);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        font-size: 18px;
        box-shadow: 0 4px 16px rgba(78,157,255,.35);
        flex-shrink: 0;
    }

    .ph-title {
        font-family: var(--font-h);
        font-size: 21px;
        font-weight: 700;
        color: var(--text);
        line-height: 1.1;
    }

        .ph-title span {
            color: var(--blue);
        }

    .ph-breadcrumb {
        display: flex;
        align-items: center;
        gap: 5px;
        font-family: var(--font-m);
        font-size: 10px;
        color: var(--text3);
        letter-spacing: .4px;
        margin-top: 3px;
    }

        .ph-breadcrumb i {
            font-size: 7px;
        }

        .ph-breadcrumb .bc-cur {
            color: var(--blue);
            font-weight: 500;
        }

    .view-toggle {
        display: flex;
        gap: 4px;
        background: var(--surface);
        padding: 4px;
        border-radius: var(--r);
        border: 1px solid var(--border2);
        box-shadow: var(--sh);
    }

    .vt-btn {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 8px 16px;
        font-family: var(--font-b);
        font-size: 12.5px;
        font-weight: 700;
        border-radius: 6px;
        border: none;
        cursor: pointer;
        transition: all .2s ease;
    }

    .vt-btn-ghost {
        background: transparent;
        color: var(--text2);
    }

        .vt-btn-ghost:hover {
            background: var(--surface3);
            color: var(--text);
        }

    .vt-btn-active {
        background: linear-gradient(135deg, var(--blue) 0%, var(--blue-dark) 100%);
        color: #fff;
        box-shadow: 0 2px 10px rgba(78,157,255,.30);
    }

        .vt-btn-active:hover {
            transform: translateY(-1px);
        }

    .divider {
        display: flex;
        gap: 3px;
        height: 3px;
        margin-bottom: 20px;
        border-radius: 3px;
        overflow: hidden;
    }

        .divider span:nth-child(1) {
            flex: 3;
            background: var(--blue);
        }

        .divider span:nth-child(2) {
            flex: 1;
            background: var(--teal);
            opacity: .6;
        }

        .divider span:nth-child(3) {
            flex: 8;
            background: var(--border2);
        }

    .form-card {
        background: var(--surface);
        border-radius: var(--r3);
        border: 1px solid var(--border2);
        box-shadow: var(--sh2);
        overflow: hidden;
        animation: slideUp .35s cubic-bezier(.22,1,.36,1) both;
    }

    .fc-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 14px 22px;
        background: var(--surface2);
        border-bottom: 1px solid var(--border2);
        border-top: 3px solid var(--blue);
    }

    .fc-header-left {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .fc-icon {
        width: 32px;
        height: 32px;
        border-radius: var(--r);
        background: var(--blue-g);
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--blue);
        font-size: 13px;
    }

    .fc-title {
        font-family: var(--font-h);
        font-size: 14px;
        font-weight: 600;
        color: var(--text);
    }

    .fc-sub {
        font-size: 11px;
        color: var(--text3);
        font-weight: 500;
        margin-top: 1px;
    }

    .status-pill {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 4px 12px;
        border-radius: 20px;
        font-family: var(--font-m);
        font-size: 10.5px;
        font-weight: 500;
    }

    .pill-live {
        background: rgba(16,185,129,.10);
        color: var(--green);
        border: 1px solid rgba(16,185,129,.25);
    }

        .pill-live::before {
            content: '';
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: var(--green);
            animation: blink 1.8s ease-in-out infinite;
        }
    @@keyframes blink {
        0%,100%

    {
        opacity: 1
    }

    50% {
        opacity: .3
    }

    }

    .fc-body {
        padding: 24px 26px;
        max-height: 68vh;
        overflow-y: auto;
        scrollbar-width: thin;
        scrollbar-color: var(--border2) transparent;
    }

        .fc-body::-webkit-scrollbar {
            width: 4px;
        }

        .fc-body::-webkit-scrollbar-thumb {
            background: var(--border2);
            border-radius: 10px;
        }

    .sec-label {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 14px;
        padding-bottom: 10px;
        border-bottom: 1px dashed var(--border2);
    }

    .sec-label-bar {
        width: 3px;
        height: 14px;
        border-radius: 3px;
        flex-shrink: 0;
    }

    .slb-blue {
        background: linear-gradient(180deg, var(--blue), var(--teal));
    }

    .slb-teal {
        background: linear-gradient(180deg, var(--teal), var(--blue));
    }

    .slb-amber {
        background: linear-gradient(180deg, var(--amber), var(--coral));
    }

    .sec-label-txt {
        font-family: var(--font-m);
        font-size: 9.5px;
        font-weight: 500;
        color: var(--text3);
        letter-spacing: 2px;
        text-transform: uppercase;
    }

    .frow {
        display: grid;
        gap: 14px;
        margin-bottom: 14px;
    }

    .frow-1 {
        grid-template-columns: 1fr;
    }

    .frow-2 {
        grid-template-columns: 1fr 1fr;
    }

    .frow-desc-timer {
        grid-template-columns: 2fr 1fr;
    }

    .fg {
        position: relative;
    }

        .fg .fc {
            padding: 22px 14px 8px;
        }

        .fg textarea.fc {
            padding: 22px 14px 8px;
        }

        .fg select.fc {
            padding: 22px 14px 8px;
        }

        .fg.is-area .fl {
            top: 18px;
            transform: none;
        }

    .fl {
        position: absolute;
        left: 14px;
        top: 50%;
        transform: translateY(-50%);
        font-family: var(--font-b);
        font-size: 13px;
        font-weight: 600;
        color: var(--text3);
        pointer-events: none;
        transition: top .18s, transform .18s, font-size .18s, color .18s, letter-spacing .18s;
        white-space: nowrap;
    }

    .fg .fc:focus ~ .fl, .fg.has-value .fl {
        top: 7px;
        transform: none;
        font-size: 9px;
        font-family: var(--font-m);
        color: var(--blue);
        letter-spacing: 1px;
        text-transform: uppercase;
        font-weight: 500;
    }

    .fg.is-area .fc:focus ~ .fl, .fg.is-area.has-value .fl {
        top: 6px;
        transform: none;
        font-size: 9px;
        font-family: var(--font-m);
        color: var(--blue);
        letter-spacing: 1px;
        text-transform: uppercase;
        font-weight: 500;
    }

    .fg.always-up .fl {
        top: 7px;
        transform: none;
        font-size: 9px;
        font-family: var(--font-m);
        color: var(--text3);
        letter-spacing: 1px;
        text-transform: uppercase;
        font-weight: 500;
    }

    .fg.always-up .fc:focus ~ .fl {
        color: var(--blue);
    }

    .fg .fc::placeholder {
        color: transparent;
    }

    .fc {
        border: 1px solid var(--border2);
        border-radius: var(--r);
        padding: 10px 14px;
        font-size: 13.5px;
        font-family: var(--font-b);
        font-weight: 600;
        color: var(--text) !important;
        background: var(--surface);
        transition: border-color .2s, box-shadow .2s, background .2s;
        outline: none;
        width: 100%;
        -webkit-text-fill-color: var(--text) !important;
        caret-color: var(--blue);
    }

        .fc:focus {
            border-color: var(--blue);
            box-shadow: 0 0 0 3px var(--blue-g);
            background: #fff;
        }

    textarea.fc {
        resize: vertical;
        line-height: 1.6;
    }

    select.fc {
        appearance: auto;
        cursor: pointer;
    }

        select.fc option {
            background: #fff;
            color: var(--text);
        }

    input[type="number"].fc::-webkit-inner-spin-button {
        opacity: .4;
    }

    .hint {
        font-size: 10.5px;
        color: var(--text3);
        font-family: var(--font-m);
        margin-top: 5px;
        padding-left: 2px;
        display: flex;
        align-items: center;
        gap: 5px;
    }

        .hint i {
            color: var(--blue);
            font-size: 11px;
        }

    .status-meta {
        font-family: var(--font-m);
        font-size: 9.5px;
        color: var(--text3);
        letter-spacing: 1px;
        text-transform: uppercase;
        margin-bottom: 8px;
        display: flex;
        align-items: center;
        gap: 5px;
    }

        .status-meta i {
            color: var(--blue);
        }

    .check-group {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 11px 16px;
        background: var(--surface2);
        border-radius: var(--r);
        border: 1px solid var(--border2);
        cursor: pointer;
        transition: all .2s;
        width: fit-content;
        user-select: none;
    }

        .check-group:hover {
            border-color: var(--blue);
            background: var(--blue-g2);
        }

    .check-input {
        width: 16px;
        height: 16px;
        cursor: pointer;
        accent-color: var(--blue);
    }

    .check-label {
        font-size: 13px;
        font-weight: 700;
        color: var(--text2);
        cursor: pointer;
        font-family: var(--font-b);
        transition: color .2s;
    }

    .check-group:hover .check-label {
        color: var(--blue);
    }

    .media-meta {
        font-family: var(--font-m);
        font-size: 9.5px;
        color: var(--text3);
        letter-spacing: 1px;
        text-transform: uppercase;
        margin-bottom: 8px;
        display: flex;
        align-items: center;
        gap: 5px;
    }

        .media-meta i {
            color: var(--amber);
        }

    .upload-zone {
        border: 2px dashed var(--border2);
        border-radius: var(--r);
        padding: 12px 16px;
        background: var(--surface2);
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 14px;
        transition: all .25s ease;
    }

        .upload-zone:hover {
            border-color: var(--blue);
            background: var(--blue-g2);
        }

    .upload-icon {
        width: 38px;
        height: 38px;
        background: linear-gradient(135deg, var(--blue) 0%, var(--blue-dark) 100%);
        border-radius: var(--r);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        font-size: 15px;
        flex-shrink: 0;
        box-shadow: 0 3px 10px rgba(78,157,255,.30);
    }

    .upload-title {
        font-size: 13px;
        font-weight: 700;
        color: var(--text2);
    }

    .upload-sub {
        font-size: 10.5px;
        color: var(--text3);
        font-family: var(--font-m);
        margin-top: 2px;
    }

    input[type="file"].hidden-file {
        display: none;
    }

    .btn-row {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
        padding-top: 20px;
        border-top: 1px solid var(--border2);
        margin-top: 6px;
    }

    .btn {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 10px 22px;
        font-family: var(--font-b);
        font-size: 13px;
        font-weight: 700;
        border-radius: var(--r);
        border: none;
        cursor: pointer;
        transition: all .2s ease;
    }

    .btn-primary {
        background: linear-gradient(135deg, var(--blue) 0%, var(--blue-dark) 100%);
        color: #fff;
        box-shadow: 0 3px 14px rgba(78,157,255,.30);
    }

        .btn-primary:hover {
            transform: translateY(-1px);
            box-shadow: 0 6px 20px rgba(78,157,255,.42);
        }

    .btn-secondary {
        background: var(--surface2);
        color: var(--text2);
        border: 1px solid var(--border2);
    }

        .btn-secondary:hover {
            background: var(--surface3);
            color: var(--text);
            border-color: var(--border3);
        }

    .btn-view {
        background: rgba(245,158,11,.10);
        color: var(--amber);
        border: 1px solid rgba(245,158,11,.25);
        display: none;
    }

        .btn-view.show {
            display: inline-flex;
        }

        .btn-view:hover {
            background: rgba(245,158,11,.18);
        }

    .grid-card {
        background: var(--surface);
        border-radius: var(--r3);
        border: 1px solid var(--border2);
        box-shadow: var(--sh2);
        overflow: hidden;
        animation: slideUp .35s cubic-bezier(.22,1,.36,1) both;
    }

    .gc-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 14px 22px;
        background: var(--surface2);
        border-bottom: 1px solid var(--border2);
        border-top: 3px solid var(--blue);
    }

    .gc-header-left {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .gc-icon {
        width: 32px;
        height: 32px;
        border-radius: var(--r);
        background: var(--blue-g);
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--blue);
        font-size: 13px;
    }

    .gc-title {
        font-family: var(--font-h);
        font-size: 14px;
        font-weight: 600;
        color: var(--text);
    }

    .gc-badge {
        background: var(--blue-g);
        color: var(--blue-dark);
        font-family: var(--font-m);
        font-size: 10.5px;
        font-weight: 500;
        padding: 3px 10px;
        border-radius: 20px;
        border: 1px solid rgba(78,157,255,.20);
    }

    .tbl-scroll {
        height: 60vh;
        overflow-y: auto;
        scrollbar-width: thin;
        scrollbar-color: var(--border2) transparent;
    }

        .tbl-scroll::-webkit-scrollbar {
            width: 4px;
        }

        .tbl-scroll::-webkit-scrollbar-thumb {
            background: var(--border2);
            border-radius: 10px;
        }

    .pro-tbl {
        width: 100%;
        border-collapse: collapse;
    }

        .pro-tbl thead th {
            background: var(--surface2);
            color: var(--text3);
            padding: 10px 16px;
            font-size: 10px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1px;
            white-space: nowrap;
            font-family: var(--font-b);
            position: sticky;
            top: 0;
            z-index: 10;
            border-bottom: 1px solid var(--border2);
            text-align: left;
        }

        .pro-tbl tbody tr {
            border-bottom: 1px solid var(--border);
            transition: background .12s;
        }

            .pro-tbl tbody tr:hover {
                background: var(--surface2);
            }

            .pro-tbl tbody tr:last-child {
                border-bottom: none;
            }

        .pro-tbl tbody td {
            padding: 11px 16px;
            font-size: 13px;
            color: var(--text2);
            white-space: nowrap;
            font-weight: 600;
        }

    .tbl-btn {
        width: 30px;
        height: 30px;
        border-radius: var(--r);
        border: 1px solid transparent;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 11px;
        transition: all .15s;
    }

    .tbl-edit {
        background: var(--blue-g);
        color: var(--blue);
        border-color: rgba(78,157,255,.20);
    }

        .tbl-edit:hover {
            background: var(--blue);
            color: #fff;
            border-color: var(--blue);
        }

    .tbl-del {
        background: rgba(239,68,68,.08);
        color: var(--danger);
        border-color: rgba(239,68,68,.20);
        margin-left: 4px;
    }

        .tbl-del:hover {
            background: var(--danger);
            color: #fff;
            border-color: var(--danger);
        }

    .badge {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        font-size: 10.5px;
        font-weight: 700;
        padding: 3px 10px;
        border-radius: 20px;
        font-family: var(--font-b);
    }

    .badge-active {
        background: rgba(16,185,129,.10);
        color: #059669;
        border: 1px solid rgba(16,185,129,.25);
    }

    .badge-inactive {
        background: rgba(239,68,68,.08);
        color: var(--danger);
        border: 1px solid rgba(239,68,68,.20);
    }

    .badge i {
        font-size: 6px;
    }

    .img-link {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        color: var(--blue);
        font-size: 11.5px;
        font-family: var(--font-m);
        text-decoration: none;
        padding: 3px 9px;
        background: var(--blue-g);
        border-radius: 5px;
        border: 1px solid rgba(78,157,255,.20);
        transition: all .2s;
    }

        .img-link:hover {
            background: var(--blue);
            color: #fff;
            border-color: var(--blue);
        }

    .empty-state {
        padding: 70px 20px;
        text-align: center;
    }

    .empty-icon {
        width: 60px;
        height: 60px;
        background: var(--surface2);
        border-radius: var(--r2);
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--text3);
        font-size: 22px;
        margin: 0 auto 16px;
        border: 1px solid var(--border2);
    }

    .empty-title {
        font-family: var(--font-h);
        font-size: 15px;
        font-weight: 600;
        color: var(--text2);
        margin-bottom: 5px;
    }

    .empty-sub {
        font-size: 12px;
        color: var(--text3);
        font-weight: 500;
    }

    .pg-footer {
        margin-top: 18px;
        padding-top: 14px;
        border-top: 1px solid var(--border2);
        text-align: center;
        font-family: var(--font-m);
        font-size: 10.5px;
        color: var(--text3);
        letter-spacing: .5px;
    }

        .pg-footer strong {
            color: var(--blue);
            font-weight: 500;
        }

        .pg-footer .heart {
            color: var(--coral);
        }
    @@keyframes fadeDown {
        from

    {
        opacity: 0;
        transform: translateY(-16px)
    }

    to {
        opacity: 1;
        transform: translateY(0)
    }

    }
    @@keyframes slideUp {
        from

    {
        opacity: 0;
        transform: translateY(20px)
    }

    to {
        opacity: 1;
        transform: translateY(0)
    }

    }
    @@media (max-width: 768px) {
        .sr-root

    {
        padding: 14px;
    }

    .frow-2, .frow-desc-timer {
        grid-template-columns: 1fr;
    }

    .page-header {
        flex-wrap: wrap;
        gap: 12px;
    }

    }
</style>

<div class="sr-root">
    <div class="sr-inner">
        <div class="page-header">
            <div class="ph-left">
                <div class="ph-icon"><i class="fas fa-box-open"></i></div>
                <div>
                    <div class="ph-title">Product <span>Registry</span></div>
                    <div class="ph-breadcrumb">Setup <i class="fas fa-chevron-right"></i> <span class="bc-cur">Product</span></div>
                </div>
            </div>
            <div class="view-toggle">
                <button class="vt-btn vt-btn-ghost" id="gridViewToggleBtn"><i class="fas fa-table-cells"></i> Grid View</button>
                <button class="vt-btn vt-btn-active" id="formViewToggleBtn" style="display:none;"><i class="fas fa-pen-to-square"></i> Form View</button>
            </div>
        </div>
        <div class="divider"><span></span><span></span><span></span></div>

        <!-- FORM VIEW -->
        <div id="formViewContainer">
            <div class="form-card">
                <div class="fc-header">
                    <div class="fc-header-left">
                        <div class="fc-icon"><i class="fas fa-box-open"></i></div>
                        <div><div class="fc-title">Product Registration</div><div class="fc-sub">Add or update a product</div></div>
                    </div>
                    <div class="status-pill pill-live">Live</div>
                </div>
                <div class="fc-body">
                    <input style="display:none;" type="text" id="ProductId">
                    <input style="display:none;" type="text" id="ProductImageAttachmentOld">

                    <div class="sec-label"><div class="sec-label-bar slb-blue"></div><span class="sec-label-txt">Basic Details</span></div>
                    <div class="frow frow-1">
                        <div class="fg">
                            <input type="text" id="Product" class="fc" placeholder=" ">
                            <label class="fl" for="Product">Product Name</label>
                        </div>
                    </div>
                    <div class="frow frow-desc-timer">
                        <div class="fg is-area">
                            <textarea id="ProductDescription" class="fc" placeholder=" " rows="2"></textarea>
                            <label class="fl" for="ProductDescription">Product Description</label>
                        </div>
                        <div class="frow frow-1" style="margin-bottom:0;">
                            <div class="fg">
                                <input type="text" value="0" id="Prices" class="fc" placeholder=" " inputmode="decimal">
                                <label class="fl" for="Prices">Price</label>
                            </div>
                            <div class="fg">
                                <input type="text" value="0" id="DiscountAmount" class="fc" placeholder=" " inputmode="decimal">
                                <label class="fl" for="DiscountAmount">Discount Amount</label>
                            </div>
                        </div>
                    </div>
                    <div class="frow frow-2">
                        <div class="fg always-up">
                            <select id="CategoryId" class="fc"><option value="">— Select Category —</option></select>
                            <label class="fl" for="CategoryId">Category</label>
                        </div>
                        <div class="fg always-up">
                            <select id="VendorId" class="fc"><option value="">— Select Vendor —</option></select>
                            <label class="fl" for="VendorId">Vendor</label>
                        </div>
                    </div>

                    <div class="sec-label" style="margin-top:6px;"><div class="sec-label-bar slb-amber"></div><span class="sec-label-txt">Status &amp; Media</span></div>
                    <div class="frow frow-2" style="margin-bottom:20px;">
                        <div>
                            <div class="status-meta"><i class="fas fa-toggle-on"></i> Product Status</div>
                            <div class="check-group">
                                <input type="checkbox" id="IsActive" class="check-input">
                                <label class="check-label" for="IsActive">Mark as Active</label>
                            </div>
                        </div>
                        <div>
                            <div class="media-meta"><i class="fas fa-image"></i> Product Image <span style="font-size:9px;color:var(--text3);text-transform:none;letter-spacing:0;font-family:var(--font-b);font-weight:500;">(Max 500 KB · JPEG/PNG)</span></div>
                            <label for="ProductImageAttachment" class="upload-zone">
                                <div class="upload-icon"><i class="fas fa-cloud-arrow-up"></i></div>
                                <div><div class="upload-title" id="fileNameDisplay">Click to browse</div><div class="upload-sub">JPEG or PNG · max 500 KB</div></div>
                            </label>
                            <input id="ProductImageAttachment" class="hidden-file" type="file" accept=".jpeg,.png,.jpg">
                        </div>
                    </div>
                    <div class="btn-row">
                        <button class="btn btn-primary" id="saveBtn"><i class="fas fa-floppy-disk"></i> Save Product</button>
                        <button class="btn btn-secondary" id="cancelBtn"><i class="fas fa-xmark"></i> Cancel</button>
                        <a class="btn btn-view" id="ViewImageBtn" target="_blank"><i class="fas fa-eye"></i> View Image</a>
                    </div>
                </div>
            </div>
        </div>

        <!-- GRID VIEW -->
        <div id="gridViewContainer" style="display:none;">
            <div class="grid-card">
                <div class="gc-header">
                    <div class="gc-header-left">
                        <div class="gc-icon"><i class="fas fa-table-list"></i></div>
                        <div><div class="gc-title">All Products</div></div>
                        <div class="gc-badge" id="TotalProductsCount">0 records</div>
                    </div>
                    <div class="status-pill pill-live">Live Data</div>
                </div>
                <div class="tbl-scroll"><div id="ProductGridContainer"></div></div>
            </div>
        </div>

        <div class="pg-footer">Developed with <span class="heart">♥</span> by <strong>UT Designer</strong></div>
    </div>
</div>

<script>
    let userId = localStorage.getItem("userId") || "", GridViewDataList = [], IsUpdate = false;
    const SW = { background: '#ffffff', color: '#1e2a3a', confirmButtonColor: '#4e9dff', cancelButtonColor: '#f8f9fc' };

    function initFloatLabels() {
        document.querySelectorAll('.fg').forEach(g => {
            if (g.classList.contains('always-up')) return;
            const el = g.querySelector('input:not([type="checkbox"]):not([type="file"]):not([style*="display:none"]),textarea,select');
            if (!el) return;
            const chk = () => g.classList.toggle('has-value', el.value !== '');
            el.addEventListener('input', chk); el.addEventListener('change', chk); chk();
        });
    }

    function showFormView() {
        document.getElementById("formViewContainer").style.display = "block";
        document.getElementById("gridViewContainer").style.display = "none";
        document.getElementById("formViewToggleBtn").style.display = "none";
        document.getElementById("gridViewToggleBtn").style.display = "inline-flex";
        document.getElementById("gridViewToggleBtn").className = "vt-btn vt-btn-ghost";
        document.getElementById("Product").focus();
    }
    function showGridView() {
        document.getElementById("formViewContainer").style.display = "none";
        document.getElementById("gridViewContainer").style.display = "block";
        document.getElementById("gridViewToggleBtn").style.display = "none";
        document.getElementById("formViewToggleBtn").style.display = "inline-flex";
        document.getElementById("formViewToggleBtn").className = "vt-btn vt-btn-active";
    }
    document.getElementById("gridViewToggleBtn").addEventListener("click", showGridView);
    document.getElementById("formViewToggleBtn").addEventListener("click", showFormView);

    document.getElementById("ProductImageAttachment").addEventListener("change", async function () {
        const file = this.files[0]; if (!file) return;
        if (file.size > 500 * 1024) {
            this.value = ""; document.getElementById("fileNameDisplay").textContent = "Click to browse";
            await Swal.fire({ icon: 'warning', title: 'File Too Large', text: 'Image must be under 500 KB.', returnFocus: false, ...SW });
        } else { document.getElementById("fileNameDisplay").textContent = file.name; }
    });

    function GetProductImageAttachmentFile() {
        return new Promise(resolve => {
            const fileInput = document.getElementById("ProductImageAttachment"), file = fileInput.files[0];
            if (!file) { resolve({ ProductImageAttachmentfilename: "", ProductImageAttachmentbase64: "" }); return; }
            const reader = new FileReader();
            reader.onload = function (e) {
                const product = document.getElementById("Product").value.trim(),
                    now = new Date(), pad = n => n.toString().padStart(2, "0"),
                    ts = `${pad(now.getDate())}${pad(now.getMonth()+1)}${now.getFullYear()}${pad(now.getHours())}${pad(now.getMinutes())}`,
                    ext = file.name.split(".").pop();
                resolve({ ProductImageAttachmentfilename: `${product}_${ts}.${ext}`, ProductImageAttachmentbase64: e.target.result });
            };
            reader.onerror = () => resolve({ ProductImageAttachmentfilename: "", ProductImageAttachmentbase64: "" });
            reader.readAsDataURL(file);
        });
    }

    window.addEventListener("load", async function () { initFloatLabels(); await LoadProductRegistrationData(); await LoadGridViewData(); });

    async function LoadProductRegistrationData() {
        try {
            const r = await jQuery.ajax({ type: 'POST', url: '@Url.Action("nLoadProductRegistrationData", "ProductRegistration")', data: JSON.stringify({ Userid: userId }), contentType: 'application/json' });
            if (r.statusId === 1) {
                const cs = document.getElementById("CategoryId"); cs.innerHTML = '<option value="">— Select Category —</option>';
                r.CategoryList.forEach(i => { cs.innerHTML += `<option value="${i.CategoryId}">${i.Category}</option>`; });
                const vs = document.getElementById("VendorId"); vs.innerHTML = '<option value="">— Select Vendor —</option>';
                r.VendorList.forEach(i => { vs.innerHTML += `<option value="${i.VendorId}">${i.Vendor}</option>`; });
            } else await Swal.fire({ icon: 'warning', title: 'Warning', text: r.message || 'Failed', ...SW });
        } catch { await Swal.fire({ icon: 'error', title: 'Error', text: 'Error loading data', ...SW }); }
    }

    async function LoadGridViewData() {
        try {
            const r = await jQuery.ajax({ type: 'POST', url: '@Url.Action("nLoadGridViewData", "ProductRegistration")', data: JSON.stringify({ Userid: userId }), contentType: 'application/json' });
            if (r.statusId === 1) { GridViewDataList = r.GridViewDataList || []; RenderGridView(); }
            else await Swal.fire({ icon: 'warning', title: 'Warning', text: r.message || 'Failed', ...SW });
        } catch { await Swal.fire({ icon: 'error', title: 'Error', text: 'Error loading grid', ...SW }); }
    }

    function gv(item, names, def = '') { for (let n of names) { if (item[n] !== undefined && item[n] !== null) return item[n]; } return def; }

    function RenderGridView() {
        const c = document.getElementById("ProductGridContainer"), cnt = document.getElementById("TotalProductsCount");
        if (!GridViewDataList.length) {
            c.innerHTML = `<div class="empty-state"><div class="empty-icon"><i class="fas fa-box-open"></i></div><div class="empty-title">No Products Found</div><div class="empty-sub">Click "Form View" to add your first product.</div></div>`;
            cnt.textContent = "0 records"; return;
        }
        const t = document.createElement("table"); t.className = "pro-tbl";
        t.innerHTML = `<thead><tr><th>Actions</th><th>Code</th><th>Product Name</th><th>Description</th><th>Category</th><th>Vendor</th><th>Price</th><th>Discount</th><th>Status</th><th>Image</th></tr></thead>`;
        const tb = document.createElement("tbody");
        GridViewDataList.forEach(item => {
            const tr = document.createElement("tr");
            tr.innerHTML = `<td>
                <button class="tbl-btn tbl-edit" onclick="EditProduct(${item.ProductCode})" title="Edit"><i class="fas fa-pen"></i></button>
                <button class="tbl-btn tbl-del"  onclick="DeleteProduct(${item.ProductCode})" title="Delete"><i class="fas fa-trash-can"></i></button>
            </td>
            <td>${item.ProductCode || ''}</td>
            <td>${gv(item, ['Product Name','ProductName','Product'])}</td>
            <td>${gv(item, ['Product Description','ProductDescription','Description'], '—')}</td>
            <td>${gv(item, ['CategoryId Name','Category','CategoryName'], '—')}</td>
            <td>${gv(item, ['VendorId Name','Vendor','VendorName'], '—')}</td>
            <td>${item.Prices || '0'}</td>
            <td>${gv(item, ['Discount Amount','DiscountAmount'], '0')}</td>
            <td>${item['Is Active'] ? '<span class="badge badge-active"><i class="fas fa-circle"></i> Active</span>' : '<span class="badge badge-inactive"><i class="fas fa-circle"></i> Inactive</span>'}</td>
            <td>${item.ProductImage ? `<a class="img-link" href="${item.ProductImage}" target="_blank"><i class="fas fa-eye"></i> View</a>` : '<span style="color:var(--text3);font-size:11px;">—</span>'}</td>`;
            tb.appendChild(tr);
        });
        t.appendChild(tb); c.innerHTML = ""; c.appendChild(t);
        cnt.textContent = `${tb.rows.length} record${tb.rows.length !== 1 ? 's' : ''}`;
    }

    function EditProduct(productId) {
        const p = GridViewDataList.find(c => parseInt(c.ProductCode) === parseInt(productId));
        if (!p) { Swal.fire({ icon: 'error', title: 'Error', text: 'Not found.', ...SW }); return; }
        document.getElementById("ProductId").value          = p.ProductCode || '';
        document.getElementById("Product").value            = gv(p, ['Product Name','ProductName','Product']);
        document.getElementById("ProductDescription").value = gv(p, ['Product Description','ProductDescription','Description']);
        document.getElementById("Prices").value             = p.Prices || '0';
        document.getElementById("DiscountAmount").value     = gv(p, ['Discount Amount','DiscountAmount'], '0');
        document.getElementById("IsActive").checked         = p['Is Active'] === true || p['Is Active'] === 1;
        document.getElementById("CategoryId").value         = p.ProductCategoryId || p.CategoryId || '';
        document.getElementById("VendorId").value           = p.ProductVendorId   || p.VendorId   || '';
        if (p.ProductImage) {
            document.getElementById("ProductImageAttachmentOld").value = p.ProductImage;
            const vb = document.getElementById("ViewImageBtn"); vb.href = p.ProductImage; vb.classList.add("show");
        } else { document.getElementById("ProductImageAttachmentOld").value = ""; document.getElementById("ViewImageBtn").classList.remove("show"); }
        IsUpdate = true;
        document.getElementById("saveBtn").innerHTML = '<i class="fas fa-floppy-disk"></i> Update Product';
        initFloatLabels(); showFormView();
    }

    async function DeleteProduct(productId) {
        const r = await Swal.fire({ title: 'Delete Product?', text: 'Cannot be undone.', icon: 'warning', showCancelButton: true, confirmButtonText: 'Yes, Delete', cancelButtonText: 'Cancel', confirmButtonColor: '#ef4444', ...SW });
        if (!r.isConfirmed) return;
        const p = GridViewDataList.find(c => parseInt(c.ProductCode) === parseInt(productId));
        if (!p) { await Swal.fire({ icon: 'error', title: 'Error', text: 'Not found.', ...SW }); return; }
        let img = ""; if (p.ProductImage) { const parts = p.ProductImage.split('/'); img = parts[parts.length - 1]; }
        Swal.fire({ title: 'Please wait', text: 'Deleting...', allowOutsideClick: false, allowEscapeKey: false, didOpen: () => Swal.showLoading(), ...SW });
        try {
            const res = await jQuery.ajax({ type: 'POST', url: '@Url.Action("nDeleteProductRegistrationData", "ProductRegistration")', data: JSON.stringify({ Userid: userId, ProductId: `${productId}`, ProductImageAttachmentfilenameold: img, FtpPath: "/wwwroot/Images/ProductRegistration" }), contentType: 'application/json' });
            Swal.close();
            if (res.statusId === 1) { await Swal.fire({ icon: 'success', title: 'Deleted!', text: res.message || 'Deleted.', ...SW }); await LoadGridViewData(); }
            else await Swal.fire({ icon: 'warning', title: 'Failed', text: res.message || 'Could not delete.', ...SW });
        } catch { Swal.close(); await Swal.fire({ icon: 'error', title: 'Error', text: 'An error occurred.', ...SW }); }
    }

    document.getElementById("saveBtn").addEventListener("click", async function () {
        const ProductId = document.getElementById("ProductId").value.trim(),
              Product = document.getElementById("Product").value.trim(),
              ProductDescription = document.getElementById("ProductDescription").value.trim(),
              CategoryId = document.getElementById("CategoryId").value.trim(),
              VendorId = document.getElementById("VendorId").value.trim(),
              Prices = document.getElementById("Prices").value.trim(),
              DiscountAmount = document.getElementById("DiscountAmount").value.trim(),
              isActive = document.getElementById("IsActive").checked,
              ProductImageAttachmentold = document.getElementById("ProductImageAttachmentOld").value.trim();

        const validations = [
            { cond: !Product,                                                   text: 'Product name is required',        focus: 'Product' },
            { cond: !ProductDescription,                                        text: 'Product description is required', focus: 'ProductDescription' },
            { cond: !CategoryId,                                                text: 'Please select a category',        focus: 'CategoryId' },
            { cond: !VendorId,                                                  text: 'Please select a vendor',          focus: 'VendorId' },
            { cond: !Prices || isNaN(Prices) || parseFloat(Prices) <= 0,       text: 'Please enter a valid price',      focus: 'Prices' },
        ];
        for (const v of validations) {
            if (v.cond) { await Swal.fire({ icon: 'warning', title: 'Validation', text: v.text, returnFocus: false, ...SW, didClose: () => document.getElementById(v.focus).focus() }); return; }
        }

        const { ProductImageAttachmentfilename, ProductImageAttachmentbase64 } = await GetProductImageAttachmentFile();
        const payload = { Userid: userId, ProductId, Product, ProductDescription, CategoryId, VendorId, ProductImageAttachmentfilename, ProductImageAttachmentfilenameold: ProductImageAttachmentold, ProductImageAttachmentbase64, Prices, DiscountAmount: DiscountAmount || "0", IsActive: isActive, IsUpdate, FtpPath: "/wwwroot/Images/ProductRegistration" };

        Swal.fire({ title: 'Please wait', text: 'Saving...', allowOutsideClick: false, allowEscapeKey: false, didOpen: () => Swal.showLoading(), ...SW });
        try {
            const res = await jQuery.ajax({ type: 'POST', url: '@Url.Action("nSaveProductRegistrationData", "ProductRegistration")', data: JSON.stringify(payload), contentType: 'application/json' });
            Swal.close();
            if (res.statusId === 1) { await Swal.fire({ icon: 'success', title: 'Saved!', text: res.message || 'Saved.', returnFocus: false, ...SW, didClose: () => document.getElementById("Product").focus() }); nClearForm(); }
            else await Swal.fire({ icon: 'warning', title: 'Failed', text: res.message || 'Could not save.', ...SW });
        } catch { Swal.close(); await Swal.fire({ icon: 'error', title: 'Error', text: 'An error occurred.', ...SW }); }
    });

    document.getElementById("cancelBtn").addEventListener("click", function () { nClearForm(); });

    async function nClearForm() {
        ["ProductId","ProductImageAttachmentOld","Product","ProductDescription"].forEach(id => document.getElementById(id).value = "");
        document.getElementById("CategoryId").value = ""; document.getElementById("VendorId").value = "";
        document.getElementById("IsActive").checked = false;
        document.getElementById("ProductImageAttachment").value = "";
        document.getElementById("fileNameDisplay").textContent = "Click to browse";
        document.getElementById("Prices").value = "0"; document.getElementById("DiscountAmount").value = "0";
        IsUpdate = false;
        document.getElementById("saveBtn").innerHTML = '<i class="fas fa-floppy-disk"></i> Save Product';
        document.getElementById("ViewImageBtn").classList.remove("show");
        initFloatLabels(); document.getElementById("Product").focus();
        await LoadGridViewData();
    }

    [document.getElementById("Prices"), document.getElementById("DiscountAmount")].forEach(input => {
        input.addEventListener("keydown", function (e) {
            if ([8,9,27,13,46].includes(e.keyCode) || (e.ctrlKey && [65,67,86,88].includes(e.keyCode)) || (e.keyCode >= 35 && e.keyCode <= 39)) return;
            if ((e.shiftKey || (e.keyCode < 48 || e.keyCode > 57)) && (e.keyCode < 96 || e.keyCode > 105) && e.keyCode !== 110 && e.keyCode !== 190) e.preventDefault();
        });
        input.addEventListener("paste", function () { setTimeout(() => { this.value = this.value.replace(/[^0-9.]/g, ''); }, 10); });
    });
</script>
