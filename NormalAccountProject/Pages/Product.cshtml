@page "/Product"
@model NormalAccountProject.Pages.ProductModel
@{
    ViewData["Title"] = "Product Registration";
}

<div class="section__content section__content--p30">
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-12">
                <div class="overview-wrap d-flex justify-content-between align-items-center">
                    <h2 class="title-1">Product Registration</h2>
                    <div>
                        <button class="btn btn-info" id="gridViewToggleBtn">
                            <i class="fas fa-table me-2"></i>Grid View
                        </button>
                        <button class="btn btn-primary" id="formViewToggleBtn" style="display:none;">
                            <i class="fas fa-form me-2"></i>Form View
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <hr>

        <!-- FORM VIEW -->
        <div id="formViewContainer">
            <div class="row mt-3">
                <div class="col-md-6">
                    <!-- Hidden Fields -->
                    <input style="display:none;" type="text" id="ProductId">
                    <input style="display:none;" type="text" id="ProductImageAttachmentOld">

                    <!-- Row 1: Product Name -->
                    <div class="row mb-3">
                        <div class="col-md-12">
                            <label for="Product">Product Name *</label>
                            <input type="text" id="Product" class="form-control" placeholder="Enter Product Name">
                        </div>
                    </div>

                    <!-- Row 2: Prices & Discount Amount -->
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label for="Prices">Prices *</label>
                            <input type="text" id="Prices" class="form-control" placeholder="Enter Prices" inputmode="decimal">
                        </div>
                        <div class="col-md-6">
                            <label for="DiscountAmount">Discount Amount</label>
                            <input type="text" id="DiscountAmount" class="form-control" placeholder="Enter Discount Amount" inputmode="decimal">
                        </div>
                    </div>

                    <!-- Row 3: Category -->
                    <div class="row mb-3">
                        <div class="col-md-12">
                            <label for="CategoryId">Category *</label>
                            <select id="CategoryId" class="form-control">
                                <option value="">-- Select Category --</option>
                            </select>
                        </div>
                    </div>

                    <!-- Row 4: Vendor -->
                    <div class="row mb-3">
                        <div class="col-md-12">
                            <label for="VendorId">Vendor *</label>
                            <select id="VendorId" class="form-control">
                                <option value="">-- Select Vendor --</option>
                            </select>
                        </div>
                    </div>

                    <!-- Row 5: IsActive -->
                    <div class="row mb-3">
                        <div class="col-md-6 d-flex align-items-center">
                            <div class="form-check">
                                <input type="checkbox" id="IsActive" class="form-check-input">
                                <label class="form-check-label" for="IsActive">Is Active</label>
                            </div>
                        </div>
                    </div>

                    <!-- Row 6: Product Image -->
                    <div class="row mb-3">
                        <div class="col-md-12" style="display: grid;">
                            <label>Product Image (Max Size 500KB)*</label>
                            <input id="ProductImageAttachment" style="height: fit-content;background: white;padding: 5px;" type="file" accept=".jpeg,.png,.jpg" required>
                        </div>
                    </div>

                    <!-- Row 7: Buttons -->
                    <div class="row mb-3">
                        <div class="col-md-12 d-flex align-items-end">
                            <button class="btn btn-success me-2" id="saveBtn">Save</button>
                            <button class="btn btn-secondary me-2" id="cancelBtn">Cancel</button>
                            <a class="btn btn-warning" style="display:none;" id="ViewImageBtn" target="_blank">
                                View Image
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- GRID VIEW -->
        <div id="gridViewContainer" style="display:none;">
            <div class="row mt-5">
                <div class="col-md-12">
                    <div id="ProductGridContainer" class="table-responsive" style="height: 62vh; overflow-y: auto;"></div>
                    <div class="mt-3" style="text-align:center;">
                        <p>Total Products (<span id="TotalProductsCount">0</span>)</p>
                    </div>
                </div>
            </div>
        </div>

        <hr>

        <div class="row">
            <div class="col-md-12">
                <div class="copyright">
                    <p style="margin: 0;">Software Developed By : <span style="font-weight:600;">AV_Softs</span></p>
                </div>
            </div>
        </div>

    </div>
</div>

<script>
    // Variable Declaration
    let userId = localStorage.getItem("userId") || "";
    let GridViewDataList = [];
    let IsUpdate = false;

    // VIEW TOGGLE FUNCTIONS
    function showFormView() {
        document.getElementById("formViewContainer").style.display = "block";
        document.getElementById("gridViewContainer").style.display = "none";
        document.getElementById("formViewToggleBtn").style.display = "none";
        document.getElementById("gridViewToggleBtn").style.display = "inline-block";
        document.getElementById("Product").focus();
    }

    function showGridView() {
        document.getElementById("formViewContainer").style.display = "none";
        document.getElementById("gridViewContainer").style.display = "block";
        document.getElementById("gridViewToggleBtn").style.display = "none";
        document.getElementById("formViewToggleBtn").style.display = "inline-block";
    }

    document.getElementById("gridViewToggleBtn").addEventListener("click", showGridView);
    document.getElementById("formViewToggleBtn").addEventListener("click", showFormView);

    // Product Image Validation
    document.getElementById("ProductImageAttachment").addEventListener("change", async function () {
        const file = this.files[0];
        if (!file) return;

        const maxSize = 500 * 1024;
        if (file.size > maxSize) {
            this.value = "";
            await Swal.fire({
                icon: 'warning',
                title: 'Validation',
                text: 'Image size must be less than 500 KB.',
                returnFocus: false,
                didClose: () => {
                    document.getElementById("ProductImageAttachment").focus();
                }
            });
        }
    });

    function GetProductImageAttachmentFile() {
        return new Promise((resolve, reject) => {
            const fileInput = document.getElementById("ProductImageAttachment");
            const file = fileInput.files[0];

            if (!file) {
                resolve({ ProductImageAttachmentfilename: "", ProductImageAttachmentbase64: "" });
                return;
            }

            const reader = new FileReader();

            reader.onload = function (e) {
                const product = document.getElementById("Product").value.trim();
                const now = new Date();
                const pad = (num) => num.toString().padStart(2, "0");

                const dd = pad(now.getDate());
                const MM = pad(now.getMonth() + 1);
                const yyyy = now.getFullYear();
                const hh = pad(now.getHours());
                const mm = pad(now.getMinutes());
                const timestamp = `${dd}${MM}${yyyy}${hh}${mm}`;

                const extension = file.name.split('.').pop();
                const filename = `${product}_${timestamp}.${extension}`;

                resolve({
                    ProductImageAttachmentfilename: filename,
                    ProductImageAttachmentbase64: e.target.result
                });
            };

            reader.onerror = function () {
                reject(new Error("File read error"));
            };

            reader.readAsDataURL(file);
        });
    }

    // PAGE LOAD
    window.addEventListener("load", async function () {
        await LoadProductRegistrationData();
        await LoadGridViewData();
    });

    // Load Product Registration Data
    async function LoadProductRegistrationData() {
        const nInfoTab = {
            Userid: userId,
        };

        try {
            const response = await jQuery.ajax({
                type: 'POST',
                url: '@Url.Action("nLoadProductRegistrationData", "ProductRegistration")',
                data: JSON.stringify(nInfoTab),
                contentType: 'application/json'
            });

            if (response.statusId === 1) {
                // Populate Category Dropdown
                const categorySelect = document.getElementById("CategoryId");
                categorySelect.innerHTML = '<option value="">-- Select Category --</option>';
                response.CategoryList.forEach(item => {
                    categorySelect.innerHTML += `<option value="${item.CategoryId}">${item.Category}</option>`;
                });

                // Populate Vendor Dropdown
                const vendorSelect = document.getElementById("VendorId");
                vendorSelect.innerHTML = '<option value="">-- Select Vendor --</option>';
                response.VendorList.forEach(item => {
                    vendorSelect.innerHTML += `<option value="${item.VendorId}">${item.Vendor}</option>`;
                });

            } else {
                await Swal.fire({
                    icon: 'warning',
                    title: 'Product Registration',
                    text: response.message || 'Failed to load data'
                });
            }

        } catch (xhr) {
            await Swal.fire({
                icon: 'error',
                title: 'Error',
                text: 'An error occurred while loading data'
            });
            console.error("LoadProductRegistrationData Error:", xhr);
        }
    }

    // Load Grid View Data
    async function LoadGridViewData() {
        const nInfoTab = {
            Userid: userId,
        };

        try {
            const response = await jQuery.ajax({
                type: 'POST',
                url: '@Url.Action("nLoadGridViewData", "ProductRegistration")',
                data: JSON.stringify(nInfoTab),
                contentType: 'application/json'
            });

            if (response.statusId === 1) {
                GridViewDataList = response.GridViewDataList || [];
                document.getElementById("TotalProductsCount").textContent = GridViewDataList.length;
                RenderGridView();

            } else {
                await Swal.fire({
                    icon: 'warning',
                    title: 'Grid View',
                    text: response.message || 'Failed to load grid data'
                });
            }

        } catch (xhr) {
            await Swal.fire({
                icon: 'error',
                title: 'Error',
                text: 'An error occurred while loading grid view'
            });
            console.error("LoadGridViewData Error:", xhr);
        }
    }

    // Render Grid View
    function RenderGridView() {
        const container = document.getElementById("ProductGridContainer");

        if (GridViewDataList.length === 0) {
            container.innerHTML = `<p style="text-align:center; margin-top:20px;">No products available</p>`;
            return;
        }

        let tableHTML = `
            <table class="table table-bordered table-striped">
                <thead class="thead-dark">
                    <tr>
                        <th>Product Code</th>
                        <th>Product Name</th>
                        <th>Category</th>
                        <th>Vendor</th>
                        <th>Prices</th>
                        <th>Discount Amount</th>
                        <th>Is Active</th>
                        <th>Product Image</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
        `;

        GridViewDataList.forEach(item => {
            tableHTML += `
                <tr>
                    <td>${item.ProductCode || ''}</td>
                    <td>${item['Product Name'] || ''}</td>
                    <td>${item['CategoryId Name'] || ''}</td>
                    <td>${item['VendorId Name'] || ''}</td>
                    <td>${item.Prices || '0'}</td>
                    <td>${item['Discount Amount'] || '0'}</td>
                    <td>${item['Is Active'] ? 'Yes' : 'No'}</td>
                    <td>
                        ${item.ProductImage ? `<a href="${item.ProductImage}" target="_blank">View Image</a>` : 'No Image'}
                    </td>
                    <td>
                        <button class="btn btn-sm btn-primary" onclick='EditProduct(${item.ProductCode})'>Edit</button>
                        <button class="btn btn-sm btn-danger" onclick='DeleteProduct(${item.ProductCode})'>Delete</button>
                    </td>
                </tr>
            `;
        });

        tableHTML += `
                </tbody>
            </table>
        `;

        container.innerHTML = tableHTML;
    }

    // ✅ FIXED - Edit Product Function
    function EditProduct(productId) {
        console.log("Edit clicked for ProductCode:", productId);
        console.log("GridViewDataList:", GridViewDataList);

        const product = GridViewDataList.find(c => parseInt(c.ProductCode) === parseInt(productId));

        if (!product) {
            Swal.fire({
                icon: 'error',
                title: 'Error',
                text: 'Product not found. ProductCode: ' + productId
            });
            console.error("Product not found:", productId);
            return;
        }

        console.log("Found product:", product);

        document.getElementById("ProductId").value = product.ProductCode || '';
        document.getElementById("Product").value = product['Product Name'] || '';
        document.getElementById("CategoryId").value = product.CategoryId || '';
        document.getElementById("VendorId").value = product.VendorId || '';
        document.getElementById("Prices").value = product.Prices || '0';
        document.getElementById("DiscountAmount").value = product['Discount Amount'] || '0';
        document.getElementById("IsActive").checked = product['Is Active'] === true || product['Is Active'] === 1;

        if (product.ProductImage) {
            document.getElementById("ProductImageAttachmentOld").value = product.ProductImage;
            document.getElementById("ViewImageBtn").href = product.ProductImage;
            document.getElementById("ViewImageBtn").style.display = "inline-block";
        } else {
            document.getElementById("ProductImageAttachmentOld").value = "";
            document.getElementById("ViewImageBtn").style.display = "none";
        }

        IsUpdate = true;
        document.getElementById("saveBtn").textContent = "Update";
        showFormView();
    }

    // ✅ COMPLETELY FIXED - Delete Product Function
    async function DeleteProduct(productId) {
        console.log("Delete clicked for ProductCode:", productId);
        console.log("GridViewDataList:", GridViewDataList);

        const result = await Swal.fire({
            title: 'Are you sure?',
            text: "You won't be able to revert this!",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#d33',
            cancelButtonColor: '#3085d6',
            confirmButtonText: 'Yes, delete it!'
        });

        if (!result.isConfirmed) return;

        // ✅ FIX: Convert to number for comparison
        const product = GridViewDataList.find(c => parseInt(c.ProductCode) === parseInt(productId));

        if (!product) {
            await Swal.fire({
                icon: 'error',
                title: 'Error',
                text: 'Product not found for deletion'
            });
            console.error("Product not found:", productId);
            return;
        }

        // ✅ CRITICAL FIX: Extract only filename from full URL
        let imageFilename = "";
        if (product.ProductImage) {
            // If it's a full URL like "http://192.168.100.243/ProductRegistration/image.jpg"
            // Extract only "image.jpg"
            const urlParts = product.ProductImage.split('/');
            imageFilename = urlParts[urlParts.length - 1];
        }

        console.log("Product to delete:", product);
        console.log("Image filename:", imageFilename);

        const nProductTab = {
            Userid: userId,
            ProductId: parseInt(productId),
            ProductImageAttachmentfilenameold: imageFilename // ✅ Only filename, not full URL
        };

        console.log("Sending to backend:", nProductTab);

        Swal.fire({
            title: 'Please wait',
            text: 'Deleting product...',
            allowOutsideClick: false,
            allowEscapeKey: false,
            didOpen: () => Swal.showLoading()
        });

        try {
            const response = await jQuery.ajax({
                type: 'POST',
                url: '@Url.Action("nDeleteProductRegistrationData", "ProductRegistration")',
                data: JSON.stringify(nProductTab),
                contentType: 'application/json'
            });

            console.log("Delete response:", response);

            Swal.close();

            if (response.statusId === 1) {
                await Swal.fire({
                    icon: 'success',
                    title: 'Product Deleted',
                    text: response.message || 'Product deleted successfully'
                });

                await LoadGridViewData();
            } else {
                await Swal.fire({
                    icon: 'warning',
                    title: 'Delete Failed',
                    text: response.message || 'Failed to delete product'
                });
            }

        } catch (error) {
            Swal.close();

            console.error("DeleteProduct Error:", error);

            // ✅ Show detailed error message
            let errorMessage = 'An error occurred while deleting product';

            if (error.responseJSON && error.responseJSON.message) {
                errorMessage = error.responseJSON.message;
            } else if (error.responseText) {
                errorMessage = error.responseText;
            } else if (error.statusText) {
                errorMessage = error.statusText;
            }

            await Swal.fire({
                icon: 'error',
                title: 'Error',
                text: errorMessage,
                footer: 'Check browser console for details (Press F12)'
            });
        }
    }

    // Save Button click
    document.getElementById("saveBtn").addEventListener("click", async function () {
        const ProductId = document.getElementById("ProductId").value.trim();
        const Product = document.getElementById("Product").value.trim();
        const CategoryId = document.getElementById("CategoryId").value.trim();
        const VendorId = document.getElementById("VendorId").value.trim();
        const Prices = document.getElementById("Prices").value.trim();
        const DiscountAmount = document.getElementById("DiscountAmount").value.trim();
        const isActive = document.getElementById("IsActive").checked;
        const productImageAttachment = document.getElementById("ProductImageAttachment").files.length > 0;
        const productImageAttachmentold = document.getElementById("ProductImageAttachmentOld").value.trim();

        // Validations
        if (!Product) {
            await Swal.fire({
                icon: 'warning',
                title: 'Validation',
                text: 'Product name is required',
                returnFocus: false,
                didClose: () => {
                    document.getElementById("Product").focus();
                }
            });
            return;
        }

        if (!CategoryId) {
            await Swal.fire({
                icon: 'warning',
                title: 'Validation',
                text: 'Please select category',
                returnFocus: false,
                didClose: () => {
                    document.getElementById("CategoryId").focus();
                }
            });
            return;
        }

        if (!VendorId) {
            await Swal.fire({
                icon: 'warning',
                title: 'Validation',
                text: 'Please select vendor',
                returnFocus: false,
                didClose: () => {
                    document.getElementById("VendorId").focus();
                }
            });
            return;
        }

        if (!Prices || isNaN(Prices) || parseFloat(Prices) <= 0) {
            await Swal.fire({
                icon: 'warning',
                title: 'Validation',
                text: 'Please enter valid price (numbers only)',
                returnFocus: false,
                didClose: () => {
                    document.getElementById("Prices").focus();
                }
            });
            return;
        }

        if (DiscountAmount && (isNaN(DiscountAmount) || parseFloat(DiscountAmount) < 0)) {
            await Swal.fire({
                icon: 'warning',
                title: 'Validation',
                text: 'Please enter valid discount amount (numbers only)',
                returnFocus: false,
                didClose: () => {
                    document.getElementById("DiscountAmount").focus();
                }
            });
            return;
        }

        if (!IsUpdate && !productImageAttachment) {
            await Swal.fire({
                icon: 'warning',
                title: 'Validation',
                text: 'Please select product image',
                returnFocus: false,
                didClose: () => {
                    document.getElementById("ProductImageAttachment").focus();
                }
            });
            return;
        }

        const { ProductImageAttachmentfilename, ProductImageAttachmentbase64 } = await GetProductImageAttachmentFile();

        const nProductTab = {
            Userid: userId,
            ProductId: ProductId,
            Product: Product,
            CategoryId: CategoryId,
            VendorId: VendorId,
            ProductImageAttachmentfilename: ProductImageAttachmentfilename,
            ProductImageAttachmentfilenameold: productImageAttachmentold,
            ProductImageAttachmentbase64: ProductImageAttachmentbase64,
            Prices: Prices,
            DiscountAmount: DiscountAmount || "0",
            IsActive: isActive,
            IsUpdate: IsUpdate,
        };

        Swal.fire({
            title: 'Please wait',
            text: 'Product registration is in process...',
            allowOutsideClick: false,
            allowEscapeKey: false,
            didOpen: () => Swal.showLoading()
        });

        try {
            const response = await jQuery.ajax({
                type: 'POST',
                url: '@Url.Action("nSaveProductRegistrationData", "ProductRegistration")',
                data: JSON.stringify(nProductTab),
                contentType: 'application/json'
            });

            Swal.close();

            if (response.statusId === 1) {
                await Swal.fire({
                    icon: 'success',
                    title: 'Product Registration',
                    text: response.message || 'Product saved successfully',
                    returnFocus: false,
                    didClose: () => {
                        document.getElementById("Product").focus();
                    }
                });

                nClearForm();

            } else {
                await Swal.fire({
                    icon: 'warning',
                    title: 'Product Registration',
                    text: response.message || 'Product save failed'
                });
            }

        } catch (xhr) {
            Swal.close();

            await Swal.fire({
                icon: 'error',
                title: 'Error',
                text: 'An error occurred while saving product'
            });

            console.error("SaveData Error:", xhr);
        }
    });

    // Cancel Button click
    document.getElementById("cancelBtn").addEventListener("click", function () {
        nClearForm();
    });

    async function nClearForm() {
        document.getElementById("ProductId").value = "";
        document.getElementById("ProductImageAttachmentOld").value = "";
        document.getElementById("Product").value = "";
        document.getElementById("CategoryId").value = "";
        document.getElementById("VendorId").value = "";
        document.getElementById("IsActive").checked = false;
        document.getElementById("ProductImageAttachment").value = "";
        document.getElementById("Prices").value = "";
        document.getElementById("DiscountAmount").value = "";
        IsUpdate = false;
        document.getElementById("saveBtn").textContent = "Save";
        document.getElementById("Product").focus();
        document.getElementById("ViewImageBtn").style.display = "none";
        await LoadGridViewData();
    }

    // Numeric Input Validation
    const pricesInput = document.getElementById("Prices");
    const discountInput = document.getElementById("DiscountAmount");

    [pricesInput, discountInput].forEach(input => {
        input.addEventListener("keydown", function (e) {
            if ([8, 9, 27, 13, 46].indexOf(e.keyCode) !== -1 ||
                (e.keyCode === 65 && (e.ctrlKey === true || e.metaKey === true)) ||
                (e.keyCode === 67 && (e.ctrlKey === true || e.metaKey === true)) ||
                (e.keyCode === 86 && (e.ctrlKey === true || e.metaKey === true)) ||
                (e.keyCode === 88 && (e.ctrlKey === true || e.metaKey === true)) ||
                (e.keyCode >= 35 && e.keyCode <= 39)) {
                return;
            }
            if ((e.shiftKey || (e.keyCode < 48 || e.keyCode > 57)) && (e.keyCode < 96 || e.keyCode > 105) && e.keyCode !== 110 && e.keyCode !== 190) {
                e.preventDefault();
            }
        });

        input.addEventListener("paste", function (e) {
            setTimeout(() => {
                this.value = this.value.replace(/[^0-9.]/g, '');
            }, 10);
        });
    });
</script>

<style>
    select.form-control {
        appearance: auto;
        -webkit-appearance: auto;
        -moz-appearance: auto;
    }

    .table-responsive {
        border: 1px solid #dee2e6;
        border-radius: 5px;
    }

    .table thead th {
        position: sticky;
        top: 0;
        background-color: #343a40;
        color: white;
        z-index: 10;
    }
</style>
