@page
@model NormalAccountProject.Pages.PurchaseInvoiceModel
@{
}

<link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;500;600;700;800&family=Rubik:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<style>
    :root {
        --bg: #f0f3f8;
        --surface: #ffffff;
        --surface2: #f8f9fc;
        --surface3: #eef1f8;
        --border: #eef0f6;
        --border2: #e2e6f0;
        --border3: #d4d9e8;
        --blue: #4e9dff;
        --blue-dark: #2d7dd2;
        --blue-g: rgba(78,157,255,.10);
        --blue-g2: rgba(78,157,255,.06);
        --teal: #00c9a7;
        --coral: #ff6b6b;
        --amber: #f59e0b;
        --green: #10b981;
        --danger: #ef4444;
        --text: #1e2a3a;
        --text2: #5a6478;
        --text3: #9ba3b8;
        --font-h: 'Rubik', sans-serif;
        --font-b: 'Nunito', sans-serif;
        --font-m: 'JetBrains Mono', monospace;
        --r: 8px;
        --r2: 12px;
        --r3: 16px;
        --sh: 0 2px 12px rgba(0,0,0,.06);
        --sh2: 0 4px 24px rgba(0,0,0,.09);
    }

    *, *::before, *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    .sr-root {
        font-family: var(--font-b);
        color: var(--text);
        background: var(--bg);
        min-height: calc(100vh - 60px);
        padding: 24px 28px 20px;
        overflow-y: auto;
        overflow-x: hidden;
        scrollbar-width: thin;
        scrollbar-color: var(--border2) transparent;
    }

    .sr-inner {
        max-width: 1400px;
        margin: 0 auto;
    }

    .page-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 22px;
        animation: fadeDown .4s ease both;
    }

    .ph-left {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .ph-icon {
        width: 46px;
        height: 46px;
        background: linear-gradient(135deg, var(--blue) 0%, var(--blue-dark) 100%);
        border-radius: var(--r2);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        font-size: 18px;
        box-shadow: 0 4px 16px rgba(78,157,255,.35);
        flex-shrink: 0;
    }

    .ph-title {
        font-family: var(--font-h);
        font-size: 21px;
        font-weight: 700;
        color: var(--text);
        line-height: 1.1;
    }

        .ph-title span {
            color: var(--blue);
        }

    .ph-breadcrumb {
        display: flex;
        align-items: center;
        gap: 5px;
        font-family: var(--font-m);
        font-size: 10px;
        color: var(--text3);
        letter-spacing: .4px;
        margin-top: 3px;
    }

        .ph-breadcrumb i {
            font-size: 7px;
        }

        .ph-breadcrumb .bc-cur {
            color: var(--blue);
            font-weight: 500;
        }

    .status-pill {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 4px 12px;
        border-radius: 20px;
        font-family: var(--font-m);
        font-size: 10.5px;
        font-weight: 500;
    }

    .pill-live {
        background: rgba(16,185,129,.10);
        color: var(--green);
        border: 1px solid rgba(16,185,129,.25);
    }

        .pill-live::before {
            content: '';
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: var(--green);
            animation: blink 1.8s ease-in-out infinite;
        }
    @@keyframes blink {
        0%,100%

    {
        opacity: 1
    }

    50% {
        opacity: .3
    }

    }

    .divider {
        display: flex;
        gap: 3px;
        height: 3px;
        margin-bottom: 20px;
        border-radius: 3px;
        overflow: hidden;
    }

        .divider span:nth-child(1) {
            flex: 3;
            background: var(--blue);
        }

        .divider span:nth-child(2) {
            flex: 1;
            background: var(--teal);
            opacity: .6;
        }

        .divider span:nth-child(3) {
            flex: 8;
            background: var(--border2);
        }

    .form-card {
        background: var(--surface);
        border-radius: var(--r3);
        border: 1px solid var(--border2);
        box-shadow: var(--sh2);
        overflow: hidden;
        animation: slideUp .35s cubic-bezier(.22,1,.36,1) both;
    }

    .fc-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 14px 22px;
        background: var(--surface2);
        border-bottom: 1px solid var(--border2);
        border-top: 3px solid var(--blue);
    }

    .fc-header-left {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .fc-icon {
        width: 32px;
        height: 32px;
        border-radius: var(--r);
        background: var(--blue-g);
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--blue);
        font-size: 13px;
    }

    .fc-title {
        font-family: var(--font-h);
        font-size: 14px;
        font-weight: 600;
        color: var(--text);
    }

    .fc-sub {
        font-size: 11px;
        color: var(--text3);
        font-weight: 500;
        margin-top: 1px;
    }

    .fc-body {
        padding: 24px 26px;
        max-height: 82vh;
        overflow-y: auto;
        scrollbar-width: thin;
        scrollbar-color: var(--border2) transparent;
    }

        .fc-body::-webkit-scrollbar {
            width: 4px;
        }

        .fc-body::-webkit-scrollbar-thumb {
            background: var(--border2);
            border-radius: 10px;
        }

    .sec-label {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 14px;
        padding-bottom: 10px;
        border-bottom: 1px dashed var(--border2);
    }

    .sec-label-bar {
        width: 3px;
        height: 14px;
        border-radius: 3px;
        flex-shrink: 0;
    }

    .slb-blue {
        background: linear-gradient(180deg, var(--blue), var(--teal));
    }

    .slb-teal {
        background: linear-gradient(180deg, var(--teal), var(--blue));
    }

    .slb-amber {
        background: linear-gradient(180deg, var(--amber), var(--coral));
    }

    .sec-label-txt {
        font-family: var(--font-m);
        font-size: 9.5px;
        font-weight: 500;
        color: var(--text3);
        letter-spacing: 2px;
        text-transform: uppercase;
    }

    .frow {
        display: grid;
        gap: 14px;
        margin-bottom: 14px;
    }

    .frow-4 {
        grid-template-columns: 1fr 1fr 1fr 1fr;
    }

    .frow-3 {
        grid-template-columns: 1fr 1fr 1fr;
    }

    .frow-2 {
        grid-template-columns: 1fr 1fr;
    }

    .fg {
        position: relative;
    }

        .fg .fc {
            padding: 22px 14px 8px;
        }

        .fg select.fc {
            padding: 22px 14px 8px;
        }

        .fg.always-up .fl {
            top: 7px;
            transform: none;
            font-size: 9px;
            font-family: var(--font-m);
            color: var(--text3);
            letter-spacing: 1px;
            text-transform: uppercase;
            font-weight: 500;
        }

        .fg.always-up .fc:focus ~ .fl {
            color: var(--blue);
        }

    .fl {
        position: absolute;
        left: 14px;
        top: 50%;
        transform: translateY(-50%);
        font-family: var(--font-b);
        font-size: 13px;
        font-weight: 600;
        color: var(--text3);
        pointer-events: none;
        transition: top .18s,transform .18s,font-size .18s,color .18s,letter-spacing .18s;
        white-space: nowrap;
    }

    .fg .fc:focus ~ .fl, .fg.has-value .fl {
        top: 7px;
        transform: none;
        font-size: 9px;
        font-family: var(--font-m);
        color: var(--blue);
        letter-spacing: 1px;
        text-transform: uppercase;
        font-weight: 500;
    }

    .fg .fc::placeholder {
        color: transparent;
    }

    .fc {
        border: 1px solid var(--border2);
        border-radius: var(--r);
        padding: 10px 14px;
        font-size: 13.5px;
        font-family: var(--font-b);
        font-weight: 600;
        color: var(--text) !important;
        background: var(--surface);
        transition: border-color .2s, box-shadow .2s, background .2s;
        outline: none;
        width: 100%;
        -webkit-text-fill-color: var(--text) !important;
        caret-color: var(--blue);
    }

        .fc:focus {
            border-color: var(--blue);
            box-shadow: 0 0 0 3px var(--blue-g);
            background: #fff;
        }

        .fc[readonly] {
            background: var(--surface2);
            color: var(--text3) !important;
            -webkit-text-fill-color: var(--text3) !important;
            cursor: default;
        }

    select.fc {
        appearance: auto;
        cursor: pointer;
    }

        select.fc option {
            background: #fff;
            color: var(--text);
        }

    input[type="date"].fc::-webkit-calendar-picker-indicator {
        opacity: .5;
        cursor: pointer;
    }

    .entry-align {
        display: flex;
        align-items: flex-end;
        gap: 10px;
        margin-bottom: 14px;
        flex-wrap: wrap;
    }

        .entry-align .fg {
            min-width: 100px;
        }

            .entry-align .fg.xl {
                flex: 3;
            }

            .entry-align .fg.sm {
                flex: 1;
            }

    /* Summary Strip */
    .summary-strip {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 10px;
        margin-bottom: 16px;
    }

    .summary-card {
        background: var(--surface2);
        border: 1px solid var(--border2);
        border-radius: var(--r2);
        padding: 12px 16px;
        text-align: center;
    }

    .summary-label {
        font-family: var(--font-m);
        font-size: 9px;
        color: var(--text3);
        letter-spacing: 1.5px;
        text-transform: uppercase;
        margin-bottom: 5px;
    }

    .summary-value {
        font-family: var(--font-m);
        font-size: 15px;
        font-weight: 500;
        color: var(--text);
    }

    .summary-card.highlight {
        border-color: rgba(78,157,255,.25);
        background: var(--blue-g2);
    }

        .summary-card.highlight .summary-value {
            color: var(--blue-dark);
        }

    /* Table */
    .table-wrap {
        border: 1px solid var(--border2);
        border-radius: var(--r2);
        overflow: hidden;
        margin-bottom: 16px;
    }

    .pro-tbl {
        width: 100%;
        border-collapse: collapse;
    }

        .pro-tbl thead th {
            background: var(--surface2);
            color: var(--text3);
            padding: 10px 14px;
            font-size: 9.5px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1.2px;
            white-space: nowrap;
            font-family: var(--font-b);
            border-bottom: 1px solid var(--border2);
            border-right: 1px solid var(--border);
            text-align: center;
        }

            .pro-tbl thead th:last-child {
                border-right: none;
            }

        .pro-tbl tbody tr {
            border-bottom: 1px solid var(--border);
            transition: background .12s;
        }

            .pro-tbl tbody tr:hover {
                background: var(--surface2);
            }

            .pro-tbl tbody tr:last-child {
                border-bottom: none;
            }

        .pro-tbl tbody td {
            padding: 10px 14px;
            font-size: 12.5px;
            color: var(--text2);
            text-align: center;
            font-weight: 600;
        }

            .pro-tbl tbody td.td-left {
                text-align: left;
                font-weight: 700;
                color: var(--text);
            }

        .pro-tbl tfoot td, .pro-tbl tfoot th {
            padding: 11px 14px;
            font-family: var(--font-m);
            font-size: 11px;
            font-weight: 500;
            text-align: center;
            background: var(--surface2);
            border-top: 1px solid var(--border2);
            color: var(--text);
        }

            .pro-tbl tfoot th.label-cell {
                text-align: left;
                color: var(--text2);
                font-size: 9.5px;
                letter-spacing: 1px;
                text-transform: uppercase;
            }

            .pro-tbl tfoot th.grand-val {
                color: var(--blue-dark);
                font-size: 13px;
            }

    .amount-cell {
        font-family: var(--font-m);
        font-size: 12px;
    }

    .tbl-del {
        width: 28px;
        height: 28px;
        border-radius: var(--r);
        border: 1px solid rgba(239,68,68,.20);
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 11px;
        transition: all .15s;
        background: rgba(239,68,68,.08);
        color: var(--danger);
    }

        .tbl-del:hover {
            background: var(--danger);
            color: #fff;
            border-color: var(--danger);
        }

    .empty-state {
        padding: 40px 20px;
        text-align: center;
    }

    .empty-icon {
        width: 48px;
        height: 48px;
        background: var(--surface2);
        border-radius: var(--r2);
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--text3);
        font-size: 18px;
        margin: 0 auto 12px;
        border: 1px solid var(--border2);
    }

    .empty-text {
        font-size: 13px;
        color: var(--text3);
    }

    /* Buttons */
    .btn-row {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
        padding-top: 18px;
        border-top: 1px solid var(--border2);
        margin-top: 4px;
        justify-content: flex-end;
    }

    .btn {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 10px 22px;
        font-family: var(--font-b);
        font-size: 13px;
        font-weight: 700;
        border-radius: var(--r);
        border: none;
        cursor: pointer;
        transition: all .2s ease;
        white-space: nowrap;
    }

    .btn-add {
        background: linear-gradient(135deg, var(--teal) 0%, #00a88e 100%);
        color: #fff;
        box-shadow: 0 3px 16px rgba(0,201,167,.30);
        height: 46px;
    }

        .btn-add:hover {
            transform: translateY(-1px);
            box-shadow: 0 6px 24px rgba(0,201,167,.40);
        }

    .btn-primary {
        background: linear-gradient(135deg, var(--blue) 0%, var(--blue-dark) 100%);
        color: #fff;
        box-shadow: 0 3px 14px rgba(78,157,255,.30);
    }

        .btn-primary:hover {
            transform: translateY(-1px);
            box-shadow: 0 6px 20px rgba(78,157,255,.42);
        }

    .btn-secondary {
        background: var(--surface2);
        color: var(--text2);
        border: 1px solid var(--border2);
    }

        .btn-secondary:hover {
            background: var(--surface3);
            color: var(--text);
            border-color: var(--border3);
        }

    .pg-footer {
        margin-top: 18px;
        padding-top: 14px;
        border-top: 1px solid var(--border2);
        text-align: center;
        font-family: var(--font-m);
        font-size: 10.5px;
        color: var(--text3);
        letter-spacing: .5px;
    }

        .pg-footer strong {
            color: var(--blue);
            font-weight: 500;
        }

        .pg-footer .heart {
            color: var(--coral);
        }

    @@keyframes fadeDown {
        from

    {
        opacity: 0;
        transform: translateY(-16px)
    }

    to {
        opacity: 1;
        transform: translateY(0)
    }

    }
    @@keyframes slideUp {
        from

    {
        opacity: 0;
        transform: translateY(20px)
    }

    to {
        opacity: 1;
        transform: translateY(0)
    }

    }
    @@keyframes fadeIn {
        from

    {
        opacity: 0;
        transform: translateY(-6px)
    }

    to {
        opacity: 1;
        transform: translateY(0)
    }

    }
    @@media (max-width: 900px) {
        .sr-root

    {
        padding: 14px;
    }

    .frow-4, .frow-3 {
        grid-template-columns: 1fr 1fr;
    }

    .summary-strip {
        grid-template-columns: 1fr 1fr;
    }

    }
</style>

<div class="sr-root">
    <div class="sr-inner">

        <div class="page-header">
            <div class="ph-left">
                <div class="ph-icon"><i class="fas fa-cart-shopping"></i></div>
                <div>
                    <div class="ph-title">Purchase <span>Invoice</span></div>
                    <div class="ph-breadcrumb">Finance <i class="fas fa-chevron-right"></i> <span class="bc-cur">Purchase Invoice</span></div>
                </div>
            </div>
            <div class="status-pill pill-live">Live</div>
        </div>

        <div class="divider"><span></span><span></span><span></span></div>

        <div class="form-card">
            <div class="fc-header">
                <div class="fc-header-left">
                    <div class="fc-icon"><i class="fas fa-cart-shopping"></i></div>
                    <div><div class="fc-title">Purchase Invoice</div><div class="fc-sub">Create a new purchase invoice</div></div>
                </div>
                <div class="status-pill pill-live">Live</div>
            </div>

            <div class="fc-body">

                <div class="sec-label"><div class="sec-label-bar slb-blue"></div><span class="sec-label-txt">Invoice Details</span></div>
                <div class="frow frow-4">
                    <div class="fg always-up">
                        <input type="text" id="documentNo" class="fc" readonly placeholder=" ">
                        <label class="fl" for="documentNo">Document No</label>
                    </div>
                    <div class="fg always-up">
                        <input type="date" id="date" class="fc">
                        <label class="fl" for="date">Date</label>
                    </div>
                    <div class="fg always-up">
                        <select id="vendorDropdown" class="fc"><option value="">— Select Vendor —</option></select>
                        <label class="fl" for="vendorDropdown">Vendor</label>
                    </div>
                    <div class="fg">
                        <input type="text" id="remarks" class="fc" placeholder=" ">
                        <label class="fl" for="remarks">Remarks</label>
                    </div>
                </div>

                <div class="sec-label" style="margin-top:4px;"><div class="sec-label-bar slb-teal"></div><span class="sec-label-txt">Add Product Entry</span></div>
                <div class="entry-align">
                    <div class="fg always-up xl">
                        <select id="productDropdown" class="fc"><option value="">— Select Product —</option></select>
                        <label class="fl" for="productDropdown">Product</label>
                    </div>
                    <div class="fg always-up sm">
                        <input type="number" id="qty" class="fc" placeholder=" " min="1">
                        <label class="fl" for="qty">Qty</label>
                    </div>
                    <div class="fg always-up sm">
                        <input type="number" id="rate" class="fc" placeholder=" ">
                        <label class="fl" for="rate">Rate</label>
                    </div>
                    <div class="fg always-up sm">
                        <input type="number" id="amount" class="fc" placeholder=" " readonly>
                        <label class="fl" for="amount">Amount</label>
                    </div>
                    <div class="fg always-up sm">
                        <input type="number" id="discount" class="fc" placeholder=" ">
                        <label class="fl" for="discount">Discount</label>
                    </div>
                    <div class="fg always-up sm">
                        <input type="number" id="netAmount" class="fc" placeholder=" " readonly>
                        <label class="fl" for="netAmount">Net Amount</label>
                    </div>
                    <div>
                        <button class="btn btn-add" onclick="addRow()"><i class="fas fa-plus"></i> Add</button>
                    </div>
                </div>

                <div class="summary-strip">
                    <div class="summary-card"><div class="summary-label">Total Qty</div><div class="summary-value" id="dispQty">0</div></div>
                    <div class="summary-card"><div class="summary-label">Total Amount</div><div class="summary-value" id="dispAmount">0.00</div></div>
                    <div class="summary-card"><div class="summary-label">Total Discount</div><div class="summary-value" id="dispDiscount">0.00</div></div>
                    <div class="summary-card highlight"><div class="summary-label">Net Amount</div><div class="summary-value" id="dispNet">0.00</div></div>
                </div>

                <div class="sec-label" style="margin-top:4px;"><div class="sec-label-bar slb-amber"></div><span class="sec-label-txt">Invoice Entries</span></div>
                <div class="table-wrap">
                    <table class="pro-tbl" id="dataTable">
                        <thead>
                            <tr>
                                <th style="width:4%">#</th>
                                <th style="width:30%;text-align:left;">Product</th>
                                <th style="width:10%">Qty</th>
                                <th style="width:14%">Rate</th>
                                <th style="width:14%">Amount</th>
                                <th style="width:14%">Discount</th>
                                <th style="width:10%">Net Amount</th>
                                <th style="width:4%"></th>
                            </tr>
                        </thead>
                        <tbody id="tableBody">
                            <tr id="emptyRow">
                                <td colspan="8">
                                    <div class="empty-state">
                                        <div class="empty-icon"><i class="fas fa-box-open"></i></div>
                                        <div class="empty-text">No products added yet.</div>
                                    </div>
                                </td>
                            </tr>
                        </tbody>
                        <tfoot>
                            <tr>
                                <th colspan="2" class="label-cell">Grand Total</th>
                                <th id="sumQty" class="amount-cell">0</th>
                                <th class="amount-cell">—</th>
                                <th id="sumAmount" class="amount-cell">0.00</th>
                                <th id="sumDiscount" class="amount-cell">0.00</th>
                                <th id="sumNet" class="amount-cell grand-val">0.00</th>
                                <th></th>
                            </tr>
                        </tfoot>
                    </table>
                </div>

                <div class="btn-row">
                    <button class="btn btn-secondary" onclick="cancelForm()"><i class="fas fa-xmark"></i> Cancel</button>
                    <button class="btn btn-primary" onclick="saveForm()"><i class="fas fa-floppy-disk"></i> Save Invoice</button>
                </div>

            </div>
        </div>

        <div class="pg-footer">Developed with <span class="heart">♥</span> by <strong>UT Designer</strong></div>
    </div>
</div>

<script>
    let productMap = {};
    let rowCounter = 0;
    let detailRows = [];
    const SW = { background: '#ffffff', color: '#1e2a3a', confirmButtonColor: '#4e9dff', cancelButtonColor: '#f8f9fc' };

    document.addEventListener("DOMContentLoaded", function () {
        document.getElementById("date").valueAsDate = new Date();
        loadDocumentNo();
        loadVendorDropdown();
        loadProductDropdown();
    });

    async function loadDocumentNo() {
        try {
            const res = await fetch("/PurchaseInvoice/nLoadPurchaseInvoiceNo", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({}) });
            const data = await res.json();
            document.getElementById("documentNo").value = (data.statusId === 1 && data.documentNo) ? data.documentNo : "N/A";
        } catch (e) { document.getElementById("documentNo").value = "Error"; }
    }

    async function loadVendorDropdown() {
        const dd = document.getElementById("vendorDropdown");
        try {
            const res = await fetch("/PurchaseInvoice/nLoadPurchaseInvoiceVendorDropDown", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({}) });
            const data = await res.json();
            if (data.statusId === 1 && data.vendors) {
                data.vendors.forEach(function (v) { const opt = document.createElement("option"); opt.value = v.vendorCode; opt.textContent = v.vendorName; dd.appendChild(opt); });
            }
        } catch (e) { console.error("Error loading vendors:", e); }
    }

    async function loadProductDropdown() {
        const dd = document.getElementById("productDropdown");
        try {
            const res = await fetch("/PurchaseInvoice/nLoadPurchaseInvoiceProductDropDown", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({}) });
            const data = await res.json();
            if (data.statusId === 1 && data.products) {
                data.products.forEach(function (p) {
                    const opt = document.createElement("option"); opt.value = p.productCode; opt.textContent = p.productName; dd.appendChild(opt);
                    productMap[p.productCode] = { rate: parseFloat(p.rate) || 0, discountAmount: parseFloat(p.discountAmount) || 0, productName: p.productName };
                });
            }
        } catch (e) { console.error("Error loading products:", e); }
    }

    document.getElementById("productDropdown").addEventListener("change", function () {
        const code = this.value;
        if (code && productMap[code]) {
            document.getElementById("rate").value     = productMap[code].rate.toFixed(2);
            document.getElementById("discount").value = productMap[code].discountAmount.toFixed(2);
            document.getElementById("qty").value      = 1;
            recalcEntry(); document.getElementById("qty").focus();
        } else { clearEntryFields(); }
    });

    document.getElementById("qty").addEventListener("input", recalcEntry);
    document.getElementById("rate").addEventListener("input", recalcEntry);
    document.getElementById("discount").addEventListener("input", recalcEntry);

    document.getElementById("qty").addEventListener("keydown", function (e) { if (e.key === "Enter") { e.preventDefault(); document.getElementById("rate").focus(); } });
    document.getElementById("rate").addEventListener("keydown", function (e) { if (e.key === "Enter") { e.preventDefault(); document.getElementById("discount").focus(); } });
    document.getElementById("discount").addEventListener("keydown", function (e) { if (e.key === "Enter") { e.preventDefault(); addRow(); } });

    function recalcEntry() {
        const qty = parseFloat(document.getElementById("qty").value) || 0;
        const rate = parseFloat(document.getElementById("rate").value) || 0;
        const discount = parseFloat(document.getElementById("discount").value) || 0;
        const amount = qty * rate;
        document.getElementById("amount").value    = amount.toFixed(2);
        document.getElementById("netAmount").value = (amount - discount).toFixed(2);
    }

    function clearEntryFields() {
        ["qty","rate","amount","discount","netAmount"].forEach(id => document.getElementById(id).value = "");
    }

    function addRow() {
        const dd = document.getElementById("productDropdown");
        const productCode = dd.value;
        const productName = dd.options[dd.selectedIndex].text;
        const qty       = parseFloat(document.getElementById("qty").value)       || 0;
        const rate      = parseFloat(document.getElementById("rate").value)      || 0;
        const amount    = parseFloat(document.getElementById("amount").value)    || 0;
        const discount  = parseFloat(document.getElementById("discount").value)  || 0;
        const netAmount = parseFloat(document.getElementById("netAmount").value) || 0;

        if (!productCode) { alert("Please select a Product."); dd.focus(); return; }
        if (qty <= 0)     { alert("Please enter a valid Qty."); document.getElementById("qty").focus(); return; }
        if (rate <= 0)    { alert("Rate is 0. Check product data."); document.getElementById("rate").focus(); return; }

        const emptyRow = document.getElementById("emptyRow"); if (emptyRow) emptyRow.remove();
        rowCounter++;
        const tbody = document.getElementById("tableBody");
        const row = document.createElement("tr"); row.id = "row_" + rowCounter; row.style.animation = "fadeIn 0.3s ease";
        row.innerHTML = `
            <td>${rowCounter}</td><td class="td-left">${productName}</td>
            <td class="amount-cell">${qty}</td><td class="amount-cell">${rate.toFixed(2)}</td>
            <td class="amount-cell">${amount.toFixed(2)}</td><td class="amount-cell">${discount.toFixed(2)}</td>
            <td class="amount-cell">${netAmount.toFixed(2)}</td>
            <td><button class="tbl-del" onclick="deleteRow('row_${rowCounter}',${qty},${amount},${discount},${netAmount})" title="Remove"><i class="fas fa-trash-can"></i></button></td>`;
        tbody.appendChild(row);
        updateTotals(qty, amount, discount, netAmount);
        detailRows.push({ rowId: "row_" + rowCounter, productCode: parseInt(productCode), qty, rate, amount, discountAmount: discount, netAmount });
        dd.value = ""; clearEntryFields(); dd.focus();
    }

    function deleteRow(rowId, qty, amount, discount, netAmount) {
        const row = document.getElementById(rowId);
        if (row) {
            row.style.opacity = "0"; row.style.transform = "translateX(20px)"; row.style.transition = "all 0.25s ease";
            setTimeout(() => {
                row.remove(); updateTotals(-qty, -amount, -discount, -netAmount);
                detailRows = detailRows.filter(d => d.rowId !== rowId);
                const tbody = document.getElementById("tableBody");
                if (tbody.children.length === 0) {
                    const er = document.createElement("tr"); er.id = "emptyRow";
                    er.innerHTML = `<td colspan="8"><div class="empty-state"><div class="empty-icon"><i class="fas fa-box-open"></i></div><div class="empty-text">No products added yet.</div></div></td>`;
                    tbody.appendChild(er);
                }
            }, 250);
        }
    }

    function updateTotals(qty, amount, discount, netAmount) {
        const sQty  = parseFloat(document.getElementById("sumQty").innerText)      + qty;
        const sAmt  = parseFloat(document.getElementById("sumAmount").innerText)   + amount;
        const sDisc = parseFloat(document.getElementById("sumDiscount").innerText) + discount;
        const sNet  = parseFloat(document.getElementById("sumNet").innerText)      + netAmount;
        document.getElementById("sumQty").innerText      = sQty.toFixed(0);
        document.getElementById("sumAmount").innerText   = sAmt.toFixed(2);
        document.getElementById("sumDiscount").innerText = sDisc.toFixed(2);
        document.getElementById("sumNet").innerText      = sNet.toFixed(2);
        const dq = document.getElementById("dispQty"), da = document.getElementById("dispAmount"), dd2 = document.getElementById("dispDiscount"), dn = document.getElementById("dispNet");
        if (dq) dq.innerText = sQty.toFixed(0); if (da) da.innerText = sAmt.toFixed(2); if (dd2) dd2.innerText = sDisc.toFixed(2); if (dn) dn.innerText = sNet.toFixed(2);
    }

    async function saveForm() {
        const tbody = document.getElementById("tableBody");
        if (tbody.querySelector("#emptyRow")) { alert("Please add at least one product before saving."); return; }
        const documentNo = document.getElementById("documentNo").value;
        const date = document.getElementById("date").value;
        const vendorCode = document.getElementById("vendorDropdown").value;
        const remarks = document.getElementById("remarks").value;
        if (!date) { alert("Please select a Date."); return; }
        if (!vendorCode) { alert("Please select a Vendor."); return; }
        const payload = {
            documentNo, vendorCode: parseInt(vendorCode), date, remarks,
            totalQty: parseFloat(document.getElementById("sumQty").innerText) || 0,
            totalAmount: parseFloat(document.getElementById("sumAmount").innerText) || 0,
            totalDiscountAmount: parseFloat(document.getElementById("sumDiscount").innerText) || 0,
            netAmount: parseFloat(document.getElementById("sumNet").innerText) || 0,
            details: detailRows.map(d => ({ productCode: d.productCode, qty: d.qty, rate: d.rate, amount: d.amount, discountAmount: d.discountAmount, netAmount: d.netAmount }))
        };
        try {
            const res = await fetch("/PurchaseInvoice/nSavePurchaseInvoice", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(payload) });
            const data = await res.json();
            if (data.statusId === 1) {
                Swal.fire({ icon: 'success', title: 'Saved!', text: 'Purchase Invoice saved successfully!', confirmButtonText: 'OK', confirmButtonColor: '#4e9dff', timer: 2000, timerProgressBar: true, ...SW }).then(() => { location.reload(); });
            } else {
                Swal.fire({ icon: 'error', title: 'Error!', text: data.message || "Failed to save.", confirmButtonText: 'OK', confirmButtonColor: '#ef4444', ...SW });
            }
        } catch (e) { console.error("Save error:", e); alert("Error saving invoice."); }
    }

    function cancelForm() {
        Swal.fire({ icon: 'warning', title: 'Cancel?', text: 'All data will be lost.', showCancelButton: true, confirmButtonText: 'Yes, Cancel', cancelButtonText: 'Go Back', confirmButtonColor: '#ef4444', cancelButtonColor: '#4e9dff', ...SW })
            .then((result) => { if (result.isConfirmed) location.reload(); });
    }
</script>
