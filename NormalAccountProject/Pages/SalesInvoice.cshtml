                    <div class="page-title">Invoice <span>Registration</span></div>
                    <div class="breadcrumb">Sales <i class="fas fa-chevron-right"></i> <span>Invoice</span></div>
                </div>
            </div>
            <div style="display:flex;align-items:center;gap:10px;">
                <div class="toggle-group">
                    <button class="toggle-btn toggle-btn-outline" id="gridViewToggleBtn">
                        <i class="fas fa-table-cells"></i> Grid
                    </button>
                    <button class="toggle-btn toggle-btn-solid" id="formViewToggleBtn" style="display:none;">
                        <i class="fas fa-pen-to-square"></i> Form
                    </button>
                </div>
            </div>
        </div>

        <div class="accent-line"><span></span><span></span><span></span></div>

        <!-- FORM VIEW -->
        <div id="formViewContainer">
            <div class="form-card">
                <div class="form-card-header">
                    <div class="form-card-header-left">
                        <div class="header-dots">
                            <div class="h-dot h-dot-1"></div>
                            <div class="h-dot h-dot-2"></div>
                            <div class="h-dot h-dot-3"></div>
                        </div>
                        <div class="form-card-title">invoice_registration.form</div>
                    </div>
                    <div class="pill pill-gold"><i class="fas fa-circle" style="font-size:6px;"></i> Live</div>
                </div>

                <div class="form-body">
                    <input type="hidden" id="InvoiceId">

                    <div class="section-label">
                        <div class="section-label-bar"></div>
                        <span class="section-label-text">Invoice Details</span>
                    </div>

                    <div class="form-row" style="grid-template-columns:140px 165px 1fr 1fr;gap:12px;margin-bottom:14px;">
                        <div>
                            <div class="field-label">
                                <i class="fas fa-hashtag" style="color:var(--gold);margin-right:4px;font-size:8px;"></i>Invoice No
                            </div>
                            <div class="inv-no-box" id="InvoiceNoDisplay">920001</div>
                        </div>
                        <div>
                            <div class="field-label">
                                <i class="fas fa-calendar-days" style="color:var(--teal);margin-right:4px;font-size:8px;"></i>Date
                            </div>
                            <input type="date" id="InvoiceDate" class="form-control date-ctrl">
                        </div>
                        <div class="float-group">
                            <select id="CustomerId" class="form-control">
                                <option value=""> </option>
                                <option value="1">Gentec Industries Pvt Ltd</option>
                                <option value="2">Alpha Solutions</option>
                                <option value="3">Beta Traders</option>
                                <option value="4">Gamma Corp</option>
                            </select>
                            <label class="float-label" for="CustomerId">Customer</label>
                        </div>
                        <div class="float-group">
                            <input type="text" id="Description" class="form-control" placeholder=" ">
                            <label class="float-label" for="Description">Description / Remarks</label>
                        </div>
                    </div>

                    <div class="section-label">
                        <div class="section-label-bar"></div>
                        <span class="section-label-text">Product Line Items</span>
                    </div>

                    <div class="items-header">
                        <div class="items-sub">
                            <i class="fas fa-list-ul" style="color:var(--teal);margin-right:5px;font-size:9px;"></i>
                            Add products to the invoice
                        </div>
                        <button class="btn-add" id="addRowBtn" type="button">
                            <i class="fas fa-circle-plus"></i> Add Product
                        </button>
                    </div>

                    <div class="items-table-wrap">
                        <table class="items-table">
                            <thead>
                                <tr>
                                    <th style="width:32px;"></th>
                                    <th style="width:85px;">Product Code</th>
                                    <th style="min-width:150px;">Product Name</th>
                                    <th style="width:65px;">Qty</th>
                                    <th style="width:75px;">Price</th>
                                    <th style="width:85px;">Amount</th>
                                    <th style="width:90px;">Discount</th>
                                    <th style="width:90px;">Net Amount</th>
                                </tr>
                            </thead>
                            <tbody id="InvoiceItemsTbody"></tbody>
                            <tfoot>
                                <tr>
                                    <td colspan="3" style="color:var(--text3);font-family:var(--font-m);font-size:9.5px;letter-spacing:1px;">TOTALS</td>
                                    <td id="ftQty" style="color:var(--teal);">0</td>
                                    <td></td>
                                    <td id="ftAmount" style="color:var(--text);">0.00</td>
                                    <td id="ftDiscount" style="color:var(--danger);">0.00</td>
                                    <td id="ftNetAmount" style="color:var(--accent);font-weight:700;">0.00</td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>

                    <div class="totals-panel">
                        <div class="total-card">
                            <div class="total-card-label"><i class="fas fa-boxes-stacked" style="margin-right:4px;font-size:8px;color:var(--teal);"></i>Total Qty</div>
                            <div class="total-card-value" id="sumQty">0<sub>units</sub></div>
                        </div>
                        <div class="total-card">
                            <div class="total-card-label"><i class="fas fa-scissors" style="margin-right:4px;font-size:8px;color:var(--danger);"></i>Total Discount</div>
                            <div class="total-card-value" id="sumDiscount" style="color:var(--danger);">0.00<sub>PKR</sub></div>
                        </div>
                        <div class="total-card accent-card">
                            <div class="total-card-label"><i class="fas fa-coins" style="margin-right:4px;font-size:8px;color:var(--accent);"></i>Net Payable</div>
                            <div class="total-card-value" id="sumNet" style="color:var(--accent);">0.00<sub>PKR</sub></div>
                        </div>
                    </div>

                    <div class="btn-row">
                        <button class="btn-pro btn-save" id="saveBtn" type="button">
                            <i class="fas fa-floppy-disk"></i> Save Invoice
                        </button>
                        <button class="btn-pro btn-cancel" id="cancelBtn" type="button">
                            <i class="fas fa-xmark"></i> Cancel
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- GRID VIEW -->
        <div id="gridViewContainer" style="display:none;">
            <div class="grid-card">
                <div class="grid-header">
                    <div class="grid-header-left">
                        <div class="header-dots">
                            <div class="h-dot h-dot-1"></div>
                            <div class="h-dot h-dot-2"></div>
                            <div class="h-dot h-dot-3"></div>
                        </div>
                        <div class="grid-header-title">All Invoices</div>
                        <div class="grid-badge" id="TotalInvoicesCount">0 records</div>
                    </div>
                    <div class="pill pill-accent"><i class="fas fa-circle-dot" style="font-size:7px;"></i> Live Data</div>
                </div>
                <div class="grid-scroll">
                    <div id="InvoiceGridContainer">
                        <div class="empty-state">
                            <div class="empty-icon"><i class="fas fa-file-invoice"></i></div>
                            <div class="empty-text">No invoices found.</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="page-footer">
            Developed with <span style="color:var(--danger);">&#9829;</span> by <strong>UT Designer</strong>
        </div>
    </div>
</div>

<script>
    let userId = localStorage.getItem("userId") || "";
    let GridViewDataList = [], IsUpdate = false, rowCounter = 0;
    window._ProductList = [
        { ProductId: 1, ProductCode: '90001', ProductName: 'test Product',   Price: 125 },
        { ProductId: 2, ProductCode: '90002', ProductName: 'test Product 1', Price: 135 },
        { ProductId: 3, ProductCode: '90003', ProductName: 'test Product 2', Price: 45  },
        { ProductId: 4, ProductCode: '90004', ProductName: 'test Product 3', Price: 95  }
    ];
    const SW = { background: '#ffffff', color: '#1a1a1a', confirmButtonColor: '#474544', cancelButtonColor: '#f9f9f9' };

    function initFloatLabels(){document.querySelectorAll('.float-group').forEach(g=>{const el=g.querySelector('input:not([type="checkbox"]):not([type="hidden"]),textarea,select');if(!el)return;const chk=()=>g.classList.toggle('has-value',el.value!=='');el.addEventListener('input',chk);el.addEventListener('change',chk);chk();});}

    function showFormView(){document.getElementById("formViewContainer").style.display="block";document.getElementById("gridViewContainer").style.display="none";document.getElementById("formViewToggleBtn").style.display="none";document.getElementById("gridViewToggleBtn").style.display="inline-flex";}
    function showGridView(){document.getElementById("formViewContainer").style.display="none";document.getElementById("gridViewContainer").style.display="block";document.getElementById("gridViewToggleBtn").style.display="none";document.getElementById("formViewToggleBtn").style.display="inline-flex";}

    document.getElementById("gridViewToggleBtn").addEventListener("click",async function(){showGridView();await LoadGridViewData();});
    document.getElementById("formViewToggleBtn").addEventListener("click",showFormView);

    window.addEventListener("load",async function(){document.getElementById("InvoiceDate").value=new Date().toISOString().split('T')[0];initFloatLabels();await LoadInvoicePageData();await LoadGridViewData();});

    async function LoadInvoicePageData(){
        try{
            const r=await jQuery.ajax({type:'POST',url:'@Url.Action("nLoadInvoicePageData", "InvoiceRegistration")',data:JSON.stringify({Userid:userId}),contentType:'application/json'});
            if(r.statusId===1){
                if(r.InvoiceNo)document.getElementById("InvoiceNoDisplay").textContent=r.InvoiceNo;
                const custSel=document.getElementById("CustomerId");
                custSel.innerHTML='<option value=""> </option>';
                (r.CustomerList||[]).forEach(c=>{const o=document.createElement("option");o.value=c.CustomerId;o.textContent=c.CustomerName;custSel.appendChild(o);});
                if(r.ProductList&&r.ProductList.length)window._ProductList=r.ProductList;
            }else await Swal.fire({icon:'warning',title:'Warning',text:r.message||'Failed.',...SW});
        }catch{await Swal.fire({icon:'error',title:'Error',text:'Error loading data.',...SW});}
    }

    document.getElementById("addRowBtn").addEventListener("click",function(){addItemRow();});

    function addItemRow(data){
        rowCounter++;const id=rowCounter;const tbody=document.getElementById("InvoiceItemsTbody");const tr=document.createElement("tr");tr.dataset.rowid=id;
        let opts='<option value="">— Select Product —</option>';
        (window._ProductList||[]).forEach(p=>{opts+=`<option value="${p.ProductId}" data-price="${p.Price}" data-code="${p.ProductCode}" ${data&&data.ProductId==p.ProductId?'selected':''}>${p.ProductName}</option>`;});
        tr.innerHTML=`<td><button class="tbl-btn-del" type="button" onclick="removeItemRow(${id})" title="Remove"><i class="fas fa-xmark"></i></button></td>
        <td><input type="text" id="pCode_${id}" readonly placeholder="Auto" style="width:75px;" value="${data?(data.ProductCode||''):''}"></td>
        <td><select id="pSel_${id}" onchange="onProductChange(${id})" style="min-width:140px;appearance:none;background:transparent;border:1px solid transparent;border-radius:6px;padding:5px 7px;font-size:12px;font-family:var(--font-b);color:var(--text);outline:none;width:100%;">${opts}</select></td>
        <td><input type="number" id="qty_${id}"   min="0" step="1"    placeholder="0"    value="${data?(data.Qty||'')   :''}" oninput="recalcRow(${id})" style="width:55px;"></td>
        <td><input type="number" id="price_${id}" min="0" step="0.01" placeholder="0.00" value="${data?(data.Price||'') :''}" oninput="recalcRow(${id})" style="width:65px;"></td>
        <td><input type="number" id="amount_${id}" readonly value="${data?(data.Amount||''):''}" style="width:75px;color:var(--text3);"></td>
        <td><input type="number" id="disc_${id}"  min="0" step="0.01" placeholder="0.00" value="${data?(data.DiscountAmount||''):''}" oninput="recalcRow(${id})" style="width:75px;"></td>
        <td><input type="number" id="net_${id}"  readonly value="${data?(data.NetAmount||''):''}" style="width:80px;color:var(--accent);font-weight:600;"></td>`;
        tbody.appendChild(tr);recalcRow(id);
    }

    function removeItemRow(id){const tr=document.querySelector(`tr[data-rowid="${id}"]`);if(tr)tr.remove();updateTotals();}
    function onProductChange(id){const sel=document.getElementById(`pSel_${id}`);const opt=sel.options[sel.selectedIndex];document.getElementById(`pCode_${id}`).value=opt.dataset.code||'';document.getElementById(`price_${id}`).value=parseFloat(opt.dataset.price)||0;recalcRow(id);}
    function recalcRow(id){const qty=parseFloat(document.getElementById(`qty_${id}`)?.value)||0;const price=parseFloat(document.getElementById(`price_${id}`)?.value)||0;const disc=parseFloat(document.getElementById(`disc_${id}`)?.value)||0;const amt=qty*price;const net=amt-disc;if(document.getElementById(`amount_${id}`))document.getElementById(`amount_${id}`).value=amt.toFixed(2);if(document.getElementById(`net_${id}`))document.getElementById(`net_${id}`).value=net.toFixed(2);updateTotals();}
    function updateTotals(){let tQ=0,tA=0,tD=0,tN=0;document.querySelectorAll('#InvoiceItemsTbody tr').forEach(tr=>{const id=tr.dataset.rowid;tQ+=parseFloat(document.getElementById(`qty_${id}`)?.value)||0;tA+=parseFloat(document.getElementById(`amount_${id}`)?.value)||0;tD+=parseFloat(document.getElementById(`disc_${id}`)?.value)||0;tN+=parseFloat(document.getElementById(`net_${id}`)?.value)||0;});document.getElementById("ftQty").textContent=tQ;document.getElementById("ftAmount").textContent=tA.toFixed(2);document.getElementById("ftDiscount").textContent=tD.toFixed(2);document.getElementById("ftNetAmount").textContent=tN.toFixed(2);document.getElementById("sumQty").innerHTML=`${tQ}<sub>units</sub>`;document.getElementById("sumDiscount").innerHTML=`${tD.toFixed(2)}<sub>PKR</sub>`;document.getElementById("sumNet").innerHTML=`${tN.toFixed(2)}<sub>PKR</sub>`;}
    function collectItems(){const items=[];let ok=true;document.querySelectorAll('#InvoiceItemsTbody tr').forEach(tr=>{const id=tr.dataset.rowid;const sel=document.getElementById(`pSel_${id}`);if(!sel||!sel.value){ok=false;return;}items.push({ProductId:sel.value,ProductCode:document.getElementById(`pCode_${id}`).value,ProductName:sel.options[sel.selectedIndex].textContent.trim(),Qty:parseFloat(document.getElementById(`qty_${id}`).value)||0,Price:parseFloat(document.getElementById(`price_${id}`).value)||0,Amount:parseFloat(document.getElementById(`amount_${id}`).value)||0,DiscountAmount:parseFloat(document.getElementById(`disc_${id}`).value)||0,NetAmount:parseFloat(document.getElementById(`net_${id}`).value)||0});});return{items,ok};}

    document.getElementById("saveBtn").addEventListener("click",async function(){
        const InvoiceId=document.getElementById("InvoiceId").value.trim(),CustomerId=document.getElementById("CustomerId").value.trim(),InvoiceDate=document.getElementById("InvoiceDate").value.trim(),Description=document.getElementById("Description").value.trim();
        const{items,ok}=collectItems();
        if(!CustomerId){await Swal.fire({icon:'warning',title:'Validation',text:'Please select a customer.',returnFocus:false,...SW,didClose:()=>document.getElementById("CustomerId").focus()});return;}
        if(items.length===0){await Swal.fire({icon:'warning',title:'Validation',text:'Add at least one product line item.',...SW});return;}
        if(!ok){await Swal.fire({icon:'warning',title:'Validation',text:'Please select a product for every row.',...SW});return;}
        Swal.fire({title:'Please wait',text:'Saving invoice...',allowOutsideClick:false,allowEscapeKey:false,didOpen:()=>Swal.showLoading(),...SW});
        try{const res=await jQuery.ajax({type:'POST',url:'@Url.Action("nSaveInvoiceRegistrationData", "InvoiceRegistration")',data:JSON.stringify({Userid:userId,InvoiceId,CustomerId,InvoiceDate,Description,IsUpdate,Items:items}),contentType:'application/json'});Swal.close();if(res.statusId===1){await Swal.fire({icon:'success',title:'Saved',text:res.message||'Invoice saved.',returnFocus:false,...SW});await nClearForm();}else await Swal.fire({icon:'warning',title:'Failed',text:res.message||'Could not save.',...SW});}
        catch{Swal.close();await Swal.fire({icon:'error',title:'Error',text:'An error occurred.',...SW});}
    });

    document.getElementById("cancelBtn").addEventListener("click",async function(){await nClearForm();});
    async function nClearForm(){document.getElementById("InvoiceId").value="";document.getElementById("CustomerId").value="";document.getElementById("Description").value="";document.getElementById("InvoiceItemsTbody").innerHTML="";document.getElementById("saveBtn").innerHTML='<i class="fas fa-floppy-disk"></i> Save Invoice';IsUpdate=false;document.getElementById("InvoiceDate").value=new Date().toISOString().split('T')[0];updateTotals();initFloatLabels();await LoadInvoicePageData();}

    async function LoadGridViewData(){
        try{const r=await jQuery.ajax({type:'POST',url:'@Url.Action("nLoadInvoiceGridViewData", "InvoiceRegistration")',data:JSON.stringify({Userid:userId}),contentType:'application/json'});
        if(r.statusId===1){GridViewDataList=r.GridViewDataList||[];RenderGridView();}else await Swal.fire({icon:'warning',title:'Warning',text:r.message||'Failed.',...SW});}
        catch{await Swal.fire({icon:'error',title:'Error',text:'Error loading grid.',...SW});}
    }

    function RenderGridView(){const c=document.getElementById("InvoiceGridContainer"),cnt=document.getElementById("TotalInvoicesCount");if(!GridViewDataList.length){c.innerHTML=`<div class="empty-state"><div class="empty-icon"><i class="fas fa-file-invoice"></i></div><div class="empty-text">No invoices found.</div></div>`;cnt.textContent="0 records";return;}const tbl=document.createElement("table");tbl.className="pro-table";tbl.innerHTML=`<thead><tr><th>Actions</th><th>Invoice No</th><th>Date</th><th>Customer</th><th>Description</th><th>Items</th><th>Net Amount</th><th>Status</th></tr></thead>`;const tbody=document.createElement("tbody");GridViewDataList.forEach(item=>{const tr=document.createElement("tr");tr.innerHTML=`<td><button class="tbl-btn-edit" onclick="EditInvoice(${item.InvoiceId})" title="Edit"><i class="fas fa-pen"></i></button><button class="tbl-btn-del2" onclick="DeleteInvoice(${item.InvoiceId})" title="Delete"><i class="fas fa-trash-can"></i></button></td><td style="font-family:var(--font-m);color:var(--gold);">${item.InvoiceNo||''}</td><td style="font-family:var(--font-m);">${item.InvoiceDate||''}</td><td>${item.CustomerName||''}</td><td style="max-width:160px;overflow:hidden;text-overflow:ellipsis;">${item.Description||'—'}</td><td style="text-align:center;"><span class="badge-active"><i class="fas fa-circle" style="font-size:5px;margin-right:3px;"></i>${item.ItemCount||0} items</span></td><td style="font-family:var(--font-m);color:var(--accent);font-weight:600;">${parseFloat(item.NetAmount||0).toFixed(2)}</td><td>${item['Is Active']?'<span class="badge-active"><i class="fas fa-circle" style="font-size:6px;margin-right:4px;"></i>Active</span>':'<span class="badge-inactive"><i class="fas fa-circle" style="font-size:6px;margin-right:4px;"></i>Inactive</span>'}</td>`;tbody.appendChild(tr);});tbl.appendChild(tbody);c.innerHTML="";c.appendChild(tbl);cnt.textContent=`${tbody.rows.length} records`;}

    async function EditInvoice(id){try{Swal.fire({title:'Loading...',allowOutsideClick:false,allowEscapeKey:false,didOpen:()=>Swal.showLoading(),...SW});const r=await jQuery.ajax({type:'POST',url:'@Url.Action("nLoadInvoiceEditData", "InvoiceRegistration")',data:JSON.stringify({Userid:userId,InvoiceId:`${id}`}),contentType:'application/json'});Swal.close();if(r.statusId!==1){await Swal.fire({icon:'warning',title:'Warning',text:r.message||'Failed.',...SW});return;}const inv=r.Invoice;document.getElementById("InvoiceId").value=inv.InvoiceId||'';document.getElementById("InvoiceNoDisplay").textContent=inv.InvoiceNo||'';document.getElementById("InvoiceDate").value=inv.InvoiceDate||'';document.getElementById("CustomerId").value=inv.CustomerId||'';document.getElementById("Description").value=inv.Description||'';document.getElementById("InvoiceItemsTbody").innerHTML="";(r.Items||[]).forEach(item=>addItemRow(item));IsUpdate=true;document.getElementById("saveBtn").innerHTML='<i class="fas fa-floppy-disk"></i> Update Invoice';initFloatLabels();updateTotals();showFormView();}catch{Swal.close();await Swal.fire({icon:'error',title:'Error',text:'Error loading invoice.',...SW});}}
    async function DeleteInvoice(id){const result=await Swal.fire({title:'Confirm Delete',text:'This action cannot be undone.',icon:'warning',showCancelButton:true,confirmButtonText:'Yes, delete',cancelButtonText:'Cancel',confirmButtonColor:'#d94f4f',...SW});if(!result.isConfirmed)return;Swal.fire({title:'Please wait',text:'Deleting...',allowOutsideClick:false,allowEscapeKey:false,didOpen:()=>Swal.showLoading(),...SW});try{const res=await jQuery.ajax({type:'POST',url:'@Url.Action("nDeleteInvoiceRegistrationData", "InvoiceRegistration")',data:JSON.stringify({Userid:userId,InvoiceId:`${id}`}),contentType:'application/json'});Swal.close();if(res.statusId===1){await Swal.fire({icon:'success',title:'Deleted',text:res.message||'Invoice deleted.',...SW});await LoadGridViewData();}else await Swal.fire({icon:'warning',title:'Failed',text:res.message||'Could not delete.',...SW});}catch{Swal.close();await Swal.fire({icon:'error',title:'Error',text:'An error occurred.',...SW});}}
</script>
