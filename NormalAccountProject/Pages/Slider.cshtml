@page "/Slider"
@model NormalAccountProject.Pages.SliderModel
@{
    ViewData["Title"] = "Slider Registration";
}

<link href="https://fonts.googleapis.com/css2?family=Syne:wght@600;700;800&family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">

<style>
    :root {
        --bg: #f4f4f4;
        --bg2: #ffffff;
        --surface: #ffffff;
        --surface2: #f9f9f9;
        --surface3: #efefef;
        --border: rgba(0,0,0,.07);
        --border2: rgba(0,0,0,.12);
        --accent: #474544;
        --accent2: #2e2d2c;
        --accent-g: rgba(71,69,68,.10);
        --gold: #b08d57;
        --gold-g: rgba(176,141,87,.12);
        --teal: #5a7a6e;
        --danger: #d94f4f;
        --success: #2e7d5e;
        --amber: #b07d2e;
        --text: #1a1a1a;
        --text2: #5c5a58;
        --text3: #9a9896;
        --font-h: 'Syne', sans-serif;
        --font-b: 'Plus Jakarta Sans', sans-serif;
        --font-m: 'JetBrains Mono', monospace;
        --r: 10px;
        --r2: 14px;
        --r3: 18px;
        --sh2: 0 8px 40px rgba(0,0,0,.10), 0 0 0 1px rgba(71,69,68,.08);
    }

    *, *::before, *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    .vr-wrap {
        font-family: var(--font-b);
        color: var(--text);
        background: var(--bg);
        min-height: calc(100vh - 60px);
        position: relative;
        overflow: hidden;
    }

        .vr-wrap::before {
            content: '';
            position: fixed;
            top: -200px;
            right: -200px;
            width: 550px;
            height: 550px;
            background: radial-gradient(circle, rgba(71,69,68,.05) 0%, transparent 65%);
            pointer-events: none;
            z-index: 0;
        }

        .vr-wrap::after {
            content: '';
            position: fixed;
            bottom: -150px;
            left: -150px;
            width: 450px;
            height: 450px;
            background: radial-gradient(circle, rgba(90,122,110,.04) 0%, transparent 65%);
            pointer-events: none;
            z-index: 0;
        }

    .vr-bg-grid {
        position: fixed;
        inset: 0;
        z-index: 0;
        pointer-events: none;
        background-image: linear-gradient(rgba(0,0,0,.04) 1px, transparent 1px), linear-gradient(90deg, rgba(0,0,0,.04) 1px, transparent 1px);
        background-size: 40px 40px;
    }

    .vr-inner {
        position: relative;
        z-index: 1;
        padding: 20px 24px;
    }

    .top-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 20px;
        padding-bottom: 16px;
        border-bottom: 1px solid var(--border2);
    }

    .top-bar-left {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .icon-box {
        width: 44px;
        height: 44px;
        background: linear-gradient(135deg, var(--accent) 0%, var(--accent2) 100%);
        border-radius: var(--r);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        font-size: 17px;
        box-shadow: 0 4px 20px rgba(71,69,68,.30);
        flex-shrink: 0;
    }

    .page-title {
        font-family: var(--font-h);
        font-size: 21px;
        font-weight: 800;
        color: var(--text);
        letter-spacing: -.3px;
        line-height: 1.1;
    }

        .page-title span {
            color: var(--accent);
        }

    .breadcrumb {
        display: flex;
        align-items: center;
        gap: 5px;
        font-family: var(--font-m);
        font-size: 10px;
        color: var(--text3);
        letter-spacing: .5px;
        margin-top: 3px;
    }

        .breadcrumb i {
            font-size: 7px;
        }

        .breadcrumb span {
            color: var(--gold);
        }

    .pill {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 3px 10px;
        border-radius: 20px;
        font-family: var(--font-m);
        font-size: 10.5px;
        font-weight: 500;
        border: 1px solid transparent;
    }

    .pill-gold {
        background: var(--gold-g);
        color: var(--gold);
        border-color: rgba(176,141,87,.30);
    }

    .pill-accent {
        background: var(--accent-g);
        color: var(--accent2);
        border-color: rgba(71,69,68,.20);
    }

    .toggle-group {
        display: flex;
        gap: 4px;
        background: var(--surface2);
        padding: 4px;
        border-radius: var(--r);
        border: 1px solid var(--border2);
    }

    .toggle-btn {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 7px 15px;
        font-family: var(--font-b);
        font-size: 12px;
        font-weight: 600;
        border-radius: 7px;
        border: none;
        cursor: pointer;
        transition: all .2s ease;
    }

    .toggle-btn-outline {
        background: transparent;
        color: var(--text2);
    }

        .toggle-btn-outline:hover {
            background: var(--surface3);
            color: var(--text);
        }

    .toggle-btn-solid {
        background: linear-gradient(135deg, var(--accent) 0%, var(--accent2) 100%);
        color: #fff;
        box-shadow: 0 2px 12px rgba(71,69,68,.25);
    }

        .toggle-btn-solid:hover {
            transform: translateY(-1px);
            box-shadow: 0 4px 18px rgba(71,69,68,.35);
        }

    .accent-line {
        display: flex;
        gap: 2px;
        margin-bottom: 18px;
        height: 2px;
    }

        .accent-line span:nth-child(1) {
            flex: 2;
            background: var(--accent);
            border-radius: 2px;
        }

        .accent-line span:nth-child(2) {
            flex: 1;
            background: var(--teal);
            border-radius: 2px;
            opacity: .6;
        }

        .accent-line span:nth-child(3) {
            flex: 3;
            background: var(--border2);
            border-radius: 2px;
        }

    .form-card {
        background: var(--surface);
        border-radius: var(--r3);
        border: 1px solid var(--border2);
        box-shadow: var(--sh2);
        overflow: hidden;
        animation: fadeUp .3s ease both;
        position: relative;
    }

    .form-card-header {
        padding: 12px 22px;
        background: linear-gradient(90deg, var(--surface2) 0%, rgba(71,69,68,.06) 100%);
        border-bottom: 1px solid var(--border2);
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .form-card-header-left {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .header-dots {
        display: flex;
        gap: 5px;
    }

    .h-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
    }

    .h-dot-1 {
        background: #f43f5e;
    }

    .h-dot-2 {
        background: #f59e0b;
    }

    .h-dot-3 {
        background: #10b981;
    }

    .form-card-title {
        font-family: var(--font-m);
        font-size: 10.5px;
        font-weight: 500;
        color: var(--text3);
        letter-spacing: 1.5px;
        text-transform: uppercase;
    }

    .form-body {
        padding: 22px 24px;
        max-height: 65vh;
        overflow-y: auto;
        scrollbar-width: thin;
        scrollbar-color: var(--surface3) transparent;
    }

        .form-body::-webkit-scrollbar {
            width: 4px;
        }

        .form-body::-webkit-scrollbar-thumb {
            background: var(--surface3);
            border-radius: 10px;
        }

    .section-label {
        display: flex;
        align-items: center;
        gap: 9px;
        font-family: var(--font-m);
        font-size: 9.5px;
        color: var(--text3);
        letter-spacing: 2px;
        text-transform: uppercase;
        margin-bottom: 14px;
        padding-bottom: 10px;
        border-bottom: 1px solid var(--border);
        font-weight: 500;
    }

    .section-label-bar {
        width: 3px;
        height: 12px;
        background: linear-gradient(180deg, var(--accent), var(--teal));
        border-radius: 3px;
        flex-shrink: 0;
    }

    .section-label-bar-gold {
        width: 3px;
        height: 12px;
        background: linear-gradient(180deg, var(--gold), var(--teal));
        border-radius: 3px;
        flex-shrink: 0;
    }

    .section-label-bar-teal {
        width: 3px;
        height: 12px;
        background: linear-gradient(180deg, var(--teal), var(--accent));
        border-radius: 3px;
        flex-shrink: 0;
    }

    .section-label-text {
        color: var(--text2);
    }

    .form-row {
        display: grid;
        gap: 12px;
        margin-bottom: 14px;
    }

    .form-row-1 {
        grid-template-columns: 1fr;
    }

    .form-row-2 {
        grid-template-columns: 1fr 1fr;
    }

    .float-group {
        position: relative;
    }

        .float-group .form-control {
            padding: 22px 13px 7px;
        }

        .float-group select.form-control, .float-group textarea.form-control {
            padding: 22px 13px 7px;
        }

    .float-label {
        position: absolute;
        left: 13px;
        top: 50%;
        transform: translateY(-50%);
        font-family: var(--font-b);
        font-size: 13px;
        font-weight: 500;
        color: var(--text3);
        pointer-events: none;
        transition: top .18s, transform .18s, font-size .18s, color .18s, letter-spacing .18s;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        max-width: calc(100% - 26px);
    }

    .float-group.is-area .float-label {
        top: 16px;
        transform: none;
    }

    .float-group .form-control:focus ~ .float-label, .float-group.has-value .float-label {
        top: 7px;
        transform: none;
        font-size: 9px;
        font-family: var(--font-m);
        color: var(--accent);
        letter-spacing: 1px;
        text-transform: uppercase;
        font-weight: 500;
    }

    .float-group.is-area .form-control:focus ~ .float-label, .float-group.is-area.has-value .float-label {
        top: 5px;
        transform: none;
        font-size: 9px;
        font-family: var(--font-m);
        color: var(--accent);
        letter-spacing: 1px;
        text-transform: uppercase;
        font-weight: 500;
    }

    .float-group.always-float .float-label {
        top: 7px;
        transform: none;
        font-size: 9px;
        font-family: var(--font-m);
        color: var(--text3);
        letter-spacing: 1px;
        text-transform: uppercase;
        font-weight: 500;
    }

    .float-group.always-float .form-control:focus ~ .float-label {
        color: var(--accent);
    }

    .float-group .form-control::placeholder {
        color: transparent;
    }

    .hint-text {
        font-size: 10px;
        color: var(--text3);
        font-family: var(--font-m);
        margin-top: 4px;
        padding-left: 2px;
    }

    .form-control {
        border: 1px solid var(--border2);
        border-radius: var(--r);
        padding: 9px 13px;
        font-size: 13.5px;
        font-family: var(--font-b);
        color: #1a1a1a !important;
        background: var(--bg2);
        transition: border-color .18s, box-shadow .18s, background .18s;
        outline: none;
        width: 100%;
        -webkit-text-fill-color: #1a1a1a !important;
        caret-color: var(--accent);
    }

        .form-control:focus {
            border-color: var(--accent);
            box-shadow: 0 0 0 3px rgba(71,69,68,.12);
            background: var(--surface);
            color: #1a1a1a !important;
            -webkit-text-fill-color: #1a1a1a !important;
        }

        .form-control::placeholder {
            color: var(--text3);
            -webkit-text-fill-color: var(--text3);
        }

        .form-control:-webkit-autofill, .form-control:-webkit-autofill:hover, .form-control:-webkit-autofill:focus {
            -webkit-text-fill-color: #1a1a1a !important;
            -webkit-box-shadow: 0 0 0px 1000px #ffffff inset !important;
            transition: background-color 5000s ease-in-out 0s;
        }

    textarea.form-control {
        resize: vertical;
        line-height: 1.5;
    }

    select.form-control {
        appearance: auto;
        cursor: pointer;
        color: #1a1a1a !important;
    }

        select.form-control option {
            background: var(--surface);
            color: #1a1a1a;
        }

    input[type="number"].form-control::-webkit-inner-spin-button {
        opacity: .4;
    }

    .status-meta {
        font-family: var(--font-m);
        font-size: 9.5px;
        color: var(--text3);
        letter-spacing: 1px;
        text-transform: uppercase;
        margin-bottom: 7px;
    }

    .check-group {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 10px 14px;
        background: var(--bg2);
        border-radius: var(--r);
        border: 1px solid var(--border2);
        cursor: pointer;
        transition: all .2s;
        width: fit-content;
    }

        .check-group:hover {
            border-color: var(--accent);
            background: var(--accent-g);
        }

    .check-input {
        width: 16px;
        height: 16px;
        cursor: pointer;
        accent-color: var(--accent);
    }

    .check-label {
        font-size: 13px;
        font-weight: 500;
        color: var(--text2);
        cursor: pointer;
        font-family: var(--font-b);
        transition: color .2s;
    }

    .check-group:hover .check-label {
        color: var(--text);
    }

    .file-upload-zone {
        border: 1px dashed var(--border2);
        border-radius: var(--r);
        padding: 10px 14px;
        background: var(--bg2);
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 12px;
        transition: all .2s;
    }

        .file-upload-zone:hover {
            border-color: var(--accent);
            background: var(--accent-g);
        }

    .file-icon {
        width: 34px;
        height: 34px;
        background: linear-gradient(135deg, var(--accent) 0%, var(--accent2) 100%);
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        font-size: 13px;
        flex-shrink: 0;
        box-shadow: 0 3px 10px rgba(71,69,68,.25);
    }

    .file-info-title {
        font-size: 12.5px;
        font-weight: 600;
        color: var(--text2);
    }

    .file-info-sub {
        font-size: 10px;
        color: var(--text3);
        font-family: var(--font-m);
        margin-top: 2px;
    }

    .form-control-file {
        display: none;
    }

    .media-label {
        font-family: var(--font-m);
        font-size: 9px;
        color: var(--text3);
        letter-spacing: 1px;
        text-transform: uppercase;
        margin-bottom: 7px;
        font-weight: 500;
    }

    .btn-row {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
        padding-top: 18px;
        border-top: 1px solid var(--border);
        margin-top: 4px;
    }

    .btn-pro {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 9px 20px;
        font-family: var(--font-b);
        font-size: 13px;
        font-weight: 600;
        border-radius: var(--r);
        border: none;
        cursor: pointer;
        transition: all .2s ease;
    }

    .btn-save {
        background: linear-gradient(135deg, var(--accent) 0%, var(--accent2) 100%);
        color: #fff;
        box-shadow: 0 3px 16px rgba(71,69,68,.30);
    }

        .btn-save:hover {
            transform: translateY(-1px);
            box-shadow: 0 6px 24px rgba(71,69,68,.40);
        }

    .btn-cancel {
        background: var(--surface2);
        color: var(--text2);
        border: 1px solid var(--border2);
    }

        .btn-cancel:hover {
            background: var(--surface3);
            color: var(--text);
        }

    .btn-view-img {
        background: var(--gold-g);
        color: var(--gold);
        border: 1px solid rgba(176,141,87,.30);
        font-family: var(--font-b);
        font-size: 13px;
        font-weight: 600;
        border-radius: var(--r);
        padding: 9px 16px;
        text-decoration: none;
        display: none;
        align-items: center;
        gap: 7px;
        transition: all .2s ease;
    }

        .btn-view-img:hover {
            background: rgba(176,141,87,.20);
        }

    .grid-card {
        background: var(--surface);
        border-radius: var(--r3);
        border: 1px solid var(--border2);
        box-shadow: var(--sh2);
        overflow: hidden;
        animation: fadeUp .3s ease both;
    }

    .grid-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 13px 20px;
        background: linear-gradient(90deg, var(--surface2) 0%, rgba(71,69,68,.05) 100%);
        border-bottom: 1px solid var(--border2);
    }

    .grid-header-left {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .grid-header-title {
        font-family: var(--font-m);
        font-size: 10.5px;
        font-weight: 500;
        color: var(--text2);
        text-transform: uppercase;
        letter-spacing: 1.5px;
    }

    .grid-badge {
        background: var(--accent-g);
        color: var(--accent2);
        font-family: var(--font-m);
        font-size: 10.5px;
        padding: 3px 10px;
        border-radius: 20px;
        border: 1px solid rgba(71,69,68,.20);
    }

    .grid-scroll {
        height: 58vh;
        overflow-y: auto;
        scrollbar-width: thin;
        scrollbar-color: var(--surface3) transparent;
    }

        .grid-scroll::-webkit-scrollbar {
            width: 4px;
        }

        .grid-scroll::-webkit-scrollbar-thumb {
            background: var(--surface3);
            border-radius: 10px;
        }

    .pro-table {
        width: 100%;
        border-collapse: collapse;
    }

        .pro-table thead th {
            background: var(--surface2);
            color: var(--text3);
            padding: 10px 14px;
            font-size: 9.5px;
            font-weight: 500;
            text-transform: uppercase;
            letter-spacing: 1.2px;
            white-space: nowrap;
            font-family: var(--font-m);
            position: sticky;
            top: 0;
            z-index: 10;
            border-bottom: 1px solid var(--border2);
            border-right: 1px solid var(--border);
        }

            .pro-table thead th:last-child {
                border-right: none;
            }

        .pro-table tbody tr {
            border-bottom: 1px solid var(--border);
            transition: background .12s;
        }

            .pro-table tbody tr:hover {
                background: var(--surface2);
            }

            .pro-table tbody tr:last-child {
                border-bottom: none;
            }

        .pro-table tbody td {
            padding: 10px 14px;
            font-size: 12.5px;
            color: var(--text2);
            white-space: nowrap;
        }

    .tbl-btn {
        width: 28px;
        height: 28px;
        border-radius: 7px;
        border: 1px solid transparent;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 11px;
        transition: all .15s;
    }

    .tbl-btn-edit {
        background: var(--surface2);
        color: var(--text2);
        border-color: var(--border2);
    }

        .tbl-btn-edit:hover {
            background: var(--accent);
            color: #fff;
            border-color: var(--accent);
        }

    .tbl-btn-del {
        background: rgba(217,79,79,.08);
        color: #c0392b;
        border-color: rgba(217,79,79,.20);
        margin-left: 4px;
    }

        .tbl-btn-del:hover {
            background: var(--danger);
            color: #fff;
            border-color: var(--danger);
        }

    .badge-active {
        background: rgba(46,125,94,.10);
        color: #1e6b4a;
        border: 1px solid rgba(46,125,94,.22);
        font-size: 10px;
        font-weight: 600;
        padding: 3px 10px;
        border-radius: 20px;
        font-family: var(--font-m);
        display: inline-block;
    }

    .badge-inactive {
        background: rgba(217,79,79,.08);
        color: #c0392b;
        border: 1px solid rgba(217,79,79,.20);
        font-size: 10px;
        font-weight: 600;
        padding: 3px 10px;
        border-radius: 20px;
        font-family: var(--font-m);
        display: inline-block;
    }

    .link-btn {
        color: var(--accent);
        font-size: 11px;
        font-family: var(--font-m);
        text-decoration: none;
        padding: 3px 8px;
        background: var(--accent-g);
        border-radius: 5px;
        border: 1px solid rgba(71,69,68,.18);
    }

    .empty-state {
        padding: 60px 20px;
        text-align: center;
    }

    .empty-icon {
        width: 54px;
        height: 54px;
        background: var(--surface2);
        border-radius: var(--r2);
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--text3);
        font-size: 20px;
        margin: 0 auto 14px;
        border: 1px solid var(--border2);
    }

    .empty-text {
        font-size: 13px;
        color: var(--text3);
    }

    .page-footer {
        margin-top: 16px;
        padding-top: 12px;
        border-top: 1px solid var(--border);
        text-align: center;
        font-family: var(--font-m);
        font-size: 10px;
        color: var(--text3);
        letter-spacing: .5px;
    }

        .page-footer strong {
            color: var(--accent);
            font-weight: 500;
        }

    @@keyframes fadeUp {
        from {
            opacity: 0;
            transform: translateY(10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>

<div class="vr-wrap">
    <div class="vr-bg-grid"></div>
    <div class="vr-inner">
        <div class="top-bar">
            <div class="top-bar-left">
                <div class="icon-box"><i class="fas fa-images"></i></div>
                <div>
                    <div class="page-title">Slider <span>Registry</span></div>
                    <div class="breadcrumb">Setup <i class="fas fa-chevron-right"></i> <span>Slider</span></div>
                </div>
            </div>
            <div style="display:flex;align-items:center;gap:10px;">
                <div class="toggle-group">
                    <button class="toggle-btn toggle-btn-outline" id="gridViewToggleBtn"><i class="fas fa-table-cells"></i> Grid</button>
                    <button class="toggle-btn toggle-btn-solid" id="formViewToggleBtn" style="display:none;"><i class="fas fa-pen-to-square"></i> Form</button>
                </div>
            </div>
        </div>

        <div class="accent-line"><span></span><span></span><span></span></div>

        <div id="formViewContainer">
            <div class="form-card">
                <div class="form-card-header">
                    <div class="form-card-header-left">
                        <div class="header-dots"><div class="h-dot h-dot-1"></div><div class="h-dot h-dot-2"></div><div class="h-dot h-dot-3"></div></div>
                        <div class="form-card-title">slider_registration.form</div>
                    </div>
                    <div class="pill pill-gold"><i class="fas fa-circle" style="font-size:6px;"></i> Live</div>
                </div>
                <div class="form-body">
                    <input style="display:none;" type="text" id="SliderId">
                    <input style="display:none;" type="text" id="SliderImageAttachmentOld">

                    <div class="section-label"><div class="section-label-bar"></div><span class="section-label-text">Basic Details</span></div>
                    <div class="form-row form-row-1">
                        <div class="float-group">
                            <input type="text" id="SliderName" class="form-control" placeholder=" ">
                            <label class="float-label" for="SliderName">Slider Name</label>
                        </div>
                    </div>
                    <div class="form-row form-row-1">
                        <div class="float-group">
                            <input type="text" id="HeadingSlider" class="form-control" placeholder=" ">
                            <label class="float-label" for="HeadingSlider">Heading</label>
                        </div>
                    </div>
                    <div class="form-row form-row-1">
                        <div class="float-group is-area">
                            <textarea id="DescriptionSlider" class="form-control" placeholder=" " rows="2"></textarea>
                            <label class="float-label" for="DescriptionSlider">Description</label>
                        </div>
                    </div>
                    <div class="form-row form-row-1">
                        <div>
                            <div class="float-group">
                                <input type="number" id="SliderMovingTimer" class="form-control" placeholder=" " min="0" value="0">
                                <label class="float-label" for="SliderMovingTimer">Moving Timer (Seconds)</label>
                            </div>
                            <div class="hint-text"><i class="fas fa-circle-info" style="color:var(--accent);margin-right:4px;"></i>How long each slide displays. Default: 0</div>
                        </div>
                    </div>

                    <div class="section-label" style="margin-top:4px;"><div class="section-label-bar-gold"></div><span class="section-label-text">Configuration</span></div>
                    <div class="form-row form-row-2">
                        <div class="float-group always-float">
                            <select id="SliderType" class="form-control"><option value="">— Select Type —</option></select>
                            <label class="float-label" for="SliderType">Slider Type</label>
                        </div>
                        <div class="float-group always-float">
                            <select id="VendorId" class="form-control"><option value="">— Select Vendor —</option></select>
                            <label class="float-label" for="VendorId">Vendor</label>
                        </div>
                    </div>

                    <div class="section-label" style="margin-top:4px;"><div class="section-label-bar-teal"></div><span class="section-label-text">Status &amp; Media</span></div>
                    <div class="form-row form-row-2" style="margin-bottom:18px;">
                        <div>
                            <div class="status-meta"><i class="fas fa-toggle-on" style="color:var(--accent);margin-right:5px;"></i>Slider Status</div>
                            <div class="check-group">
                                <input type="checkbox" id="IsActive" class="check-input">
                                <label class="check-label" for="IsActive">Mark as Active</label>
                            </div>
                        </div>
                        <div>
                            <div class="media-label"><i class="fas fa-image" style="color:var(--gold);margin-right:5px;"></i>Slider Image <span style="font-size:8px;color:var(--text3);text-transform:none;letter-spacing:0;">(Max 500 KB · JPEG/PNG)</span></div>
                            <label for="SliderImageAttachment" class="file-upload-zone">
                                <div class="file-icon"><i class="fas fa-cloud-arrow-up"></i></div>
                                <div><div class="file-info-title" id="fileNameDisplay">Click to browse</div><div class="file-info-sub">JPEG or PNG · max 500 KB</div></div>
                            </label>
                            <input id="SliderImageAttachment" class="form-control-file" type="file" accept=".jpeg,.png,.jpg">
                        </div>
                    </div>
                    <div class="btn-row">
                        <button class="btn-pro btn-save" id="saveBtn"><i class="fas fa-floppy-disk"></i> Save Slider</button>
                        <button class="btn-pro btn-cancel" id="cancelBtn"><i class="fas fa-xmark"></i> Cancel</button>
                        <a class="btn-view-img" id="ViewImageBtn" target="_blank"><i class="fas fa-eye"></i> View Image</a>
                    </div>
                </div>
            </div>
        </div>

        <div id="gridViewContainer" style="display:none;">
            <div class="grid-card">
                <div class="grid-header">
                    <div class="grid-header-left">
                        <div class="header-dots"><div class="h-dot h-dot-1"></div><div class="h-dot h-dot-2"></div><div class="h-dot h-dot-3"></div></div>
                        <div class="grid-header-title">All Sliders</div>
                        <div class="grid-badge" id="TotalSlidersCount">0 records</div>
                    </div>
                    <div class="pill pill-accent"><i class="fas fa-circle-dot" style="font-size:7px;"></i> Live Data</div>
                </div>
                <div class="grid-scroll"><div id="SliderGridContainer"></div></div>
            </div>
        </div>
        <div class="page-footer">Developed with <span style="color:var(--danger);">♥</span> by <strong>UT Designer</strong></div>
    </div>
</div>

<script>
    let userId=localStorage.getItem("userId")||"",GridViewDataList=[],IsUpdate=false;
    const SW={background:'#ffffff',color:'#1a1a1a',confirmButtonColor:'#474544',cancelButtonColor:'#f9f9f9'};
    function initFloatLabels(){document.querySelectorAll('.float-group').forEach(g=>{if(g.classList.contains('always-float'))return;const el=g.querySelector('input:not([type="checkbox"]):not([type="file"]):not([style*="display:none"]),textarea,select');if(!el)return;const chk=()=>g.classList.toggle('has-value',el.value!=='');el.addEventListener('input',chk);el.addEventListener('change',chk);chk();});}
    function showFormView(){document.getElementById("formViewContainer").style.display="block";document.getElementById("gridViewContainer").style.display="none";document.getElementById("formViewToggleBtn").style.display="none";document.getElementById("gridViewToggleBtn").style.display="inline-flex";document.getElementById("SliderName").focus();}
    function showGridView(){document.getElementById("formViewContainer").style.display="none";document.getElementById("gridViewContainer").style.display="block";document.getElementById("gridViewToggleBtn").style.display="none";document.getElementById("formViewToggleBtn").style.display="inline-flex";}
    document.getElementById("gridViewToggleBtn").addEventListener("click",showGridView);
    document.getElementById("formViewToggleBtn").addEventListener("click",showFormView);
    document.getElementById("SliderImageAttachment").addEventListener("change",async function(){const file=this.files[0];if(!file)return;if(file.size>500*1024){this.value="";document.getElementById("fileNameDisplay").textContent="Click to browse";await Swal.fire({icon:'warning',title:'Validation',text:'Image must be under 500 KB.',returnFocus:false,...SW});}else{document.getElementById("fileNameDisplay").textContent=file.name;}});
    function GetSliderImageAttachmentFile(){return new Promise((resolve)=>{const fileInput=document.getElementById("SliderImageAttachment"),file=fileInput.files[0];if(!file){resolve({SliderImageAttachmentfilename:"",SliderImageAttachmentbase64:""});return;}const reader=new FileReader();reader.onload=function(e){const n=document.getElementById("SliderName").value.trim(),now=new Date(),pad=n=>n.toString().padStart(2,"0"),ts=`${pad(now.getDate())}${pad(now.getMonth()+1)}${now.getFullYear()}${pad(now.getHours())}${pad(now.getMinutes())}`,ext=file.name.split(".").pop();resolve({SliderImageAttachmentfilename:`${n}_${ts}.${ext}`,SliderImageAttachmentbase64:e.target.result});};reader.onerror=()=>resolve({SliderImageAttachmentfilename:"",SliderImageAttachmentbase64:""});reader.readAsDataURL(file);});}
    window.addEventListener("load",async function(){initFloatLabels();await LoadSliderRegistrationData();await LoadGridViewData();});
    async function LoadSliderRegistrationData(){try{const r=await jQuery.ajax({type:'POST',url:'@Url.Action("nLoadSliderRegistrationData", "SliderRegistration")',data:JSON.stringify({Userid:userId}),contentType:'application/json'});if(r.statusId===1){const vs=document.getElementById("VendorId");vs.innerHTML='<option value="">— Select Vendor —</option>';r.VendorList.forEach(i=>{vs.innerHTML+=`<option value="${i.VendorId}">${i.Vendor}</option>`;});const st=document.getElementById("SliderType");st.innerHTML='<option value="">— Select Type —</option>';r.SliderTypeList.forEach(i=>{st.innerHTML+=`<option value="${i.SliderType}">${i.SliderType}</option>`;});}else await Swal.fire({icon:'warning',title:'Warning',text:r.message||'Failed',...SW});}catch{await Swal.fire({icon:'error',title:'Error',text:'Error loading data',...SW});}}
    async function LoadGridViewData(){try{const r=await jQuery.ajax({type:'POST',url:'@Url.Action("nLoadGridViewData", "SliderRegistration")',data:JSON.stringify({Userid:userId}),contentType:'application/json'});if(r.statusId===1){GridViewDataList=r.GridViewDataList||[];RenderGridView();}else await Swal.fire({icon:'warning',title:'Warning',text:r.message||'Failed',...SW});}catch{await Swal.fire({icon:'error',title:'Error',text:'Error loading grid',...SW});}}
    function gv(item,names,def=''){for(let n of names){if(item[n]!==undefined&&item[n]!==null)return item[n];}return def;}
    function RenderGridView(){const c=document.getElementById("SliderGridContainer"),cnt=document.getElementById("TotalSlidersCount");if(!GridViewDataList.length){c.innerHTML=`<div class="empty-state"><div class="empty-icon"><i class="fas fa-images"></i></div><div class="empty-text">No sliders found.</div></div>`;cnt.textContent="0 records";return;}const t=document.createElement("table");t.className="pro-table";t.innerHTML=`<thead><tr><th>Actions</th><th>Slider ID</th><th>Slider Name</th><th>Heading</th><th>Description</th><th>Timer(s)</th><th>Vendor</th><th>Type</th><th>Status</th><th>Image</th></tr></thead>`;const tb=document.createElement("tbody");GridViewDataList.forEach(item=>{const tr=document.createElement("tr");tr.innerHTML=`<td><button class="tbl-btn tbl-btn-edit" onclick="EditSlider(${item.SliderId})" title="Edit"><i class="fas fa-pen"></i></button><button class="tbl-btn tbl-btn-del" onclick="DeleteSlider(${item.SliderId})" title="Delete"><i class="fas fa-trash-can"></i></button></td><td>${item.SliderId||''}</td><td>${gv(item,['SliderName','Slider Name'])}</td><td>${gv(item,['HeadingSlider','Heading Slider','Heading'],'—')}</td><td>${gv(item,['DescriptionSlider','Description Slider','Description'],'—')}</td><td>${gv(item,['SliderMovingTimer','Slider Moving Timer'],'0')}</td><td>${gv(item,['Vendor','VendorId Name'])}</td><td>${gv(item,['SliderType','Slider Type'],'—')}</td><td>${item['Is Active']?'<span class="badge-active"><i class="fas fa-circle" style="font-size:6px;margin-right:4px;"></i>Active</span>':'<span class="badge-inactive"><i class="fas fa-circle" style="font-size:6px;margin-right:4px;"></i>Inactive</span>'}</td><td>${item.SliderImages?`<a class="link-btn" href="${item.SliderImages}" target="_blank"><i class="fas fa-eye"></i> View</a>`:'<span style="color:var(--text3);font-size:11px;">—</span>'}</td>`;tb.appendChild(tr);});t.appendChild(tb);c.innerHTML="";c.appendChild(t);cnt.textContent=`${tb.rows.length} records`;}
    function EditSlider(SliderId){const s=GridViewDataList.find(c=>parseInt(c.SliderId)===parseInt(SliderId));if(!s){Swal.fire({icon:'error',title:'Error',text:'Not found.',...SW});return;}const g=(names,def='')=>{for(let n of names){if(s[n]!==undefined&&s[n]!==null)return s[n];}return def;};document.getElementById("SliderId").value=s.SliderId||'';document.getElementById("SliderName").value=g(['SliderName','Slider Name']);document.getElementById("HeadingSlider").value=g(['HeadingSlider','Heading Slider','Heading']);document.getElementById("DescriptionSlider").value=g(['DescriptionSlider','Description Slider','Description']);document.getElementById("SliderMovingTimer").value=g(['SliderMovingTimer','Slider Moving Timer'],'0');document.getElementById("SliderType").value=g(['SliderType','Slider Type']);document.getElementById("VendorId").value=s.VendorId||'';document.getElementById("IsActive").checked=s['Is Active']===true||s['Is Active']===1;if(s.SliderImages){document.getElementById("SliderImageAttachmentOld").value=s.SliderImages;const vb=document.getElementById("ViewImageBtn");vb.href=s.SliderImages;vb.style.display="inline-flex";}else{document.getElementById("SliderImageAttachmentOld").value="";document.getElementById("ViewImageBtn").style.display="none";}IsUpdate=true;document.getElementById("saveBtn").innerHTML='<i class="fas fa-floppy-disk"></i> Update Slider';initFloatLabels();showFormView();}
    async function DeleteSlider(SliderId){const r=await Swal.fire({title:'Confirm Delete',text:"Cannot be undone.",icon:'warning',showCancelButton:true,confirmButtonText:'Yes, delete',cancelButtonText:'Cancel',confirmButtonColor:'#d94f4f',...SW});if(!r.isConfirmed)return;const s=GridViewDataList.find(c=>parseInt(c.SliderId)===parseInt(SliderId));if(!s){await Swal.fire({icon:'error',title:'Error',text:'Not found.',...SW});return;}let img="";if(s.SliderImages){const p=s.SliderImages.split('/');img=p[p.length-1];}Swal.fire({title:'Please wait',text:'Deleting...',allowOutsideClick:false,allowEscapeKey:false,didOpen:()=>Swal.showLoading(),...SW});try{const res=await jQuery.ajax({type:'POST',url:'@Url.Action("nDeleteSliderRegistrationData", "SliderRegistration")',data:JSON.stringify({Userid:userId,SliderId:`${SliderId}`,SliderImageAttachmentfilenameold:img,FtpPath:"/wwwroot/Images/SliderRegistration"}),contentType:'application/json'});Swal.close();if(res.statusId===1){await Swal.fire({icon:'success',title:'Deleted',text:res.message||'Deleted.',...SW});await LoadGridViewData();}else await Swal.fire({icon:'warning',title:'Failed',text:res.message||'Could not delete.',...SW});}catch{Swal.close();await Swal.fire({icon:'error',title:'Error',text:'An error occurred.',...SW});}}
    document.getElementById("saveBtn").addEventListener("click",async function(){const SliderId=document.getElementById("SliderId").value.trim(),SliderName=document.getElementById("SliderName").value.trim(),HeadingSlider=document.getElementById("HeadingSlider").value.trim(),DescriptionSlider=document.getElementById("DescriptionSlider").value.trim(),SliderMovingTimer=document.getElementById("SliderMovingTimer").value.trim(),SliderType=document.getElementById("SliderType").value.trim(),VendorId=document.getElementById("VendorId").value.trim(),isActive=document.getElementById("IsActive").checked,hasImage=document.getElementById("SliderImageAttachment").files.length>0,SliderImageAttachmentold=document.getElementById("SliderImageAttachmentOld").value.trim();
    const validations=[{cond:!SliderName,text:'Slider name is required',focus:'SliderName'},{cond:!SliderMovingTimer||isNaN(SliderMovingTimer)||parseInt(SliderMovingTimer)<0,text:'Enter a valid timer (0 or more)',focus:'SliderMovingTimer'},{cond:!SliderType,text:'Please select slider type',focus:'SliderType'},{cond:!VendorId,text:'Please select vendor',focus:'VendorId'},{cond:!IsUpdate&&!hasImage,text:'Please select slider image',focus:'SliderImageAttachment'}];
    for(const v of validations){if(v.cond){await Swal.fire({icon:'warning',title:'Validation',text:v.text,returnFocus:false,...SW,didClose:()=>document.getElementById(v.focus).focus()});return;}}
    const{SliderImageAttachmentfilename,SliderImageAttachmentbase64}=await GetSliderImageAttachmentFile();
    const nSliderTab={Userid:userId,SliderId,SliderName,HeadingSlider:HeadingSlider||"",DescriptionSlider:DescriptionSlider||"",SliderMovingTimer:parseInt(SliderMovingTimer)||0,SliderType,VendorId,SliderImageAttachmentfilename,SliderImageAttachmentfilenameold:SliderImageAttachmentold,SliderImageAttachmentbase64,IsActive:isActive,IsUpdate,FtpPath:"/wwwroot/Images/SliderRegistration"};
    Swal.fire({title:'Please wait',text:'Saving...',allowOutsideClick:false,allowEscapeKey:false,didOpen:()=>Swal.showLoading(),...SW});
    try{const res=await jQuery.ajax({type:'POST',url:'@Url.Action("nSaveSliderRegistrationData", "SliderRegistration")',data:JSON.stringify(nSliderTab),contentType:'application/json'});Swal.close();if(res.statusId===1){await Swal.fire({icon:'success',title:'Saved',text:res.message||'Saved.',returnFocus:false,...SW,didClose:()=>document.getElementById("SliderName").focus()});nClearForm();}else await Swal.fire({icon:'warning',title:'Failed',text:res.message||'Could not save.',...SW});}catch{Swal.close();await Swal.fire({icon:'error',title:'Error',text:'An error occurred.',...SW});}});
    document.getElementById("cancelBtn").addEventListener("click",function(){nClearForm();});
    async function nClearForm(){["SliderId","SliderImageAttachmentOld","SliderName","HeadingSlider","DescriptionSlider"].forEach(id=>document.getElementById(id).value="");document.getElementById("SliderMovingTimer").value="0";document.getElementById("SliderType").value="";document.getElementById("VendorId").value="";document.getElementById("IsActive").checked=false;document.getElementById("SliderImageAttachment").value="";document.getElementById("fileNameDisplay").textContent="Click to browse";IsUpdate=false;document.getElementById("saveBtn").innerHTML='<i class="fas fa-floppy-disk"></i> Save Slider';document.getElementById("ViewImageBtn").style.display="none";initFloatLabels();document.getElementById("SliderName").focus();await LoadGridViewData();}
</script>
