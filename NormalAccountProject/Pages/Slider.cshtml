@page "/Slider"
@model NormalAccountProject.Pages.SliderModel
@{
    ViewData["Title"] = "Slider Registration";
}

<link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;500;600;700;800&family=Rubik:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">

<style>
    /* ══════════════════════════════════════════════
               SLIDER PAGE — Professional Light Theme
               Matches: Stellar-style Dashboard
            ══════════════════════════════════════════════ */
    :root {
        --bg: #f0f3f8;
        --surface: #ffffff;
        --surface2: #f8f9fc;
        --surface3: #eef1f8;
        --border: #eef0f6;
        --border2: #e2e6f0;
        --border3: #d4d9e8;
        --blue: #4e9dff;
        --blue-dark: #2d7dd2;
        --blue-g: rgba(78,157,255,.10);
        --blue-g2: rgba(78,157,255,.06);
        --teal: #00c9a7;
        --coral: #ff6b6b;
        --amber: #f59e0b;
        --green: #10b981;
        --danger: #ef4444;
        --purple: #8b5cf6;
        --text: #1e2a3a;
        --text2: #5a6478;
        --text3: #9ba3b8;
        --font-h: 'Rubik', sans-serif;
        --font-b: 'Nunito', sans-serif;
        --font-m: 'JetBrains Mono', monospace;
        --r: 8px;
        --r2: 12px;
        --r3: 16px;
        --sh: 0 2px 12px rgba(0,0,0,.06);
        --sh2: 0 4px 24px rgba(0,0,0,.09);
        --sh3: 0 8px 40px rgba(0,0,0,.12);
    }

    *, *::before, *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    /* ── ROOT ── */
    .sr-root {
        font-family: var(--font-b);
        color: var(--text);
        background: var(--bg);
        min-height: calc(100vh - 60px);
        padding: 24px 28px 20px;
        overflow-y: auto;
        overflow-x: hidden;
        scrollbar-width: thin;
        scrollbar-color: var(--border2) transparent;
    }

    .sr-inner {
        max-width: 1400px;
        margin: 0 auto;
    }

    /* ── PAGE HEADER ── */
    .page-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 22px;
        animation: fadeDown .4s ease both;
    }

    .ph-left {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .ph-icon {
        width: 46px;
        height: 46px;
        background: linear-gradient(135deg, var(--blue) 0%, var(--blue-dark) 100%);
        border-radius: var(--r2);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        font-size: 18px;
        box-shadow: 0 4px 16px rgba(78,157,255,.35);
        flex-shrink: 0;
    }

    .ph-title {
        font-family: var(--font-h);
        font-size: 21px;
        font-weight: 700;
        color: var(--text);
        line-height: 1.1;
    }

        .ph-title span {
            color: var(--blue);
        }

    .ph-breadcrumb {
        display: flex;
        align-items: center;
        gap: 5px;
        font-family: var(--font-m);
        font-size: 10px;
        color: var(--text3);
        letter-spacing: .4px;
        margin-top: 3px;
    }

        .ph-breadcrumb i {
            font-size: 7px;
            color: var(--text3);
        }

        .ph-breadcrumb .bc-cur {
            color: var(--blue);
            font-weight: 500;
        }

    /* ── VIEW TOGGLE ── */
    .view-toggle {
        display: flex;
        gap: 4px;
        background: var(--surface);
        padding: 4px;
        border-radius: var(--r);
        border: 1px solid var(--border2);
        box-shadow: var(--sh);
    }

    .vt-btn {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 8px 16px;
        font-family: var(--font-b);
        font-size: 12.5px;
        font-weight: 700;
        border-radius: 6px;
        border: none;
        cursor: pointer;
        transition: all .2s ease;
    }

    .vt-btn-ghost {
        background: transparent;
        color: var(--text2);
    }

        .vt-btn-ghost:hover {
            background: var(--surface3);
            color: var(--text);
        }

    .vt-btn-active {
        background: linear-gradient(135deg, var(--blue) 0%, var(--blue-dark) 100%);
        color: #fff;
        box-shadow: 0 2px 10px rgba(78,157,255,.30);
    }

        .vt-btn-active:hover {
            transform: translateY(-1px);
            box-shadow: 0 4px 16px rgba(78,157,255,.40);
        }

    /* ── DIVIDER ── */
    .divider {
        display: flex;
        gap: 3px;
        height: 3px;
        margin-bottom: 20px;
        border-radius: 3px;
        overflow: hidden;
    }

        .divider span:nth-child(1) {
            flex: 3;
            background: var(--blue);
        }

        .divider span:nth-child(2) {
            flex: 1;
            background: var(--teal);
            opacity: .6;
        }

        .divider span:nth-child(3) {
            flex: 8;
            background: var(--border2);
        }

    /* ══════════════════════
               FORM CARD
            ══════════════════════ */
    .form-card {
        background: var(--surface);
        border-radius: var(--r3);
        border: 1px solid var(--border2);
        box-shadow: var(--sh2);
        overflow: hidden;
        animation: slideUp .35s cubic-bezier(.22,1,.36,1) both;
    }

    /* Card header with colored top strip */
    .fc-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 14px 22px;
        background: var(--surface2);
        border-bottom: 1px solid var(--border2);
        border-top: 3px solid var(--blue);
    }

    .fc-header-left {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .fc-icon {
        width: 32px;
        height: 32px;
        border-radius: var(--r);
        background: var(--blue-g);
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--blue);
        font-size: 13px;
    }

    .fc-title {
        font-family: var(--font-h);
        font-size: 14px;
        font-weight: 600;
        color: var(--text);
    }

    .fc-sub {
        font-size: 11px;
        color: var(--text3);
        font-weight: 500;
        margin-top: 1px;
    }

    .status-pill {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 4px 12px;
        border-radius: 20px;
        font-family: var(--font-m);
        font-size: 10.5px;
        font-weight: 500;
    }

    .pill-live {
        background: rgba(16,185,129,.10);
        color: var(--green);
        border: 1px solid rgba(16,185,129,.25);
    }

        .pill-live::before {
            content: '';
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: var(--green);
            animation: blink 1.8s ease-in-out infinite;
        }

    @@keyframes blink {
        0%, 100% {
            opacity: 1
        }

        50% {
            opacity: .3
        }
    }

    /* Form body */
    .fc-body {
        padding: 24px 26px;
        max-height: 68vh;
        overflow-y: auto;
        scrollbar-width: thin;
        scrollbar-color: var(--border2) transparent;
    }

        .fc-body::-webkit-scrollbar {
            width: 4px;
        }

        .fc-body::-webkit-scrollbar-thumb {
            background: var(--border2);
            border-radius: 10px;
        }

    /* Section label */
    .sec-label {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 14px;
        padding-bottom: 10px;
        border-bottom: 1px dashed var(--border2);
    }

    .sec-label-bar {
        width: 3px;
        height: 14px;
        border-radius: 3px;
        flex-shrink: 0;
    }

    .slb-blue {
        background: linear-gradient(180deg, var(--blue), var(--teal));
    }

    .slb-teal {
        background: linear-gradient(180deg, var(--teal), var(--blue));
    }

    .slb-amber {
        background: linear-gradient(180deg, var(--amber), var(--coral));
    }

    .sec-label-txt {
        font-family: var(--font-m);
        font-size: 9.5px;
        font-weight: 500;
        color: var(--text3);
        letter-spacing: 2px;
        text-transform: uppercase;
    }

    /* Form rows */
    .frow {
        display: grid;
        gap: 14px;
        margin-bottom: 14px;
    }

    .frow-1 {
        grid-template-columns: 1fr;
    }

    .frow-2 {
        grid-template-columns: 1fr 1fr;
    }

    /* ── NEW: Description + Timer row (2fr + 1fr) ── */
    .frow-desc-timer {
        grid-template-columns: 2fr 1fr;
    }

    /* Float labels */
    .fg {
        position: relative;
    }

        .fg .fc {
            padding: 22px 14px 8px;
        }

        .fg textarea.fc {
            padding: 22px 14px 8px;
        }

        .fg select.fc {
            padding: 22px 14px 8px;
        }

    .fl {
        position: absolute;
        left: 14px;
        top: 50%;
        transform: translateY(-50%);
        font-family: var(--font-b);
        font-size: 13px;
        font-weight: 600;
        color: var(--text3);
        pointer-events: none;
        transition: top .18s, transform .18s, font-size .18s, color .18s, letter-spacing .18s;
        white-space: nowrap;
    }

    .fg.is-area .fl {
        top: 18px;
        transform: none;
    }

    .fg .fc:focus ~ .fl,
    .fg.has-value .fl {
        top: 7px;
        transform: none;
        font-size: 9px;
        font-family: var(--font-m);
        color: var(--blue);
        letter-spacing: 1px;
        text-transform: uppercase;
        font-weight: 500;
    }

    .fg.is-area .fc:focus ~ .fl,
    .fg.is-area.has-value .fl {
        top: 6px;
        transform: none;
        font-size: 9px;
        font-family: var(--font-m);
        color: var(--blue);
        letter-spacing: 1px;
        text-transform: uppercase;
        font-weight: 500;
    }

    .fg.always-up .fl {
        top: 7px;
        transform: none;
        font-size: 9px;
        font-family: var(--font-m);
        color: var(--text3);
        letter-spacing: 1px;
        text-transform: uppercase;
        font-weight: 500;
    }

    .fg.always-up .fc:focus ~ .fl {
        color: var(--blue);
    }

    .fg .fc::placeholder {
        color: transparent;
    }

    /* Input base */
    .fc {
        border: 1px solid var(--border2);
        border-radius: var(--r);
        padding: 10px 14px;
        font-size: 13.5px;
        font-family: var(--font-b);
        font-weight: 600;
        color: var(--text) !important;
        background: var(--surface);
        transition: border-color .2s, box-shadow .2s, background .2s;
        outline: none;
        width: 100%;
        -webkit-text-fill-color: var(--text) !important;
        caret-color: var(--blue);
    }

        .fc:focus {
            border-color: var(--blue);
            box-shadow: 0 0 0 3px var(--blue-g);
            background: #fff;
        }

        .fc:-webkit-autofill,
        .fc:-webkit-autofill:hover,
        .fc:-webkit-autofill:focus {
            -webkit-text-fill-color: var(--text) !important;
            -webkit-box-shadow: 0 0 0px 1000px #ffffff inset !important;
        }

    textarea.fc {
        resize: vertical;
        line-height: 1.6;
    }

    select.fc {
        appearance: auto;
        cursor: pointer;
    }

        select.fc option {
            background: #fff;
            color: var(--text);
        }

    input[type="number"].fc::-webkit-inner-spin-button {
        opacity: .4;
    }

    .hint {
        font-size: 10.5px;
        color: var(--text3);
        font-family: var(--font-m);
        margin-top: 5px;
        padding-left: 2px;
        display: flex;
        align-items: center;
        gap: 5px;
    }

        .hint i {
            color: var(--blue);
            font-size: 11px;
        }

    /* Status toggle */
    .status-meta {
        font-family: var(--font-m);
        font-size: 9.5px;
        color: var(--text3);
        letter-spacing: 1px;
        text-transform: uppercase;
        margin-bottom: 8px;
        display: flex;
        align-items: center;
        gap: 5px;
    }

        .status-meta i {
            color: var(--blue);
        }

    .check-group {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 11px 16px;
        background: var(--surface2);
        border-radius: var(--r);
        border: 1px solid var(--border2);
        cursor: pointer;
        transition: all .2s;
        width: fit-content;
        user-select: none;
    }

        .check-group:hover {
            border-color: var(--blue);
            background: var(--blue-g2);
        }

    .check-input {
        width: 16px;
        height: 16px;
        cursor: pointer;
        accent-color: var(--blue);
    }

    .check-label {
        font-size: 13px;
        font-weight: 700;
        color: var(--text2);
        cursor: pointer;
        font-family: var(--font-b);
        transition: color .2s;
    }

    .check-group:hover .check-label {
        color: var(--blue);
    }

    /* File upload */
    .media-meta {
        font-family: var(--font-m);
        font-size: 9.5px;
        color: var(--text3);
        letter-spacing: 1px;
        text-transform: uppercase;
        margin-bottom: 8px;
        display: flex;
        align-items: center;
        gap: 5px;
    }

        .media-meta i {
            color: var(--amber);
        }

    .upload-zone {
        border: 2px dashed var(--border2);
        border-radius: var(--r);
        padding: 12px 16px;
        background: var(--surface2);
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 14px;
        transition: all .25s ease;
    }

        .upload-zone:hover {
            border-color: var(--blue);
            background: var(--blue-g2);
        }

    .upload-icon {
        width: 38px;
        height: 38px;
        background: linear-gradient(135deg, var(--blue) 0%, var(--blue-dark) 100%);
        border-radius: var(--r);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        font-size: 15px;
        flex-shrink: 0;
        box-shadow: 0 3px 10px rgba(78,157,255,.30);
    }

    .upload-title {
        font-size: 13px;
        font-weight: 700;
        color: var(--text2);
    }

    .upload-sub {
        font-size: 10.5px;
        color: var(--text3);
        font-family: var(--font-m);
        margin-top: 2px;
    }

    input[type="file"].hidden-file {
        display: none;
    }

    /* Button row */
    .btn-row {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
        padding-top: 20px;
        border-top: 1px solid var(--border2);
        margin-top: 6px;
    }

    .btn {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 10px 22px;
        font-family: var(--font-b);
        font-size: 13px;
        font-weight: 700;
        border-radius: var(--r);
        border: none;
        cursor: pointer;
        transition: all .2s ease;
    }

    .btn-primary {
        background: linear-gradient(135deg, var(--blue) 0%, var(--blue-dark) 100%);
        color: #fff;
        box-shadow: 0 3px 14px rgba(78,157,255,.30);
    }

        .btn-primary:hover {
            transform: translateY(-1px);
            box-shadow: 0 6px 20px rgba(78,157,255,.42);
        }

    .btn-secondary {
        background: var(--surface2);
        color: var(--text2);
        border: 1px solid var(--border2);
    }

        .btn-secondary:hover {
            background: var(--surface3);
            color: var(--text);
            border-color: var(--border3);
        }

    .btn-view {
        background: rgba(245,158,11,.10);
        color: var(--amber);
        border: 1px solid rgba(245,158,11,.25);
        display: none;
    }

        .btn-view.show {
            display: inline-flex;
        }

        .btn-view:hover {
            background: rgba(245,158,11,.18);
        }

    /* ══════════════════════
               GRID CARD
            ══════════════════════ */
    .grid-card {
        background: var(--surface);
        border-radius: var(--r3);
        border: 1px solid var(--border2);
        box-shadow: var(--sh2);
        overflow: hidden;
        animation: slideUp .35s cubic-bezier(.22,1,.36,1) both;
    }

    .gc-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 14px 22px;
        background: var(--surface2);
        border-bottom: 1px solid var(--border2);
        border-top: 3px solid var(--blue);
    }

    .gc-header-left {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .gc-icon {
        width: 32px;
        height: 32px;
        border-radius: var(--r);
        background: var(--blue-g);
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--blue);
        font-size: 13px;
    }

    .gc-title {
        font-family: var(--font-h);
        font-size: 14px;
        font-weight: 600;
        color: var(--text);
    }

    .gc-badge {
        background: var(--blue-g);
        color: var(--blue-dark);
        font-family: var(--font-m);
        font-size: 10.5px;
        font-weight: 500;
        padding: 3px 10px;
        border-radius: 20px;
        border: 1px solid rgba(78,157,255,.20);
    }

    /* Table */
    .tbl-scroll {
        height: 60vh;
        overflow-y: auto;
        scrollbar-width: thin;
        scrollbar-color: var(--border2) transparent;
    }

        .tbl-scroll::-webkit-scrollbar {
            width: 4px;
        }

        .tbl-scroll::-webkit-scrollbar-thumb {
            background: var(--border2);
            border-radius: 10px;
        }

    .pro-tbl {
        width: 100%;
        border-collapse: collapse;
    }

        .pro-tbl thead th {
            background: var(--surface2);
            color: var(--text3);
            padding: 10px 16px;
            font-size: 10px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1px;
            white-space: nowrap;
            font-family: var(--font-b);
            position: sticky;
            top: 0;
            z-index: 10;
            border-bottom: 1px solid var(--border2);
            text-align: left;
        }

        .pro-tbl tbody tr {
            border-bottom: 1px solid var(--border);
            transition: background .12s;
        }

            .pro-tbl tbody tr:hover {
                background: var(--surface2);
            }

            .pro-tbl tbody tr:last-child {
                border-bottom: none;
            }

        .pro-tbl tbody td {
            padding: 11px 16px;
            font-size: 13px;
            color: var(--text2);
            white-space: nowrap;
            font-weight: 600;
        }

            .pro-tbl tbody td:first-child {
                color: var(--text);
            }

    /* Action buttons */
    .tbl-btn {
        width: 30px;
        height: 30px;
        border-radius: var(--r);
        border: 1px solid transparent;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 11px;
        transition: all .15s;
    }

    .tbl-edit {
        background: var(--blue-g);
        color: var(--blue);
        border-color: rgba(78,157,255,.20);
    }

        .tbl-edit:hover {
            background: var(--blue);
            color: #fff;
            border-color: var(--blue);
        }

    .tbl-del {
        background: rgba(239,68,68,.08);
        color: var(--danger);
        border-color: rgba(239,68,68,.20);
        margin-left: 4px;
    }

        .tbl-del:hover {
            background: var(--danger);
            color: #fff;
            border-color: var(--danger);
        }

    /* Badges */
    .badge {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        font-size: 10.5px;
        font-weight: 700;
        padding: 3px 10px;
        border-radius: 20px;
        font-family: var(--font-b);
    }

    .badge-active {
        background: rgba(16,185,129,.10);
        color: #059669;
        border: 1px solid rgba(16,185,129,.25);
    }

    .badge-inactive {
        background: rgba(239,68,68,.08);
        color: var(--danger);
        border: 1px solid rgba(239,68,68,.20);
    }

    .badge i {
        font-size: 6px;
    }

    .img-link {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        color: var(--blue);
        font-size: 11.5px;
        font-family: var(--font-m);
        text-decoration: none;
        padding: 3px 9px;
        background: var(--blue-g);
        border-radius: 5px;
        border: 1px solid rgba(78,157,255,.20);
        transition: all .2s;
    }

        .img-link:hover {
            background: var(--blue);
            color: #fff;
            border-color: var(--blue);
        }

    /* Empty state */
    .empty-state {
        padding: 70px 20px;
        text-align: center;
    }

    .empty-icon {
        width: 60px;
        height: 60px;
        background: var(--surface2);
        border-radius: var(--r2);
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--text3);
        font-size: 22px;
        margin: 0 auto 16px;
        border: 1px solid var(--border2);
    }

    .empty-title {
        font-family: var(--font-h);
        font-size: 15px;
        font-weight: 600;
        color: var(--text2);
        margin-bottom: 5px;
    }

    .empty-sub {
        font-size: 12px;
        color: var(--text3);
        font-weight: 500;
    }

    /* Footer */
    .pg-footer {
        margin-top: 18px;
        padding-top: 14px;
        border-top: 1px solid var(--border2);
        text-align: center;
        font-family: var(--font-m);
        font-size: 10.5px;
        color: var(--text3);
        letter-spacing: .5px;
    }

        .pg-footer strong {
            color: var(--blue);
            font-weight: 500;
        }

        .pg-footer .heart {
            color: var(--coral);
        }

    /* ── KEYFRAMES ── */
    @@keyframes fadeDown {
        from {
            opacity: 0;
            transform: translateY(-16px)
        }

        to {
            opacity: 1;
            transform: translateY(0)
        }
    }

    @@keyframes slideUp {
        from {
            opacity: 0;
            transform: translateY(20px)
        }

        to {
            opacity: 1;
            transform: translateY(0)
        }
    }

    @@keyframes fadeUp {
        from {
            opacity: 0;
            transform: translateY(8px)
        }

        to {
            opacity: 1;
            transform: translateY(0)
        }
    }

    /* ── RESPONSIVE ── */
    @@media (max-width: 768px) {
        .sr-root {
            padding: 14px;
        }

        .frow-2, .frow-desc-timer {
            grid-template-columns: 1fr;
        }

        .page-header {
            flex-wrap: wrap;
            gap: 12px;
        }
    }
</style>

<div class="sr-root">
    <div class="sr-inner">

        <!-- PAGE HEADER -->
        <div class="page-header">
            <div class="ph-left">
                <div class="ph-icon"><i class="fas fa-images"></i></div>
                <div>
                    <div class="ph-title">Slider <span>Registry</span></div>
                    <div class="ph-breadcrumb">
                        Setup
                        <i class="fas fa-chevron-right"></i>
                        <span class="bc-cur">Slider Management</span>
                    </div>
                </div>
            </div>

            <!-- View Toggle -->
            <div class="view-toggle">
                <button class="vt-btn vt-btn-ghost" id="gridViewToggleBtn">
                    <i class="fas fa-table-cells"></i> Grid View
                </button>
                <button class="vt-btn vt-btn-active" id="formViewToggleBtn" style="display:none;">
                    <i class="fas fa-pen-to-square"></i> Form View
                </button>
            </div>
        </div>

        <div class="divider"><span></span><span></span><span></span></div>

        <!-- ══ FORM VIEW ══ -->
        <div id="formViewContainer">
            <div class="form-card">

                <!-- Form Body -->
                <div class="fc-body">
                    <input style="display:none;" type="text" id="SliderId">
                    <input style="display:none;" type="text" id="SliderImageAttachmentOld">

                    <!-- ROW 1: Slider Name + Heading (same row) -->
                    <div class="frow frow-2">
                        <div class="fg">
                            <input type="text" id="SliderName" class="fc" placeholder=" ">
                            <label class="fl" for="SliderName">Slider Name</label>
                        </div>
                        <div class="fg">
                            <input type="text" id="HeadingSlider" class="fc" placeholder=" ">
                            <label class="fl" for="HeadingSlider">Heading</label>
                        </div>
                    </div>

                    <!-- ROW 2: Description + Moving Timer (same row) -->
                    <div class="frow frow-desc-timer">
                        <div class="fg is-area">
                            <textarea id="DescriptionSlider" class="fc" placeholder=" " rows="2"></textarea>
                            <label class="fl" for="DescriptionSlider">Description</label>
                        </div>
                        <div>
                            <div class="fg">
                                <input type="number" id="SliderMovingTimer" class="fc" placeholder=" " min="0" value="0">
                                <label class="fl" for="SliderMovingTimer">Moving Timer (Seconds)</label>
                            </div>
                            <div class="hint"><i class="fas fa-circle-info"></i> How long each slide displays. Default: 0</div>
                        </div>
                    </div>

                    <div class="frow frow-2">
                        <div class="fg always-up">
                            <select id="SliderType" class="fc">
                                <option value="">— Select Type —</option>
                            </select>
                            <label class="fl" for="SliderType">Slider Type</label>
                        </div>
                        <div class="fg always-up">
                            <select id="VendorId" class="fc">
                                <option value="">— Select Vendor —</option>
                            </select>
                            <label class="fl" for="VendorId">Vendor</label>
                        </div>
                    </div>



                    <div class="frow frow-2" style="margin-bottom:20px;">
                        <!-- Status -->
                        <div>
                            <div class="check-group">
                                <input type="checkbox" id="IsActive" class="check-input">
                                <label class="check-label" for="IsActive">IsActive</label>
                            </div>
                        </div>

                        <!-- Image Upload -->
                        <div>
                            <div class="media-meta">
                                <i class="fas fa-image"></i>
                                Slider Image
                                <span style="font-size:9px;color:var(--text3);text-transform:none;letter-spacing:0;font-family:var(--font-b);font-weight:500;">(Max 500 KB · JPEG/PNG)</span>
                            </div>
                            <label for="SliderImageAttachment" class="upload-zone">
                                <div class="upload-icon"><i class="fas fa-cloud-arrow-up"></i></div>
                                <div>
                                    <div class="upload-title" id="fileNameDisplay">Click to browse</div>
                                    <div class="upload-sub">JPEG or PNG · max 500 KB</div>
                                </div>
                            </label>
                            <input id="SliderImageAttachment" class="hidden-file" type="file" accept=".jpeg,.png,.jpg">
                        </div>
                    </div>

                    <!-- Action Buttons -->
                    <div class="btn-row">
                        <button class="btn btn-primary" id="saveBtn">
                            <i class="fas fa-floppy-disk"></i> Save Slider
                        </button>
                        <button class="btn btn-secondary" id="cancelBtn">
                            <i class="fas fa-xmark"></i> Cancel
                        </button>
                        <a class="btn btn-view" id="ViewImageBtn" target="_blank">
                            <i class="fas fa-eye"></i> View Image
                        </a>
                    </div>

                </div><!-- /fc-body -->
            </div><!-- /form-card -->
        </div><!-- /formViewContainer -->
        <!-- ══ GRID VIEW ══ -->
        <div id="gridViewContainer" style="display:none;">
            <div class="grid-card">

                <div class="gc-header">
                    <div class="gc-header-left">
                        <div class="gc-icon"><i class="fas fa-table-list"></i></div>
                        <div>
                            <div class="gc-title">All Sliders</div>
                        </div>
                        <div class="gc-badge" id="TotalSlidersCount">0 records</div>
                    </div>
                    <div class="status-pill pill-live">Live Data</div>
                </div>

                <div class="tbl-scroll">
                    <div id="SliderGridContainer"></div>
                </div>

            </div>
        </div><!-- /gridViewContainer -->

        <div class="pg-footer">
            Developed with <span class="heart">♥</span> by <strong>UT Designer</strong>
        </div>

    </div>
</div>

<script>
    let userId = localStorage.getItem("userId") || "",
        GridViewDataList = [],
        IsUpdate = false;

    const SW = {
        background: '#ffffff',
        color: '#1e2a3a',
        confirmButtonColor: '#4e9dff',
        cancelButtonColor: '#f8f9fc'
    };

    /* ── Float Labels ── */
    function initFloatLabels() {
        document.querySelectorAll('.fg').forEach(g => {
            if (g.classList.contains('always-up')) return;
            const el = g.querySelector('input:not([type="checkbox"]):not([type="file"]):not([style*="display:none"]),textarea,select');
            if (!el) return;
            const chk = () => g.classList.toggle('has-value', el.value !== '');
            el.addEventListener('input', chk);
            el.addEventListener('change', chk);
            chk();
        });
    }

    /* ── View Toggle ── */
    function showFormView() {
        document.getElementById("formViewContainer").style.display = "block";
        document.getElementById("gridViewContainer").style.display  = "none";
        document.getElementById("formViewToggleBtn").style.display  = "none";
        document.getElementById("gridViewToggleBtn").style.display  = "inline-flex";
        document.getElementById("gridViewToggleBtn").className      = "vt-btn vt-btn-ghost";
        document.getElementById("SliderName").focus();
    }

    function showGridView() {
        document.getElementById("formViewContainer").style.display = "none";
        document.getElementById("gridViewContainer").style.display  = "block";
        document.getElementById("gridViewToggleBtn").style.display  = "none";
        document.getElementById("formViewToggleBtn").style.display  = "inline-flex";
        document.getElementById("formViewToggleBtn").className      = "vt-btn vt-btn-active";
    }

    document.getElementById("gridViewToggleBtn").addEventListener("click", showGridView);
    document.getElementById("formViewToggleBtn").addEventListener("click", showFormView);

    /* ── File Input ── */
    document.getElementById("SliderImageAttachment").addEventListener("change", async function () {
        const file = this.files[0];
        if (!file) return;
        if (file.size > 500 * 1024) {
            this.value = "";
            document.getElementById("fileNameDisplay").textContent = "Click to browse";
            await Swal.fire({ icon: 'warning', title: 'File Too Large', text: 'Image must be under 500 KB.', returnFocus: false, ...SW });
        } else {
            document.getElementById("fileNameDisplay").textContent = file.name;
        }
    });

    function GetSliderImageAttachmentFile() {
        return new Promise(resolve => {
            const fileInput = document.getElementById("SliderImageAttachment"),
                  file = fileInput.files[0];
            if (!file) { resolve({ SliderImageAttachmentfilename: "", SliderImageAttachmentbase64: "" }); return; }
            const reader = new FileReader();
            reader.onload = e => {
                const n   = document.getElementById("SliderName").value.trim(),
                      now = new Date(),
                      pad = x => x.toString().padStart(2, "0"),
                      ts  = `${pad(now.getDate())}${pad(now.getMonth()+1)}${now.getFullYear()}${pad(now.getHours())}${pad(now.getMinutes())}`,
                      ext = file.name.split(".").pop();
                resolve({ SliderImageAttachmentfilename: `${n}_${ts}.${ext}`, SliderImageAttachmentbase64: e.target.result });
            };
            reader.onerror = () => resolve({ SliderImageAttachmentfilename: "", SliderImageAttachmentbase64: "" });
            reader.readAsDataURL(file);
        });
    }

    /* ── Init ── */
    window.addEventListener("load", async function () {
        initFloatLabels();
        await LoadSliderRegistrationData();
        await LoadGridViewData();
    });

    async function LoadSliderRegistrationData() {
        try {
            const r = await jQuery.ajax({
                type: 'POST',
                url: '@Url.Action("nLoadSliderRegistrationData", "SliderRegistration")',
                data: JSON.stringify({ Userid: userId }),
                contentType: 'application/json'
            });
            if (r.statusId === 1) {
                const vs = document.getElementById("VendorId");
                vs.innerHTML = '<option value="">— Select Vendor —</option>';
                r.VendorList.forEach(i => { vs.innerHTML += `<option value="${i.VendorId}">${i.Vendor}</option>`; });

                const st = document.getElementById("SliderType");
                st.innerHTML = '<option value="">— Select Type —</option>';
                r.SliderTypeList.forEach(i => { st.innerHTML += `<option value="${i.SliderType}">${i.SliderType}</option>`; });
            } else {
                await Swal.fire({ icon: 'warning', title: 'Warning', text: r.message || 'Failed', ...SW });
            }
        } catch {
            await Swal.fire({ icon: 'error', title: 'Error', text: 'Error loading data', ...SW });
        }
    }

    async function LoadGridViewData() {
        try {
            const r = await jQuery.ajax({
                type: 'POST',
                url: '@Url.Action("nLoadGridViewData", "SliderRegistration")',
                data: JSON.stringify({ Userid: userId }),
                contentType: 'application/json'
            });
            if (r.statusId === 1) {
                GridViewDataList = r.GridViewDataList || [];
                RenderGridView();
            } else {
                await Swal.fire({ icon: 'warning', title: 'Warning', text: r.message || 'Failed', ...SW });
            }
        } catch {
            await Swal.fire({ icon: 'error', title: 'Error', text: 'Error loading grid', ...SW });
        }
    }

    function gv(item, names, def = '') {
        for (let n of names) { if (item[n] !== undefined && item[n] !== null) return item[n]; }
        return def;
    }

    function RenderGridView() {
        const c   = document.getElementById("SliderGridContainer"),
              cnt = document.getElementById("TotalSlidersCount");

        if (!GridViewDataList.length) {
            c.innerHTML = `
                <div class="empty-state">
                    <div class="empty-icon"><i class="fas fa-images"></i></div>
                    <div class="empty-title">No Sliders Found</div>
                    <div class="empty-sub">Click "Form View" to add your first slider.</div>
                </div>`;
            cnt.textContent = "0 records";
            return;
        }

        const t  = document.createElement("table");
        t.className = "pro-tbl";
        t.innerHTML = `
            <thead>
                <tr>
                    <th>Actions</th>
                    <th>ID</th>
                    <th>Slider Name</th>
                    <th>Heading</th>
                    <th>Description</th>
                    <th>Timer (s)</th>
                    <th>Vendor</th>
                    <th>Type</th>
                    <th>Status</th>
                    <th>Image</th>
                </tr>
            </thead>`;

        const tb = document.createElement("tbody");
        GridViewDataList.forEach(item => {
            const tr = document.createElement("tr");
            const isActive = item['Is Active'] === true || item['Is Active'] === 1;
            tr.innerHTML = `
                <td>
                    <button class="tbl-btn tbl-edit" onclick="EditSlider(${item.SliderId})" title="Edit"><i class="fas fa-pen"></i></button>
                    <button class="tbl-btn tbl-del"  onclick="DeleteSlider(${item.SliderId})" title="Delete"><i class="fas fa-trash-can"></i></button>
                </td>
                <td>${item.SliderId || ''}</td>
                <td>${gv(item, ['SliderName', 'Slider Name'])}</td>
                <td>${gv(item, ['HeadingSlider', 'Heading Slider', 'Heading'], '—')}</td>
                <td>${gv(item, ['DescriptionSlider', 'Description Slider', 'Description'], '—')}</td>
                <td>${gv(item, ['SliderMovingTimer', 'Slider Moving Timer'], '0')}</td>
                <td>${gv(item, ['Vendor', 'VendorId Name'])}</td>
                <td>${gv(item, ['SliderType', 'Slider Type'], '—')}</td>
                <td>
                    ${isActive
                        ? '<span class="badge badge-active"><i class="fas fa-circle"></i> Active</span>'
                        : '<span class="badge badge-inactive"><i class="fas fa-circle"></i> Inactive</span>'}
                </td>
                <td>
                    ${item.SliderImages
                        ? `<a class="img-link" href="${item.SliderImages}" target="_blank"><i class="fas fa-eye"></i> View</a>`
                        : '<span style="color:var(--text3);font-size:11px;">—</span>'}
                </td>`;
            tb.appendChild(tr);
        });

        t.appendChild(tb);
        c.innerHTML = "";
        c.appendChild(t);
        cnt.textContent = `${tb.rows.length} record${tb.rows.length !== 1 ? 's' : ''}`;
    }

    function EditSlider(SliderId) {
        const s = GridViewDataList.find(c => parseInt(c.SliderId) === parseInt(SliderId));
        if (!s) { Swal.fire({ icon: 'error', title: 'Error', text: 'Not found.', ...SW }); return; }

        const g = (names, def = '') => { for (let n of names) { if (s[n] !== undefined && s[n] !== null) return s[n]; } return def; };

        document.getElementById("SliderId").value           = s.SliderId || '';
        document.getElementById("SliderName").value         = g(['SliderName', 'Slider Name']);
        document.getElementById("HeadingSlider").value      = g(['HeadingSlider', 'Heading Slider', 'Heading']);
        document.getElementById("DescriptionSlider").value  = g(['DescriptionSlider', 'Description Slider', 'Description']);
        document.getElementById("SliderMovingTimer").value  = g(['SliderMovingTimer', 'Slider Moving Timer'], '0');
        document.getElementById("SliderType").value         = g(['SliderType', 'Slider Type']);
        document.getElementById("VendorId").value           = s.VendorId || '';
        document.getElementById("IsActive").checked         = s['Is Active'] === true || s['Is Active'] === 1;

        const vb = document.getElementById("ViewImageBtn");
        if (s.SliderImages) {
            document.getElementById("SliderImageAttachmentOld").value = s.SliderImages;
            vb.href = s.SliderImages;
            vb.classList.add("show");
        } else {
            document.getElementById("SliderImageAttachmentOld").value = "";
            vb.classList.remove("show");
        }

        IsUpdate = true;
        document.getElementById("saveBtn").innerHTML = '<i class="fas fa-floppy-disk"></i> Update Slider';
        initFloatLabels();
        showFormView();
    }

    async function DeleteSlider(SliderId) {
        const r = await Swal.fire({
            title: 'Delete Slider?',
            text: 'This action cannot be undone.',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonText: 'Yes, Delete',
            cancelButtonText: 'Cancel',
            confirmButtonColor: '#ef4444',
            ...SW
        });
        if (!r.isConfirmed) return;

        const s = GridViewDataList.find(c => parseInt(c.SliderId) === parseInt(SliderId));
        if (!s) { await Swal.fire({ icon: 'error', title: 'Error', text: 'Not found.', ...SW }); return; }

        let img = "";
        if (s.SliderImages) { const p = s.SliderImages.split('/'); img = p[p.length - 1]; }

        Swal.fire({ title: 'Please wait', text: 'Deleting...', allowOutsideClick: false, allowEscapeKey: false, didOpen: () => Swal.showLoading(), ...SW });

        try {
            const res = await jQuery.ajax({
                type: 'POST',
                url: '@Url.Action("nDeleteSliderRegistrationData", "SliderRegistration")',
                data: JSON.stringify({ Userid: userId, SliderId: `${SliderId}`, SliderImageAttachmentfilenameold: img, FtpPath: "/wwwroot/Images/SliderRegistration" }),
                contentType: 'application/json'
            });
            Swal.close();
            if (res.statusId === 1) {
                await Swal.fire({ icon: 'success', title: 'Deleted!', text: res.message || 'Slider deleted.', ...SW });
                await LoadGridViewData();
            } else {
                await Swal.fire({ icon: 'warning', title: 'Failed', text: res.message || 'Could not delete.', ...SW });
            }
        } catch {
            Swal.close();
            await Swal.fire({ icon: 'error', title: 'Error', text: 'An error occurred.', ...SW });
        }
    }

    /* ── Save ── */
    document.getElementById("saveBtn").addEventListener("click", async function () {
        const SliderId              = document.getElementById("SliderId").value.trim(),
              SliderName            = document.getElementById("SliderName").value.trim(),
              HeadingSlider         = document.getElementById("HeadingSlider").value.trim(),
              DescriptionSlider     = document.getElementById("DescriptionSlider").value.trim(),
              SliderMovingTimer     = document.getElementById("SliderMovingTimer").value.trim(),
              SliderType            = document.getElementById("SliderType").value.trim(),
              VendorId              = document.getElementById("VendorId").value.trim(),
              isActive              = document.getElementById("IsActive").checked,
              hasImage              = document.getElementById("SliderImageAttachment").files.length > 0,
              SliderImageAttachmentold = document.getElementById("SliderImageAttachmentOld").value.trim();

        const validations = [
            { cond: !SliderName,                                                                          text: 'Slider name is required',           focus: 'SliderName' },
            { cond: !SliderMovingTimer || isNaN(SliderMovingTimer) || parseInt(SliderMovingTimer) < 0,   text: 'Enter a valid timer (0 or more)',    focus: 'SliderMovingTimer' },
            { cond: !SliderType,                                                                          text: 'Please select slider type',         focus: 'SliderType' },
            { cond: !VendorId,                                                                            text: 'Please select a vendor',            focus: 'VendorId' },
            { cond: !IsUpdate && !hasImage,                                                               text: 'Please select a slider image',      focus: 'SliderImageAttachment' }
        ];

        for (const v of validations) {
            if (v.cond) {
                await Swal.fire({ icon: 'warning', title: 'Validation', text: v.text, returnFocus: false, ...SW, didClose: () => document.getElementById(v.focus).focus() });
                return;
            }
        }

        const { SliderImageAttachmentfilename, SliderImageAttachmentbase64 } = await GetSliderImageAttachmentFile();

        const payload = {
            Userid: userId, SliderId, SliderName,
            HeadingSlider: HeadingSlider || "",
            DescriptionSlider: DescriptionSlider || "",
            SliderMovingTimer: parseInt(SliderMovingTimer) || 0,
            SliderType, VendorId,
            SliderImageAttachmentfilename,
            SliderImageAttachmentfilenameold: SliderImageAttachmentold,
            SliderImageAttachmentbase64,
            IsActive: isActive, IsUpdate,
            FtpPath: "/wwwroot/Images/SliderRegistration"
        };

        Swal.fire({ title: 'Saving...', text: 'Please wait', allowOutsideClick: false, allowEscapeKey: false, didOpen: () => Swal.showLoading(), ...SW });

        try {
            const res = await jQuery.ajax({
                type: 'POST',
                url: '@Url.Action("nSaveSliderRegistrationData", "SliderRegistration")',
                data: JSON.stringify(payload),
                contentType: 'application/json'
            });
            Swal.close();
            if (res.statusId === 1) {
                await Swal.fire({ icon: 'success', title: 'Saved!', text: res.message || 'Slider saved successfully.', returnFocus: false, ...SW, didClose: () => document.getElementById("SliderName").focus() });
                nClearForm();
            } else {
                await Swal.fire({ icon: 'warning', title: 'Failed', text: res.message || 'Could not save.', ...SW });
            }
        } catch {
            Swal.close();
            await Swal.fire({ icon: 'error', title: 'Error', text: 'An error occurred.', ...SW });
        }
    });

    /* ── Cancel / Clear ── */
    document.getElementById("cancelBtn").addEventListener("click", () => nClearForm());

    async function nClearForm() {
        ["SliderId", "SliderImageAttachmentOld", "SliderName", "HeadingSlider", "DescriptionSlider"].forEach(id => document.getElementById(id).value = "");
        document.getElementById("SliderMovingTimer").value = "0";
        document.getElementById("SliderType").value        = "";
        document.getElementById("VendorId").value          = "";
        document.getElementById("IsActive").checked        = false;
        document.getElementById("SliderImageAttachment").value = "";
        document.getElementById("fileNameDisplay").textContent = "Click to browse";
        IsUpdate = false;
        document.getElementById("saveBtn").innerHTML = '<i class="fas fa-floppy-disk"></i> Save Slider';
        document.getElementById("ViewImageBtn").classList.remove("show");
        initFloatLabels();
        document.getElementById("SliderName").focus();
        await LoadGridViewData();
    }
</script>
