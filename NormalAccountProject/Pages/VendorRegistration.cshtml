@page "/VendorRegistration"
@model NormalAccountProject.Pages.VendorRegistrationModel
@{
    ViewData["Title"] = "Vendor Registration";
}

<div class="section__content section__content--p30">
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-12">
                <div class="overview-wrap d-flex justify-content-between align-items-center">
                    <h2 class="title-1">Vendor Registration</h2>
                    <div>
                        <button class="btn btn-info" id="gridViewToggleBtn">
                            <i class="fas fa-table me-2"></i>Grid View
                        </button>
                        <button class="btn btn-primary" id="formViewToggleBtn" style="display:none;">
                            <i class="fas fa-form me-2"></i>Form View
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <hr>

        <!-- FORM VIEW -->
        <div id="formViewContainer" style="max-height: 75vh; overflow-y: auto; padding-right: 5px;">
            <div class="row mt-3">
                <div class="col-md-6">
                    <!-- Row 1: Vendor Name + Contact No -->
                    <div class="row mb-3">
                        <input style="display:none;" type="text" id="VendorId">
                        <input style="display:none;" type="text" id="VendorImageAttachmentOld">

                        <div class="col-md-6">
                            <label for="Vendor">Vendor Name</label>
                            <input type="text" id="Vendor" class="form-control" placeholder="Enter Vendor Name">
                        </div>
                        <div class="col-md-6">
                            <label for="ContactNo">Contact Number</label>
                            <input type="text" id="ContactNo" class="form-control" placeholder="Enter Contact Number" inputmode="numeric" autocomplete="off">
                        </div>
                    </div>

                    <!-- Row 2: Time In + Time Out -->
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label for="TimeIn">Time In</label>
                            <input type="time" id="TimeIn" class="form-control" placeholder="Enter Time In">
                        </div>
                        <div class="col-md-6">
                            <label for="TimeOut">Time Out</label>
                            <input type="time" id="TimeOut" class="form-control" placeholder="Enter Time Out">
                        </div>
                    </div>

                    <!-- Row 3: Delivery Charges + Per Product Amount -->
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label for="DeliveryCharges">Delivery Charges</label>
                            <input type="text" id="DeliveryCharges" class="form-control" placeholder="Enter Delivery Charges">
                        </div>
                        <div class="col-md-6">
                            <label for="PerProductAmount">Per Product Amount</label>
                            <input type="text" id="PerProductAmount" class="form-control" placeholder="Enter Per Product Amount">
                        </div>
                    </div>

                    <!-- Row 4: Address -->
                    <div class="row mb-3">
                        <div class="col-md-12">
                            <label for="Address">Address</label>
                            <textarea id="Address" class="form-control" placeholder="Enter Address" rows="2" style="resize: vertical;"></textarea>
                        </div>
                    </div>

                    <!-- Row 5: Type + Department -->
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label for="TypeId">Type</label>
                            <select id="TypeId" class="form-control">
                                <option value="">-- Select Type --</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label for="DepartmentId">Department</label>
                            <select id="DepartmentId" class="form-control">
                                <option value="">-- Select Department --</option>
                            </select>
                        </div>
                    </div>

                    <!-- Row 6: IsActive -->
                    <div class="row mb-3">
                        <div class="col-md-6 d-flex align-items-center">
                            <div class="form-check">
                                <input type="checkbox" id="IsActive" class="form-check-input">
                                <label class="form-check-label" for="IsActive">Is Active</label>
                            </div>
                        </div>
                    </div>

                    <!-- Row 7: Vendor Image -->
                    <div class="row mb-3">
                        <div class="col-md-12" style="display: grid;">
                            <label>Vendor Image (Max Size 500KB)*</label>
                            <input id="VendorImageAttachment" style="height: fit-content;background: white;padding: 5px;" type="file" accept=".jpeg,.png" required>
                        </div>
                    </div>

                    <!-- Row 8: Buttons -->
                    <div class="row mb-3">
                        <div class="col-md-4 d-flex align-items-end">
                            <button class="btn btn-success me-2" id="saveBtn">Save</button>
                            <button class="btn btn-secondary me-2" id="cancelBtn">Cancel</button>
                            <a class="btn btn-warning" style="display:none;" id="ViewImageBtn" target="_blank">
                                View Image
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- GRID VIEW -->
        <div id="gridViewContainer" style="display:none;">
            <div class="row mt-5">
                <div class="col-md-12">
                    <div id="VendorGridContainer" class="table-responsive" style="height: 62vh; overflow-y: auto;"></div>
                    <div class="mt-3" style="text-align:center;">
                        <p>Total Vendors (<span id="TotalVendorsCount">100</span>)</p>
                    </div>
                </div>
            </div>
        </div>

        <hr>

        <div class="row">
            <div class="col-md-12">
                <div class="copyright">
                    <p style="margin: 0;">Software Developed By : <span style="font-weight:600;">UT Designer</span></p>
                </div>
            </div>
        </div>

    </div>
</div>

<script>
    // Variable Declaration
    let userId = localStorage.getItem("userId") || "";
    let GridViewDataList = [];
    let IsUpdate = false;
    // Variable Declaration

    // VIEW TOGGLE FUNCTIONS
    function showFormView() {
        document.getElementById("formViewContainer").style.display = "block";
        document.getElementById("gridViewContainer").style.display = "none";
        document.getElementById("formViewToggleBtn").style.display = "none";
        document.getElementById("gridViewToggleBtn").style.display = "inline-block";
        document.getElementById("Vendor").focus();
    }

    function showGridView() {
        document.getElementById("formViewContainer").style.display = "none";
        document.getElementById("gridViewContainer").style.display = "block";
        document.getElementById("gridViewToggleBtn").style.display = "none";
        document.getElementById("formViewToggleBtn").style.display = "inline-block";
    }

    // Toggle Button Click Events
    document.getElementById("gridViewToggleBtn").addEventListener("click", showGridView);
    document.getElementById("formViewToggleBtn").addEventListener("click", showFormView);
    // VIEW TOGGLE FUNCTIONS


    // Vendor Image
    document.getElementById("VendorImageAttachment").addEventListener("change", async function () {
        const file = this.files[0];
        if (!file) return;

        const maxSize = 500 * 1024; // 500 KB
        if (file.size > maxSize) {
            this.value = "";

            await Swal.fire({
                icon: 'warning',
                title: 'Validation',
                text: 'Image size must be less than 500 KB.',
                returnFocus: false,
                didClose: () => {
                    document.getElementById("VendorImageAttachment").focus();
                }
            });
        }
    });
    function GetVendorImageAttachmentFile() {
        return new Promise((resolve, reject) => {
            const fileInput = document.getElementById("VendorImageAttachment");
            const file = fileInput.files[0];

            if (!file) {
                resolve({ VendorImageAttachmentfilename: "", VendorImageAttachmentbase64: "" });
                return;
            }

            const reader = new FileReader();

            reader.onload = function (e) {
                const Vendor = document.getElementById("Vendor").value.trim();

                const now = new Date();
                const pad = (num) => num.toString().padStart(2, "0");
                const timestamp = `${pad(now.getDate())}${pad(now.getMonth() + 1)}${now.getFullYear()}${pad(now.getHours())}${pad(now.getMinutes())}`;

                const originalNameParts = file.name.split(".");
                const fileExtension = originalNameParts.pop();
                const newFileName = `${Vendor}_${timestamp}_VendorRegistrationLogo.${fileExtension}`;

                const arrayBuffer = e.target.result;
                const uint8Array = new Uint8Array(arrayBuffer);
                let binaryString = "";
                for (let i = 0; i < uint8Array.length; i++) {
                    binaryString += String.fromCharCode(uint8Array[i]);
                }
                const base64String = btoa(binaryString);

                resolve({
                    VendorImageAttachmentfilename: newFileName,
                    VendorImageAttachmentbase64: base64String
                });
            };

            reader.onerror = function () {
                resolve({ VendorImageAttachmentfilename: "", VendorImageAttachmentbase64: "" });
            };

            reader.readAsArrayBuffer(file);
        });
    }
    // Vendor Image


    // Time In - Time Out Textbox
    function setCurrentTime() {
        const now = new Date();
        const hours = String(now.getHours()).padStart(2, '0');
        const minutes = String(now.getMinutes()).padStart(2, '0');
        const currentTime = `${hours}:${minutes}`;

        document.getElementById("TimeIn").value = currentTime;
        document.getElementById("TimeOut").value = currentTime;

        storeTime("TimeIn");
        storeTime("TimeOut");
    }
    function storeTime(inputId) {
        const timeValue = document.getElementById(inputId).value;
        if (!timeValue) return;
        const formattedTime = `1900-01-01 ${timeValue}:00.000`;
        console.log(inputId + " => ", formattedTime);
        if (inputId === "TimeIn") {
            window.TimeInValue = formattedTime;
        } else if (inputId === "TimeOut") {
            window.TimeOutValue = formattedTime;
        }
    }
    function getTimeFromTextbox(inputId) {
        const timeValue = document.getElementById(inputId).value;
        if (!timeValue) {
            console.log(inputId + " is empty");
            return;
        }
        const formattedTime = `1900-01-01 ${timeValue}:00.000`;
        return formattedTime;
    }
    function setTimeToTextbox(inputId, dateTimeValue) {
        if (!dateTimeValue) return;
        const time = dateTimeValue.split("T")[1].substring(0, 5);
        document.getElementById(inputId).value = time;
    }
    // Time In - Time Out Textbox


    // Form Load
    document.addEventListener("DOMContentLoaded", async function () {
        await LoadData();
        await LoadGridViewData();
        setCurrentTime();
        document.getElementById("DeliveryCharges").value = "0";
        document.getElementById("PerProductAmount").value = "0";

        const fields = [
            document.getElementById("Vendor"),
            document.getElementById("ContactNo"),
            document.getElementById("TypeId"),
            document.getElementById("DepartmentId"),
            document.getElementById("IsActive")
        ];
        fields.forEach((field, index) => {
            field.addEventListener("keydown", function (e) {
                if (e.key === "Enter") {
                    e.preventDefault();
                    if (index < fields.length - 1) {
                        fields[index + 1].focus();
                    } else {
                        document.getElementById("saveBtn").click();
                    }
                }
            });
        });
        document.getElementById("Vendor").focus();
    });
    // Form Load


    // Load Type & Department DropDown
    async function LoadData() {
        const nInfoTab = { Userid: userId };

        return new Promise((resolve, reject) => {
            jQuery.ajax({
                type: 'POST',
                url: '@Url.Action("nLoadVendorRegistrationData", "VendorRegistration")',
                data: JSON.stringify(nInfoTab),
                contentType: 'application/json',
                success: function (response) {
                    if (response.statusId === 1) {
                        TypeDropdown(response.TypeList);
                        DepartmentDropdown(response.DepartmentList);
                        resolve();
                    } else {
                        toastr.warning("No data found for VendorRegistration.");
                        reject();
                    }
                },
                error: function (xhr, status, error) {
                    console.log("Error LoadData details: ", xhr, status, error);
                    reject();
                }
            });
        });
    }
    function TypeDropdown(typeList) {
        const ddl = document.getElementById("TypeId");
        ddl.innerHTML = '<option value="">-- Select Type --</option>';
        typeList.forEach(item => {
            const option = document.createElement("option");
            option.value = item.TypeId;
            option.text = item.Type;
            ddl.appendChild(option);
        });
    }
    function DepartmentDropdown(departmentList) {
        const ddl = document.getElementById("DepartmentId");
        ddl.innerHTML = '<option value="">-- Select Department --</option>';
        departmentList.forEach(item => {
            const option = document.createElement("option");
            option.value = item.DepartmentId;
            option.text = item.Department;
            ddl.appendChild(option);
        });
    }
    // Load Type & Department DropDown


    // Grid View
    async function LoadGridViewData() {
        const nInfoTab = { Userid: userId };

        return new Promise((resolve, reject) => {
            jQuery.ajax({
                type: 'POST',
                url: '@Url.Action("nLoadGridViewData", "VendorRegistration")',
                data: JSON.stringify(nInfoTab),
                contentType: 'application/json',
                success: function (response) {
                    if (response.statusId === 1) {
                        console.log(response.GridViewDataList);
                        GridViewDataList = response.GridViewDataList;
                        renderVendorGrid(GridViewDataList);
                        resolve();
                    } else {
                        toastr.warning("No data found for VendorRegistration.");
                        reject();
                    }
                },
                error: function (xhr, status, error) {
                    console.log("Error LoadData details: ", xhr, status, error);
                    reject();
                }
            });
        });
    }
    function renderVendorGrid(gridData) {
        const container = document.getElementById("VendorGridContainer");
        container.innerHTML = "";

        if (!gridData || gridData.length === 0) {
            container.innerHTML = '<p>No records found.</p>';
            document.getElementById("TotalVendorsCount").textContent = "0";
            return;
        }

        const columns = Object.keys(gridData[0]).filter(col =>
            col !== "Userid" && col !== "Type" && col !== "VendorId" &&
            col !== "DepartmentId" && col !== "ImagePath" &&
            col !== "TimeIn" && col !== "TimeOut"
        );

        const table = document.createElement("table");
        table.className = "table table-bordered table-striped table-sm mb-0";

        const thead = document.createElement("thead");
        thead.style.position = "sticky";
        thead.style.top = "0";
        thead.style.backgroundColor = "#fff";
        thead.style.zIndex = "10";

        const headerRow = document.createElement("tr");
        const actionTh = document.createElement("th");
        actionTh.textContent = "";
        headerRow.appendChild(actionTh);

        columns.forEach(col => {
            const th = document.createElement("th");
            th.textContent = col;
            headerRow.appendChild(th);
        });
        thead.appendChild(headerRow);

        const filterRow = document.createElement("tr");
        const emptyTh = document.createElement("th");
        filterRow.appendChild(emptyTh);

        columns.forEach(col => {
            const th = document.createElement("th");
            const input = document.createElement("input");
            input.type = "text";
            input.placeholder = `Filter ${col}`;
            input.className = "form-control form-control-sm";
            input.addEventListener("input", function () {
                filterTable(this, col);
            });
            th.appendChild(input);
            filterRow.appendChild(th);
        });
        thead.appendChild(filterRow);
        table.appendChild(thead);

        const tbody = document.createElement("tbody");

        gridData.forEach(row => {
            const tr = document.createElement("tr");

            const actionTd = document.createElement("td");

            const editBtn = document.createElement("button");
            editBtn.className = "btn btn-sm btn-primary me-1";
            editBtn.innerHTML = '<i class="fas fa-edit"></i>';
            editBtn.style.padding = "3px";
            editBtn.addEventListener("click", () => {
                onEditRow(row);
                showFormView();
            });
            actionTd.appendChild(editBtn);

            const deleteBtn = document.createElement("button");
            deleteBtn.className = "btn btn-sm btn-danger";
            deleteBtn.innerHTML = '<i class="fas fa-trash"></i>';
            deleteBtn.style.padding = "3px";
            deleteBtn.addEventListener("click", () => onDeleteRow(row));
            actionTd.appendChild(deleteBtn);

            tr.appendChild(actionTd);

            columns.forEach(col => {
                const td = document.createElement("td");
                if (col === "Is Active") {
                    td.innerHTML = row[col] ? '<span class="badge bg-success">Active</span>' : '<span class="badge bg-danger">In-Active</span>';
                } else {
                    td.textContent = row[col];
                }
                tr.appendChild(td);
            });

            tbody.appendChild(tr);
        });

        table.appendChild(tbody);
        container.appendChild(table);

        document.getElementById("TotalVendorsCount").textContent = tbody.rows.length;
    }
    function filterTable(input, column) {
        const table = input.closest("table");
        const tbody = table.querySelector("tbody");
        const rows = Array.from(tbody.rows);
        const filterValue = input.value.toLowerCase();

        const colIndex = Array.from(table.querySelectorAll("thead tr:first-child th")).findIndex(th => th.textContent === column);

        let visibleCount = 0;

        rows.forEach(row => {
            const cellText = row.cells[colIndex].textContent.toLowerCase();
            if (cellText.includes(filterValue)) {
                row.style.display = "";
                visibleCount++;
            } else {
                row.style.display = "none";
            }
        });

        document.getElementById("TotalVendorsCount").textContent = visibleCount;
    }
    function onEditRow(rowData) {
        IsUpdate = true;
        document.getElementById("saveBtn").textContent = "Update";

        document.getElementById("VendorId").value = rowData["VendorId"] || "";
        document.getElementById("VendorImageAttachmentOld").value = rowData["ImagePath"] || "";
        document.getElementById("Vendor").value = rowData["Vendor Name"] || "";
        document.getElementById("ContactNo").value = rowData["Contact #"] || "";
        document.getElementById("TypeId").value = rowData["Type"] || "";
        document.getElementById("DepartmentId").value = rowData["DepartmentId"] || "";
        document.getElementById("IsActive").checked = rowData["Is Active"] || false;
        document.getElementById("DeliveryCharges").value = rowData["Delivery Charges"] || "";
        document.getElementById("PerProductAmount").value = rowData["PerProductAmount"] || "";
        document.getElementById("Address").value = rowData["Address"] || "";  // ✅ Address

        setTimeToTextbox("TimeIn", rowData["TimeIn"]);
        setTimeToTextbox("TimeOut", rowData["TimeOut"]);

        console.log("Edit TimeIn:", rowData["TimeIn"]);
        console.log("Edit TimeOut:", rowData["TimeOut"]);

        document.getElementById("Vendor").focus();

        ViewImage(rowData["ImagePath"] || "");
    }

    async function onDeleteRow(rowData) {
        console.log("Delete clicked", rowData);

        const result = await Swal.fire({
            title: 'Are you sure?',
            text: `Do you really want to delete this Vendor (${rowData["Vendor Name"]}) ?`,
            icon: 'warning',
            showCancelButton: true,
            confirmButtonText: 'Yes',
            cancelButtonText: 'No'
        });

        if (!result.isConfirmed) return;

        const nInfoTab = {
            Userid: userId.toString(),
            VendorId: rowData["VendorId"].toString(),
            VendorImageAttachmentfilenameold: rowData["ImagePath"].toString()
        };

        Swal.fire({
            title: 'Please wait',
            text: 'Vendor Delete is in process...',
            allowOutsideClick: false,
            allowEscapeKey: false,
            returnFocus: false,
            didOpen: () => Swal.showLoading()
        });

        try {
            const response = await jQuery.ajax({
                type: 'POST',
                url: '@Url.Action("nDeleteVendorRegistrationData", "VendorRegistration")',
                data: JSON.stringify(nInfoTab),
                contentType: 'application/json'
            });

            Swal.close();

            if (response.statusId === 1) {
                await Swal.fire({
                    icon: 'success',
                    title: 'Vendor Deleted',
                    text: response.message || 'Vendor deleted successfully',
                    returnFocus: false,
                    didClose: () => {
                        document.getElementById("Vendor").focus();
                    }
                });

                nClearForm();
            } else {
                await Swal.fire({
                    icon: 'warning',
                    title: 'Vendor Delete',
                    text: response.message || 'Vendor delete failed',
                    returnFocus: false
                });
            }

        } catch (xhr) {
            Swal.close();

            await Swal.fire({
                icon: 'error',
                title: 'Error',
                text: 'An error occurred while deleting Vendor',
                returnFocus: false
            });

            console.error("Delete Error:", xhr);
        }
    }
    function ViewImage(Link) {
        const viewBtn = document.getElementById("ViewImageBtn");
        viewBtn.style.display = "";
        viewBtn.href = Link;
        viewBtn.target = "_blank";
    }
    // Grid View


    // Save Button click
    document.getElementById("saveBtn").addEventListener("click", async function () {
        console.log(getTimeFromTextbox("TimeIn"));
        console.log(getTimeFromTextbox("TimeOut"));
        await SaveData();
    });
    async function SaveData() {
        const VendorId = document.getElementById("VendorId").value.trim();
        const Vendor = document.getElementById("Vendor").value.trim();
        const contactNo = document.getElementById("ContactNo").value.trim();
        const type = document.getElementById("TypeId").value.trim();
        const department = document.getElementById("DepartmentId").value.trim();
        const isActive = document.getElementById("IsActive").checked;
        const VendorImageAttachment = document.getElementById("VendorImageAttachment").value.trim();
        const VendorImageAttachmentold = document.getElementById("VendorImageAttachmentOld").value.trim();
        const nTimeIn = getTimeFromTextbox("TimeIn");
        const nTimeOut = getTimeFromTextbox("TimeOut");
        const nDeliveryCharges = document.getElementById("DeliveryCharges").value.trim();
        const nPerProductAmount = document.getElementById("PerProductAmount").value.trim();
        const nAddress = document.getElementById("Address").value.trim(); // ✅ Address

        // 🔴 Vendor Name Validation
        if (!Vendor) {
            await Swal.fire({
                icon: 'warning',
                title: 'Validation',
                text: 'Vendor name is required',
                returnFocus: false,
                didClose: () => { document.getElementById("Vendor").focus(); }
            });
            return;
        }

        // 🔴 Contact No Validation
        if (!contactNo) {
            await Swal.fire({
                icon: 'warning',
                title: 'Validation',
                text: 'Contact number is required',
                returnFocus: false,
                didClose: () => { document.getElementById("ContactNo").focus(); }
            });
            return;
        }

        if (contactNo.length < 10) {
            await Swal.fire({
                icon: 'warning',
                title: 'Validation',
                text: 'Contact number must be at least 10 digits',
                returnFocus: false,
                didClose: () => { document.getElementById("ContactNo").focus(); }
            });
            return;
        }

        // 🔴 Type Validation
        if (!type) {
            await Swal.fire({
                icon: 'warning',
                title: 'Validation',
                text: 'Please select Vendor type',
                returnFocus: false,
                didClose: () => { document.getElementById("TypeId").focus(); }
            });
            return;
        }

        // 🔴 Department Validation
        if (!department) {
            await Swal.fire({
                icon: 'warning',
                title: 'Validation',
                text: 'Please select department',
                returnFocus: false,
                didClose: () => { document.getElementById("DepartmentId").focus(); }
            });
            return;
        }

        // 🔴 Vendor Image Validation
        if (!VendorImageAttachment) {
            await Swal.fire({
                icon: 'warning',
                title: 'Validation',
                text: 'Please select Vendor image',
                returnFocus: false,
                didClose: () => { document.getElementById("VendorImageAttachment").focus(); }
            });
            return;
        }

        const { VendorImageAttachmentfilename, VendorImageAttachmentbase64 } = await GetVendorImageAttachmentFile();

        const nInfoTab = {
            Userid: userId,
            VendorId: VendorId,
            Vendor: Vendor,
            ContactNo: contactNo,
            Type: type,
            DepartmentId: department,
            VendorImageAttachmentfilename: VendorImageAttachmentfilename,
            VendorImageAttachmentfilenameold: VendorImageAttachmentold,
            VendorImageAttachmentbase64: VendorImageAttachmentbase64,
            TimeIn: nTimeIn,
            TimeOut: nTimeOut,
            DeliveryCharges: nDeliveryCharges,
            PerProductAmount: nPerProductAmount,
            Address: nAddress,   // ✅ Address
            IsActive: isActive,
            IsUpdate: IsUpdate,
        };

        Swal.fire({
            title: 'Please wait',
            text: 'Vendor creation is in process...',
            allowOutsideClick: false,
            allowEscapeKey: false,
            didOpen: () => Swal.showLoading()
        });

        try {
            const response = await jQuery.ajax({
                type: 'POST',
                url: '@Url.Action("nSaveVendorRegistrationData", "VendorRegistration")',
                data: JSON.stringify(nInfoTab),
                contentType: 'application/json'
            });

            Swal.close();

            if (response.statusId === 1) {
                await Swal.fire({
                    icon: 'success',
                    title: 'Vendor Registration',
                    text: response.message || 'Vendor saved successfully',
                    returnFocus: false,
                    didClose: () => { document.getElementById("Vendor").focus(); }
                });

                nClearForm();

            } else {
                await Swal.fire({
                    icon: 'warning',
                    title: 'Vendor Registration',
                    text: response.message || 'Vendor save failed'
                });
            }

        } catch (xhr) {
            Swal.close();

            await Swal.fire({
                icon: 'error',
                title: 'Error',
                text: 'An error occurred while saving Vendor'
            });

            console.error("SaveData Error:", xhr);
        }
    }
    // Save Button click


    // Cancel Button click
    document.getElementById("cancelBtn").addEventListener("click", function () {
        nClearForm();
    });
    async function nClearForm() {
        document.getElementById("VendorId").value = "";
        document.getElementById("VendorImageAttachmentOld").value = "";
        document.getElementById("Vendor").value = "";
        document.getElementById("ContactNo").value = "";
        document.getElementById("TypeId").value = "";
        document.getElementById("DepartmentId").value = "";
        document.getElementById("IsActive").checked = false;
        document.getElementById("VendorImageAttachment").value = "";
        document.getElementById("Address").value = "";  // ✅ Address
        IsUpdate = false;
        document.getElementById("saveBtn").textContent = "Save";
        document.getElementById("Vendor").focus();
        document.getElementById("ViewImageBtn").style.display = "none";
        document.getElementById("DeliveryCharges").value = "0";
        document.getElementById("PerProductAmount").value = "0";
        setCurrentTime();
        await LoadGridViewData();
    }
    // Cancel Button click


    // Contact Input
    const contactInput = document.getElementById("ContactNo");
    contactInput.addEventListener("keydown", function (e) {
        if (
            e.ctrlKey || e.metaKey ||
            (e.key >= '0' && e.key <= '9') ||
            ['Backspace', 'Delete', 'ArrowLeft', 'ArrowRight', 'Tab'].includes(e.key)
        ) {
            return;
        }
        e.preventDefault();
    });
    contactInput.addEventListener("input", function () {
        this.value = this.value.replace(/\D/g, '');
    });
    // Contact Input
</script>

