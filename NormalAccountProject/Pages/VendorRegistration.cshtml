@page "/VendorRegistration"
@model NormalAccountProject.Pages.VendorRegistrationModel
@{
    ViewData["Title"] = "Vendor Registration";
}

<link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;500;600;700;800&family=Rubik:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">

<style>
    :root {
        --bg: #f0f3f8;
        --surface: #ffffff;
        --surface2: #f8f9fc;
        --surface3: #eef1f8;
        --border: #eef0f6;
        --border2: #e2e6f0;
        --border3: #d4d9e8;
        --blue: #4e9dff;
        --blue-dark: #2d7dd2;
        --blue-g: rgba(78,157,255,.10);
        --blue-g2: rgba(78,157,255,.06);
        --teal: #00c9a7;
        --coral: #ff6b6b;
        --amber: #f59e0b;
        --green: #10b981;
        --danger: #ef4444;
        --text: #1e2a3a;
        --text2: #5a6478;
        --text3: #9ba3b8;
        --font-h: 'Rubik', sans-serif;
        --font-b: 'Nunito', sans-serif;
        --font-m: 'JetBrains Mono', monospace;
        --r: 8px;
        --r2: 12px;
        --r3: 16px;
        --sh: 0 2px 12px rgba(0,0,0,.06);
        --sh2: 0 4px 24px rgba(0,0,0,.09);
    }

    *, *::before, *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    .sr-root {
        font-family: var(--font-b);
        color: var(--text);
        background: var(--bg);
        min-height: calc(100vh - 60px);
        padding: 24px 28px 20px;
        overflow-y: auto;
        overflow-x: hidden;
        scrollbar-width: thin;
        scrollbar-color: var(--border2) transparent;
    }

    .sr-inner {
        max-width: 1400px;
        margin: 0 auto;
    }

    .page-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 22px;
        animation: fadeDown .4s ease both;
    }

    .ph-left {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .ph-icon {
        width: 46px;
        height: 46px;
        background: linear-gradient(135deg, var(--blue) 0%, var(--blue-dark) 100%);
        border-radius: var(--r2);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        font-size: 18px;
        box-shadow: 0 4px 16px rgba(78,157,255,.35);
        flex-shrink: 0;
    }

    .ph-title {
        font-family: var(--font-h);
        font-size: 21px;
        font-weight: 700;
        color: var(--text);
        line-height: 1.1;
    }

        .ph-title span {
            color: var(--blue);
        }

    .ph-breadcrumb {
        display: flex;
        align-items: center;
        gap: 5px;
        font-family: var(--font-m);
        font-size: 10px;
        color: var(--text3);
        letter-spacing: .4px;
        margin-top: 3px;
    }

        .ph-breadcrumb i {
            font-size: 7px;
        }

        .ph-breadcrumb .bc-cur {
            color: var(--blue);
            font-weight: 500;
        }

    .view-toggle {
        display: flex;
        gap: 4px;
        background: var(--surface);
        padding: 4px;
        border-radius: var(--r);
        border: 1px solid var(--border2);
        box-shadow: var(--sh);
    }

    .vt-btn {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 8px 16px;
        font-family: var(--font-b);
        font-size: 12.5px;
        font-weight: 700;
        border-radius: 6px;
        border: none;
        cursor: pointer;
        transition: all .2s ease;
    }

    .vt-btn-ghost {
        background: transparent;
        color: var(--text2);
    }

        .vt-btn-ghost:hover {
            background: var(--surface3);
            color: var(--text);
        }

    .vt-btn-active {
        background: linear-gradient(135deg, var(--blue) 0%, var(--blue-dark) 100%);
        color: #fff;
        box-shadow: 0 2px 10px rgba(78,157,255,.30);
    }

        .vt-btn-active:hover {
            transform: translateY(-1px);
        }

    .divider {
        display: flex;
        gap: 3px;
        height: 3px;
        margin-bottom: 20px;
        border-radius: 3px;
        overflow: hidden;
    }

        .divider span:nth-child(1) {
            flex: 3;
            background: var(--blue);
        }

        .divider span:nth-child(2) {
            flex: 1;
            background: var(--teal);
            opacity: .6;
        }

        .divider span:nth-child(3) {
            flex: 8;
            background: var(--border2);
        }

    .form-card {
        background: var(--surface);
        border-radius: var(--r3);
        border: 1px solid var(--border2);
        box-shadow: var(--sh2);
        overflow: hidden;
        animation: slideUp .35s cubic-bezier(.22,1,.36,1) both;
    }

    .fc-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 14px 22px;
        background: var(--surface2);
        border-bottom: 1px solid var(--border2);
        border-top: 3px solid var(--blue);
    }

    .fc-header-left {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .fc-icon {
        width: 32px;
        height: 32px;
        border-radius: var(--r);
        background: var(--blue-g);
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--blue);
        font-size: 13px;
    }

    .fc-title {
        font-family: var(--font-h);
        font-size: 14px;
        font-weight: 600;
        color: var(--text);
    }

    .fc-sub {
        font-size: 11px;
        color: var(--text3);
        font-weight: 500;
        margin-top: 1px;
    }

    .status-pill {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 4px 12px;
        border-radius: 20px;
        font-family: var(--font-m);
        font-size: 10.5px;
        font-weight: 500;
    }

    .pill-live {
        background: rgba(16,185,129,.10);
        color: var(--green);
        border: 1px solid rgba(16,185,129,.25);
    }

        .pill-live::before {
            content: '';
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: var(--green);
            animation: blink 1.8s ease-in-out infinite;
        }
    @@keyframes blink {
        0%,100%

    {
        opacity: 1
    }

    50% {
        opacity: .3
    }

    }

    .fc-body {
        padding: 24px 26px;
        max-height: 68vh;
        overflow-y: auto;
        scrollbar-width: thin;
        scrollbar-color: var(--border2) transparent;
    }

        .fc-body::-webkit-scrollbar {
            width: 4px;
        }

        .fc-body::-webkit-scrollbar-thumb {
            background: var(--border2);
            border-radius: 10px;
        }

    .sec-label {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 14px;
        padding-bottom: 10px;
        border-bottom: 1px dashed var(--border2);
    }

    .sec-label-bar {
        width: 3px;
        height: 14px;
        border-radius: 3px;
        flex-shrink: 0;
    }

    .slb-blue {
        background: linear-gradient(180deg, var(--blue), var(--teal));
    }

    .slb-teal {
        background: linear-gradient(180deg, var(--teal), var(--blue));
    }

    .slb-amber {
        background: linear-gradient(180deg, var(--amber), var(--coral));
    }

    .sec-label-txt {
        font-family: var(--font-m);
        font-size: 9.5px;
        font-weight: 500;
        color: var(--text3);
        letter-spacing: 2px;
        text-transform: uppercase;
    }

    .frow {
        display: grid;
        gap: 14px;
        margin-bottom: 14px;
    }

    .frow-1 {
        grid-template-columns: 1fr;
    }

    .frow-2 {
        grid-template-columns: 1fr 1fr;
    }

    .fg {
        position: relative;
    }

        .fg .fc {
            padding: 22px 14px 8px;
        }

        .fg textarea.fc {
            padding: 22px 14px 8px;
        }

        .fg select.fc {
            padding: 22px 14px 8px;
        }

        .fg.is-area .fl {
            top: 18px;
            transform: none;
        }

        .fg.always-up .fl {
            top: 7px;
            transform: none;
            font-size: 9px;
            font-family: var(--font-m);
            color: var(--text3);
            letter-spacing: 1px;
            text-transform: uppercase;
            font-weight: 500;
        }

        .fg.always-up .fc:focus ~ .fl {
            color: var(--blue);
        }

    .fl {
        position: absolute;
        left: 14px;
        top: 50%;
        transform: translateY(-50%);
        font-family: var(--font-b);
        font-size: 13px;
        font-weight: 600;
        color: var(--text3);
        pointer-events: none;
        transition: top .18s,transform .18s,font-size .18s,color .18s,letter-spacing .18s;
        white-space: nowrap;
    }

    .fg .fc:focus ~ .fl, .fg.has-value .fl {
        top: 7px;
        transform: none;
        font-size: 9px;
        font-family: var(--font-m);
        color: var(--blue);
        letter-spacing: 1px;
        text-transform: uppercase;
        font-weight: 500;
    }

    .fg.is-area .fc:focus ~ .fl, .fg.is-area.has-value .fl {
        top: 6px;
        transform: none;
        font-size: 9px;
        font-family: var(--font-m);
        color: var(--blue);
        letter-spacing: 1px;
        text-transform: uppercase;
        font-weight: 500;
    }

    .fg .fc::placeholder {
        color: transparent;
    }

    .fc {
        border: 1px solid var(--border2);
        border-radius: var(--r);
        padding: 10px 14px;
        font-size: 13.5px;
        font-family: var(--font-b);
        font-weight: 600;
        color: var(--text) !important;
        background: var(--surface);
        transition: border-color .2s, box-shadow .2s, background .2s;
        outline: none;
        width: 100%;
        -webkit-text-fill-color: var(--text) !important;
        caret-color: var(--blue);
    }

        .fc:focus {
            border-color: var(--blue);
            box-shadow: 0 0 0 3px var(--blue-g);
            background: #fff;
        }

    textarea.fc {
        resize: vertical;
        line-height: 1.6;
    }

    select.fc {
        appearance: auto;
        cursor: pointer;
    }

        select.fc option {
            background: #fff;
            color: var(--text);
        }

    input[type="time"].fc::-webkit-calendar-picker-indicator {
        opacity: .5;
        cursor: pointer;
    }

    .status-meta {
        font-family: var(--font-m);
        font-size: 9.5px;
        color: var(--text3);
        letter-spacing: 1px;
        text-transform: uppercase;
        margin-bottom: 8px;
        display: flex;
        align-items: center;
        gap: 5px;
    }

        .status-meta i {
            color: var(--blue);
        }

    .check-group {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 11px 16px;
        background: var(--surface2);
        border-radius: var(--r);
        border: 1px solid var(--border2);
        cursor: pointer;
        transition: all .2s;
        width: fit-content;
        user-select: none;
    }

        .check-group:hover {
            border-color: var(--blue);
            background: var(--blue-g2);
        }

    .check-input {
        width: 16px;
        height: 16px;
        cursor: pointer;
        accent-color: var(--blue);
    }

    .check-label {
        font-size: 13px;
        font-weight: 700;
        color: var(--text2);
        cursor: pointer;
        font-family: var(--font-b);
        transition: color .2s;
    }

    .check-group:hover .check-label {
        color: var(--blue);
    }

    .media-meta {
        font-family: var(--font-m);
        font-size: 9.5px;
        color: var(--text3);
        letter-spacing: 1px;
        text-transform: uppercase;
        margin-bottom: 8px;
        display: flex;
        align-items: center;
        gap: 5px;
    }

        .media-meta i {
            color: var(--amber);
        }

    .upload-zone {
        border: 2px dashed var(--border2);
        border-radius: var(--r);
        padding: 12px 16px;
        background: var(--surface2);
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 14px;
        transition: all .25s ease;
    }

        .upload-zone:hover {
            border-color: var(--blue);
            background: var(--blue-g2);
        }

    .upload-icon {
        width: 38px;
        height: 38px;
        background: linear-gradient(135deg, var(--blue) 0%, var(--blue-dark) 100%);
        border-radius: var(--r);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        font-size: 15px;
        flex-shrink: 0;
        box-shadow: 0 3px 10px rgba(78,157,255,.30);
    }

    .upload-title {
        font-size: 13px;
        font-weight: 700;
        color: var(--text2);
    }

    .upload-sub {
        font-size: 10.5px;
        color: var(--text3);
        font-family: var(--font-m);
        margin-top: 2px;
    }

    input[type="file"].hidden-file {
        display: none;
    }

    .btn-row {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
        padding-top: 20px;
        border-top: 1px solid var(--border2);
        margin-top: 6px;
    }

    .btn {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 10px 22px;
        font-family: var(--font-b);
        font-size: 13px;
        font-weight: 700;
        border-radius: var(--r);
        border: none;
        cursor: pointer;
        transition: all .2s ease;
    }

    .btn-primary {
        background: linear-gradient(135deg, var(--blue) 0%, var(--blue-dark) 100%);
        color: #fff;
        box-shadow: 0 3px 14px rgba(78,157,255,.30);
    }

        .btn-primary:hover {
            transform: translateY(-1px);
            box-shadow: 0 6px 20px rgba(78,157,255,.42);
        }

    .btn-secondary {
        background: var(--surface2);
        color: var(--text2);
        border: 1px solid var(--border2);
    }

        .btn-secondary:hover {
            background: var(--surface3);
            color: var(--text);
            border-color: var(--border3);
        }

    .btn-view {
        background: rgba(245,158,11,.10);
        color: var(--amber);
        border: 1px solid rgba(245,158,11,.25);
        display: none;
    }

        .btn-view.show {
            display: inline-flex;
        }

        .btn-view:hover {
            background: rgba(245,158,11,.18);
        }

    .grid-card {
        background: var(--surface);
        border-radius: var(--r3);
        border: 1px solid var(--border2);
        box-shadow: var(--sh2);
        overflow: hidden;
        animation: slideUp .35s cubic-bezier(.22,1,.36,1) both;
    }

    .gc-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 14px 22px;
        background: var(--surface2);
        border-bottom: 1px solid var(--border2);
        border-top: 3px solid var(--blue);
    }

    .gc-header-left {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .gc-icon {
        width: 32px;
        height: 32px;
        border-radius: var(--r);
        background: var(--blue-g);
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--blue);
        font-size: 13px;
    }

    .gc-title {
        font-family: var(--font-h);
        font-size: 14px;
        font-weight: 600;
        color: var(--text);
    }

    .gc-badge {
        background: var(--blue-g);
        color: var(--blue-dark);
        font-family: var(--font-m);
        font-size: 10.5px;
        font-weight: 500;
        padding: 3px 10px;
        border-radius: 20px;
        border: 1px solid rgba(78,157,255,.20);
    }

    .tbl-scroll {
        height: 60vh;
        overflow-y: auto;
        scrollbar-width: thin;
        scrollbar-color: var(--border2) transparent;
    }

        .tbl-scroll::-webkit-scrollbar {
            width: 4px;
        }

        .tbl-scroll::-webkit-scrollbar-thumb {
            background: var(--border2);
            border-radius: 10px;
        }

    .pro-tbl {
        width: 100%;
        border-collapse: collapse;
    }

        .pro-tbl thead th {
            background: var(--surface2);
            color: var(--text3);
            padding: 10px 16px;
            font-size: 10px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1px;
            white-space: nowrap;
            font-family: var(--font-b);
            position: sticky;
            top: 0;
            z-index: 10;
            border-bottom: 1px solid var(--border2);
            text-align: left;
        }

        .pro-tbl thead tr:nth-child(2) th {
            background: var(--surface3);
            padding: 7px 10px;
            top: 38px;
            border-bottom: 1px solid var(--border2);
        }

            .pro-tbl thead tr:nth-child(2) th input {
                width: 100%;
                padding: 5px 9px;
                font-size: 11px;
                border: 1px solid var(--border2);
                border-radius: 6px;
                font-family: var(--font-b);
                background: var(--surface);
                outline: none;
                color: var(--text);
                transition: border-color .15s;
            }

                .pro-tbl thead tr:nth-child(2) th input:focus {
                    border-color: var(--blue);
                }

        .pro-tbl tbody tr {
            border-bottom: 1px solid var(--border);
            transition: background .12s;
        }

            .pro-tbl tbody tr:hover {
                background: var(--surface2);
            }

            .pro-tbl tbody tr:last-child {
                border-bottom: none;
            }

        .pro-tbl tbody td {
            padding: 11px 16px;
            font-size: 13px;
            color: var(--text2);
            white-space: nowrap;
            font-weight: 600;
        }

    .tbl-btn {
        width: 30px;
        height: 30px;
        border-radius: var(--r);
        border: 1px solid transparent;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 11px;
        transition: all .15s;
    }

    .tbl-edit {
        background: var(--blue-g);
        color: var(--blue);
        border-color: rgba(78,157,255,.20);
    }

        .tbl-edit:hover {
            background: var(--blue);
            color: #fff;
            border-color: var(--blue);
        }

    .tbl-del {
        background: rgba(239,68,68,.08);
        color: var(--danger);
        border-color: rgba(239,68,68,.20);
        margin-left: 4px;
    }

        .tbl-del:hover {
            background: var(--danger);
            color: #fff;
            border-color: var(--danger);
        }

    .badge {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        font-size: 10.5px;
        font-weight: 700;
        padding: 3px 10px;
        border-radius: 20px;
        font-family: var(--font-b);
    }

    .badge-active {
        background: rgba(16,185,129,.10);
        color: #059669;
        border: 1px solid rgba(16,185,129,.25);
    }

    .badge-inactive {
        background: rgba(239,68,68,.08);
        color: var(--danger);
        border: 1px solid rgba(239,68,68,.20);
    }

    .badge i {
        font-size: 6px;
    }

    .empty-state {
        padding: 70px 20px;
        text-align: center;
    }

    .empty-icon {
        width: 60px;
        height: 60px;
        background: var(--surface2);
        border-radius: var(--r2);
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--text3);
        font-size: 22px;
        margin: 0 auto 16px;
        border: 1px solid var(--border2);
    }

    .empty-title {
        font-family: var(--font-h);
        font-size: 15px;
        font-weight: 600;
        color: var(--text2);
        margin-bottom: 5px;
    }

    .empty-sub {
        font-size: 12px;
        color: var(--text3);
        font-weight: 500;
    }

    .pg-footer {
        margin-top: 18px;
        padding-top: 14px;
        border-top: 1px solid var(--border2);
        text-align: center;
        font-family: var(--font-m);
        font-size: 10.5px;
        color: var(--text3);
        letter-spacing: .5px;
    }

        .pg-footer strong {
            color: var(--blue);
            font-weight: 500;
        }

        .pg-footer .heart {
            color: var(--coral);
        }

    .edit-pill {
        display: none;
        background: rgba(245,158,11,.10);
        color: var(--amber);
        border: 1px solid rgba(245,158,11,.25);
        padding: 4px 12px;
        border-radius: 20px;
        font-family: var(--font-m);
        font-size: 10.5px;
        align-items: center;
        gap: 5px;
    }

        .edit-pill.show {
            display: inline-flex;
        }
    @@keyframes fadeDown {
        from

    {
        opacity: 0;
        transform: translateY(-16px)
    }

    to {
        opacity: 1;
        transform: translateY(0)
    }

    }
    @@keyframes slideUp {
        from

    {
        opacity: 0;
        transform: translateY(20px)
    }

    to {
        opacity: 1;
        transform: translateY(0)
    }

    }
    @@media (max-width: 768px) {
        .sr-root

    {
        padding: 14px;
    }

    .frow-2 {
        grid-template-columns: 1fr;
    }

    .page-header {
        flex-wrap: wrap;
        gap: 12px;
    }

    }
</style>

<div class="sr-root">
    <div class="sr-inner">
        <div class="page-header">
            <div class="ph-left">
                <div class="ph-icon"><i class="fas fa-store-alt"></i></div>
                <div>
                    <div class="ph-title">Vendor <span>Registry</span></div>
                    <div class="ph-breadcrumb">Setup <i class="fas fa-chevron-right"></i> <span class="bc-cur">Vendors</span></div>
                </div>
            </div>
            <div style="display:flex;align-items:center;gap:10px;">
                <div class="edit-pill" id="updatePill"><i class="fas fa-pen" style="font-size:9px;"></i> Edit Mode</div>
                <div class="view-toggle">
                    <button class="vt-btn vt-btn-ghost" id="gridViewToggleBtn"><i class="fas fa-table-cells"></i> Grid View</button>
                    <button class="vt-btn vt-btn-active" id="formViewToggleBtn" style="display:none;"><i class="fas fa-pen-to-square"></i> Form View</button>
                </div>
            </div>
        </div>
        <div class="divider"><span></span><span></span><span></span></div>

        <!-- FORM VIEW -->
        <div id="formViewContainer">
            <div class="form-card">
                <div class="fc-header">
                    <div class="fc-header-left">
                        <div class="fc-icon"><i class="fas fa-store-alt"></i></div>
                        <div><div class="fc-title">Vendor Registration</div><div class="fc-sub">Add or update a vendor record</div></div>
                    </div>
                    <div class="status-pill pill-live">Live</div>
                </div>
                <div class="fc-body">
                    <input style="display:none;" type="text" id="VendorId">
                    <input style="display:none;" type="text" id="VendorImageAttachmentOld">

                    <div class="sec-label"><div class="sec-label-bar slb-blue"></div><span class="sec-label-txt">Basic Details</span></div>
                    <div class="frow frow-2">
                        <div class="fg">
                            <input type="text" id="Vendor" class="fc" placeholder=" ">
                            <label class="fl" for="Vendor">Vendor Name</label>
                        </div>
                        <div class="fg">
                            <input type="text" id="ContactNo" class="fc" placeholder=" " inputmode="numeric" autocomplete="off">
                            <label class="fl" for="ContactNo">Contact Number</label>
                        </div>
                    </div>
                    <div class="frow frow-2">
                        <div class="fg always-up">
                            <select id="TypeId" class="fc"><option value="">— Select Type —</option></select>
                            <label class="fl" for="TypeId">Vendor Type</label>
                        </div>
                        <div class="fg always-up">
                            <select id="DepartmentId" class="fc"><option value="">— Select Department —</option></select>
                            <label class="fl" for="DepartmentId">Department</label>
                        </div>
                    </div>
                    <div class="frow frow-1">
                        <div class="fg is-area">
                            <textarea id="Address" class="fc" placeholder=" " rows="2"></textarea>
                            <label class="fl" for="Address">Full Address</label>
                        </div>
                    </div>

                    <div class="sec-label" style="margin-top:6px;"><div class="sec-label-bar slb-teal"></div><span class="sec-label-txt">Schedule &amp; Charges</span></div>
                    <div class="frow frow-2">
                        <div class="fg always-up"><input type="time" id="TimeIn" class="fc"><label class="fl" for="TimeIn">Time In</label></div>
                        <div class="fg always-up"><input type="time" id="TimeOut" class="fc"><label class="fl" for="TimeOut">Time Out</label></div>
                    </div>
                    <div class="frow frow-2">
                        <div class="fg always-up"><input type="text" id="DeliveryCharges" class="fc" placeholder=" "><label class="fl" for="DeliveryCharges">Delivery Charges</label></div>
                        <div class="fg always-up"><input type="text" id="DiscountAmount" class="fc" placeholder=" "><label class="fl" for="DiscountAmount">Discount Amount</label></div>
                    </div>
                    <div class="frow frow-1">
                        <div class="fg always-up"><input type="text" id="PerProductAmount" class="fc" placeholder=" "><label class="fl" for="PerProductAmount">Per Product Amount</label></div>
                    </div>

                    <div class="sec-label" style="margin-top:6px;"><div class="sec-label-bar slb-amber"></div><span class="sec-label-txt">Status &amp; Media</span></div>
                    <div class="frow frow-2" style="margin-bottom:20px;">
                        <div>
                            <div class="status-meta"><i class="fas fa-toggle-on"></i> Vendor Status</div>
                            <div class="check-group">
                                <input type="checkbox" id="IsActive" class="check-input">
                                <label class="check-label" for="IsActive">Mark as Active</label>
                            </div>
                        </div>
                        <div>
                            <div class="media-meta"><i class="fas fa-image"></i> Vendor Logo <span style="font-size:9px;color:var(--text3);text-transform:none;letter-spacing:0;font-family:var(--font-b);font-weight:500;">(Max 500 KB · JPEG/PNG)</span></div>
                            <label for="VendorImageAttachment" class="upload-zone">
                                <div class="upload-icon"><i class="fas fa-cloud-arrow-up"></i></div>
                                <div><div class="upload-title" id="fileNameDisplay">Click to browse</div><div class="upload-sub">JPEG or PNG · max 500 KB</div></div>
                            </label>
                            <input id="VendorImageAttachment" class="hidden-file" type="file" accept=".jpeg,.png">
                        </div>
                    </div>
                    <div class="btn-row">
                        <button class="btn btn-primary" id="saveBtn"><i class="fas fa-floppy-disk"></i> Save Vendor</button>
                        <button class="btn btn-secondary" id="cancelBtn"><i class="fas fa-xmark"></i> Cancel</button>
                        <a class="btn btn-view" id="ViewImageBtn" target="_blank"><i class="fas fa-eye"></i> View Image</a>
                    </div>
                </div>
            </div>
        </div>

        <!-- GRID VIEW -->
        <div id="gridViewContainer" style="display:none;">
            <div class="grid-card">
                <div class="gc-header">
                    <div class="gc-header-left">
                        <div class="gc-icon"><i class="fas fa-table-list"></i></div>
                        <div><div class="gc-title">All Vendors</div></div>
                        <div class="gc-badge" id="TotalVendorsCount">0 records</div>
                    </div>
                    <div class="status-pill pill-live">Live Data</div>
                </div>
                <div class="tbl-scroll"><div id="VendorGridContainer"></div></div>
            </div>
        </div>

        <div class="pg-footer">Developed with <span class="heart">♥</span> by <strong>UT Designer</strong></div>
    </div>
</div>

<script>
    let userId = localStorage.getItem("userId") || "";
    let GridViewDataList = [], IsUpdate = false;
    const SW = { background: '#ffffff', color: '#1e2a3a', confirmButtonColor: '#4e9dff', cancelButtonColor: '#f8f9fc' };

    function initFloatLabels() {
        document.querySelectorAll('.fg').forEach(g => {
            if (g.classList.contains('always-up')) return;
            const el = g.querySelector('input:not([type="checkbox"]):not([type="file"]):not([style*="display:none"]),textarea,select');
            if (!el) return;
            const chk = () => g.classList.toggle('has-value', el.value !== '');
            el.addEventListener('input', chk); el.addEventListener('change', chk); chk();
        });
    }

    function setFieldValue(id, val) {
        const el = document.getElementById(id); if (!el) return; el.value = val;
        const g = el.closest('.fg');
        if (g && !g.classList.contains('always-up')) g.classList.toggle('has-value', el.value !== '');
    }

    function showFormView() {
        document.getElementById("formViewContainer").style.display = "block";
        document.getElementById("gridViewContainer").style.display = "none";
        document.getElementById("formViewToggleBtn").style.display = "none";
        document.getElementById("gridViewToggleBtn").style.display = "inline-flex";
        document.getElementById("gridViewToggleBtn").className = "vt-btn vt-btn-ghost";
        document.getElementById("Vendor").focus();
    }
    function showGridView() {
        document.getElementById("formViewContainer").style.display = "none";
        document.getElementById("gridViewContainer").style.display = "block";
        document.getElementById("gridViewToggleBtn").style.display = "none";
        document.getElementById("formViewToggleBtn").style.display = "inline-flex";
        document.getElementById("formViewToggleBtn").className = "vt-btn vt-btn-active";
    }
    document.getElementById("gridViewToggleBtn").addEventListener("click", showGridView);
    document.getElementById("formViewToggleBtn").addEventListener("click", showFormView);

    document.getElementById("VendorImageAttachment").addEventListener("change", async function () {
        const file = this.files[0]; if (!file) return;
        if (file.size > 500 * 1024) {
            this.value = ""; document.getElementById("fileNameDisplay").textContent = "Click to browse";
            await Swal.fire({ icon: 'warning', title: 'File Too Large', text: 'Image must be under 500 KB.', returnFocus: false, ...SW });
        } else { document.getElementById("fileNameDisplay").textContent = file.name; }
    });

    function GetVendorImageAttachmentFile() {
        return new Promise(resolve => {
            const fileInput = document.getElementById("VendorImageAttachment"), file = fileInput.files[0];
            if (!file) { resolve({ VendorImageAttachmentfilename: "", VendorImageAttachmentbase64: "" }); return; }
            const reader = new FileReader();
            reader.onload = function (e) {
                const vendor = document.getElementById("Vendor").value.trim();
                const now = new Date(), pad = n => n.toString().padStart(2, "0");
                const ts = `${pad(now.getDate())}${pad(now.getMonth()+1)}${now.getFullYear()}${pad(now.getHours())}${pad(now.getMinutes())}`;
                const ext = file.name.split(".").pop();
                const uint8 = new Uint8Array(e.target.result);
                let bin = ""; for (let i = 0; i < uint8.length; i++) bin += String.fromCharCode(uint8[i]);
                resolve({ VendorImageAttachmentfilename: `${vendor}_${ts}_VendorRegistrationLogo.${ext}`, VendorImageAttachmentbase64: btoa(bin) });
            };
            reader.onerror = () => resolve({ VendorImageAttachmentfilename: "", VendorImageAttachmentbase64: "" });
            reader.readAsArrayBuffer(file);
        });
    }

    function setCurrentTime() {
        const now = new Date();
        const t = `${String(now.getHours()).padStart(2,'0')}:${String(now.getMinutes()).padStart(2,'0')}`;
        document.getElementById("TimeIn").value = t; document.getElementById("TimeOut").value = t;
    }
    function getTimeFromTextbox(id) { const v = document.getElementById(id).value; if (!v) return; return `1900-01-01 ${v}:00.000`; }
    function setTimeToTextbox(id, val) { if (!val) return; document.getElementById(id).value = val.split("T")[1].substring(0,5); }

    document.addEventListener("DOMContentLoaded", async function () {
        await LoadData(); await LoadGridViewData(); setCurrentTime();
        setFieldValue("DeliveryCharges", "0"); setFieldValue("DiscountAmount", "0"); setFieldValue("PerProductAmount", "0");
        initFloatLabels(); document.getElementById("Vendor").focus();
    });

    async function LoadData() {
        return new Promise((res, rej) => jQuery.ajax({
            type: 'POST', url: '@Url.Action("nLoadVendorRegistrationData", "VendorRegistration")', data: JSON.stringify({ Userid: userId }), contentType: 'application/json',
            success(r) { if (r.statusId === 1) { TypeDropdown(r.TypeList); DepartmentDropdown(r.DepartmentList); res(); } else { toastr.warning("No data."); rej(); } },
            error(x, s, e) { console.log(x, s, e); rej(); }
        }));
    }

    function TypeDropdown(list) {
        const d = document.getElementById("TypeId"); d.innerHTML = '<option value="">— Select Type —</option>';
        list.forEach(i => { const o = document.createElement("option"); o.value = i.TypeId; o.text = i.Type; d.appendChild(o); });
    }
    function DepartmentDropdown(list) {
        const d = document.getElementById("DepartmentId"); d.innerHTML = '<option value="">— Select Department —</option>';
        list.forEach(i => { const o = document.createElement("option"); o.value = i.DepartmentId; o.text = i.Department; d.appendChild(o); });
    }

    async function LoadGridViewData() {
        return new Promise((res, rej) => jQuery.ajax({
            type: 'POST', url: '@Url.Action("nLoadGridViewData", "VendorRegistration")', data: JSON.stringify({ Userid: userId }), contentType: 'application/json',
            success(r) { if (r.statusId === 1) { GridViewDataList = r.GridViewDataList; renderVendorGrid(GridViewDataList); res(); } else { toastr.warning("No data."); rej(); } },
            error(x, s, e) { console.log(x, s, e); rej(); }
        }));
    }

    function renderVendorGrid(gridData) {
        const container = document.getElementById("VendorGridContainer");
        container.innerHTML = "";
        if (!gridData || gridData.length === 0) {
            container.innerHTML = `<div class="empty-state"><div class="empty-icon"><i class="fas fa-store-slash"></i></div><div class="empty-title">No Vendors Found</div><div class="empty-sub">Click "Form View" to add your first vendor.</div></div>`;
            document.getElementById("TotalVendorsCount").textContent = "0 records"; return;
        }
        const columns = Object.keys(gridData[0]).filter(c => !["Userid","Type","VendorId","DepartmentId","ImagePath","TimeIn","TimeOut"].includes(c));
        const table = document.createElement("table"); table.className = "pro-tbl";
        const thead = document.createElement("thead");
        const h1 = document.createElement("tr");
        const ah = document.createElement("th"); ah.textContent = "Actions"; h1.appendChild(ah);
        columns.forEach(c => { const th = document.createElement("th"); th.textContent = c; h1.appendChild(th); });
        thead.appendChild(h1);
        const h2 = document.createElement("tr"); h2.appendChild(document.createElement("th"));
        columns.forEach(c => {
            const th = document.createElement("th"); const inp = document.createElement("input");
            inp.type = "text"; inp.placeholder = "Filter...";
            inp.addEventListener("input", function () { filterTable(this, c); });
            th.appendChild(inp); h2.appendChild(th);
        });
        thead.appendChild(h2); table.appendChild(thead);
        const tbody = document.createElement("tbody");
        gridData.forEach(row => {
            const tr = document.createElement("tr");
            const atd = document.createElement("td");
            const eb = document.createElement("button"); eb.className = "tbl-btn tbl-edit"; eb.innerHTML = '<i class="fas fa-pen"></i>'; eb.title = "Edit";
            eb.addEventListener("click", () => { onEditRow(row); showFormView(); }); atd.appendChild(eb);
            const db = document.createElement("button"); db.className = "tbl-btn tbl-del"; db.innerHTML = '<i class="fas fa-trash-can"></i>'; db.title = "Delete";
            db.addEventListener("click", () => onDeleteRow(row)); atd.appendChild(db);
            tr.appendChild(atd);
            columns.forEach(c => {
                const td = document.createElement("td");
                if (c === "Is Active") td.innerHTML = row[c] ? '<span class="badge badge-active"><i class="fas fa-circle"></i> Active</span>' : '<span class="badge badge-inactive"><i class="fas fa-circle"></i> Inactive</span>';
                else td.textContent = row[c];
                tr.appendChild(td);
            });
            tbody.appendChild(tr);
        });
        table.appendChild(tbody); container.appendChild(table);
        document.getElementById("TotalVendorsCount").textContent = `${tbody.rows.length} records`;
    }

    function filterTable(input, column) {
        const table = input.closest("table"); const tbody = table.querySelector("tbody");
        const rows = Array.from(tbody.rows); const fv = input.value.toLowerCase();
        const ci = Array.from(table.querySelectorAll("thead tr:first-child th")).findIndex(th => th.textContent === column);
        let count = 0;
        rows.forEach(r => { const m = (r.cells[ci]?.textContent.toLowerCase() || "").includes(fv); r.style.display = m ? "" : "none"; if (m) count++; });
        document.getElementById("TotalVendorsCount").textContent = `${count} records`;
    }

    function onEditRow(row) {
        IsUpdate = true;
        document.getElementById("updatePill").classList.add("show");
        document.getElementById("saveBtn").innerHTML = '<i class="fas fa-floppy-disk"></i> Update Vendor';
        document.getElementById("VendorId").value = row["VendorId"] || "";
        document.getElementById("VendorImageAttachmentOld").value = row["ImagePath"] || "";
        setFieldValue("Vendor", row["Vendor Name"] || "");
        setFieldValue("ContactNo", row["Contact #"] || "");
        setFieldValue("Address", row["Address"] || "");
        setFieldValue("DeliveryCharges", row["Delivery Charges"] || "0");
        setFieldValue("DiscountAmount", row["Discount Amount"] || "0");
        setFieldValue("PerProductAmount", row["PerProductAmount"] || "0");
        document.getElementById("TypeId").value = row["Type"] || "";
        document.getElementById("DepartmentId").value = row["DepartmentId"] || "";
        document.getElementById("IsActive").checked = row["Is Active"] || false;
        setTimeToTextbox("TimeIn", row["TimeIn"]); setTimeToTextbox("TimeOut", row["TimeOut"]);
        if (row["ImagePath"]) { const vb = document.getElementById("ViewImageBtn"); vb.href = row["ImagePath"]; vb.classList.add("show"); }
        initFloatLabels(); document.getElementById("Vendor").focus();
    }

    async function onDeleteRow(row) {
        const r = await Swal.fire({ title: 'Delete Vendor?', text: `Delete "${row["Vendor Name"]}"?`, icon: 'warning', showCancelButton: true, confirmButtonText: 'Yes, Delete', cancelButtonText: 'Cancel', confirmButtonColor: '#ef4444', ...SW });
        if (!r.isConfirmed) return;
        Swal.fire({ title: 'Please wait', text: 'Deleting...', allowOutsideClick: false, allowEscapeKey: false, didOpen: () => Swal.showLoading(), ...SW });
        try {
            const res = await jQuery.ajax({ type: 'POST', url: '@Url.Action("nDeleteVendorRegistrationData", "VendorRegistration")', data: JSON.stringify({ Userid: userId.toString(), VendorId: row["VendorId"].toString(), VendorImageAttachmentfilenameold: row["ImagePath"].toString() }), contentType: 'application/json' });
            Swal.close();
            if (res.statusId === 1) { await Swal.fire({ icon: 'success', title: 'Deleted!', text: res.message || 'Vendor deleted.', returnFocus: false, ...SW }); nClearForm(); }
            else await Swal.fire({ icon: 'warning', title: 'Failed', text: res.message || 'Could not delete.', ...SW });
        } catch (e) { Swal.close(); await Swal.fire({ icon: 'error', title: 'Error', text: 'An error occurred.', ...SW }); }
    }

    document.getElementById("saveBtn").addEventListener("click", async function () {
        const VendorId = document.getElementById("VendorId").value.trim();
        const Vendor = document.getElementById("Vendor").value.trim();
        const contactNo = document.getElementById("ContactNo").value.trim();
        const type = document.getElementById("TypeId").value.trim();
        const department = document.getElementById("DepartmentId").value.trim();
        const isActive = document.getElementById("IsActive").checked;
        const VendorImageAttachmentold = document.getElementById("VendorImageAttachmentOld").value.trim();
        const nAddress = document.getElementById("Address").value.trim();
        const validations = [
            { cond: !Vendor,                             text: 'Vendor name is required',                   focus: 'Vendor' },
            { cond: !contactNo,                          text: 'Contact number is required',                focus: 'ContactNo' },
            { cond: contactNo && contactNo.length < 10,  text: 'Contact number must be at least 10 digits', focus: 'ContactNo' },
            { cond: !type,                               text: 'Please select a vendor type',               focus: 'TypeId' },
            { cond: !department,                         text: 'Please select a department',                focus: 'DepartmentId' }
        ];
        for (const v of validations) {
            if (v.cond) { await Swal.fire({ icon: 'warning', title: 'Validation', text: v.text, returnFocus: false, ...SW, didClose: () => document.getElementById(v.focus).focus() }); return; }
        }
        const { VendorImageAttachmentfilename, VendorImageAttachmentbase64 } = await GetVendorImageAttachmentFile();
        const nInfoTab = {
            Userid: userId, VendorId, Vendor, ContactNo: contactNo, Type: type, DepartmentId: department,
            VendorImageAttachmentfilename, VendorImageAttachmentfilenameold: VendorImageAttachmentold, VendorImageAttachmentbase64,
            TimeIn: getTimeFromTextbox("TimeIn"), TimeOut: getTimeFromTextbox("TimeOut"),
            DeliveryCharges: document.getElementById("DeliveryCharges").value.trim(),
            DiscountAmount: document.getElementById("DiscountAmount").value.trim(),
            PerProductAmount: document.getElementById("PerProductAmount").value.trim(),
            Address: nAddress, IsActive: isActive, IsUpdate
        };
        Swal.fire({ title: 'Please wait', text: 'Saving...', allowOutsideClick: false, allowEscapeKey: false, didOpen: () => Swal.showLoading(), ...SW });
        try {
            const res = await jQuery.ajax({ type: 'POST', url: '@Url.Action("nSaveVendorRegistrationData", "VendorRegistration")', data: JSON.stringify(nInfoTab), contentType: 'application/json' });
            Swal.close();
            if (res.statusId === 1) { await Swal.fire({ icon: 'success', title: 'Saved!', text: res.message || 'Vendor saved.', returnFocus: false, ...SW, didClose: () => document.getElementById("Vendor").focus() }); nClearForm(); }
            else await Swal.fire({ icon: 'warning', title: 'Failed', text: res.message || 'Could not save.', ...SW });
        } catch (e) { Swal.close(); await Swal.fire({ icon: 'error', title: 'Error', text: 'An error occurred.', ...SW }); }
    });

    document.getElementById("cancelBtn").addEventListener("click", function () { nClearForm(); });

    async function nClearForm() {
        ["VendorId","VendorImageAttachmentOld","Vendor","ContactNo","Address"].forEach(id => document.getElementById(id).value = "");
        document.getElementById("TypeId").value = ""; document.getElementById("DepartmentId").value = "";
        document.getElementById("IsActive").checked = false;
        document.getElementById("VendorImageAttachment").value = "";
        document.getElementById("fileNameDisplay").textContent = "Click to browse";
        setFieldValue("DeliveryCharges","0"); setFieldValue("DiscountAmount","0"); setFieldValue("PerProductAmount","0");
        IsUpdate = false;
        document.getElementById("saveBtn").innerHTML = '<i class="fas fa-floppy-disk"></i> Save Vendor';
        document.getElementById("ViewImageBtn").classList.remove("show");
        document.getElementById("updatePill").classList.remove("show");
        setCurrentTime(); initFloatLabels(); document.getElementById("Vendor").focus();
        await LoadGridViewData();
    }

    const ci = document.getElementById("ContactNo");
    ci.addEventListener("keydown", function (e) { if (e.ctrlKey || e.metaKey || (e.key >= '0' && e.key <= '9') || ['Backspace','Delete','ArrowLeft','ArrowRight','Tab'].includes(e.key)) return; e.preventDefault(); });
    ci.addEventListener("input", function () { this.value = this.value.replace(/\D/g,''); });
</script>
