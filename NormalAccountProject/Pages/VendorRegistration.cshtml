@page "/VendorRegistration"
@model NormalAccountProject.Pages.VendorRegistrationModel
@{
    ViewData["Title"] = "Vendor Registration";
}

<link href="https://fonts.googleapis.com/css2?family=Syne:wght@600;700;800&family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">

<style>
    :root {
        --bg: #f4f4f4;
        --bg2: #ffffff;
        --surface: #ffffff;
        --surface2: #f9f9f9;
        --surface3: #efefef;
        --border: rgba(0,0,0,.07);
        --border2: rgba(0,0,0,.12);
        --border3: rgba(0,0,0,.18);
        --accent: #474544;
        --accent2: #2e2d2c;
        --accent-g: rgba(71,69,68,.10);
        --gold: #b08d57;
        --gold-g: rgba(176,141,87,.12);
        --teal: #5a7a6e;
        --danger: #d94f4f;
        --success: #2e7d5e;
        --text: #1a1a1a;
        --text2: #5c5a58;
        --text3: #9a9896;
        --font-h: 'Syne', sans-serif;
        --font-b: 'Plus Jakarta Sans', sans-serif;
        --font-m: 'JetBrains Mono', monospace;
        --r: 10px;
        --r2: 14px;
        --r3: 18px;
        --sh: 0 4px 32px rgba(0,0,0,.08);
        --sh2: 0 8px 40px rgba(0,0,0,.10), 0 0 0 1px rgba(71,69,68,.08);
    }

    *, *::before, *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    .vr-wrap {
        font-family: var(--font-b);
        color: var(--text);
        background: var(--bg);
        min-height: calc(100vh - 60px);
        position: relative;
        overflow: hidden;
    }

    .vr-inner {
        position: relative;
        z-index: 1;
        padding: 20px 24px;
    }

    .top-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 20px;
        padding-bottom: 16px;
        border-bottom: 1px solid var(--border2);
    }

    .top-bar-left {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .icon-box {
        width: 44px;
        height: 44px;
        background: linear-gradient(135deg, var(--accent) 0%, var(--accent2) 100%);
        border-radius: var(--r);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        font-size: 17px;
        box-shadow: 0 4px 20px rgba(71,69,68,.30);
        flex-shrink: 0;
    }

    .page-title {
        font-family: var(--font-h);
        font-size: 21px;
        font-weight: 800;
        color: var(--text);
        letter-spacing: -.3px;
        line-height: 1.1;
    }

        .page-title span {
            color: var(--accent);
        }

    .breadcrumb {
        display: flex;
        align-items: center;
        gap: 5px;
        font-family: var(--font-m);
        font-size: 10px;
        color: var(--text3);
        letter-spacing: .5px;
        margin-top: 3px;
    }

        .breadcrumb i {
            font-size: 7px;
        }

        .breadcrumb span {
            color: var(--gold);
        }

    .pill {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 3px 10px;
        border-radius: 20px;
        font-family: var(--font-m);
        font-size: 10.5px;
        font-weight: 500;
        border: 1px solid transparent;
    }

    .pill-accent {
        background: var(--accent-g);
        color: var(--accent2);
        border-color: rgba(71,69,68,.20);
    }

    .pill-gold {
        background: var(--gold-g);
        color: var(--gold);
        border-color: rgba(176,141,87,.30);
    }

    .pill-success {
        background: rgba(46,125,94,.10);
        color: #1e6b4a;
        border-color: rgba(46,125,94,.25);
    }

    .pill-danger {
        background: rgba(217,79,79,.08);
        color: #c0392b;
        border-color: rgba(217,79,79,.20);
    }

    .toggle-group {
        display: flex;
        gap: 4px;
        background: var(--surface2);
        padding: 4px;
        border-radius: var(--r);
        border: 1px solid var(--border2);
    }

    .toggle-btn {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 7px 15px;
        font-family: var(--font-b);
        font-size: 12px;
        font-weight: 600;
        border-radius: 7px;
        border: none;
        cursor: pointer;
        transition: all .2s ease;
    }

    .toggle-btn-outline {
        background: transparent;
        color: var(--text2);
    }

        .toggle-btn-outline:hover {
            background: var(--surface3);
            color: var(--text);
        }

    .toggle-btn-solid {
        background: linear-gradient(135deg, var(--accent) 0%, var(--accent2) 100%);
        color: #fff;
        box-shadow: 0 2px 12px rgba(71,69,68,.25);
    }

        .toggle-btn-solid:hover {
            transform: translateY(-1px);
            box-shadow: 0 4px 18px rgba(71,69,68,.35);
        }

    .form-card {
        background: var(--surface);
        border-radius: var(--r3);
        border: 1px solid var(--border2);
        box-shadow: var(--sh2);
        overflow: hidden;
        animation: fadeUp .3s ease both;
    }

    .form-card-header {
        padding: 12px 22px;
        background: linear-gradient(90deg, var(--surface2) 0%, rgba(71,69,68,.06) 100%);
        border-bottom: 1px solid var(--border2);
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .form-card-header-left {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .header-dots {
        display: flex;
        gap: 5px;
    }

    .h-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
    }

    .h-dot-1 {
        background: #f43f5e;
    }

    .h-dot-2 {
        background: #f59e0b;
    }

    .h-dot-3 {
        background: #10b981;
    }

    .form-card-title {
        font-family: var(--font-m);
        font-size: 10.5px;
        font-weight: 500;
        color: var(--text3);
        letter-spacing: 1.5px;
        text-transform: uppercase;
    }

    .form-body {
        padding: 22px 24px;
        max-height: 65vh;
        overflow-y: auto;
        scrollbar-width: thin;
        scrollbar-color: var(--surface3) transparent;
    }

        .form-body::-webkit-scrollbar {
            width: 4px;
        }

        .form-body::-webkit-scrollbar-thumb {
            background: var(--surface3);
            border-radius: 10px;
        }

    .section-label {
        display: flex;
        align-items: center;
        gap: 9px;
        font-family: var(--font-m);
        font-size: 9.5px;
        color: var(--text3);
        letter-spacing: 2px;
        text-transform: uppercase;
        margin-bottom: 14px;
        padding-bottom: 10px;
        border-bottom: 1px solid var(--border);
        font-weight: 500;
    }

    .section-label-bar {
        width: 3px;
        height: 12px;
        background: linear-gradient(180deg, var(--accent), var(--teal));
        border-radius: 3px;
        flex-shrink: 0;
    }

    .section-label-text {
        color: var(--text2);
    }

    .form-row {
        display: grid;
        gap: 12px;
        margin-bottom: 14px;
    }

    .form-row-2 {
        grid-template-columns: 1fr 1fr;
    }

    .form-row-1 {
        grid-template-columns: 1fr;
    }

    .float-group {
        position: relative;
    }

        .float-group .form-control {
            padding: 22px 13px 7px;
        }

        .float-group select.form-control, .float-group textarea.form-control {
            padding: 22px 13px 7px;
        }

    .float-label {
        position: absolute;
        left: 13px;
        top: 50%;
        transform: translateY(-50%);
        font-family: var(--font-b);
        font-size: 13px;
        font-weight: 500;
        color: var(--text3);
        pointer-events: none;
        transition: top .18s, transform .18s, font-size .18s, color .18s, letter-spacing .18s;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        max-width: calc(100% - 26px);
    }

    .float-group.is-area .float-label {
        top: 16px;
        transform: none;
    }

    .float-group .form-control:focus ~ .float-label,
    .float-group.has-value .float-label {
        top: 7px;
        transform: none;
        font-size: 9px;
        font-family: var(--font-m);
        color: var(--accent);
        letter-spacing: 1px;
        text-transform: uppercase;
        font-weight: 500;
    }

    .float-group.is-area .form-control:focus ~ .float-label,
    .float-group.is-area.has-value .float-label {
        top: 5px;
        transform: none;
        font-size: 9px;
        font-family: var(--font-m);
        color: var(--accent);
        letter-spacing: 1px;
        text-transform: uppercase;
        font-weight: 500;
    }

    .float-group.always-float .float-label {
        top: 7px;
        transform: none;
        font-size: 9px;
        font-family: var(--font-m);
        color: var(--text3);
        letter-spacing: 1px;
        text-transform: uppercase;
        font-weight: 500;
    }

    .float-group.always-float .form-control:focus ~ .float-label {
        color: var(--accent);
    }

    .float-group .form-control::placeholder {
        color: transparent;
    }

    .form-control {
        border: 1px solid var(--border2);
        border-radius: var(--r);
        padding: 9px 13px;
        font-size: 13.5px;
        font-family: var(--font-b);
        color: #1a1a1a !important;
        background: var(--bg2);
        transition: border-color .18s, box-shadow .18s, background .18s;
        outline: none;
        width: 100%;
        -webkit-text-fill-color: #1a1a1a !important;
        caret-color: var(--accent);
    }

        .form-control:focus {
            border-color: var(--accent);
            box-shadow: 0 0 0 3px rgba(71,69,68,.12);
            background: var(--surface);
            color: #1a1a1a !important;
            -webkit-text-fill-color: #1a1a1a !important;
        }

        .form-control::placeholder {
            color: var(--text3);
            -webkit-text-fill-color: var(--text3);
        }

        .form-control:-webkit-autofill,
        .form-control:-webkit-autofill:hover,
        .form-control:-webkit-autofill:focus {
            -webkit-text-fill-color: #1a1a1a !important;
            -webkit-box-shadow: 0 0 0px 1000px #ffffff inset !important;
            box-shadow: 0 0 0px 1000px #ffffff inset !important;
            caret-color: var(--accent);
            transition: background-color 5000s ease-in-out 0s;
        }

    textarea.form-control {
        resize: vertical;
        line-height: 1.5;
    }

    select.form-control {
        appearance: auto;
        cursor: pointer;
        color: #1a1a1a !important;
    }

        select.form-control option {
            background: var(--surface);
            color: #1a1a1a;
        }

    input[type="time"].form-control::-webkit-calendar-picker-indicator {
        opacity: .5;
        cursor: pointer;
    }

    .input-icon-wrap {
        position: relative;
    }

        .input-icon-wrap .form-control {
            padding-left: 38px;
        }

    .input-icon {
        position: absolute;
        left: 12px;
        top: 50%;
        transform: translateY(-50%);
        color: var(--text3);
        font-size: 13px;
        pointer-events: none;
    }

    .check-group {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 10px 14px;
        background: var(--bg2);
        border-radius: var(--r);
        border: 1px solid var(--border2);
        cursor: pointer;
        transition: all .2s;
        width: fit-content;
    }

        .check-group:hover {
            border-color: var(--accent);
            background: var(--accent-g);
        }

    .check-input {
        width: 16px;
        height: 16px;
        cursor: pointer;
        accent-color: var(--accent);
    }

    .check-label {
        font-size: 13px;
        font-weight: 500;
        color: var(--text2);
        cursor: pointer;
        font-family: var(--font-b);
        transition: color .2s;
    }

    .check-group:hover .check-label {
        color: var(--text);
    }

    .file-upload-zone {
        border: 1px dashed var(--border2);
        border-radius: var(--r);
        padding: 10px 14px;
        background: var(--bg2);
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 12px;
        transition: all .2s;
    }

        .file-upload-zone:hover {
            border-color: var(--accent);
            background: var(--accent-g);
        }

    .file-icon {
        width: 34px;
        height: 34px;
        background: linear-gradient(135deg, var(--accent) 0%, var(--accent2) 100%);
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        font-size: 13px;
        flex-shrink: 0;
        box-shadow: 0 3px 10px rgba(71,69,68,.25);
    }

    .file-info-title {
        font-size: 12.5px;
        font-weight: 600;
        color: var(--text2);
    }

    .file-info-sub {
        font-size: 10px;
        color: var(--text3);
        font-family: var(--font-m);
        margin-top: 2px;
    }

    .form-control-file {
        display: none;
    }

    .status-meta {
        font-family: var(--font-m);
        font-size: 9.5px;
        color: var(--text3);
        letter-spacing: 1px;
        text-transform: uppercase;
        margin-bottom: 7px;
    }

    .media-label {
        font-family: var(--font-m);
        font-size: 9px;
        color: var(--text3);
        letter-spacing: 1px;
        text-transform: uppercase;
        margin-bottom: 7px;
        font-weight: 500;
    }

    .btn-row {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
        padding-top: 18px;
        border-top: 1px solid var(--border);
        margin-top: 4px;
    }

    .btn-pro {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 9px 20px;
        font-family: var(--font-b);
        font-size: 13px;
        font-weight: 600;
        border-radius: var(--r);
        border: none;
        cursor: pointer;
        transition: all .2s ease;
    }

    .btn-save {
        background: linear-gradient(135deg, var(--accent) 0%, var(--accent2) 100%);
        color: #fff;
        box-shadow: 0 3px 16px rgba(71,69,68,.30);
    }

        .btn-save:hover {
            transform: translateY(-1px);
            box-shadow: 0 6px 24px rgba(71,69,68,.40);
        }

        .btn-save:active {
            transform: translateY(0);
        }

    .btn-cancel {
        background: var(--surface2);
        color: var(--text2);
        border: 1px solid var(--border2);
    }

        .btn-cancel:hover {
            background: var(--surface3);
            color: var(--text);
        }

    .btn-view-img {
        background: var(--gold-g);
        color: var(--gold);
        border: 1px solid rgba(176,141,87,.30);
        font-family: var(--font-b);
        font-size: 13px;
        font-weight: 600;
        border-radius: var(--r);
        padding: 9px 16px;
        text-decoration: none;
        display: none;
        align-items: center;
        gap: 7px;
        transition: all .2s ease;
    }

        .btn-view-img:hover {
            background: rgba(176,141,87,.20);
        }

    .grid-card {
        background: var(--surface);
        border-radius: var(--r3);
        border: 1px solid var(--border2);
        box-shadow: var(--sh2);
        overflow: hidden;
        animation: fadeUp .3s ease both;
    }

    .grid-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 13px 20px;
        background: linear-gradient(90deg, var(--surface2) 0%, rgba(71,69,68,.05) 100%);
        border-bottom: 1px solid var(--border2);
    }

    .grid-header-left {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .grid-header-title {
        font-family: var(--font-m);
        font-size: 10.5px;
        font-weight: 500;
        color: var(--text2);
        text-transform: uppercase;
        letter-spacing: 1.5px;
    }

    .grid-badge {
        background: var(--accent-g);
        color: var(--accent2);
        font-family: var(--font-m);
        font-size: 10.5px;
        padding: 3px 10px;
        border-radius: 20px;
        border: 1px solid rgba(71,69,68,.20);
    }

    .grid-scroll {
        height: 58vh;
        overflow-y: auto;
        scrollbar-width: thin;
        scrollbar-color: var(--surface3) transparent;
    }

        .grid-scroll::-webkit-scrollbar {
            width: 4px;
        }

        .grid-scroll::-webkit-scrollbar-thumb {
            background: var(--surface3);
            border-radius: 10px;
        }

    .pro-table {
        width: 100%;
        border-collapse: collapse;
    }

        .pro-table thead th {
            background: var(--surface2);
            color: var(--text3);
            padding: 10px 14px;
            font-size: 9.5px;
            font-weight: 500;
            text-transform: uppercase;
            letter-spacing: 1.2px;
            white-space: nowrap;
            font-family: var(--font-m);
            position: sticky;
            top: 0;
            z-index: 10;
            border-bottom: 1px solid var(--border2);
            border-right: 1px solid var(--border);
        }

            .pro-table thead th:last-child {
                border-right: none;
            }

            .pro-table thead th:first-child {
                color: var(--text2);
            }

        .pro-table thead tr:nth-child(2) th {
            background: #f0f0f0;
            padding: 7px 10px;
            position: sticky;
            top: 38px;
            border-bottom: 1px solid var(--border2);
        }

            .pro-table thead tr:nth-child(2) th input {
                width: 100%;
                padding: 5px 9px;
                font-size: 11px;
                border: 1px solid var(--border2);
                border-radius: 6px;
                font-family: var(--font-b);
                background: var(--bg2);
                outline: none;
                color: var(--text);
                transition: border-color .15s;
            }

                .pro-table thead tr:nth-child(2) th input::placeholder {
                    color: var(--text3);
                }

                .pro-table thead tr:nth-child(2) th input:focus {
                    border-color: var(--accent);
                }

        .pro-table tbody tr {
            border-bottom: 1px solid var(--border);
            transition: background .12s;
        }

            .pro-table tbody tr:hover {
                background: var(--surface2);
            }

            .pro-table tbody tr:last-child {
                border-bottom: none;
            }

        .pro-table tbody td {
            padding: 10px 14px;
            font-size: 12.5px;
            color: var(--text2);
            white-space: nowrap;
        }

    .tbl-btn {
        width: 28px;
        height: 28px;
        border-radius: 7px;
        border: 1px solid transparent;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 11px;
        transition: all .15s;
    }

    .tbl-btn-edit {
        background: var(--surface2);
        color: var(--text2);
        border-color: var(--border2);
    }

        .tbl-btn-edit:hover {
            background: var(--accent);
            color: #fff;
            border-color: var(--accent);
        }

    .tbl-btn-del {
        background: rgba(217,79,79,.08);
        color: #c0392b;
        border-color: rgba(217,79,79,.20);
        margin-left: 4px;
    }

        .tbl-btn-del:hover {
            background: var(--danger);
            color: #fff;
            border-color: var(--danger);
        }

    .badge-active {
        background: rgba(46,125,94,.10);
        color: #1e6b4a;
        border: 1px solid rgba(46,125,94,.22);
        font-size: 10px;
        font-weight: 600;
        padding: 3px 10px;
        border-radius: 20px;
        font-family: var(--font-m);
        display: inline-block;
    }

    .badge-inactive {
        background: rgba(217,79,79,.08);
        color: #c0392b;
        border: 1px solid rgba(217,79,79,.20);
        font-size: 10px;
        font-weight: 600;
        padding: 3px 10px;
        border-radius: 20px;
        font-family: var(--font-m);
        display: inline-block;
    }

    .empty-state {
        padding: 60px 20px;
        text-align: center;
    }

    .empty-icon {
        width: 54px;
        height: 54px;
        background: var(--surface2);
        border-radius: var(--r2);
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--text3);
        font-size: 20px;
        margin: 0 auto 14px;
        border: 1px solid var(--border2);
    }

    .empty-text {
        font-size: 13px;
        color: var(--text3);
    }

    .accent-line {
        display: flex;
        gap: 2px;
        margin-bottom: 18px;
        height: 2px;
    }

        .accent-line span:nth-child(1) {
            flex: 2;
            background: var(--accent);
            border-radius: 2px;
        }

        .accent-line span:nth-child(2) {
            flex: 1;
            background: var(--teal);
            border-radius: 2px;
            opacity: .6;
        }

        .accent-line span:nth-child(3) {
            flex: 3;
            background: var(--border2);
            border-radius: 2px;
        }

    .page-footer {
        margin-top: 16px;
        padding-top: 12px;
        border-top: 1px solid var(--border);
        text-align: center;
        font-family: var(--font-m);
        font-size: 10px;
        color: var(--text3);
        letter-spacing: .5px;
    }

        .page-footer strong {
            color: var(--accent);
            font-weight: 500;
        }

    .stat-row {
        display: flex;
        gap: 8px;
        margin-bottom: 16px;
    }

    .stat-chip {
        display: flex;
        align-items: center;
        gap: 7px;
        padding: 7px 13px;
        background: var(--surface);
        border: 1px solid var(--border2);
        border-radius: var(--r);
        font-size: 11.5px;
        color: var(--text2);
        font-family: var(--font-b);
    }

        .stat-chip i {
            color: var(--accent);
            font-size: 11px;
        }

    .form-card::after {
        content: '';
        position: absolute;
        inset: 0;
        border-radius: var(--r3);
        box-shadow: inset 0 1px 0 rgba(255,255,255,.8);
        pointer-events: none;
    }

    @@keyframes fadeUp {
        from {
            opacity: 0;
            transform: translateY(10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>

