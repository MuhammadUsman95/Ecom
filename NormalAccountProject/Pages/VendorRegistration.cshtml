@page "/VendorRegistration"
@model NormalAccountProject.Pages.VendorRegistrationModel
@{
    ViewData["Title"] = "Vendor Registration";
}

<link href="https://fonts.googleapis.com/css2?family=Syne:wght@600;700;800&family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,600;0,700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">

<style>
    /* ════════════════════════════════════════
           THEME — Matched to Sidebar
           Sidebar BG:     #252d3e
           Sidebar Header: #1e2535
           Active Item:    #2e4275 (blue-navy)
           Accent Blue:    #4f7cff
        ════════════════════════════════════════ */
    :root {
        --bg: #1a2030;
        --bg2: #151c2b;
        --surface: #252d3e;
        --surface2: #1e2535;
        --surface3: #2a3347;
        --border: rgba(255,255,255,.06);
        --border2: rgba(255,255,255,.10);
        --accent: #4f7cff;
        --accent-dim: rgba(79,124,255,.14);
        --accent-glow: rgba(79,124,255,.28);
        --active-nav: #2e4275;
        --text: #e4eaf5;
        --text2: #8d9bb5;
        --text3: #4a5878;
        --danger: #f43f5e;
        --success: #22c55e;
        --amber: #f59e0b;
        --radius-sm: 8px;
        --radius: 12px;
        --radius-lg: 14px;
        --font-head: 'Syne', sans-serif;
        --font-body: 'Plus Jakarta Sans', sans-serif;
        --font-mono: 'JetBrains Mono', monospace;
        --shadow: 0 8px 32px rgba(0,0,0,.45);
    }

    *, *::before, *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    .vr-wrap {
        font-family: var(--font-body);
        color: var(--text);
        background: var(--bg);
        min-height: calc(100vh - 60px);
        position: relative;
    }

        .vr-wrap::before {
            content: '';
            position: fixed;
            top: -180px;
            right: -180px;
            width: 500px;
            height: 500px;
            background: radial-gradient(circle, rgba(79,124,255,.055) 0%, transparent 70%);
            pointer-events: none;
            z-index: 0;
        }

    .vr-inner {
        position: relative;
        z-index: 1;
        padding: 22px 26px;
    }

    /* ─── Top Bar ─── */
    .top-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 22px;
        padding-bottom: 18px;
        border-bottom: 1px solid var(--border2);
    }

    .top-bar-left {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .icon-box {
        width: 42px;
        height: 42px;
        background: var(--active-nav);
        border: 1px solid rgba(79,124,255,.28);
        border-radius: var(--radius-sm);
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--accent);
        font-size: 17px;
        box-shadow: 0 0 18px rgba(79,124,255,.18);
        flex-shrink: 0;
    }

    .page-title {
        font-family: var(--font-head);
        font-size: 20px;
        font-weight: 800;
        color: var(--text);
        letter-spacing: -.3px;
        line-height: 1.1;
    }

        .page-title span {
            color: var(--accent);
        }

    .breadcrumb {
        display: flex;
        align-items: center;
        gap: 5px;
        font-family: var(--font-mono);
        font-size: 10.5px;
        color: var(--text3);
        letter-spacing: .4px;
        margin-top: 3px;
    }

        .breadcrumb i {
            font-size: 7px;
        }

        .breadcrumb span {
            color: var(--accent);
        }

    /* ─── Toggle Group ─── */
    .toggle-group {
        display: flex;
        gap: 5px;
        background: var(--surface2);
        padding: 5px;
        border-radius: var(--radius-sm);
        border: 1px solid var(--border2);
    }

    .toggle-btn {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 8px 16px;
        font-family: var(--font-body);
        font-size: 12.5px;
        font-weight: 600;
        border-radius: 6px;
        border: none;
        cursor: pointer;
        transition: all .2s ease;
    }

    .toggle-btn-outline {
        background: transparent;
        color: var(--text2);
    }

        .toggle-btn-outline:hover {
            background: var(--surface3);
            color: var(--accent);
        }

    .toggle-btn-solid {
        background: var(--active-nav);
        color: #c5d4ff;
        font-weight: 700;
        border: 1px solid rgba(79,124,255,.3);
        box-shadow: 0 2px 10px rgba(46,66,117,.5);
    }

        .toggle-btn-solid:hover {
            background: #354e8a;
            transform: translateY(-1px);
        }

    /* ─── Form Card ─── */
    .form-card {
        background: var(--surface);
        border-radius: var(--radius-lg);
        border: 1px solid var(--border2);
        box-shadow: var(--shadow);
        overflow: hidden;
        animation: fadeUp .28s ease both;
    }

    .form-card-header {
        padding: 13px 22px;
        background: var(--surface2);
        border-bottom: 1px solid var(--border);
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .header-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: var(--accent);
        box-shadow: 0 0 8px var(--accent-glow);
    }

    .form-card-title {
        font-family: var(--font-mono);
        font-size: 10.5px;
        font-weight: 500;
        color: var(--text2);
        letter-spacing: 1.5px;
        text-transform: uppercase;
    }

    .form-body {
        padding: 22px 24px;
        max-height: 65vh;
        overflow-y: auto;
        scrollbar-width: thin;
        scrollbar-color: var(--surface3) transparent;
    }

        .form-body::-webkit-scrollbar {
            width: 4px;
        }

        .form-body::-webkit-scrollbar-thumb {
            background: var(--surface3);
            border-radius: 10px;
        }

    /* Section label */
    .section-label {
        display: flex;
        align-items: center;
        gap: 8px;
        font-family: var(--font-mono);
        font-size: 9.5px;
        color: var(--accent);
        letter-spacing: 2px;
        text-transform: uppercase;
        margin-bottom: 14px;
        padding-bottom: 10px;
        border-bottom: 1px solid var(--border);
    }

        .section-label::before {
            content: '';
            width: 3px;
            height: 13px;
            background: var(--accent);
            border-radius: 3px;
            box-shadow: 0 0 7px var(--accent-glow);
            flex-shrink: 0;
        }

    /* Form grid */
    .form-row {
        display: grid;
        gap: 14px;
        margin-bottom: 16px;
    }

    .form-row-2 {
        grid-template-columns: 1fr 1fr;
    }

    .form-row-1 {
        grid-template-columns: 1fr;
    }

    .form-group {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    /* ── Floating Label ── */
    .float-group {
        position: relative;
    }

        .float-group .form-control {
            padding: 22px 13px 7px;
        }

        .float-group select.form-control, .float-group textarea.form-control {
            padding: 22px 13px 7px;
        }

    .float-label {
        position: absolute;
        left: 13px;
        top: 50%;
        transform: translateY(-50%);
        font-family: var(--font-body);
        font-size: 13.5px;
        font-weight: 500;
        color: var(--text3);
        pointer-events: none;
        transition: top .18s, transform .18s, font-size .18s, color .18s, letter-spacing .18s;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        max-width: calc(100% - 26px);
    }

    .float-group.is-area .float-label {
        top: 16px;
        transform: none;
    }

    .float-group .form-control:focus ~ .float-label,
    .float-group.has-value .float-label {
        top: 7px;
        transform: none;
        font-size: 9px;
        font-family: var(--font-mono);
        color: var(--accent);
        letter-spacing: 1px;
        text-transform: uppercase;
        font-weight: 500;
    }

    .float-group.is-area .form-control:focus ~ .float-label,
    .float-group.is-area.has-value .float-label {
        top: 5px;
        transform: none;
        font-size: 9px;
        font-family: var(--font-mono);
        color: var(--accent);
        letter-spacing: 1px;
        text-transform: uppercase;
        font-weight: 500;
    }

    .float-group.always-float .float-label {
        top: 7px;
        transform: none;
        font-size: 9px;
        font-family: var(--font-mono);
        color: var(--text3);
        letter-spacing: 1px;
        text-transform: uppercase;
        font-weight: 500;
    }

    .float-group.always-float .form-control:focus ~ .float-label {
        color: var(--accent);
    }

    .float-group .form-control::placeholder {
        color: transparent;
    }

    .form-control {
        border: 1.5px solid var(--border2);
        border-radius: var(--radius-sm);
        padding: 9px 13px;
        font-size: 13.5px;
        font-family: var(--font-body);
        color: var(--text);
        background: var(--surface2);
        transition: border-color .18s, box-shadow .18s;
        outline: none;
        width: 100%;
    }

        .form-control:focus {
            border-color: rgba(255,255,255,.7);
            box-shadow: 0 0 0 3px rgba(255,255,255,.08);
            background: rgba(255,255,255,.7);
        }

        .form-control::placeholder {
            color: var(--text3);
        }

    textarea.form-control {
        resize: vertical;
        line-height: 1.5;
    }

    select.form-control {
        appearance: auto;
        cursor: pointer;
    }

        select.form-control option {
            background: var(--surface3);
            color: var(--text);
        }

    /* Checkbox */
    .check-group {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 10px 15px;
        background: var(--active-nav);
        border-radius: var(--radius-sm);
        border: 1px solid rgba(79,124,255,.3);
        cursor: pointer;
        transition: background .2s;
        width: fit-content;
    }

        .check-group:hover {
            background: #354e8a;
        }

    .check-input {
        width: 16px;
        height: 16px;
        cursor: pointer;
        accent-color: var(--accent);
    }

    .check-label {
        font-size: 13px;
        font-weight: 600;
        color: #a0b8ff;
        cursor: pointer;
        font-family: var(--font-body);
    }

    /* File Upload */
    .file-upload-zone {
        border: 1.5px dashed var(--border2);
        border-radius: var(--radius-sm);
        padding: 11px 14px;
        background: var(--surface2);
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 11px;
        transition: border-color .2s, background .2s;
    }

        .file-upload-zone:hover {
            border-color: var(--accent);
            background: var(--accent-dim);
        }

    .file-icon {
        width: 32px;
        height: 32px;
        background: var(--active-nav);
        border-radius: 7px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--accent);
        font-size: 13px;
        flex-shrink: 0;
    }

    .file-info-title {
        font-size: 12.5px;
        font-weight: 600;
        color: var(--text2);
        font-family: var(--font-body);
    }

    .file-info-sub {
        font-size: 10px;
        color: var(--text3);
        font-family: var(--font-mono);
        margin-top: 2px;
    }

    .form-control-file {
        display: none;
    }

    .status-meta {
        font-family: var(--font-mono);
        font-size: 9.5px;
        color: var(--text3);
        letter-spacing: 1px;
        text-transform: uppercase;
        margin-bottom: 7px;
    }

    .media-label {
        font-family: var(--font-mono);
        font-size: 9px;
        color: var(--text3);
        letter-spacing: 1px;
        text-transform: uppercase;
        margin-bottom: 7px;
        font-weight: 500;
    }

    /* Buttons */
    .btn-row {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
        padding-top: 18px;
        border-top: 1px solid var(--border);
        margin-top: 4px;
    }

    .btn-pro {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 9px 22px;
        font-family: var(--font-body);
        font-size: 13px;
        font-weight: 700;
        border-radius: var(--radius-sm);
        border: none;
        cursor: pointer;
        transition: all .2s ease;
    }

    .btn-save {
        background: var(--active-nav);
        color: #c5d4ff;
        border: 1px solid rgba(79,124,255,.35);
        box-shadow: 0 2px 14px rgba(46,66,117,.5);
    }

        .btn-save:hover {
            background: #354e8a;
            transform: translateY(-1px);
            box-shadow: 0 4px 20px var(--accent-glow);
        }

        .btn-save:active {
            transform: translateY(0);
        }

    .btn-cancel {
        background: var(--surface3);
        color: var(--text2);
        border: 1px solid var(--border2);
    }

        .btn-cancel:hover {
            background: var(--surface2);
            color: var(--text);
        }

    .btn-view-img {
        background: rgba(245,158,11,.1);
        color: var(--amber);
        border: 1px solid rgba(245,158,11,.22);
        font-family: var(--font-body);
        font-size: 13px;
        font-weight: 700;
        border-radius: var(--radius-sm);
        padding: 9px 18px;
        text-decoration: none;
        display: none;
        align-items: center;
        gap: 7px;
        transition: .2s ease;
    }

        .btn-view-img:hover {
            background: rgba(245,158,11,.18);
        }

    /* ─── Grid Card ─── */
    .grid-card {
        background: var(--surface);
        border-radius: var(--radius-lg);
        border: 1px solid var(--border2);
        box-shadow: var(--shadow);
        overflow: hidden;
        animation: fadeUp .28s ease both;
    }

    .grid-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 14px 20px;
        background: var(--surface2);
        border-bottom: 1px solid var(--border);
    }

    .grid-header-left {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .grid-header-title {
        font-family: var(--font-mono);
        font-size: 10.5px;
        font-weight: 500;
        color: var(--text2);
        text-transform: uppercase;
        letter-spacing: 1.5px;
    }

    .grid-badge {
        background: var(--active-nav);
        color: #a0b8ff;
        font-family: var(--font-mono);
        font-size: 10.5px;
        padding: 3px 10px;
        border-radius: 20px;
        border: 1px solid rgba(79,124,255,.25);
    }

    .grid-scroll {
        height: 57vh;
        overflow-y: auto;
        scrollbar-width: thin;
        scrollbar-color: var(--surface3) transparent;
    }

        .grid-scroll::-webkit-scrollbar {
            width: 4px;
        }

        .grid-scroll::-webkit-scrollbar-thumb {
            background: var(--surface3);
            border-radius: 10px;
        }

    /* Table */
    .pro-table {
        width: 100%;
        border-collapse: collapse;
    }

        .pro-table thead th {
            background: var(--bg2);
            color: var(--text3);
            padding: 11px 15px;
            font-size: 9.5px;
            font-weight: 500;
            text-transform: uppercase;
            letter-spacing: 1.2px;
            white-space: nowrap;
            font-family: var(--font-mono);
            position: sticky;
            top: 0;
            z-index: 10;
            border-bottom: 1px solid var(--border);
            border-right: 1px solid var(--border);
        }

            .pro-table thead th:last-child {
                border-right: none;
            }

            .pro-table thead th:first-child {
                color: var(--accent);
            }

        .pro-table thead tr:nth-child(2) th {
            background: var(--surface3);
            padding: 7px 10px;
            position: sticky;
            top: 39px;
            border-bottom: 1px solid var(--border);
        }

            .pro-table thead tr:nth-child(2) th input {
                width: 100%;
                padding: 5px 9px;
                font-size: 11px;
                border: 1.5px solid var(--border2);
                border-radius: 6px;
                font-family: var(--font-body);
                background: var(--surface2);
                outline: none;
                color: var(--text);
                transition: border-color .15s;
            }

                .pro-table thead tr:nth-child(2) th input::placeholder {
                    color: var(--text3);
                }

                .pro-table thead tr:nth-child(2) th input:focus {
                    border-color: rgba(255,255,255,.6);
                }

        .pro-table tbody tr {
            border-bottom: 1px solid var(--border);
            transition: background .12s;
        }

            .pro-table tbody tr:hover {
                background: var(--surface2);
            }

            .pro-table tbody tr:last-child {
                border-bottom: none;
            }

        .pro-table tbody td {
            padding: 10px 15px;
            font-size: 13px;
            color: var(--text2);
            white-space: nowrap;
        }

    .tbl-btn {
        width: 29px;
        height: 29px;
        border-radius: 7px;
        border: 1px solid transparent;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 11px;
        transition: all .15s;
    }

    .tbl-btn-edit {
        background: var(--active-nav);
        color: #a0b8ff;
        border-color: rgba(79,124,255,.2);
    }

        .tbl-btn-edit:hover {
            background: var(--accent);
            color: #fff;
            box-shadow: 0 2px 8px var(--accent-glow);
        }

    .tbl-btn-del {
        background: rgba(244,63,94,.1);
        color: var(--danger);
        border-color: rgba(244,63,94,.2);
        margin-left: 5px;
    }

        .tbl-btn-del:hover {
            background: var(--danger);
            color: #fff;
            box-shadow: 0 2px 8px rgba(244,63,94,.35);
        }

    .badge-active {
        background: rgba(34,197,94,.1);
        color: var(--success);
        border: 1px solid rgba(34,197,94,.2);
        font-size: 10.5px;
        font-weight: 600;
        padding: 3px 10px;
        border-radius: 20px;
        font-family: var(--font-mono);
        display: inline-block;
    }

    .badge-inactive {
        background: rgba(244,63,94,.1);
        color: var(--danger);
        border: 1px solid rgba(244,63,94,.2);
        font-size: 10.5px;
        font-weight: 600;
        padding: 3px 10px;
        border-radius: 20px;
        font-family: var(--font-mono);
        display: inline-block;
    }

    .empty-state {
        padding: 60px 20px;
        text-align: center;
    }

    .empty-icon {
        width: 52px;
        height: 52px;
        background: var(--surface3);
        border-radius: var(--radius);
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--text3);
        font-size: 20px;
        margin: 0 auto 12px;
        border: 1px solid var(--border2);
    }

    .empty-text {
        font-size: 13.5px;
        color: var(--text3);
    }

    /* Footer */
    .page-footer {
        margin-top: 18px;
        padding-top: 14px;
        border-top: 1px solid var(--border);
        text-align: center;
        font-family: var(--font-mono);
        font-size: 10.5px;
        color: var(--text3);
        letter-spacing: .5px;
    }

        .page-footer strong {
            color: var(--accent);
            font-weight: 500;
        }

    @@keyframes fadeUp {
        from

    {
        opacity: 0;
        transform: translateY(10px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

    }
</style>

<div class="vr-wrap">
    <div class="vr-inner">

        <!-- Top Bar -->
        <div class="top-bar">
            <div class="top-bar-left">
                <div class="icon-box"><i class="fas fa-store-alt"></i></div>
                <div>
                    <div class="page-title">Vendor <span>Registration</span></div>
                    <div class="breadcrumb">
                        Setup <i class="fas fa-chevron-right"></i> <span>Vendor</span>
                    </div>
                </div>
            </div>
            <div class="toggle-group">
                <button class="toggle-btn toggle-btn-outline" id="gridViewToggleBtn">
                    <i class="fas fa-table-cells"></i> Grid View
                </button>
                <button class="toggle-btn toggle-btn-solid" id="formViewToggleBtn" style="display:none;">
                    <i class="fas fa-pen-to-square"></i> Form View
                </button>
            </div>
        </div>

        <!-- FORM VIEW -->
        <div id="formViewContainer">
            <div class="form-card">
                <div class="form-card-header">
                    <div class="header-dot"></div>
                    <div class="form-card-title">Vendor Information</div>
                </div>
                <div class="form-body">
                    <input style="display:none;" type="text" id="VendorId">
                    <input style="display:none;" type="text" id="VendorImageAttachmentOld">

                    <div class="section-label">Basic Details</div>

                    <div class="form-row form-row-2">
                        <div class="float-group">
                            <input type="text" id="Vendor" class="form-control" placeholder=" ">
                            <label class="float-label" for="Vendor">Vendor Name</label>
                        </div>
                        <div class="float-group">
                            <input type="text" id="ContactNo" class="form-control" placeholder=" " inputmode="numeric" autocomplete="off">
                            <label class="float-label" for="ContactNo">Contact Number</label>
                        </div>
                    </div>

                    <div class="form-row form-row-2">
                        <div class="float-group always-float">
                            <select id="TypeId" class="form-control"><option value="">— Select Type —</option></select>
                            <label class="float-label" for="TypeId">Type</label>
                        </div>
                        <div class="float-group always-float">
                            <select id="DepartmentId" class="form-control"><option value="">— Select Department —</option></select>
                            <label class="float-label" for="DepartmentId">Department</label>
                        </div>
                    </div>

                    <div class="form-row form-row-1">
                        <div class="float-group is-area">
                            <textarea id="Address" class="form-control" placeholder=" " rows="2"></textarea>
                            <label class="float-label" for="Address">Full Address</label>
                        </div>
                    </div>

                    <div class="section-label" style="margin-top:4px;">Schedule & Charges</div>

                    <div class="form-row form-row-2">
                        <div class="float-group always-float">
                            <input type="time" id="TimeIn" class="form-control">
                            <label class="float-label" for="TimeIn">Time In</label>
                        </div>
                        <div class="float-group always-float">
                            <input type="time" id="TimeOut" class="form-control">
                            <label class="float-label" for="TimeOut">Time Out</label>
                        </div>
                    </div>

                    <div class="form-row form-row-2">
                        <div class="float-group">
                            <input type="text" id="DeliveryCharges" class="form-control" placeholder=" ">
                            <label class="float-label" for="DeliveryCharges">Delivery Charges</label>
                        </div>
                        <div class="float-group">
                            <input type="text" id="PerProductAmount" class="form-control" placeholder=" ">
                            <label class="float-label" for="PerProductAmount">Per Product Amount</label>
                        </div>
                    </div>

                    <div class="section-label" style="margin-top:4px;">Status & Media</div>

                    <div class="form-row form-row-2" style="margin-bottom:18px;">
                        <div class="form-group">
                            <div class="status-meta"><i class="fas fa-circle-check" style="color:var(--accent);margin-right:5px;"></i>Status</div>
                            <div class="check-group">
                                <input type="checkbox" id="IsActive" class="check-input">
                                <label class="check-label" for="IsActive">Mark as Active</label>
                            </div>
                        </div>
                        <div class="form-group">
                            <div class="media-label"><i class="fas fa-image" style="color:var(--accent);margin-right:5px;"></i>Vendor Logo <span style="color:var(--text3);text-transform:none;letter-spacing:0;font-size:9px;">(Max 500 KB · JPEG/PNG)</span></div>
                            <label for="VendorImageAttachment" class="file-upload-zone">
                                <div class="file-icon"><i class="fas fa-cloud-arrow-up"></i></div>
                                <div>
                                    <div class="file-info-title" id="fileNameDisplay">Click to browse</div>
                                    <div class="file-info-sub">JPEG or PNG · max 500 KB</div>
                                </div>
                            </label>
                            <input id="VendorImageAttachment" class="form-control-file" type="file" accept=".jpeg,.png">
                        </div>
                    </div>

                    <div class="btn-row">
                        <button class="btn-pro btn-save" id="saveBtn"><i class="fas fa-floppy-disk"></i> Save Vendor</button>
                        <button class="btn-pro btn-cancel" id="cancelBtn"><i class="fas fa-xmark"></i> Cancel</button>
                        <a class="btn-view-img" id="ViewImageBtn" target="_blank"><i class="fas fa-eye"></i> View Image</a>
                    </div>
                </div>
            </div>
        </div>

        <!-- GRID VIEW -->
        <div id="gridViewContainer" style="display:none;">
            <div class="grid-card">
                <div class="grid-header">
                    <div class="grid-header-left">
                        <div class="grid-header-title">All Vendors</div>
                        <div class="grid-badge" id="TotalVendorsCount">0 records</div>
                    </div>
                </div>
                <div class="grid-scroll">
                    <div id="VendorGridContainer"></div>
                </div>
            </div>
        </div>

        <div class="page-footer">Software Developed By: <strong>UT Designer</strong></div>
    </div>
</div>

<script>
    let userId = localStorage.getItem("userId") || "";
    let GridViewDataList = [];
    let IsUpdate = false;
    const SW = { background:'#252d3e', color:'#e4eaf5' };

    function initFloatLabels() {
        document.querySelectorAll('.float-group').forEach(g => {
            if (g.classList.contains('always-float')) return;
            const el = g.querySelector('input:not([type="checkbox"]):not([type="file"]):not([style*="display:none"]),textarea,select');
            if (!el) return;
            const chk = () => g.classList.toggle('has-value', el.value !== '');
            el.addEventListener('input', chk); el.addEventListener('change', chk); chk();
        });
    }

    function showFormView() {
        document.getElementById("formViewContainer").style.display = "block";
        document.getElementById("gridViewContainer").style.display = "none";
        document.getElementById("formViewToggleBtn").style.display = "none";
        document.getElementById("gridViewToggleBtn").style.display = "inline-flex";
        document.getElementById("Vendor").focus();
    }
    function showGridView() {
        document.getElementById("formViewContainer").style.display = "none";
        document.getElementById("gridViewContainer").style.display = "block";
        document.getElementById("gridViewToggleBtn").style.display = "none";
        document.getElementById("formViewToggleBtn").style.display = "inline-flex";
    }
    document.getElementById("gridViewToggleBtn").addEventListener("click", showGridView);
    document.getElementById("formViewToggleBtn").addEventListener("click", showFormView);

    document.getElementById("VendorImageAttachment").addEventListener("change", async function () {
        const file = this.files[0]; if (!file) return;
        if (file.size > 500 * 1024) {
            this.value = ""; document.getElementById("fileNameDisplay").textContent = "Click to browse";
            await Swal.fire({ icon:'warning', title:'Validation', text:'Image must be under 500 KB.', returnFocus:false, ...SW, didClose:()=>document.getElementById("VendorImageAttachment").focus() });
        } else { document.getElementById("fileNameDisplay").textContent = file.name; }
    });

    function GetVendorImageAttachmentFile() {
        return new Promise((resolve) => {
            const fileInput = document.getElementById("VendorImageAttachment");
            const file = fileInput.files[0];
            if (!file) { resolve({ VendorImageAttachmentfilename:"", VendorImageAttachmentbase64:"" }); return; }
            const reader = new FileReader();
            reader.onload = function(e) {
                const Vendor = document.getElementById("Vendor").value.trim();
                const now = new Date(); const pad = n => n.toString().padStart(2,"0");
                const ts = `${pad(now.getDate())}${pad(now.getMonth()+1)}${now.getFullYear()}${pad(now.getHours())}${pad(now.getMinutes())}`;
                const ext = file.name.split(".").pop();
                const newFileName = `${Vendor}_${ts}_VendorRegistrationLogo.${ext}`;
                const uint8 = new Uint8Array(e.target.result);
                let bin = ""; for (let i=0;i<uint8.length;i++) bin += String.fromCharCode(uint8[i]);
                resolve({ VendorImageAttachmentfilename: newFileName, VendorImageAttachmentbase64: btoa(bin) });
            };
            reader.onerror = () => resolve({ VendorImageAttachmentfilename:"", VendorImageAttachmentbase64:"" });
            reader.readAsArrayBuffer(file);
        });
    }

    function setCurrentTime() {
        const now = new Date();
        const t = `${String(now.getHours()).padStart(2,'0')}:${String(now.getMinutes()).padStart(2,'0')}`;
        document.getElementById("TimeIn").value = t;
        document.getElementById("TimeOut").value = t;
    }
    function getTimeFromTextbox(id) { const v=document.getElementById(id).value; if(!v)return; return `1900-01-01 ${v}:00.000`; }
    function setTimeToTextbox(id, val) { if(!val)return; document.getElementById(id).value=val.split("T")[1].substring(0,5); }

    document.addEventListener("DOMContentLoaded", async function () {
        initFloatLabels();
        await LoadData(); await LoadGridViewData();
        setCurrentTime();
        document.getElementById("DeliveryCharges").value = "0";
        document.getElementById("PerProductAmount").value = "0";
        const fields = [document.getElementById("Vendor"), document.getElementById("ContactNo"), document.getElementById("TypeId"), document.getElementById("DepartmentId"), document.getElementById("IsActive")];
        fields.forEach((f,i) => f.addEventListener("keydown", function(e) {
            if (e.key==="Enter") { e.preventDefault(); i<fields.length-1 ? fields[i+1].focus() : document.getElementById("saveBtn").click(); }
        }));
        document.getElementById("Vendor").focus();
    });

    async function LoadData() {
        return new Promise((res,rej) => jQuery.ajax({ type:'POST', url:'@Url.Action("nLoadVendorRegistrationData", "VendorRegistration")', data:JSON.stringify({Userid:userId}), contentType:'application/json',
            success(r) { if(r.statusId===1){TypeDropdown(r.TypeList);DepartmentDropdown(r.DepartmentList);res();}else{toastr.warning("No data.");rej();} },
            error(x,s,e){console.log(x,s,e);rej();}
        }));
    }
    function TypeDropdown(list) { const d=document.getElementById("TypeId"); d.innerHTML='<option value="">— Select Type —</option>'; list.forEach(i=>{const o=document.createElement("option");o.value=i.TypeId;o.text=i.Type;d.appendChild(o);}); }
    function DepartmentDropdown(list) { const d=document.getElementById("DepartmentId"); d.innerHTML='<option value="">— Select Department —</option>'; list.forEach(i=>{const o=document.createElement("option");o.value=i.DepartmentId;o.text=i.Department;d.appendChild(o);}); }

    async function LoadGridViewData() {
        return new Promise((res,rej) => jQuery.ajax({ type:'POST', url:'@Url.Action("nLoadGridViewData", "VendorRegistration")', data:JSON.stringify({Userid:userId}), contentType:'application/json',
            success(r) { if(r.statusId===1){GridViewDataList=r.GridViewDataList;renderVendorGrid(GridViewDataList);res();}else{toastr.warning("No data.");rej();} },
            error(x,s,e){console.log(x,s,e);rej();}
        }));
    }

    function renderVendorGrid(gridData) {
        const container = document.getElementById("VendorGridContainer");
        container.innerHTML = "";
        if (!gridData || gridData.length === 0) {
            container.innerHTML = `<div class="empty-state"><div class="empty-icon"><i class="fas fa-store-slash"></i></div><div class="empty-text">No vendor records found.</div></div>`;
            document.getElementById("TotalVendorsCount").textContent = "0 records"; return;
        }
        const columns = Object.keys(gridData[0]).filter(c => !["Userid","Type","VendorId","DepartmentId","ImagePath","TimeIn","TimeOut"].includes(c));
        const table = document.createElement("table"); table.className = "pro-table";
        const thead = document.createElement("thead");
        const h1 = document.createElement("tr");
        const ah = document.createElement("th"); ah.textContent = "Actions"; h1.appendChild(ah);
        columns.forEach(c => { const th=document.createElement("th"); th.textContent=c; h1.appendChild(th); });
        thead.appendChild(h1);
        const h2 = document.createElement("tr");
        h2.appendChild(document.createElement("th"));
        columns.forEach(c => {
            const th=document.createElement("th"); const inp=document.createElement("input");
            inp.type="text"; inp.placeholder="Search...";
            inp.addEventListener("input",function(){filterTable(this,c);}); th.appendChild(inp); h2.appendChild(th);
        });
        thead.appendChild(h2); table.appendChild(thead);
        const tbody = document.createElement("tbody");
        gridData.forEach(row => {
            const tr = document.createElement("tr");
            const atd = document.createElement("td");
            const eb = document.createElement("button"); eb.className="tbl-btn tbl-btn-edit"; eb.innerHTML='<i class="fas fa-pen"></i>'; eb.title="Edit";
            eb.addEventListener("click",()=>{onEditRow(row);showFormView();}); atd.appendChild(eb);
            const db = document.createElement("button"); db.className="tbl-btn tbl-btn-del"; db.innerHTML='<i class="fas fa-trash-can"></i>'; db.title="Delete";
            db.addEventListener("click",()=>onDeleteRow(row)); atd.appendChild(db);
            tr.appendChild(atd);
            columns.forEach(c => {
                const td=document.createElement("td");
                if(c==="Is Active") td.innerHTML=row[c]?'<span class="badge-active">Active</span>':'<span class="badge-inactive">Inactive</span>';
                else td.textContent=row[c];
                tr.appendChild(td);
            });
            tbody.appendChild(tr);
        });
        table.appendChild(tbody); container.appendChild(table);
        document.getElementById("TotalVendorsCount").textContent = `${tbody.rows.length} records`;
    }

    function filterTable(input, column) {
        const table=input.closest("table"); const tbody=table.querySelector("tbody");
        const rows=Array.from(tbody.rows); const fv=input.value.toLowerCase();
        const ci=Array.from(table.querySelectorAll("thead tr:first-child th")).findIndex(th=>th.textContent===column);
        let count=0;
        rows.forEach(r=>{const m=(r.cells[ci]?.textContent.toLowerCase()||"").includes(fv); r.style.display=m?"":"none"; if(m)count++;});
        document.getElementById("TotalVendorsCount").textContent=`${count} records`;
    }

    function onEditRow(row) {
        IsUpdate=true;
        document.getElementById("saveBtn").innerHTML='<i class="fas fa-floppy-disk"></i> Update Vendor';
        document.getElementById("VendorId").value=row["VendorId"]||"";
        document.getElementById("VendorImageAttachmentOld").value=row["ImagePath"]||"";
        document.getElementById("Vendor").value=row["Vendor Name"]||"";
        document.getElementById("ContactNo").value=row["Contact #"]||"";
        document.getElementById("TypeId").value=row["Type"]||"";
        document.getElementById("DepartmentId").value=row["DepartmentId"]||"";
        document.getElementById("IsActive").checked=row["Is Active"]||false;
        document.getElementById("DeliveryCharges").value=row["Delivery Charges"]||"";
        document.getElementById("PerProductAmount").value=row["PerProductAmount"]||"";
        document.getElementById("Address").value=row["Address"]||"";
        setTimeToTextbox("TimeIn",row["TimeIn"]); setTimeToTextbox("TimeOut",row["TimeOut"]);
        document.getElementById("Vendor").focus();
        ViewImage(row["ImagePath"]||"");
        initFloatLabels();
    }

    async function onDeleteRow(row) {
        const r=await Swal.fire({title:'Confirm Delete',text:`Delete "${row["Vendor Name"]}"?`,icon:'warning',showCancelButton:true,confirmButtonText:'Yes, delete',cancelButtonText:'Cancel',confirmButtonColor:'#f43f5e',...SW});
        if(!r.isConfirmed)return;
        const nInfoTab={Userid:userId.toString(),VendorId:row["VendorId"].toString(),VendorImageAttachmentfilenameold:row["ImagePath"].toString()};
        Swal.fire({title:'Please wait',text:'Deleting...',allowOutsideClick:false,allowEscapeKey:false,returnFocus:false,didOpen:()=>Swal.showLoading(),...SW});
        try {
            const res=await jQuery.ajax({type:'POST',url:'@Url.Action("nDeleteVendorRegistrationData", "VendorRegistration")',data:JSON.stringify(nInfoTab),contentType:'application/json'});
            Swal.close();
            if(res.statusId===1){await Swal.fire({icon:'success',title:'Deleted',text:res.message||'Vendor deleted.',returnFocus:false,...SW,didClose:()=>document.getElementById("Vendor").focus()});nClearForm();}
            else await Swal.fire({icon:'warning',title:'Failed',text:res.message||'Could not delete.',...SW});
        } catch(e){Swal.close();await Swal.fire({icon:'error',title:'Error',text:'An error occurred.',...SW});}
    }

    function ViewImage(Link){const b=document.getElementById("ViewImageBtn");b.style.display="inline-flex";b.href=Link;b.target="_blank";}

    document.getElementById("saveBtn").addEventListener("click",async function(){await SaveData();});
    async function SaveData() {
        const VendorId=document.getElementById("VendorId").value.trim();
        const Vendor=document.getElementById("Vendor").value.trim();
        const contactNo=document.getElementById("ContactNo").value.trim();
        const type=document.getElementById("TypeId").value.trim();
        const department=document.getElementById("DepartmentId").value.trim();
        const isActive=document.getElementById("IsActive").checked;
        const VendorImageAttachment=document.getElementById("VendorImageAttachment").value.trim();
        const VendorImageAttachmentold=document.getElementById("VendorImageAttachmentOld").value.trim();
        const nAddress=document.getElementById("Address").value.trim();
        const validations=[
            {cond:!Vendor,text:'Vendor name is required',focus:'Vendor'},
            {cond:!contactNo,text:'Contact number is required',focus:'ContactNo'},
            {cond:contactNo&&contactNo.length<10,text:'Contact number must be at least 10 digits',focus:'ContactNo'},
            {cond:!type,text:'Please select a vendor type',focus:'TypeId'},
            {cond:!department,text:'Please select a department',focus:'DepartmentId'},
            {cond:!VendorImageAttachment,text:'Please select a vendor image',focus:'VendorImageAttachment'}
        ];
        for(const v of validations){if(v.cond){await Swal.fire({icon:'warning',title:'Validation',text:v.text,returnFocus:false,...SW,didClose:()=>document.getElementById(v.focus).focus()});return;}}
        const{VendorImageAttachmentfilename,VendorImageAttachmentbase64}=await GetVendorImageAttachmentFile();
        const nInfoTab={Userid:userId,VendorId,Vendor,ContactNo:contactNo,Type:type,DepartmentId:department,VendorImageAttachmentfilename,VendorImageAttachmentfilenameold:VendorImageAttachmentold,VendorImageAttachmentbase64,TimeIn:getTimeFromTextbox("TimeIn"),TimeOut:getTimeFromTextbox("TimeOut"),DeliveryCharges:document.getElementById("DeliveryCharges").value.trim(),PerProductAmount:document.getElementById("PerProductAmount").value.trim(),Address:nAddress,IsActive:isActive,IsUpdate};
        Swal.fire({title:'Please wait',text:'Saving...',allowOutsideClick:false,allowEscapeKey:false,didOpen:()=>Swal.showLoading(),...SW});
        try{
            const res=await jQuery.ajax({type:'POST',url:'@Url.Action("nSaveVendorRegistrationData", "VendorRegistration")',data:JSON.stringify(nInfoTab),contentType:'application/json'});
            Swal.close();
            if(res.statusId===1){await Swal.fire({icon:'success',title:'Saved',text:res.message||'Vendor saved.',returnFocus:false,...SW,didClose:()=>document.getElementById("Vendor").focus()});nClearForm();}
            else await Swal.fire({icon:'warning',title:'Failed',text:res.message||'Could not save.',...SW});
        }catch(e){Swal.close();await Swal.fire({icon:'error',title:'Error',text:'An error occurred.',...SW});}
    }

    document.getElementById("cancelBtn").addEventListener("click",function(){nClearForm();});
    async function nClearForm(){
        ["VendorId","VendorImageAttachmentOld","Vendor","ContactNo","Address"].forEach(id=>document.getElementById(id).value="");
        document.getElementById("TypeId").value="";document.getElementById("DepartmentId").value="";
        document.getElementById("IsActive").checked=false;document.getElementById("VendorImageAttachment").value="";
        document.getElementById("fileNameDisplay").textContent="Click to browse";
        document.getElementById("DeliveryCharges").value="0";document.getElementById("PerProductAmount").value="0";
        IsUpdate=false;document.getElementById("saveBtn").innerHTML='<i class="fas fa-floppy-disk"></i> Save Vendor';
        document.getElementById("ViewImageBtn").style.display="none";
        document.getElementById("Vendor").focus();setCurrentTime();await LoadGridViewData();
    }

    const ci=document.getElementById("ContactNo");
    ci.addEventListener("keydown",function(e){if(e.ctrlKey||e.metaKey||(e.key>='0'&&e.key<='9')||['Backspace','Delete','ArrowLeft','ArrowRight','Tab'].includes(e.key))return;e.preventDefault();});
    ci.addEventListener("input",function(){this.value=this.value.replace(/\D/g,'');});
</script>
