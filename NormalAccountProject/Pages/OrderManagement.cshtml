@page "/OrderManagement"
@model NormalAccountProject.Pages.OrderManagementModel
@{
    ViewData["Title"] = "Order Management";
}

<style>
    /* ── Order Card — Fixed Size ── */
    .order-card {
        background: #fff;
        border-radius: 14px;
        box-shadow: 0 1px 6px rgba(0,0,0,0.08), 0 4px 16px rgba(0,0,0,0.05);
        border: 1px solid #eef0f3;
        overflow: hidden;
        transition: box-shadow 0.25s, transform 0.2s;
        display: flex;
        flex-direction: column;
        height: 360px; /* ✅ Fixed height */
    }

        .order-card:hover {
            box-shadow: 0 8px 28px rgba(0,0,0,0.12);
            transform: translateY(-2px);
        }

    /* ── Header ── */
    .card-header-bar {
        padding: 10px 14px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        background: linear-gradient(135deg, #1a73e8 0%, #1254b0 100%);
        flex-shrink: 0;
    }

    .order-no-badge {
        font-size: 14px;
        font-weight: 700;
        color: #fff;
        letter-spacing: 0.5px;
    }

    .status-pill {
        display: inline-block;
        padding: 3px 11px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.3px;
    }

    .pill-Pending {
        background: #fff8e1;
        color: #e65100;
    }

    .pill-Inprocess {
        background: #e3f2fd;
        color: #0d47a1;
    }

    .pill-Delivered {
        background: #e8f5e9;
        color: #1b5e20;
    }

    .pill-Cancelled {
        background: #fce4ec;
        color: #880e4f;
    }

    /* ── Customer ── */
    .customer-section {
        padding: 9px 14px;
        border-bottom: 1px solid #f2f4f7;
        display: flex;
        align-items: flex-start;
        gap: 10px;
        flex-shrink: 0;
    }

    .cust-avatar {
        width: 34px;
        height: 34px;
        border-radius: 50%;
        background: #e8f0fe;
        color: #1a73e8;
        font-weight: 700;
        font-size: 13px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .customer-name {
        font-weight: 600;
        font-size: 13px;
        color: #1a1a2e;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        max-width: 180px;
    }

    .customer-meta {
        font-size: 11px;
        color: #7a8499;
        margin-top: 1px;
        line-height: 1.5;
    }

    /* ── Items Table Wrapper — Scrollable ── */
    .items-table-wrapper {
        flex: 1; /* ✅ باقی space لے لو */
        overflow-y: auto; /* ✅ 2 سے زیادہ items پر scroll */
        overflow-x: auto;
        min-height: 0; /* flex scroll fix */
    }

        /* Custom scrollbar */
        .items-table-wrapper::-webkit-scrollbar {
            width: 4px;
        }

        .items-table-wrapper::-webkit-scrollbar-track {
            background: #f7f9fc;
        }

        .items-table-wrapper::-webkit-scrollbar-thumb {
            background: #c5cfe0;
            border-radius: 4px;
        }

            .items-table-wrapper::-webkit-scrollbar-thumb:hover {
                background: #1a73e8;
            }

    /* ── Items Table ── */
    .items-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 12px;
    }

        .items-table thead tr {
            background: #f7f9fc;
        }

        .items-table thead {
            position: sticky;
            top: 0;
            z-index: 1;
        }

        .items-table th {
            padding: 6px 12px;
            text-align: left;
            font-weight: 600;
            font-size: 10px;
            color: #9aa3b5;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            border-bottom: 1px solid #eef0f5;
            background: #f7f9fc;
        }

        .items-table td {
            padding: 6px 12px;
            color: #2d3748;
            border-bottom: 1px solid #f5f7fa;
        }

        .items-table tr:last-child td {
            border-bottom: none;
        }

        .items-table td.num {
            text-align: right;
            font-variant-numeric: tabular-nums;
        }

        .items-table tbody tr:hover {
            background: #fafbff;
        }

    /* ── Footer ── */
    .card-footer-bar {
        padding: 8px 14px;
        background: #f7f9fc;
        border-top: 1px solid #eef0f5;
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-shrink: 0;
    }

    .total-amount {
        font-size: 13px;
        font-weight: 700;
        color: #1a73e8;
    }

    /* ── Status Update ── */
    .status-update-section {
        padding: 9px 14px;
        background: #fff;
        border-top: 1px solid #eef0f5;
        display: flex;
        align-items: center;
        gap: 8px;
        flex-shrink: 0;
    }

    .status-select-input {
        flex: 1;
        min-width: 100px;
        padding: 6px 9px;
        border-radius: 8px;
        border: 1.5px solid #dde1ea;
        font-size: 12px;
        background: #f7f9fc;
        color: #2d3748;
        appearance: auto;
        cursor: pointer;
    }

        .status-select-input:focus {
            outline: none;
            border-color: #1a73e8;
            background: #fff;
        }

        .status-select-input:disabled {
            background: #f0f0f0;
            color: #aaa;
            cursor: not-allowed;
            border-color: #e0e0e0;
        }

    .update-btn {
        padding: 6px 14px;
        background: #1a73e8;
        color: #fff;
        border: none;
        border-radius: 8px;
        font-size: 12px;
        font-weight: 600;
        cursor: pointer;
        white-space: nowrap;
        transition: background 0.2s, transform 0.15s;
    }

        .update-btn:hover {
            background: #1254b0;
            transform: scale(1.02);
        }

        .update-btn:disabled {
            background: #a8c4f0;
            cursor: not-allowed;
            transform: none;
        }

    /* ── Finalized Badge ── */
    .finalized-section {
        padding: 9px 14px;
        background: #f7f9fc;
        border-top: 1px solid #eef0f5;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        font-size: 11px;
        color: #aab0be;
        font-weight: 500;
        flex-shrink: 0;
    }

    .summary-card:hover {
        transform: translateY(-2px);
    }


    /* ── Summary Cards ── */
    .summary-card {
        border-radius: 10px;
        padding: 8px 6px; /* ✅ کم padding */
        text-align: center;
        font-size: 11px;
        font-weight: 600;
        border: none;
        transition: transform 0.2s;
        height: 64px; /* ✅ Fixed height */
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
    }

        .summary-card:hover {
            transform: translateY(-2px);
        }

    .sc-pending {
        background: linear-gradient(135deg,#fff8e1,#ffe0b2);
        color: #bf360c;
    }

    .sc-inprocess {
        background: linear-gradient(135deg,#e3f2fd,#bbdefb);
        color: #0d47a1;
    }

    .sc-delivered {
        background: linear-gradient(135deg,#e8f5e9,#c8e6c9);
        color: #1b5e20;
    }

    .sc-cancelled {
        background: linear-gradient(135deg,#fce4ec,#f8bbd0);
        color: #880e4f;
    }

    .summary-count {
        font-size: 18px; /* ✅ چھوٹا number */
        font-weight: 800;
        display: block;
        line-height: 1.2;
    }

    /* ── Summary Card Bounce Animation ── */
    @@keyframes summaryPop {
        0% {
            transform: scale(1);
        }

        40% {
            transform: scale(1.08);
        }

        70% {
            transform: scale(0.97);
        }

        100% {
            transform: scale(1);
        }
    }

    .summary-card.refreshed {
        animation: summaryPop 0.4s ease;
    }

    /* ── Search Section ── */
    .search-section {
        background: #fff;
        border-radius: 12px;
        padding: 12px 14px;
        box-shadow: 0 1px 5px rgba(0,0,0,0.06);
        margin-bottom: 1rem;
        border: 1px solid #eef0f5;
    }

    /* ── Responsive ── */
    @@media (max-width: 1199px) {
        .order-card {
            height: 370px;
        }
    }

    @@media (max-width: 767px) {
        .order-card {
            height: 350px;
        }

        .customer-name {
            max-width: 140px;
        }
    }

    @@media (max-width: 575px) {
        .order-card {
            height: 340px;
        }

        .items-table th, .items-table td {
            padding: 5px 8px;
            font-size: 11px;
        }

        .card-footer-bar {
            gap: 4px;
        }

        .cust-avatar {
            width: 28px;
            height: 28px;
            font-size: 11px;
        }

        .customer-name {
            max-width: 110px;
        }

        .status-select-input {
            min-width: 80px;
            font-size: 11px;
        }

        .update-btn {
            padding: 6px 10px;
            font-size: 11px;
        }
    }
</style>

<div class="section__content section__content--p30">
    <div class="container-fluid">

        <!-- Title -->
        <div class="row mb-3">
            <div class="col-12 d-flex align-items-center justify-content-between flex-wrap gap-2">
                <h2 class="title-1 mb-0">Order Management</h2>
                <small class="text-muted">Total Orders: <strong id="totalCount">0</strong></small>
            </div>
        </div>
        <hr class="mt-0 mb-3">

        <!-- Summary Strip -->
        <!-- Summary Strip -->
        <div class="row g-2 mb-3">
            <div class="col-3">
                <!-- ✅ col-6 col-md-3 → col-3 چاروں ایک line میں -->
                <div class="summary-card sc-pending">
                    <span class="summary-count" id="cntPending">0</span>Pending
                </div>
            </div>
            <div class="col-3">
                <div class="summary-card sc-inprocess">
                    <span class="summary-count" id="cntInprocess">0</span>Inprocess
                </div>
            </div>
            <div class="col-3">
                <div class="summary-card sc-delivered">
                    <span class="summary-count" id="cntDelivered">0</span>Delivered
                </div>
            </div>
            <div class="col-3">
                <div class="summary-card sc-cancelled">
                    <span class="summary-count" id="cntCancelled">0</span>Cancelled
                </div>
            </div>
        </div>

        <!-- Search & Filter -->
        <div class="search-section">
            <div class="row g-2">
                <div class="col-12 col-md-7">
                    <input type="text" id="searchInput" class="form-control"
                           placeholder="&#128269;  Search by Order No or Customer name...">
                </div>
                <div class="col-12 col-md-5">
                    <select id="filterStatus" class="form-select">
                        <option value="">All Status</option>
                        <option value="Pending" selected>Pending</option>
                        <option value="Inprocess">Inprocess</option>
                        <option value="Delivered">Delivered</option>
                        <option value="Cancelled">Cancelled</option>
                    </select>
                </div>
            </div>
        </div>

        <!-- Cards Grid -->
        <div id="ordersGrid" class="row g-3"></div>

        <hr class="mt-4">
        <p class="text-center mb-0" style="font-size:13px;color:#aaa;">
            Software Developed By: <strong style="color:#555;">UT Designer</strong>
        </p>

    </div>
</div>

<script>
    let OrderList = [];
    const STATUS_OPTIONS = ["Pending", "Inprocess", "Delivered", "Cancelled"];

    document.addEventListener("DOMContentLoaded", async function () {
        await LoadGridViewData();
    });

    // ─── Load Data ────────────────────────────────────────────
    async function LoadGridViewData() {
        const nInfoTab = { Userid: localStorage.getItem("userId") || "" };
        try {
            const response = await jQuery.ajax({
                type: 'POST',
                url: '@Url.Action("nLoadGridViewData", "OrderManagement")',
                data: JSON.stringify(nInfoTab),
                contentType: 'application/json'
            });
            if (response.statusId === 1) {
                OrderList = response.OrderList;
                renderCards();
            } else {
                toastr.warning("No order data found.");
            }
        } catch (e) {
            console.error("LoadGridViewData error:", e);
            toastr.error("Failed to load orders.");
        }
    }

    // ─── Render Cards ─────────────────────────────────────────
    function renderCards() {
        const q    = document.getElementById("searchInput").value.toLowerCase().trim();
        const fs   = document.getElementById("filterStatus").value;
        const grid = document.getElementById("ordersGrid");
        grid.innerHTML = "";

        // ── Group by OrderNo ──
        const allGrouped = {};
        OrderList.forEach(row => {
            const key = row.OrderNo || row.orderNo || "";
            if (!allGrouped[key]) {
                allGrouped[key] = {
                    OrderNo:         key,
                    CustomerName:    row.CustomerName    || row.customerName    || "",
                    ContactNo:       row.ContactNo       || row.contactNo       || "",
                    CustomerAddress: row.CustomerAddress || row.customerAddress || "",
                    Floor:           row.Floor           || row.floor           || "",
                    Street:          row.Street          || row.street          || "",
                    OrderStatus:     row.OrderStatus     || row.orderStatus     || "Pending",
                    Items: []
                };
            }
            allGrouped[key].Items.push({
                Product:        row.Product        || row.product        || "",
                Quantity:       row.Quantity       || row.quantity       || 0,
                Rate:           row.Rate           || row.rate           || 0,
                DiscountAmount: row.DiscountAmount || row.discountAmount || 0
            });
        });

        // ── Summary counts (always from full list) ──
        const allOrders = Object.values(allGrouped);
        document.getElementById("totalCount").textContent   = allOrders.length;
        document.getElementById("cntPending").textContent   = allOrders.filter(o => o.OrderStatus === "Pending").length;
        document.getElementById("cntInprocess").textContent = allOrders.filter(o => o.OrderStatus === "Inprocess").length;
        document.getElementById("cntDelivered").textContent = allOrders.filter(o => o.OrderStatus === "Delivered").length;
        document.getElementById("cntCancelled").textContent = allOrders.filter(o => o.OrderStatus === "Cancelled").length;

        // ── Filter ──
        const filtered = allOrders.filter(o => {
            const matchQ = !q || o.OrderNo.toLowerCase().includes(q) || o.CustomerName.toLowerCase().includes(q);
            const matchS = !fs || o.OrderStatus === fs;
            return matchQ && matchS;
        });

        if (!filtered.length) {
            grid.innerHTML = `<div class="col-12 text-center text-muted py-5" style="font-size:14px;">No orders found.</div>`;
            return;
        }

        // ── Build cards ──
        filtered.forEach(order => {
            const total = order.Items.reduce((s, i) =>
                s + (Number(i.Quantity) * Number(i.Rate) - Number(i.DiscountAmount)), 0);

            const itemRows = order.Items.map(i => `
                <tr>
                    <td>${i.Product}</td>
                    <td class="num">${i.Quantity}</td>
                    <td class="num">Rs ${Number(i.Rate).toLocaleString()}</td>
                    <td class="num" style="color:#e74c3c;">
                        ${Number(i.DiscountAmount) > 0 ? '-Rs ' + Number(i.DiscountAmount).toLocaleString() : '-'}
                    </td>
                </tr>`).join("");

            const statusOptions = STATUS_OPTIONS.map(s =>
                `<option value="${s}" ${order.OrderStatus === s ? "selected" : ""}>${s}</option>`
            ).join("");

            // ── Already Delivered/Cancelled → lock ──
            const isFinalized = order.OrderStatus === "Delivered" || order.OrderStatus === "Cancelled";

            const statusUpdateHTML = isFinalized
                ? `<div class="finalized-section">
                       <i class="fas fa-lock"></i>
                       Order ${order.OrderStatus} &mdash; No further changes allowed
                   </div>`
                : `<div class="status-update-section">
                       <select class="status-select-input" id="sel_${order.OrderNo}">
                           ${statusOptions}
                       </select>
                       <button class="update-btn"
                               id="btn_${order.OrderNo}"
                               onclick="updateStatus('${order.OrderNo}', this)">
                           <i class="fas fa-check me-1"></i> Update
                       </button>
                   </div>`;

            const col = document.createElement("div");
            col.className = "col-12 col-md-6 col-xl-4";
            col.innerHTML = `
                <div class="order-card">

                    <!-- Header -->
                    <div class="card-header-bar">
                        <span class="order-no-badge"># ${order.OrderNo}</span>
                        <span class="status-pill pill-${order.OrderStatus}">${order.OrderStatus}</span>
                    </div>

                    <!-- Customer Info -->
                    <div class="customer-section">
                        <div class="cust-avatar">${order.CustomerName ? order.CustomerName.charAt(0).toUpperCase() : '?'}</div>
                        <div style="overflow:hidden;">
                            <div class="customer-name">${order.CustomerName}</div>
                            <div class="customer-meta">
                                <i class="fas fa-phone-alt me-1"></i>${order.ContactNo}<br>
                                <i class="fas fa-map-marker-alt me-1"></i>
                                ${[order.Floor ? order.Floor + ' Floor' : '', order.Street, order.CustomerAddress].filter(Boolean).join(', ')}
                            </div>
                        </div>
                    </div>

                    <!-- Items Table — Scrollable if > 2 rows -->
                    <div class="items-table-wrapper">
                        <table class="items-table">
                            <thead>
                                <tr>
                                    <th>Product</th>
                                    <th style="text-align:right">Qty</th>
                                    <th style="text-align:right">Rate</th>
                                    <th style="text-align:right">Disc</th>
                                </tr>
                            </thead>
                            <tbody>${itemRows}</tbody>
                        </table>
                    </div>

                    <!-- Footer -->
                    <div class="card-footer-bar">
                        <small style="color:#6c757d;">${order.Items.length} item(s)</small>
                        <span class="total-amount">Total: Rs ${total.toLocaleString()}</span>
                    </div>

                    <!-- Status Update / Finalized -->
                    ${statusUpdateHTML}

                </div>`;

            grid.appendChild(col);
        });
    }

    // ─── Summary Card Bounce ──────────────────────────────────
    function highlightSummaryCard(status) {
        const map = {
            "Pending"   : document.getElementById("cntPending")?.closest(".summary-card"),
            "Inprocess" : document.getElementById("cntInprocess")?.closest(".summary-card"),
            "Delivered" : document.getElementById("cntDelivered")?.closest(".summary-card"),
            "Cancelled" : document.getElementById("cntCancelled")?.closest(".summary-card")
        };
        const card = map[status];
        if (!card) return;
        card.classList.remove("refreshed");
        void card.offsetWidth;
        card.classList.add("refreshed");
        setTimeout(() => card.classList.remove("refreshed"), 500);
    }

    // ─── Update Status ────────────────────────────────────────
    async function updateStatus(orderNo, btn) {
        const sel       = document.getElementById("sel_" + orderNo);
        const newStatus = sel.value;

        if (!newStatus) {
            toastr.warning("Please select a status.");
            return;
        }

        // ✅ Button click کے بعد disable — select change پر نہیں
        btn.disabled  = true;
        sel.disabled  = true;
        btn.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i> Updating...';

        try {
            const payload = { OrderNo: String(orderNo), OrderStatus: String(newStatus) };

            const response = await jQuery.ajax({
                type: 'POST',
                url: '@Url.Action("nUpdateOrderStatus", "OrderManagement")',
                data: JSON.stringify(payload),
                contentType: 'application/json',
                dataType: 'json',
                timeout: 15000
            });

            if (response.statusId == 1) {
                // ✅ Local list update
                OrderList
                    .filter(x => String(x.OrderNo || x.orderNo) === String(orderNo))
                    .forEach(x => {
                        x.OrderStatus = newStatus;
                        x.orderStatus = newStatus;
                    });

                // ✅ Summary card bounce
                highlightSummaryCard(newStatus);

                toastr.success(response.message || "Status updated.");
                renderCards();

            } else {
                toastr.error(response.message || "Update failed.");
            }

        } catch (e) {
            console.error("Update error:", e);
            toastr.error("Error: " + (e.responseJSON?.message || e.statusText || "Request failed"));

        } finally {
            // ✅ ہمیشہ reset — success، error، exception سب میں
            btn.disabled  = false;
            sel.disabled  = false;
            btn.innerHTML = '<i class="fas fa-check me-1"></i> Update';
        }
    }

    // ─── Listeners ───────────────────────────────────────────
    document.getElementById("searchInput").addEventListener("input", renderCards);
    document.getElementById("filterStatus").addEventListener("change", renderCards);
</script>
