@page "/Category"
@model NormalAccountProject.Pages.CategoryModel
@{
    ViewData["Title"] = "Category Registration";
}

<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">

<style>
    :root {
        --bg: #0b1120;
        --bg2: #111827;
        --surface: #1a2332;
        --surface2: #1f2b3e;
        --surface3: #263249;
        --border: rgba(148,163,194,.08);
        --border2: rgba(148,163,194,.12);
        --border3: rgba(148,163,194,.20);
        --primary: #c9a227;
        --primary2: #b8931f;
        --primary-g: rgba(201,162,39,.10);
        --primary-sh: 0 4px 24px rgba(201,162,39,.25);
        --accent: #3b82f6;
        --accent-g: rgba(59,130,246,.10);
        --teal: #14b8a6;
        --teal-g: rgba(20,184,166,.10);
        --danger: #ef4444;
        --danger-g: rgba(239,68,68,.08);
        --success: #22c55e;
        --success-g: rgba(34,197,94,.10);
        --text: #e8ecf4;
        --text2: #94a3b2;
        --text3: #5a6a80;
        --font-b: 'Plus Jakarta Sans', sans-serif;
        --font-m: 'JetBrains Mono', monospace;
        --r: 8px;
        --r2: 12px;
        --r3: 16px;
        --sh: 0 2px 20px rgba(0,0,0,.25);
        --sh2: 0 8px 40px rgba(0,0,0,.35), 0 0 0 1px rgba(148,163,194,.06);
        --glass: rgba(26,35,50,.75);
        --glass-border: rgba(148,163,194,.08);
    }

    *, *::before, *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    .vr-wrap {
        font-family: var(--font-b);
        color: var(--text);
        background: var(--bg);
        min-height: calc(100vh - 60px);
        position: relative;
        overflow: hidden;
    }

        /* ── Ambient Glow Effects ── */
        .vr-wrap::before {
            content: '';
            position: fixed;
            top: -200px;
            right: -100px;
            width: 600px;
            height: 600px;
            background: radial-gradient(circle, rgba(201,162,39,.06) 0%, rgba(201,162,39,.02) 30%, transparent 65%);
            pointer-events: none;
            z-index: 0;
        }

        .vr-wrap::after {
            content: '';
            position: fixed;
            bottom: -200px;
            left: -100px;
            width: 500px;
            height: 500px;
            background: radial-gradient(circle, rgba(59,130,246,.04) 0%, transparent 60%);
            pointer-events: none;
            z-index: 0;
        }

    .vr-bg-grid {
        position: fixed;
        inset: 0;
        z-index: 0;
        pointer-events: none;
        background-image: linear-gradient(rgba(148,163,194,.03) 1px, transparent 1px), linear-gradient(90deg, rgba(148,163,194,.03) 1px, transparent 1px);
        background-size: 48px 48px;
    }

    /* Floating orbs */
    .vr-orb {
        position: fixed;
        border-radius: 50%;
        pointer-events: none;
        z-index: 0;
        filter: blur(60px);
    }

    .vr-orb-1 {
        width: 300px;
        height: 300px;
        top: 10%;
        left: 60%;
        background: rgba(201,162,39,.04);
        animation: orbFloat 20s ease-in-out infinite;
    }

    .vr-orb-2 {
        width: 250px;
        height: 250px;
        top: 60%;
        left: 20%;
        background: rgba(59,130,246,.03);
        animation: orbFloat 25s ease-in-out infinite reverse;
    }

    @@keyframes orbFloat {
        0%, 100%

    {
        transform: translate(0, 0);
    }

    33% {
        transform: translate(30px, -20px);
    }

    66% {
        transform: translate(-20px, 15px);
    }

    }

    .vr-inner {
        position: relative;
        z-index: 1;
        padding: 20px 24px;
    }

    /* ── Top Bar ── */
    .top-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 22px;
        padding-bottom: 18px;
        border-bottom: 1px solid var(--border2);
    }

    .top-bar-left {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .icon-box {
        width: 46px;
        height: 46px;
        background: linear-gradient(135deg, var(--primary) 0%, var(--primary2) 100%);
        border-radius: var(--r2);
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--bg);
        font-size: 17px;
        font-weight: 700;
        box-shadow: var(--primary-sh);
        flex-shrink: 0;
        position: relative;
    }

        .icon-box::after {
            content: '';
            position: absolute;
            inset: -2px;
            border-radius: 14px;
            background: linear-gradient(135deg, rgba(201,162,39,.3), transparent 60%);
            z-index: -1;
        }

    .page-title {
        font-family: var(--font-b);
        font-size: 22px;
        font-weight: 800;
        color: var(--text);
        letter-spacing: -.5px;
        line-height: 1.1;
    }

        .page-title span {
            background: linear-gradient(135deg, var(--primary), #e0c04a);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

    .breadcrumb {
        display: flex;
        align-items: center;
        gap: 6px;
        font-family: var(--font-m);
        font-size: 10px;
        color: var(--text3);
        letter-spacing: .5px;
        margin-top: 4px;
    }

        .breadcrumb i {
            font-size: 7px;
        }

        .breadcrumb span {
            color: var(--primary);
        }

    .pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 4px 12px;
        border-radius: 20px;
        font-family: var(--font-m);
        font-size: 10px;
        font-weight: 600;
        border: 1px solid transparent;
        letter-spacing: .3px;
    }

    .pill-gold {
        background: var(--primary-g);
        color: var(--primary);
        border-color: rgba(201,162,39,.25);
    }

    .pill-blue {
        background: var(--accent-g);
        color: var(--accent);
        border-color: rgba(59,130,246,.25);
    }

    .pill-teal {
        background: var(--teal-g);
        color: var(--teal);
        border-color: rgba(20,184,166,.25);
    }

    /* ── Toggle ── */
    .toggle-group {
        display: flex;
        gap: 4px;
        background: var(--surface);
        padding: 4px;
        border-radius: var(--r);
        border: 1px solid var(--border2);
    }

    .toggle-btn {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 8px 16px;
        font-family: var(--font-b);
        font-size: 12px;
        font-weight: 600;
        border-radius: 6px;
        border: none;
        cursor: pointer;
        transition: all .25s ease;
    }

    .toggle-btn-outline {
        background: transparent;
        color: var(--text3);
    }

        .toggle-btn-outline:hover {
            background: var(--surface2);
            color: var(--text2);
        }

    .toggle-btn-solid {
        background: linear-gradient(135deg, var(--primary) 0%, var(--primary2) 100%);
        color: var(--bg);
        box-shadow: var(--primary-sh);
        font-weight: 700;
    }

        .toggle-btn-solid:hover {
            transform: translateY(-1px);
            box-shadow: 0 6px 28px rgba(201,162,39,.35);
        }

    /* ── Accent Line ── */
    .accent-line {
        display: flex;
        gap: 3px;
        margin-bottom: 20px;
        height: 2px;
    }

        .accent-line span:nth-child(1) {
            flex: 2;
            background: linear-gradient(90deg, var(--primary), var(--primary2));
            border-radius: 2px;
        }

        .accent-line span:nth-child(2) {
            flex: 1;
            background: var(--accent);
            border-radius: 2px;
            opacity: .4;
        }

        .accent-line span:nth-child(3) {
            flex: 3;
            background: var(--border2);
            border-radius: 2px;
        }

    /* ── Form Card ── */
    .form-card {
        background: var(--glass);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border-radius: var(--r3);
        border: 1px solid var(--glass-border);
        box-shadow: var(--sh2);
        overflow: hidden;
        animation: fadeUp .4s ease both;
    }

    .form-card-header {
        padding: 14px 22px;
        background: linear-gradient(180deg, rgba(148,163,194,.04), transparent);
        border-bottom: 1px solid var(--border2);
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .form-card-header-left {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .header-dots {
        display: flex;
        gap: 6px;
    }

    .h-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
    }

    .h-dot-1 {
        background: #ef4444;
        box-shadow: 0 0 6px rgba(239,68,68,.4);
    }

    .h-dot-2 {
        background: #f59e0b;
        box-shadow: 0 0 6px rgba(245,158,11,.4);
    }

    .h-dot-3 {
        background: #22c55e;
        box-shadow: 0 0 6px rgba(34,197,94,.4);
    }

    .form-card-title {
        font-family: var(--font-m);
        font-size: 10.5px;
        font-weight: 500;
        color: var(--text3);
        letter-spacing: 1.5px;
        text-transform: uppercase;
    }

    /* ── Form Body ── */
    .form-body {
        padding: 24px 22px;
        max-height: 65vh;
        overflow-y: auto;
        scrollbar-width: thin;
        scrollbar-color: var(--surface3) transparent;
    }

        .form-body::-webkit-scrollbar {
            width: 4px;
        }

        .form-body::-webkit-scrollbar-thumb {
            background: var(--surface3);
            border-radius: 10px;
        }

    /* ── Section Label ── */
    .section-label {
        display: flex;
        align-items: center;
        gap: 10px;
        font-family: var(--font-m);
        font-size: 9.5px;
        color: var(--text3);
        letter-spacing: 2.5px;
        text-transform: uppercase;
        margin-bottom: 16px;
        padding-bottom: 12px;
        border-bottom: 1px solid var(--border);
        font-weight: 500;
    }

    .section-label-bar {
        width: 3px;
        height: 14px;
        background: linear-gradient(180deg, var(--primary), var(--accent));
        border-radius: 3px;
        flex-shrink: 0;
        box-shadow: 0 0 8px rgba(201,162,39,.3);
    }

    .section-label-text {
        color: var(--text2);
    }

    /* ── Form Row ── */
    .form-row {
        display: grid;
        gap: 14px;
        margin-bottom: 16px;
    }

    .form-row-1 {
        grid-template-columns: 1fr;
    }

    /* ── Float Label ── */
    .float-group {
        position: relative;
    }

        .float-group .form-control {
            padding: 24px 14px 8px;
        }

    .float-label {
        position: absolute;
        left: 14px;
        top: 50%;
        transform: translateY(-50%);
        font-family: var(--font-b);
        font-size: 13px;
        font-weight: 500;
        color: var(--text3);
        pointer-events: none;
        transition: top .2s, transform .2s, font-size .2s, color .2s, letter-spacing .2s;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        max-width: calc(100% - 28px);
    }

    .float-group .form-control:focus ~ .float-label,
    .float-group.has-value .float-label {
        top: 8px;
        transform: none;
        font-size: 9px;
        font-family: var(--font-m);
        color: var(--primary);
        letter-spacing: 1.2px;
        text-transform: uppercase;
        font-weight: 600;
    }

    .float-group .form-control::placeholder {
        color: transparent;
    }

    /* ── Form Control ── */
    .form-control {
        border: 1px solid var(--border2);
        border-radius: var(--r);
        padding: 10px 14px;
        font-size: 13.5px;
        font-family: var(--font-b);
        color: var(--text) !important;
        background: var(--surface);
        transition: border-color .2s, box-shadow .2s, background .2s;
        outline: none;
        width: 100%;
        -webkit-text-fill-color: var(--text) !important;
        caret-color: var(--primary);
        box-shadow: inset 0 1px 3px rgba(0,0,0,.15);
    }

        .form-control:focus {
            border-color: var(--primary);
            box-shadow: 0 0 0 3px rgba(201,162,39,.12), inset 0 1px 3px rgba(0,0,0,.1);
            background: var(--surface2);
        }

        .form-control::placeholder {
            color: var(--text3);
            -webkit-text-fill-color: var(--text3);
        }

        .form-control:-webkit-autofill,
        .form-control:-webkit-autofill:hover,
        .form-control:-webkit-autofill:focus {
            -webkit-text-fill-color: var(--text) !important;
            -webkit-box-shadow: 0 0 0px 1000px var(--surface) inset !important;
            transition: background-color 5000s ease-in-out 0s;
        }

    /* ── Status / Checkbox ── */
    .status-meta {
        font-family: var(--font-m);
        font-size: 9.5px;
        color: var(--text3);
        letter-spacing: 1.2px;
        text-transform: uppercase;
        margin-bottom: 8px;
    }

    .check-group {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 11px 16px;
        background: var(--surface);
        border-radius: var(--r);
        border: 1px solid var(--border2);
        cursor: pointer;
        transition: all .25s;
        width: fit-content;
    }

        .check-group:hover {
            border-color: var(--primary);
            background: var(--primary-g);
        }

    .check-input {
        width: 17px;
        height: 17px;
        cursor: pointer;
        accent-color: var(--primary);
    }

    .check-label {
        font-size: 13px;
        font-weight: 600;
        color: var(--text2);
        cursor: pointer;
        font-family: var(--font-b);
        transition: color .2s;
    }

    .check-group:hover .check-label {
        color: var(--text);
    }

    /* ── Buttons ── */
    .btn-row {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
        padding-top: 20px;
        border-top: 1px solid var(--border);
        margin-top: 6px;
    }

    .btn-pro {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 10px 22px;
        font-family: var(--font-b);
        font-size: 13px;
        font-weight: 700;
        border-radius: var(--r);
        border: none;
        cursor: pointer;
        transition: all .25s ease;
        letter-spacing: .2px;
    }

    .btn-save {
        background: linear-gradient(135deg, var(--primary) 0%, var(--primary2) 100%);
        color: var(--bg);
        box-shadow: var(--primary-sh);
    }

        .btn-save:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 30px rgba(201,162,39,.4);
        }

        .btn-save:active {
            transform: translateY(0);
        }

    .btn-cancel {
        background: var(--surface2);
        color: var(--text2);
        border: 1px solid var(--border2);
    }

        .btn-cancel:hover {
            background: var(--surface3);
            color: var(--text);
        }

    /* ── Grid Card ── */
    .grid-card {
        background: var(--glass);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border-radius: var(--r3);
        border: 1px solid var(--glass-border);
        box-shadow: var(--sh2);
        overflow: hidden;
        animation: fadeUp .4s ease both;
    }

    .grid-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 14px 22px;
        background: linear-gradient(180deg, rgba(148,163,194,.04), transparent);
        border-bottom: 1px solid var(--border2);
    }

    .grid-header-left {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .grid-header-title {
        font-family: var(--font-m);
        font-size: 10.5px;
        font-weight: 500;
        color: var(--text2);
        text-transform: uppercase;
        letter-spacing: 1.5px;
    }

    .grid-badge {
        background: var(--primary-g);
        color: var(--primary);
        font-family: var(--font-m);
        font-size: 10px;
        font-weight: 600;
        padding: 4px 12px;
        border-radius: 20px;
        border: 1px solid rgba(201,162,39,.25);
    }

    .grid-scroll {
        height: 58vh;
        overflow-y: auto;
        scrollbar-width: thin;
        scrollbar-color: var(--surface3) transparent;
        padding: 0;
    }

        .grid-scroll::-webkit-scrollbar {
            width: 4px;
        }

        .grid-scroll::-webkit-scrollbar-thumb {
            background: var(--surface3);
            border-radius: 10px;
        }

    /* ── Table ── */
    .pro-table {
        width: 100%;
        border-collapse: collapse;
    }

        .pro-table thead th {
            background: var(--surface2);
            color: var(--text3);
            padding: 11px 16px;
            font-size: 9.5px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            white-space: nowrap;
            font-family: var(--font-m);
            position: sticky;
            top: 0;
            z-index: 10;
            border-bottom: 1px solid var(--border2);
            border-right: 1px solid var(--border);
        }

            .pro-table thead th:last-child {
                border-right: none;
            }

        .pro-table tbody tr {
            border-bottom: 1px solid var(--border);
            transition: background .15s;
        }

            .pro-table tbody tr:hover {
                background: rgba(201,162,39,.04);
            }

            .pro-table tbody tr:last-child {
                border-bottom: none;
            }

        .pro-table tbody td {
            padding: 11px 16px;
            font-size: 12.5px;
            color: var(--text2);
            white-space: nowrap;
        }

    /* ── Table Buttons ── */
    .tbl-btn {
        width: 30px;
        height: 30px;
        border-radius: 8px;
        border: 1px solid transparent;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 11px;
        transition: all .2s;
    }

    .tbl-btn-edit {
        background: var(--surface2);
        color: var(--text2);
        border-color: var(--border2);
    }

        .tbl-btn-edit:hover {
            background: var(--primary);
            color: var(--bg);
            border-color: var(--primary);
            box-shadow: 0 2px 10px rgba(201,162,39,.3);
        }

    .tbl-btn-del {
        background: var(--danger-g);
        color: #f87171;
        border-color: rgba(239,68,68,.2);
        margin-left: 4px;
    }

        .tbl-btn-del:hover {
            background: var(--danger);
            color: #fff;
            border-color: var(--danger);
            box-shadow: 0 2px 10px rgba(239,68,68,.3);
        }

    /* ── Badges ── */
    .badge-active {
        background: var(--success-g);
        color: #4ade80;
        border: 1px solid rgba(34,197,94,.25);
        font-size: 10px;
        font-weight: 600;
        padding: 3px 11px;
        border-radius: 20px;
        font-family: var(--font-m);
        display: inline-block;
    }

    .badge-inactive {
        background: var(--danger-g);
        color: #f87171;
        border: 1px solid rgba(239,68,68,.2);
        font-size: 10px;
        font-weight: 600;
        padding: 3px 11px;
        border-radius: 20px;
        font-family: var(--font-m);
        display: inline-block;
    }

    /* ── Empty State ── */
    .empty-state {
        padding: 60px 20px;
        text-align: center;
    }

    .empty-icon {
        width: 56px;
        height: 56px;
        background: var(--surface2);
        border-radius: var(--r2);
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--text3);
        font-size: 22px;
        margin: 0 auto 14px;
        border: 1px solid var(--border2);
    }

    .empty-text {
        font-size: 13px;
        color: var(--text3);
    }

    /* ── Footer ── */
    .page-footer {
        margin-top: 18px;
        padding-top: 14px;
        border-top: 1px solid var(--border);
        text-align: center;
        font-family: var(--font-m);
        font-size: 10px;
        color: var(--text3);
        letter-spacing: .5px;
    }

        .page-footer strong {
            background: linear-gradient(135deg, var(--primary), #e0c04a);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            font-weight: 700;
        }

    @@keyframes fadeUp {
        from {
            opacity: 0;
            transform: translateY(12px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* ── SweetAlert Dark Theme Override ── */
    .swal2-popup {
        background: var(--surface) !important;
        color: var(--text) !important;
        border: 1px solid var(--border2) !important;
        border-radius: var(--r3) !important;
    }

    .swal2-title {
        color: var(--text) !important;
        font-family: var(--font-b) !important;
    }

    .swal2-html-container {
        color: var(--text2) !important;
        font-family: var(--font-b) !important;
    }
</style>

<div class="vr-wrap">
    <div class="vr-bg-grid"></div>
    <div class="vr-orb vr-orb-1"></div>
    <div class="vr-orb vr-orb-2"></div>
    <div class="vr-inner">

        <!-- Top Bar -->
        <div class="top-bar">
            <div class="top-bar-left">
                <div class="icon-box"><i class="fas fa-th-large"></i></div>
                <div>
                    <div class="page-title">Category <span>Registry</span></div>
                    <div class="breadcrumb">
                        Setup <i class="fas fa-chevron-right"></i> <span>Category</span>
                    </div>
                </div>
            </div>
            <div style="display:flex;align-items:center;gap:10px;">
                <div class="toggle-group">
                    <button class="toggle-btn toggle-btn-outline" id="gridViewToggleBtn">
                        <i class="fas fa-table-cells"></i> Grid
                    </button>
                    <button class="toggle-btn toggle-btn-solid" id="formViewToggleBtn" style="display:none;">
                        <i class="fas fa-pen-to-square"></i> Form
                    </button>
                </div>
            </div>
        </div>

        <div class="accent-line"><span></span><span></span><span></span></div>

        <!-- FORM VIEW -->
        <div id="formViewContainer">
            <div class="form-card">
                <div class="form-card-header">
                    <div class="form-card-header-left">
                        <div class="header-dots">
                            <div class="h-dot h-dot-1"></div>
                            <div class="h-dot h-dot-2"></div>
                            <div class="h-dot h-dot-3"></div>
                        </div>
                        <div class="form-card-title">category_registration.form</div>
                    </div>
                    <div class="pill pill-blue"><i class="fas fa-circle" style="font-size:6px;"></i> Live</div>
                </div>

                <div class="form-body">
                    <input style="display:none;" type="text" id="CategoryId">

                    <div class="section-label">
                        <div class="section-label-bar"></div>
                        <span class="section-label-text">Basic Details</span>
                    </div>

                    <div class="form-row form-row-1">
                        <div class="float-group">
                            <input type="text" id="Category" class="form-control" placeholder=" ">
                            <label class="float-label" for="Category">Category Name</label>
                        </div>
                    </div>

                    <div class="form-row form-row-1" style="margin-bottom:22px;">
                        <div>
                            <div class="status-meta">
                                <i class="fas fa-toggle-on" style="color:var(--primary);margin-right:5px;"></i>
                                Category Status
                            </div>
                            <div class="check-group">
                                <input type="checkbox" id="IsActive" class="check-input" checked>
                                <label class="check-label" for="IsActive">Mark as Active</label>
                            </div>
                        </div>
                    </div>

                    <div class="btn-row">
                        <button class="btn-pro btn-save" id="saveBtn">
                            <i class="fas fa-floppy-disk"></i> Save Category
                        </button>
                        <button class="btn-pro btn-cancel" id="cancelBtn">
                            <i class="fas fa-xmark"></i> Cancel
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- GRID VIEW -->
        <div id="gridViewContainer" style="display:none;">
            <div class="grid-card">
                <div class="grid-header">
                    <div class="grid-header-left">
                        <div class="header-dots">
                            <div class="h-dot h-dot-1"></div>
                            <div class="h-dot h-dot-2"></div>
                            <div class="h-dot h-dot-3"></div>
                        </div>
                        <div class="grid-header-title">All Categories</div>
                        <div class="grid-badge" id="TotalCategoriesCount">0 records</div>
                    </div>
                    <div class="pill pill-teal">
                        <i class="fas fa-circle-dot" style="font-size:7px;"></i> Live Data
                    </div>
                </div>
                <div class="grid-scroll">
                    <div id="CategoryGridContainer"></div>
                </div>
            </div>
        </div>

        <div class="page-footer">
            Developed with <span style="color:var(--danger);">&#9829;</span> by <strong>UT Designer</strong>
        </div>
    </div>
</div>

<script>
    let userId = localStorage.getItem("userId") || "", GridViewDataList = [], IsUpdate = false;

    const SW = {
        background: '#1a2332',
        color: '#e8ecf4',
        confirmButtonColor: '#c9a227',
        cancelButtonColor: '#263249'
    };

    function initFloatLabels() {
        document.querySelectorAll('.float-group').forEach(g => {
            const el = g.querySelector('input:not([type="checkbox"]):not([type="file"]):not([style*="display:none"]),textarea,select');
            if (!el) return;
            const chk = () => g.classList.toggle('has-value', el.value !== '');
            el.addEventListener('input', chk);
            el.addEventListener('change', chk);
            chk();
        });
    }

    function showFormView() {
        document.getElementById("formViewContainer").style.display = "block";
        document.getElementById("gridViewContainer").style.display = "none";
        document.getElementById("formViewToggleBtn").style.display = "none";
        document.getElementById("gridViewToggleBtn").style.display = "inline-flex";
        document.getElementById("Category").focus();
    }

    function showGridView() {
        document.getElementById("formViewContainer").style.display = "none";
        document.getElementById("gridViewContainer").style.display = "block";
        document.getElementById("gridViewToggleBtn").style.display = "none";
        document.getElementById("formViewToggleBtn").style.display = "inline-flex";
    }

    document.getElementById("gridViewToggleBtn").addEventListener("click", showGridView);
    document.getElementById("formViewToggleBtn").addEventListener("click", showFormView);

    window.addEventListener("load", async function () {
        initFloatLabels();
        await LoadCategoryRegistrationData();
        await LoadGridViewData();
    });

    async function LoadCategoryRegistrationData() {
        try {
            const r = await jQuery.ajax({
                type: 'POST',
                url: '@Url.Action("nLoadCategoryRegistrationData", "CategoryRegistration")',
                data: JSON.stringify({ Userid: userId }),
                contentType: 'application/json'
            });
            if (r.statusId !== 1) await Swal.fire({ icon: 'warning', title: 'Warning', text: r.message || 'Failed', ...SW });
        } catch {
            await Swal.fire({ icon: 'error', title: 'Error', text: 'Error loading data', ...SW });
        }
    }

    async function LoadGridViewData() {
        try {
            const r = await jQuery.ajax({
                type: 'POST',
                url: '@Url.Action("nLoadGridViewData", "CategoryRegistration")',
                data: JSON.stringify({ Userid: userId }),
                contentType: 'application/json'
            });
            if (r.statusId === 1) {
                GridViewDataList = r.GridViewDataList || [];
                RenderGridView();
            } else {
                await Swal.fire({ icon: 'warning', title: 'Warning', text: r.message || 'Failed', ...SW });
            }
        } catch {
            await Swal.fire({ icon: 'error', title: 'Error', text: 'Error loading grid', ...SW });
        }
    }

    function RenderGridView() {
        const c   = document.getElementById("CategoryGridContainer");
        const cnt = document.getElementById("TotalCategoriesCount");

        if (!GridViewDataList.length) {
            c.innerHTML = `<div class="empty-state">
                <div class="empty-icon"><i class="fas fa-folder-open"></i></div>
                <div class="empty-text">No categories found.</div>
            </div>`;
            cnt.textContent = "0 records";
            return;
        }

        const t  = document.createElement("table");
        t.className = "pro-table";
        t.innerHTML = `<thead><tr>
            <th>Actions</th>
            <th>ID</th>
            <th>Category Name</th>
            <th>Status</th>
        </tr></thead>`;

        const tb = document.createElement("tbody");
        GridViewDataList.forEach(item => {
            const tr = document.createElement("tr");
            tr.innerHTML = `
            <td>
                <button class="tbl-btn tbl-btn-edit" onclick="EditCategory(${item.CategoryId})" title="Edit">
                    <i class="fas fa-pen"></i>
                </button>
                <button class="tbl-btn tbl-btn-del" onclick="DeleteCategory(${item.CategoryId})" title="Delete">
                    <i class="fas fa-trash-can"></i>
                </button>
            </td>
            <td><span style="font-family:var(--font-m);font-size:11px;color:var(--text3);">#${item.CategoryId || ''}</span></td>
            <td style="font-weight:600;color:var(--text);">${item.Category || ''}</td>
            <td>${item['Is Active']
                ? '<span class="badge-active"><i class="fas fa-circle" style="font-size:6px;margin-right:4px;"></i>Active</span>'
                : '<span class="badge-inactive"><i class="fas fa-circle" style="font-size:6px;margin-right:4px;"></i>Inactive</span>'
            }</td>`;
            tb.appendChild(tr);
        });

        t.appendChild(tb);
        c.innerHTML = "";
        c.appendChild(t);
        cnt.textContent = `${tb.rows.length} records`;
    }

    function EditCategory(id) {
        const cat = GridViewDataList.find(c => parseInt(c.CategoryId) === parseInt(id));
        if (!cat) { Swal.fire({ icon: 'error', title: 'Error', text: 'Not found.', ...SW }); return; }

        document.getElementById("CategoryId").value = cat.CategoryId || '';
        document.getElementById("Category").value   = cat.Category   || '';
        document.getElementById("IsActive").checked = cat['Is Active'] === true || cat['Is Active'] === 1;

        IsUpdate = true;
        document.getElementById("saveBtn").innerHTML = '<i class="fas fa-floppy-disk"></i> Update Category';
        initFloatLabels();
        showFormView();
    }

    async function DeleteCategory(id) {
        const r = await Swal.fire({
            title: 'Confirm Delete', text: "Cannot be undone.",
            icon: 'warning', showCancelButton: true,
            confirmButtonText: 'Yes, delete', cancelButtonText: 'Cancel',
            confirmButtonColor: '#ef4444', ...SW
        });
        if (!r.isConfirmed) return;

        Swal.fire({ title: 'Please wait', text: 'Deleting...', allowOutsideClick: false, allowEscapeKey: false, didOpen: () => Swal.showLoading(), ...SW });

        try {
            const res = await jQuery.ajax({
                type: 'POST',
                url: '@Url.Action("nDeleteCategoryRegistrationData", "CategoryRegistration")',
                data: JSON.stringify({ Userid: userId, CategoryId: `${id}` }),
                contentType: 'application/json'
            });
            Swal.close();
            if (res.statusId === 1) {
                await Swal.fire({ icon: 'success', title: 'Deleted', text: res.message || 'Deleted.', ...SW });
                await LoadGridViewData();
            } else {
                await Swal.fire({ icon: 'warning', title: 'Failed', text: res.message || 'Could not delete.', ...SW });
            }
        } catch {
            Swal.close();
            await Swal.fire({ icon: 'error', title: 'Error', text: 'An error occurred.', ...SW });
        }
    }

    document.getElementById("saveBtn").addEventListener("click", async function () {
        const CategoryId = document.getElementById("CategoryId").value.trim();
        const Category   = document.getElementById("Category").value.trim();
        const isActive   = document.getElementById("IsActive").checked;

        if (!Category) {
            await Swal.fire({
                icon: 'warning', title: 'Validation', text: 'Category name is required',
                returnFocus: false, ...SW,
                didClose: () => document.getElementById("Category").focus()
            });
            return;
        }

        Swal.fire({ title: 'Please wait', text: 'Saving...', allowOutsideClick: false, allowEscapeKey: false, didOpen: () => Swal.showLoading(), ...SW });

        try {
            const res = await jQuery.ajax({
                type: 'POST',
                url: '@Url.Action("nSaveCategoryRegistrationData", "CategoryRegistration")',
                data: JSON.stringify({ Userid: userId, CategoryId, Category, IsActive: isActive, IsUpdate }),
                contentType: 'application/json'
            });
            Swal.close();
            if (res.statusId === 1) {
                await Swal.fire({
                    icon: 'success', title: 'Saved', text: res.message || 'Saved.',
                    returnFocus: false, ...SW,
                    didClose: () => document.getElementById("Category").focus()
                });
                nClearForm();
            } else {
                await Swal.fire({ icon: 'warning', title: 'Failed', text: res.message || 'Could not save.', ...SW });
            }
        } catch {
            Swal.close();
            await Swal.fire({ icon: 'error', title: 'Error', text: 'An error occurred.', ...SW });
        }
    });

    document.getElementById("cancelBtn").addEventListener("click", function () { nClearForm(); });

    async function nClearForm() {
        document.getElementById("CategoryId").value = "";
        document.getElementById("Category").value   = "";
        document.getElementById("IsActive").checked = true;
        IsUpdate = false;
        document.getElementById("saveBtn").innerHTML = '<i class="fas fa-floppy-disk"></i> Save Category';
        initFloatLabels();
        document.getElementById("Category").focus();
        await LoadGridViewData();
    }
</script>
