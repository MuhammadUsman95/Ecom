@page "/Category"
@model NormalAccountProject.Pages.CategoryModel
@{
    ViewData["Title"] = "Category Registration";
}

<link href="https://fonts.googleapis.com/css2?family=Syne:wght@700;800&family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,600;0,700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
    :root {
        --bg: #1a2030;
        --bg2: #151c2b;
        --surface: #252d3e;
        --surface2: #1e2535;
        --surface3: #2a3347;
        --border: rgba(255,255,255,.06);
        --border2: rgba(255,255,255,.10);
        --accent: #4f7cff;
        --accent-dim: rgba(79,124,255,.14);
        --accent-glow: rgba(79,124,255,.28);
        --active-nav: #2e4275;
        --text: #e4eaf5;
        --text2: #8d9bb5;
        --text3: #4a5878;
        --danger: #f43f5e;
        --success: #22c55e;
        --font-head: 'Syne',sans-serif;
        --font-body: 'Plus Jakarta Sans',sans-serif;
        --font-mono: 'JetBrains Mono',monospace;
        --shadow: 0 8px 32px rgba(0,0,0,.45);
        --r: 8px;
        --rl: 14px;
    }

    *, *::before, *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    .vr-wrap {
        font-family: var(--font-body);
        color: var(--text);
        background: var(--bg);
        min-height: calc(100vh - 60px);
    }

    .vr-inner {
        padding: 22px 26px;
    }

    .top-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 22px;
        padding-bottom: 18px;
        border-bottom: 1px solid var(--border2);
    }

    .top-bar-left {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .icon-box {
        width: 42px;
        height: 42px;
        background: var(--active-nav);
        border: 1px solid rgba(79,124,255,.28);
        border-radius: var(--r);
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--accent);
        font-size: 17px;
        box-shadow: 0 0 18px rgba(79,124,255,.18);
    }

    .page-title {
        font-family: var(--font-head);
        font-size: 20px;
        font-weight: 800;
        color: var(--text);
    }

        .page-title span {
            color: var(--accent);
        }

    .breadcrumb {
        display: flex;
        align-items: center;
        gap: 5px;
        font-family: var(--font-mono);
        font-size: 10.5px;
        color: var(--text3);
        margin-top: 3px;
    }

        .breadcrumb i {
            font-size: 7px;
        }

        .breadcrumb span {
            color: var(--accent);
        }

    .toggle-group {
        display: flex;
        gap: 5px;
        background: var(--surface2);
        padding: 5px;
        border-radius: var(--r);
        border: 1px solid var(--border2);
    }

    .toggle-btn {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 8px 16px;
        font-family: var(--font-body);
        font-size: 12.5px;
        font-weight: 600;
        border-radius: 6px;
        border: none;
        cursor: pointer;
        transition: all .2s ease;
    }

    .toggle-btn-outline {
        background: transparent;
        color: var(--text2);
    }

        .toggle-btn-outline:hover {
            background: var(--surface3);
            color: var(--accent);
        }

    .toggle-btn-solid {
        background: var(--active-nav);
        color: #c5d4ff;
        font-weight: 700;
        border: 1px solid rgba(79,124,255,.3);
    }

        .toggle-btn-solid:hover {
            background: #354e8a;
            transform: translateY(-1px);
        }

    .form-card {
        background: var(--surface);
        border-radius: var(--rl);
        border: 1px solid var(--border2);
        box-shadow: var(--shadow);
        overflow: hidden;
        animation: fadeUp .28s ease both;
    }

    .form-card-header {
        padding: 13px 22px;
        background: var(--surface2);
        border-bottom: 1px solid var(--border);
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .header-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: var(--accent);
        box-shadow: 0 0 8px var(--accent-glow);
    }

    .form-card-title {
        font-family: var(--font-mono);
        font-size: 10.5px;
        font-weight: 500;
        color: var(--text2);
        letter-spacing: 1.5px;
        text-transform: uppercase;
    }

    .form-body {
        padding: 22px 24px;
        max-height: 65vh;
        overflow-y: auto;
        scrollbar-width: thin;
        scrollbar-color: var(--surface3) transparent;
    }

        .form-body::-webkit-scrollbar {
            width: 4px;
        }

        .form-body::-webkit-scrollbar-thumb {
            background: var(--surface3);
            border-radius: 10px;
        }

    .section-label {
        display: flex;
        align-items: center;
        gap: 8px;
        font-family: var(--font-mono);
        font-size: 9.5px;
        color: var(--accent);
        letter-spacing: 2px;
        text-transform: uppercase;
        margin-bottom: 18px;
        padding-bottom: 10px;
        border-bottom: 1px solid var(--border);
    }

        .section-label::before {
            content: '';
            width: 3px;
            height: 13px;
            background: var(--accent);
            border-radius: 3px;
            box-shadow: 0 0 7px var(--accent-glow);
            flex-shrink: 0;
        }

    .form-row {
        display: grid;
        gap: 14px;
        margin-bottom: 18px;
    }

    .form-row-1 {
        grid-template-columns: 1fr;
    }

    /* ── Floating Label ── */
    .float-group {
        position: relative;
    }

        .float-group .form-control {
            padding: 22px 13px 7px;
        }

    .float-label {
        position: absolute;
        left: 13px;
        top: 50%;
        transform: translateY(-50%);
        font-family: var(--font-body);
        font-size: 13.5px;
        font-weight: 500;
        color: var(--text3);
        pointer-events: none;
        transition: top .18s,transform .18s,font-size .18s,color .18s,letter-spacing .18s;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        max-width: calc(100% - 26px);
    }

    .float-group .form-control:focus ~ .float-label, .float-group.has-value .float-label {
        top: 7px;
        transform: none;
        font-size: 9px;
        font-family: var(--font-mono);
        color: var(--accent);
        letter-spacing: 1px;
        text-transform: uppercase;
        font-weight: 500;
    }

    .form-control {
        border: 1.5px solid var(--border2);
        border-radius: var(--r);
        font-size: 13.5px;
        font-family: var(--font-body);
        color: var(--text);
        background: var(--surface2);
        transition: border-color .18s,box-shadow .18s;
        outline: none;
        width: 100%;
    }

        .form-control:focus {
            border-color: rgba(255,255,255,.7);
            box-shadow: 0 0 0 3px rgba(255,255,255,.08);
            background: rgba(255,255,255,.7);
        }

    .float-group .form-control::placeholder {
        color: transparent;
    }

    .status-meta {
        font-family: var(--font-mono);
        font-size: 9.5px;
        color: var(--text3);
        letter-spacing: 1px;
        text-transform: uppercase;
        margin-bottom: 7px;
    }

    .check-group {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 10px 15px;
        background: var(--active-nav);
        border-radius: var(--r);
        border: 1px solid rgba(79,124,255,.3);
        cursor: pointer;
        transition: background .2s;
        width: fit-content;
    }

        .check-group:hover {
            background: #354e8a;
        }

    .check-input {
        width: 16px;
        height: 16px;
        cursor: pointer;
        accent-color: var(--accent);
    }

    .check-label {
        font-size: 13px;
        font-weight: 600;
        color: #a0b8ff;
        cursor: pointer;
        font-family: var(--font-body);
    }

    .btn-row {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
        padding-top: 18px;
        border-top: 1px solid var(--border);
        margin-top: 4px;
    }

    .btn-pro {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 9px 22px;
        font-family: var(--font-body);
        font-size: 13px;
        font-weight: 700;
        border-radius: var(--r);
        border: none;
        cursor: pointer;
        transition: all .2s ease;
        letter-spacing: .2px;
    }

    .btn-save {
        background: var(--active-nav);
        color: #c5d4ff;
        border: 1px solid rgba(79,124,255,.35);
        box-shadow: 0 2px 14px rgba(46,66,117,.5);
    }

        .btn-save:hover {
            background: #354e8a;
            transform: translateY(-1px);
        }

    .btn-cancel {
        background: var(--surface3);
        color: var(--text2);
        border: 1px solid var(--border2);
    }

        .btn-cancel:hover {
            background: var(--surface2);
            color: var(--text);
        }

    .grid-card {
        background: var(--surface);
        border-radius: var(--rl);
        border: 1px solid var(--border2);
        box-shadow: var(--shadow);
        overflow: hidden;
        animation: fadeUp .28s ease both;
    }

    .grid-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 14px 20px;
        background: var(--surface2);
        border-bottom: 1px solid var(--border);
    }

    .grid-header-left {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .grid-header-title {
        font-family: var(--font-mono);
        font-size: 10.5px;
        font-weight: 500;
        color: var(--text2);
        text-transform: uppercase;
        letter-spacing: 1.5px;
    }

    .grid-badge {
        background: var(--active-nav);
        color: #a0b8ff;
        font-family: var(--font-mono);
        font-size: 10.5px;
        padding: 3px 10px;
        border-radius: 20px;
        border: 1px solid rgba(79,124,255,.25);
    }

    .grid-scroll {
        height: 57vh;
        overflow-y: auto;
        scrollbar-width: thin;
        scrollbar-color: var(--surface3) transparent;
    }

        .grid-scroll::-webkit-scrollbar {
            width: 4px;
        }

        .grid-scroll::-webkit-scrollbar-thumb {
            background: var(--surface3);
            border-radius: 10px;
        }

    .pro-table {
        width: 100%;
        border-collapse: collapse;
    }

        .pro-table thead th {
            background: var(--bg2);
            color: var(--text3);
            padding: 11px 15px;
            font-size: 9.5px;
            font-weight: 500;
            text-transform: uppercase;
            letter-spacing: 1.2px;
            white-space: nowrap;
            font-family: var(--font-mono);
            position: sticky;
            top: 0;
            z-index: 10;
            border-bottom: 1px solid var(--border);
            border-right: 1px solid var(--border);
        }

            .pro-table thead th:last-child {
                border-right: none;
            }

        .pro-table tbody tr {
            border-bottom: 1px solid var(--border);
            transition: background .12s;
        }

            .pro-table tbody tr:hover {
                background: var(--surface2);
            }

        .pro-table tbody td {
            padding: 11px 15px;
            font-size: 13px;
            color: var(--text2);
            font-family: var(--font-body);
        }

    .tbl-btn {
        width: 29px;
        height: 29px;
        border-radius: 7px;
        border: 1px solid transparent;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 11px;
        transition: all .15s;
    }

    .tbl-btn-edit {
        background: var(--active-nav);
        color: #a0b8ff;
        border-color: rgba(79,124,255,.2);
    }

        .tbl-btn-edit:hover {
            background: var(--accent);
            color: #fff;
        }

    .tbl-btn-del {
        background: rgba(244,63,94,.1);
        color: var(--danger);
        border-color: rgba(244,63,94,.2);
        margin-left: 5px;
    }

        .tbl-btn-del:hover {
            background: var(--danger);
            color: #fff;
        }

    .badge-active {
        background: rgba(34,197,94,.1);
        color: var(--success);
        border: 1px solid rgba(34,197,94,.2);
        font-size: 10.5px;
        font-weight: 600;
        padding: 3px 10px;
        border-radius: 20px;
        font-family: var(--font-mono);
        display: inline-block;
    }

    .badge-inactive {
        background: rgba(244,63,94,.1);
        color: var(--danger);
        border: 1px solid rgba(244,63,94,.2);
        font-size: 10.5px;
        font-weight: 600;
        padding: 3px 10px;
        border-radius: 20px;
        font-family: var(--font-mono);
        display: inline-block;
    }

    .empty-state {
        padding: 60px 20px;
        text-align: center;
    }

    .empty-icon {
        width: 52px;
        height: 52px;
        background: var(--surface3);
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--text3);
        font-size: 20px;
        margin: 0 auto 12px;
        border: 1px solid var(--border2);
    }

    .empty-text {
        font-size: 13.5px;
        color: var(--text3);
        font-family: var(--font-body);
    }

    .page-footer {
        margin-top: 18px;
        padding-top: 14px;
        border-top: 1px solid var(--border);
        text-align: center;
        font-family: var(--font-mono);
        font-size: 10.5px;
        color: var(--text3);
        letter-spacing: .5px;
    }

        .page-footer strong {
            color: var(--accent);
            font-weight: 500;
        }
    @@keyframes fadeUp {
        from

    {
        opacity: 0;
        transform: translateY(10px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

    }
</style>

<div class="vr-wrap">
    <div class="vr-inner">
        <div class="top-bar">
            <div class="top-bar-left">
                <div class="icon-box"><i class="fas fa-th-large"></i></div>
                <div>
                    <div class="page-title">Category <span>Registration</span></div>
                    <div class="breadcrumb">Setup <i class="fas fa-chevron-right"></i> <span>Category</span></div>
                </div>
            </div>
            <div class="toggle-group">
                <button class="toggle-btn toggle-btn-outline" id="gridViewToggleBtn"><i class="fas fa-table-cells"></i> Grid View</button>
                <button class="toggle-btn toggle-btn-solid" id="formViewToggleBtn" style="display:none;"><i class="fas fa-pen-to-square"></i> Form View</button>
            </div>
        </div>

        <div id="formViewContainer">
            <div class="form-card">
                <div class="form-card-header"><div class="header-dot"></div><div class="form-card-title">Category Information</div></div>
                <div class="form-body">
                    <input style="display:none;" type="text" id="CategoryId">
                    <div class="section-label">Basic Details</div>
                    <div class="form-row form-row-1">
                        <div class="float-group">
                            <input type="text" id="Category" class="form-control" placeholder=" ">
                            <label class="float-label" for="Category">Category Name</label>
                        </div>
                    </div>
                    <div class="form-row form-row-1" style="margin-bottom:20px;">
                        <div>
                            <div class="status-meta">Status</div>
                            <div class="check-group">
                                <input type="checkbox" id="IsActive" class="check-input" checked>
                                <label class="check-label" for="IsActive">Mark as Active</label>
                            </div>
                        </div>
                    </div>
                    <div class="btn-row">
                        <button class="btn-pro btn-save" id="saveBtn"><i class="fas fa-floppy-disk"></i> Save Category</button>
                        <button class="btn-pro btn-cancel" id="cancelBtn"><i class="fas fa-xmark"></i> Cancel</button>
                    </div>
                </div>
            </div>
        </div>

        <div id="gridViewContainer" style="display:none;">
            <div class="grid-card">
                <div class="grid-header">
                    <div class="grid-header-left"><div class="grid-header-title">All Categories</div><div class="grid-badge" id="TotalCategoriesCount">0 records</div></div>
                </div>
                <div class="grid-scroll"><div id="CategoryGridContainer"></div></div>
            </div>
        </div>
        <div class="page-footer">Software Developed By: <strong>UT Designer</strong></div>
    </div>
</div>

<script>
    let userId=localStorage.getItem("userId")||"",GridViewDataList=[],IsUpdate=false;
    const SW={background:'#252d3e',color:'#e4eaf5'};
    function initFloatLabels(){document.querySelectorAll('.float-group').forEach(g=>{const el=g.querySelector('input:not([type="checkbox"]):not([type="file"]):not([style*="display:none"]),textarea,select');if(!el)return;const chk=()=>g.classList.toggle('has-value',el.value!=='');el.addEventListener('input',chk);el.addEventListener('change',chk);chk();});}
    function showFormView(){document.getElementById("formViewContainer").style.display="block";document.getElementById("gridViewContainer").style.display="none";document.getElementById("formViewToggleBtn").style.display="none";document.getElementById("gridViewToggleBtn").style.display="inline-flex";document.getElementById("Category").focus();}
    function showGridView(){document.getElementById("formViewContainer").style.display="none";document.getElementById("gridViewContainer").style.display="block";document.getElementById("gridViewToggleBtn").style.display="none";document.getElementById("formViewToggleBtn").style.display="inline-flex";}
    document.getElementById("gridViewToggleBtn").addEventListener("click",showGridView);
    document.getElementById("formViewToggleBtn").addEventListener("click",showFormView);
    window.addEventListener("load",async function(){initFloatLabels();await LoadCategoryRegistrationData();await LoadGridViewData();});
    async function LoadCategoryRegistrationData(){try{const r=await jQuery.ajax({type:'POST',url:'@Url.Action("nLoadCategoryRegistrationData", "CategoryRegistration")',data:JSON.stringify({Userid:userId}),contentType:'application/json'});if(r.statusId!==1)await Swal.fire({icon:'warning',title:'Warning',text:r.message||'Failed',...SW});}catch{await Swal.fire({icon:'error',title:'Error',text:'Error loading data',...SW});}}
    async function LoadGridViewData(){try{const r=await jQuery.ajax({type:'POST',url:'@Url.Action("nLoadGridViewData", "CategoryRegistration")',data:JSON.stringify({Userid:userId}),contentType:'application/json'});if(r.statusId===1){GridViewDataList=r.GridViewDataList||[];RenderGridView();}else await Swal.fire({icon:'warning',title:'Warning',text:r.message||'Failed',...SW});}catch{await Swal.fire({icon:'error',title:'Error',text:'Error loading grid',...SW});}}
    function RenderGridView(){const c=document.getElementById("CategoryGridContainer"),cnt=document.getElementById("TotalCategoriesCount");if(!GridViewDataList.length){c.innerHTML=`<div class="empty-state"><div class="empty-icon"><i class="fas fa-folder-open"></i></div><div class="empty-text">No categories found.</div></div>`;cnt.textContent="0 records";return;}const t=document.createElement("table");t.className="pro-table";t.innerHTML=`<thead><tr><th>Actions</th><th>ID</th><th>Category Name</th><th>Status</th></tr></thead>`;const tb=document.createElement("tbody");GridViewDataList.forEach(item=>{const tr=document.createElement("tr");tr.innerHTML=`<td><button class="tbl-btn tbl-btn-edit" onclick="EditCategory(${item.CategoryId})" title="Edit"><i class="fas fa-pen"></i></button><button class="tbl-btn tbl-btn-del" onclick="DeleteCategory(${item.CategoryId})" title="Delete"><i class="fas fa-trash-can"></i></button></td><td>${item.CategoryId||''}</td><td>${item.Category||''}</td><td>${item['Is Active']?'<span class="badge-active">Active</span>':'<span class="badge-inactive">Inactive</span>'}</td>`;tb.appendChild(tr);});t.appendChild(tb);c.innerHTML="";c.appendChild(t);cnt.textContent=`${tb.rows.length} records`;}
    function EditCategory(id){const cat=GridViewDataList.find(c=>parseInt(c.CategoryId)===parseInt(id));if(!cat){Swal.fire({icon:'error',title:'Error',text:'Not found.',...SW});return;}document.getElementById("CategoryId").value=cat.CategoryId||'';document.getElementById("Category").value=cat.Category||'';document.getElementById("IsActive").checked=cat['Is Active']===true||cat['Is Active']===1;IsUpdate=true;document.getElementById("saveBtn").innerHTML='<i class="fas fa-floppy-disk"></i> Update Category';initFloatLabels();showFormView();}
    async function DeleteCategory(id){const r=await Swal.fire({title:'Confirm Delete',text:"Cannot be undone.",icon:'warning',showCancelButton:true,confirmButtonText:'Yes, delete',cancelButtonText:'Cancel',confirmButtonColor:'#f43f5e',...SW});if(!r.isConfirmed)return;Swal.fire({title:'Please wait',text:'Deleting...',allowOutsideClick:false,allowEscapeKey:false,didOpen:()=>Swal.showLoading(),...SW});try{const res=await jQuery.ajax({type:'POST',url:'@Url.Action("nDeleteCategoryRegistrationData", "CategoryRegistration")',data:JSON.stringify({Userid:userId,CategoryId:`${id}`}),contentType:'application/json'});Swal.close();if(res.statusId===1){await Swal.fire({icon:'success',title:'Deleted',text:res.message||'Deleted.',...SW});await LoadGridViewData();}else await Swal.fire({icon:'warning',title:'Failed',text:res.message||'Could not delete.',...SW});}catch{Swal.close();await Swal.fire({icon:'error',title:'Error',text:'An error occurred.',...SW});}}
    document.getElementById("saveBtn").addEventListener("click",async function(){const CategoryId=document.getElementById("CategoryId").value.trim(),Category=document.getElementById("Category").value.trim(),isActive=document.getElementById("IsActive").checked;if(!Category){await Swal.fire({icon:'warning',title:'Validation',text:'Category name is required',returnFocus:false,...SW,didClose:()=>document.getElementById("Category").focus()});return;}Swal.fire({title:'Please wait',text:'Saving...',allowOutsideClick:false,allowEscapeKey:false,didOpen:()=>Swal.showLoading(),...SW});try{const res=await jQuery.ajax({type:'POST',url:'@Url.Action("nSaveCategoryRegistrationData", "CategoryRegistration")',data:JSON.stringify({Userid:userId,CategoryId,Category,IsActive:isActive,IsUpdate}),contentType:'application/json'});Swal.close();if(res.statusId===1){await Swal.fire({icon:'success',title:'Saved',text:res.message||'Saved.',returnFocus:false,...SW,didClose:()=>document.getElementById("Category").focus()});nClearForm();}else await Swal.fire({icon:'warning',title:'Failed',text:res.message||'Could not save.',...SW});}catch{Swal.close();await Swal.fire({icon:'error',title:'Error',text:'An error occurred.',...SW});}});
    document.getElementById("cancelBtn").addEventListener("click",function(){nClearForm();});
    async function nClearForm(){document.getElementById("CategoryId").value="";document.getElementById("Category").value="";document.getElementById("IsActive").checked=true;IsUpdate=false;document.getElementById("saveBtn").innerHTML='<i class="fas fa-floppy-disk"></i> Save Category';initFloatLabels();document.getElementById("Category").focus();await LoadGridViewData();}
</script>
