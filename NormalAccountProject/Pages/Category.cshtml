    @page "/Category"
    @model NormalAccountProject.Pages.CategoryModel
    @{
        ViewData["Title"] = "Category Registration";
    }

    <link href="https://fonts.googleapis.com/css2?family=Syne:wght@600;700;800&family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">

    <style>
        :root {
            --bg: #0a0c12;
            --bg2: #0f1220;
            --surface: #141828;
            --surface2: #1a2035;
            --surface3: #1f2640;
            --border: rgba(255,255,255,.06);
            --border2: rgba(255,255,255,.11);
            --border3: rgba(255,255,255,.18);
            --accent: #6c63ff;
            --accent2: #4f46e5;
            --accent-g: rgba(108,99,255,.15);
            --gold: #f0b429;
            --gold-g: rgba(240,180,41,.12);
            --teal: #14b8a6;
            --danger: #f43f5e;
            --success: #10b981;
            --text: #e8eaf2;
            --text2: #9198b0;
            --text3: #5a6182;
            --font-h: 'Syne', sans-serif;
            --font-b: 'Plus Jakarta Sans', sans-serif;
            --font-m: 'JetBrains Mono', monospace;
            --r: 10px;
            --r2: 14px;
            --r3: 18px;
            --sh: 0 4px 32px rgba(0,0,0,.45);
            --sh2: 0 8px 48px rgba(0,0,0,.6);
        }

        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        .vr-wrap {
            font-family: var(--font-b);
            color: var(--text);
            background: var(--bg);
            min-height: calc(100vh - 60px);
            position: relative;
            overflow: hidden;
        }

            .vr-wrap::before {
                content: '';
                position: fixed;
                top: -200px;
                right: -200px;
                width: 550px;
                height: 550px;
                background: radial-gradient(circle, rgba(108,99,255,.07) 0%, transparent 65%);
                pointer-events: none;
                z-index: 0;
            }

            .vr-wrap::after {
                content: '';
                position: fixed;
                bottom: -150px;
                left: -150px;
                width: 450px;
                height: 450px;
                background: radial-gradient(circle, rgba(20,184,166,.05) 0%, transparent 65%);
                pointer-events: none;
                z-index: 0;
            }

        .vr-bg-grid {
            position: fixed;
            inset: 0;
            z-index: 0;
            pointer-events: none;
            background-image: linear-gradient(rgba(255,255,255,.02) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.02) 1px, transparent 1px);
            background-size: 40px 40px;
        }

        .vr-inner {
            position: relative;
            z-index: 1;
            padding: 20px 24px;
        }

        .top-bar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 20px;
            padding-bottom: 16px;
            border-bottom: 1px solid var(--border2);
        }

        .top-bar-left {
            display: flex;
            align-items: center;
            gap: 14px;
        }

        .icon-box {
            width: 44px;
            height: 44px;
            background: linear-gradient(135deg, var(--accent) 0%, var(--accent2) 100%);
            border-radius: var(--r);
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            font-size: 17px;
            box-shadow: 0 4px 20px rgba(108,99,255,.4);
            flex-shrink: 0;
        }

        .page-title {
            font-family: var(--font-h);
            font-size: 21px;
            font-weight: 800;
            color: var(--text);
            letter-spacing: -.3px;
            line-height: 1.1;
        }

            .page-title span {
                color: var(--accent);
            }

        .breadcrumb {
            display: flex;
            align-items: center;
            gap: 5px;
            font-family: var(--font-m);
            font-size: 10px;
            color: var(--text3);
            letter-spacing: .5px;
            margin-top: 3px;
        }

            .breadcrumb i {
                font-size: 7px;
            }

            .breadcrumb span {
                color: var(--gold);
            }

        .pill {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 3px 10px;
            border-radius: 20px;
            font-family: var(--font-m);
            font-size: 10.5px;
            font-weight: 500;
            border: 1px solid transparent;
        }

        .pill-gold {
            background: var(--gold-g);
            color: var(--gold);
            border-color: rgba(240,180,41,.25);
        }

        .toggle-group {
            display: flex;
            gap: 4px;
            background: var(--surface2);
            padding: 4px;
            border-radius: var(--r);
            border: 1px solid var(--border2);
        }

        .toggle-btn {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            padding: 7px 15px;
            font-family: var(--font-b);
            font-size: 12px;
            font-weight: 600;
            border-radius: 7px;
            border: none;
            cursor: pointer;
            transition: all .2s ease;
        }

        .toggle-btn-outline {
            background: transparent;
            color: var(--text2);
        }

            .toggle-btn-outline:hover {
                background: var(--surface3);
                color: var(--text);
            }

        .toggle-btn-solid {
            background: var(--accent);
            color: #fff;
            box-shadow: 0 2px 12px rgba(108,99,255,.35);
        }

            .toggle-btn-solid:hover {
                background: var(--accent2);
                transform: translateY(-1px);
            }

        .accent-line {
            display: flex;
            gap: 2px;
            margin-bottom: 18px;
            height: 2px;
        }

            .accent-line span:nth-child(1) {
                flex: 2;
                background: var(--accent);
                border-radius: 2px;
            }

            .accent-line span:nth-child(2) {
                flex: 1;
                background: var(--teal);
                border-radius: 2px;
                opacity: .6;
            }

            .accent-line span:nth-child(3) {
                flex: 3;
                background: var(--border);
                border-radius: 2px;
            }

        .form-card {
            background: var(--surface);
            border-radius: var(--r3);
            border: 1px solid var(--border2);
            box-shadow: var(--sh2);
            overflow: hidden;
            animation: fadeUp .3s ease both;
            position: relative;
        }

        .form-card-header {
            padding: 12px 22px;
            background: linear-gradient(90deg, var(--surface2) 0%, rgba(108,99,255,.08) 100%);
            border-bottom: 1px solid var(--border2);
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .form-card-header-left {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .header-dots {
            display: flex;
            gap: 5px;
        }

        .h-dot {
            width: 7px;
            height: 7px;
            border-radius: 50%;
        }

        .h-dot-1 {
            background: #f43f5e;
        }

        .h-dot-2 {
            background: #f59e0b;
        }

        .h-dot-3 {
            background: #10b981;
        }

        .form-card-title {
            font-family: var(--font-m);
            font-size: 10.5px;
            font-weight: 500;
            color: var(--text3);
            letter-spacing: 1.5px;
            text-transform: uppercase;
        }

        .form-body {
            padding: 22px 24px;
            max-height: 65vh;
            overflow-y: auto;
            scrollbar-width: thin;
            scrollbar-color: var(--surface3) transparent;
        }

            .form-body::-webkit-scrollbar {
                width: 4px;
            }

            .form-body::-webkit-scrollbar-thumb {
                background: var(--surface3);
                border-radius: 10px;
            }

        .section-label {
            display: flex;
            align-items: center;
            gap: 9px;
            font-family: var(--font-m);
            font-size: 9.5px;
            color: var(--text3);
            letter-spacing: 2px;
            text-transform: uppercase;
            margin-bottom: 14px;
            padding-bottom: 10px;
            border-bottom: 1px solid var(--border);
            font-weight: 500;
        }

        .section-label-bar {
            width: 3px;
            height: 12px;
            background: linear-gradient(180deg, var(--accent), var(--teal));
            border-radius: 3px;
            flex-shrink: 0;
        }

        .section-label-text {
            color: var(--text2);
        }

        .form-row {
            display: grid;
            gap: 12px;
            margin-bottom: 14px;
        }

        .form-row-1 {
            grid-template-columns: 1fr;
        }

        .float-group {
            position: relative;
        }

            .float-group .form-control {
                padding: 22px 13px 7px;
            }

        .float-label {
            position: absolute;
            left: 13px;
            top: 50%;
            transform: translateY(-50%);
            font-family: var(--font-b);
            font-size: 13px;
            font-weight: 500;
            color: var(--text3);
            pointer-events: none;
            transition: top .18s, transform .18s, font-size .18s, color .18s, letter-spacing .18s;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            max-width: calc(100% - 26px);
        }

        .float-group .form-control:focus ~ .float-label, .float-group.has-value .float-label {
            top: 7px;
            transform: none;
            font-size: 9px;
            font-family: var(--font-m);
            color: var(--accent);
            letter-spacing: 1px;
            text-transform: uppercase;
            font-weight: 500;
        }

        .float-group .form-control::placeholder {
            color: transparent;
        }

        .form-control {
            border: 1px solid var(--border2);
            border-radius: var(--r);
            padding: 9px 13px;
            font-size: 13.5px;
            font-family: var(--font-b);
            color: #e8eaf2 !important;
            background: var(--bg2);
            transition: border-color .18s, box-shadow .18s, background .18s;
            outline: none;
            width: 100%;
            -webkit-text-fill-color: #e8eaf2 !important;
            caret-color: #6c63ff;
        }

            .form-control:focus {
                border-color: var(--accent);
                box-shadow: 0 0 0 3px rgba(108,99,255,.14);
                background: var(--surface);
                color: #e8eaf2 !important;
                -webkit-text-fill-color: #e8eaf2 !important;
            }

            .form-control::placeholder {
                color: var(--text3);
                -webkit-text-fill-color: var(--text3);
            }

            .form-control:-webkit-autofill, .form-control:-webkit-autofill:hover, .form-control:-webkit-autofill:focus {
                -webkit-text-fill-color: #e8eaf2 !important;
                -webkit-box-shadow: 0 0 0px 1000px var(--bg2) inset !important;
                transition: background-color 5000s ease-in-out 0s;
            }

        .status-meta {
            font-family: var(--font-m);
            font-size: 9.5px;
            color: var(--text3);
            letter-spacing: 1px;
            text-transform: uppercase;
            margin-bottom: 7px;
        }

        .check-group {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 10px 14px;
            background: var(--bg2);
            border-radius: var(--r);
            border: 1px solid var(--border2);
            cursor: pointer;
            transition: all .2s;
            width: fit-content;
        }

            .check-group:hover {
                border-color: var(--accent);
                background: var(--accent-g);
            }

        .check-input {
            width: 16px;
            height: 16px;
            cursor: pointer;
            accent-color: var(--accent);
        }

        .check-label {
            font-size: 13px;
            font-weight: 500;
            color: var(--text2);
            cursor: pointer;
            font-family: var(--font-b);
            transition: color .2s;
        }

        .check-group:hover .check-label {
            color: var(--text);
        }

        .btn-row {
            display: flex;
            align-items: center;
            gap: 8px;
            flex-wrap: wrap;
            padding-top: 18px;
            border-top: 1px solid var(--border);
            margin-top: 4px;
        }

        .btn-pro {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            padding: 9px 20px;
            font-family: var(--font-b);
            font-size: 13px;
            font-weight: 600;
            border-radius: var(--r);
            border: none;
            cursor: pointer;
            transition: all .2s ease;
        }

        .btn-save {
            background: linear-gradient(135deg, var(--accent) 0%, var(--accent2) 100%);
            color: #fff;
            box-shadow: 0 3px 16px rgba(108,99,255,.4);
        }

            .btn-save:hover {
                transform: translateY(-1px);
                box-shadow: 0 6px 24px rgba(108,99,255,.5);
            }

        .btn-cancel {
            background: var(--surface2);
            color: var(--text2);
            border: 1px solid var(--border2);
        }

            .btn-cancel:hover {
                background: var(--surface3);
                color: var(--text);
            }

        .grid-card {
            background: var(--surface);
            border-radius: var(--r3);
            border: 1px solid var(--border2);
            box-shadow: var(--sh2);
            overflow: hidden;
            animation: fadeUp .3s ease both;
        }

        .grid-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 13px 20px;
            background: linear-gradient(90deg, var(--surface2) 0%, rgba(108,99,255,.06) 100%);
            border-bottom: 1px solid var(--border2);
        }

        .grid-header-left {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .grid-header-title {
            font-family: var(--font-m);
            font-size: 10.5px;
            font-weight: 500;
            color: var(--text2);
            text-transform: uppercase;
            letter-spacing: 1.5px;
        }

        .grid-badge {
            background: var(--accent-g);
            color: #a09eff;
            font-family: var(--font-m);
            font-size: 10.5px;
            padding: 3px 10px;
            border-radius: 20px;
            border: 1px solid rgba(108,99,255,.22);
        }

        .pill-accent {
            background: var(--accent-g);
            color: #a09eff;
            border-color: rgba(108,99,255,.25);
        }

        .grid-scroll {
            height: 58vh;
            overflow-y: auto;
            scrollbar-width: thin;
            scrollbar-color: var(--surface3) transparent;
        }

            .grid-scroll::-webkit-scrollbar {
                width: 4px;
            }

            .grid-scroll::-webkit-scrollbar-thumb {
                background: var(--surface3);
                border-radius: 10px;
            }

        .pro-table {
            width: 100%;
            border-collapse: collapse;
        }

            .pro-table thead th {
                background: var(--surface2);
                color: var(--text3);
                padding: 10px 14px;
                font-size: 9.5px;
                font-weight: 500;
                text-transform: uppercase;
                letter-spacing: 1.2px;
                white-space: nowrap;
                font-family: var(--font-m);
                position: sticky;
                top: 0;
                z-index: 10;
                border-bottom: 1px solid var(--border2);
                border-right: 1px solid var(--border);
            }

                .pro-table thead th:last-child {
                    border-right: none;
                }

            .pro-table tbody tr {
                border-bottom: 1px solid var(--border);
                transition: background .12s;
            }

                .pro-table tbody tr:hover {
                    background: var(--surface2);
                }

                .pro-table tbody tr:last-child {
                    border-bottom: none;
                }

            .pro-table tbody td {
                padding: 10px 14px;
                font-size: 12.5px;
                color: var(--text2);
                white-space: nowrap;
            }

        .tbl-btn {
            width: 28px;
            height: 28px;
            border-radius: 7px;
            border: 1px solid transparent;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 11px;
            transition: all .15s;
        }

        .tbl-btn-edit {
            background: var(--surface2);
            color: var(--text2);
            border-color: var(--border2);
        }

            .tbl-btn-edit:hover {
                background: var(--accent);
                color: #fff;
                border-color: var(--accent);
            }

        .tbl-btn-del {
            background: rgba(244,63,94,.08);
            color: #fb7185;
            border-color: rgba(244,63,94,.18);
            margin-left: 4px;
        }

            .tbl-btn-del:hover {
                background: var(--danger);
                color: #fff;
                border-color: var(--danger);
            }

        .badge-active {
            background: rgba(16,185,129,.1);
            color: #34d399;
            border: 1px solid rgba(16,185,129,.22);
            font-size: 10px;
            font-weight: 600;
            padding: 3px 10px;
            border-radius: 20px;
            font-family: var(--font-m);
            display: inline-block;
        }

        .badge-inactive {
            background: rgba(244,63,94,.08);
            color: #fb7185;
            border: 1px solid rgba(244,63,94,.18);
            font-size: 10px;
            font-weight: 600;
            padding: 3px 10px;
            border-radius: 20px;
            font-family: var(--font-m);
            display: inline-block;
        }

        .empty-state {
            padding: 60px 20px;
            text-align: center;
        }

        .empty-icon {
            width: 54px;
            height: 54px;
            background: var(--surface2);
            border-radius: var(--r2);
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--text3);
            font-size: 20px;
            margin: 0 auto 14px;
            border: 1px solid var(--border2);
        }

        .empty-text {
            font-size: 13px;
            color: var(--text3);
        }

        .page-footer {
            margin-top: 16px;
            padding-top: 12px;
            border-top: 1px solid var(--border);
            text-align: center;
            font-family: var(--font-m);
            font-size: 10px;
            color: var(--text3);
            letter-spacing: .5px;
        }

            .page-footer strong {
                color: var(--accent);
                font-weight: 500;
            }

        @@keyframes fadeUp {
            from {
                opacity: 0;
                transform: translateY(10px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
    </style>

    <div class="vr-wrap">
        <div class="vr-bg-grid"></div>
        <div class="vr-inner">
            <div class="top-bar">
                <div class="top-bar-left">
                    <div class="icon-box"><i class="fas fa-th-large"></i></div>
                    <div>
                        <div class="page-title">Category <span>Registry</span></div>
                        <div class="breadcrumb">Setup <i class="fas fa-chevron-right"></i> <span>Category</span></div>
                    </div>
                </div>
                <div style="display:flex;align-items:center;gap:10px;">
                    <div class="toggle-group">
                        <button class="toggle-btn toggle-btn-outline" id="gridViewToggleBtn"><i class="fas fa-table-cells"></i> Grid</button>
                        <button class="toggle-btn toggle-btn-solid" id="formViewToggleBtn" style="display:none;"><i class="fas fa-pen-to-square"></i> Form</button>
                    </div>
                </div>
            </div>

            <div class="accent-line"><span></span><span></span><span></span></div>

            <div id="formViewContainer">
                <div class="form-card">
                    <div class="form-card-header">
                        <div class="form-card-header-left">
                            <div class="header-dots"><div class="h-dot h-dot-1"></div><div class="h-dot h-dot-2"></div><div class="h-dot h-dot-3"></div></div>
                            <div class="form-card-title">category_registration.form</div>
                        </div>
                        <div class="pill pill-gold"><i class="fas fa-circle" style="font-size:6px;"></i> Live</div>
                    </div>
                    <div class="form-body">
                        <input style="display:none;" type="text" id="CategoryId">
                        <div class="section-label"><div class="section-label-bar"></div><span class="section-label-text">Basic Details</span></div>
                        <div class="form-row form-row-1">
                            <div class="float-group">
                                <input type="text" id="Category" class="form-control" placeholder=" ">
                                <label class="float-label" for="Category">Category Name</label>
                            </div>
                        </div>
                        <div class="form-row form-row-1" style="margin-bottom:20px;">
                            <div>
                                <div class="status-meta"><i class="fas fa-toggle-on" style="color:var(--accent);margin-right:5px;"></i>Category Status</div>
                                <div class="check-group">
                                    <input type="checkbox" id="IsActive" class="check-input" checked>
                                    <label class="check-label" for="IsActive">Mark as Active</label>
                                </div>
                            </div>
                        </div>
                        <div class="btn-row">
                            <button class="btn-pro btn-save" id="saveBtn"><i class="fas fa-floppy-disk"></i> Save Category</button>
                            <button class="btn-pro btn-cancel" id="cancelBtn"><i class="fas fa-xmark"></i> Cancel</button>
                        </div>
                    </div>
                </div>
            </div>

            <div id="gridViewContainer" style="display:none;">
                <div class="grid-card">
                    <div class="grid-header">
                        <div class="grid-header-left">
                            <div class="header-dots"><div class="h-dot h-dot-1"></div><div class="h-dot h-dot-2"></div><div class="h-dot h-dot-3"></div></div>
                            <div class="grid-header-title">All Categories</div>
                            <div class="grid-badge" id="TotalCategoriesCount">0 records</div>
                        </div>
                        <div class="pill pill-accent"><i class="fas fa-circle-dot" style="font-size:7px;"></i> Live Data</div>
                    </div>
                    <div class="grid-scroll"><div id="CategoryGridContainer"></div></div>
                </div>
            </div>

            <div class="page-footer">Developed with <span style="color:var(--danger);">♥</span> by <strong>UT Designer</strong></div>
        </div>
    </div>

    <script>
        let userId=localStorage.getItem("userId")||"",GridViewDataList=[],IsUpdate=false;
        const SW={background:'#0f1220',color:'#e8eaf2',confirmButtonColor:'#6c63ff',cancelButtonColor:'#1a2035'};
        function initFloatLabels(){document.querySelectorAll('.float-group').forEach(g=>{const el=g.querySelector('input:not([type="checkbox"]):not([type="file"]):not([style*="display:none"]),textarea,select');if(!el)return;const chk=()=>g.classList.toggle('has-value',el.value!=='');el.addEventListener('input',chk);el.addEventListener('change',chk);chk();});}
        function showFormView(){document.getElementById("formViewContainer").style.display="block";document.getElementById("gridViewContainer").style.display="none";document.getElementById("formViewToggleBtn").style.display="none";document.getElementById("gridViewToggleBtn").style.display="inline-flex";document.getElementById("Category").focus();}
        function showGridView(){document.getElementById("formViewContainer").style.display="none";document.getElementById("gridViewContainer").style.display="block";document.getElementById("gridViewToggleBtn").style.display="none";document.getElementById("formViewToggleBtn").style.display="inline-flex";}
        document.getElementById("gridViewToggleBtn").addEventListener("click",showGridView);
        document.getElementById("formViewToggleBtn").addEventListener("click",showFormView);
        window.addEventListener("load",async function(){initFloatLabels();await LoadCategoryRegistrationData();await LoadGridViewData();});
        async function LoadCategoryRegistrationData(){try{const r=await jQuery.ajax({type:'POST',url:'@Url.Action("nLoadCategoryRegistrationData", "CategoryRegistration")',data:JSON.stringify({Userid:userId}),contentType:'application/json'});if(r.statusId!==1)await Swal.fire({icon:'warning',title:'Warning',text:r.message||'Failed',...SW});}catch{await Swal.fire({icon:'error',title:'Error',text:'Error loading data',...SW});}}
        async function LoadGridViewData(){try{const r=await jQuery.ajax({type:'POST',url:'@Url.Action("nLoadGridViewData", "CategoryRegistration")',data:JSON.stringify({Userid:userId}),contentType:'application/json'});if(r.statusId===1){GridViewDataList=r.GridViewDataList||[];RenderGridView();}else await Swal.fire({icon:'warning',title:'Warning',text:r.message||'Failed',...SW});}catch{await Swal.fire({icon:'error',title:'Error',text:'Error loading grid',...SW});}}
        function RenderGridView(){const c=document.getElementById("CategoryGridContainer"),cnt=document.getElementById("TotalCategoriesCount");if(!GridViewDataList.length){c.innerHTML=`<div class="empty-state"><div class="empty-icon"><i class="fas fa-folder-open"></i></div><div class="empty-text">No categories found.</div></div>`;cnt.textContent="0 records";return;}const t=document.createElement("table");t.className="pro-table";t.innerHTML=`<thead><tr><th>Actions</th><th>ID</th><th>Category Name</th><th>Status</th></tr></thead>`;const tb=document.createElement("tbody");GridViewDataList.forEach(item=>{const tr=document.createElement("tr");tr.innerHTML=`<td><button class="tbl-btn tbl-btn-edit" onclick="EditCategory(${item.CategoryId})" title="Edit"><i class="fas fa-pen"></i></button><button class="tbl-btn tbl-btn-del" onclick="DeleteCategory(${item.CategoryId})" title="Delete"><i class="fas fa-trash-can"></i></button></td><td>${item.CategoryId||''}</td><td>${item.Category||''}</td><td>${item['Is Active']?'<span class="badge-active"><i class="fas fa-circle" style="font-size:6px;margin-right:4px;"></i>Active</span>':'<span class="badge-inactive"><i class="fas fa-circle" style="font-size:6px;margin-right:4px;"></i>Inactive</span>'}</td>`;tb.appendChild(tr);});t.appendChild(tb);c.innerHTML="";c.appendChild(t);cnt.textContent=`${tb.rows.length} records`;}
        function EditCategory(id){const cat=GridViewDataList.find(c=>parseInt(c.CategoryId)===parseInt(id));if(!cat){Swal.fire({icon:'error',title:'Error',text:'Not found.',...SW});return;}document.getElementById("CategoryId").value=cat.CategoryId||'';document.getElementById("Category").value=cat.Category||'';document.getElementById("IsActive").checked=cat['Is Active']===true||cat['Is Active']===1;IsUpdate=true;document.getElementById("saveBtn").innerHTML='<i class="fas fa-floppy-disk"></i> Update Category';initFloatLabels();showFormView();}
        async function DeleteCategory(id){const r=await Swal.fire({title:'Confirm Delete',text:"Cannot be undone.",icon:'warning',showCancelButton:true,confirmButtonText:'Yes, delete',cancelButtonText:'Cancel',confirmButtonColor:'#f43f5e',...SW});if(!r.isConfirmed)return;Swal.fire({title:'Please wait',text:'Deleting...',allowOutsideClick:false,allowEscapeKey:false,didOpen:()=>Swal.showLoading(),...SW});try{const res=await jQuery.ajax({type:'POST',url:'@Url.Action("nDeleteCategoryRegistrationData", "CategoryRegistration")',data:JSON.stringify({Userid:userId,CategoryId:`${id}`}),contentType:'application/json'});Swal.close();if(res.statusId===1){await Swal.fire({icon:'success',title:'Deleted',text:res.message||'Deleted.',...SW});await LoadGridViewData();}else await Swal.fire({icon:'warning',title:'Failed',text:res.message||'Could not delete.',...SW});}catch{Swal.close();await Swal.fire({icon:'error',title:'Error',text:'An error occurred.',...SW});}}
        document.getElementById("saveBtn").addEventListener("click",async function(){const CategoryId=document.getElementById("CategoryId").value.trim(),Category=document.getElementById("Category").value.trim(),isActive=document.getElementById("IsActive").checked;if(!Category){await Swal.fire({icon:'warning',title:'Validation',text:'Category name is required',returnFocus:false,...SW,didClose:()=>document.getElementById("Category").focus()});return;}Swal.fire({title:'Please wait',text:'Saving...',allowOutsideClick:false,allowEscapeKey:false,didOpen:()=>Swal.showLoading(),...SW});try{const res=await jQuery.ajax({type:'POST',url:'@Url.Action("nSaveCategoryRegistrationData", "CategoryRegistration")',data:JSON.stringify({Userid:userId,CategoryId,Category,IsActive:isActive,IsUpdate}),contentType:'application/json'});Swal.close();if(res.statusId===1){await Swal.fire({icon:'success',title:'Saved',text:res.message||'Saved.',returnFocus:false,...SW,didClose:()=>document.getElementById("Category").focus()});nClearForm();}else await Swal.fire({icon:'warning',title:'Failed',text:res.message||'Could not save.',...SW});}catch{Swal.close();await Swal.fire({icon:'error',title:'Error',text:'An error occurred.',...SW});}});
        document.getElementById("cancelBtn").addEventListener("click",function(){nClearForm();});
        async function nClearForm(){document.getElementById("CategoryId").value="";document.getElementById("Category").value="";document.getElementById("IsActive").checked=true;IsUpdate=false;document.getElementById("saveBtn").innerHTML='<i class="fas fa-floppy-disk"></i> Save Category';initFloatLabels();document.getElementById("Category").focus();await LoadGridViewData();}
    </script>
