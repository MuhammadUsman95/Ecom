@page
@model NormalAccountProject.Pages.LoginModel
@{
    Layout = null;
    ViewData["Title"] = "Login";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Login</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Syne:wght@600;700;800&family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    @await Html.PartialAsync("_CommonScripts")
</head>
<body>

    <style>
        :root {
            --bg: #0a0c12;
            --bg2: #0f1220;
            --surface: #141828;
            --surface2: #1a2035;
            --surface3: #1f2640;
            --border: rgba(255,255,255,.06);
            --border2: rgba(255,255,255,.11);
            --accent: #6c63ff;
            --accent2: #4f46e5;
            --accent-g: rgba(108,99,255,.15);
            --gold: #f0b429;
            --teal: #14b8a6;
            --danger: #f43f5e;
            --text: #e8eaf2;
            --text2: #9198b0;
            --text3: #5a6182;
            --font-h: 'Syne', sans-serif;
            --font-b: 'Plus Jakarta Sans', sans-serif;
            --font-m: 'JetBrains Mono', monospace;
        }

        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: var(--font-b);
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            background: var(--bg);
            padding: 20px;
            position: relative;
            overflow: hidden;
        }

            /* Grid texture */
            body::before {
                content: '';
                position: fixed;
                inset: 0;
                background-image: linear-gradient(rgba(255,255,255,.02) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.02) 1px, transparent 1px);
                background-size: 40px 40px;
                pointer-events: none;
                z-index: 0;
            }

        /* Ambient orbs */
        .orb {
            position: fixed;
            border-radius: 50%;
            pointer-events: none;
            filter: blur(1px);
        }

        .orb-1 {
            width: 500px;
            height: 500px;
            top: -200px;
            right: -200px;
            background: radial-gradient(circle, rgba(108,99,255,.08) 0%, transparent 65%);
        }

        .orb-2 {
            width: 400px;
            height: 400px;
            bottom: -150px;
            left: -150px;
            background: radial-gradient(circle, rgba(20,184,166,.06) 0%, transparent 65%);
        }

        /* Floating particles */
        .particle {
            position: fixed;
            width: 2px;
            height: 2px;
            background: rgba(108,99,255,.5);
            border-radius: 50%;
            animation: floatUp 20s infinite linear;
            pointer-events: none;
            z-index: 0;
        }

        @@keyframes floatUp {
            0% {
                transform: translateY(100vh) translateX(0);
                opacity: 0;
            }

            5% {
                opacity: 1;
            }

            95% {
                opacity: .4;
            }

            100% {
                transform: translateY(-10vh) translateX(40px);
                opacity: 0;
            }
        }

        .login-container {
            width: 100%;
            max-width: 420px;
            position: relative;
            z-index: 10;
            animation: slideUp .65s cubic-bezier(.22,1,.36,1) both;
        }

        @@keyframes slideUp {
            from {
                opacity: 0;
                transform: translateY(40px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* Card */
        .login-card {
            background: var(--surface);
            border: 1px solid var(--border2);
            border-radius: 22px;
            box-shadow: 0 30px 80px rgba(0,0,0,.6), 0 0 0 1px rgba(108,99,255,.08);
            overflow: hidden;
        }

        /* Header */
        .login-header {
            padding: 34px 32px 26px;
            text-align: center;
            background: linear-gradient(180deg, var(--surface2) 0%, var(--surface) 100%);
            border-bottom: 1px solid var(--border2);
            position: relative;
            overflow: hidden;
        }

            .login-header::before {
                content: '';
                position: absolute;
                top: -80px;
                left: 50%;
                transform: translateX(-50%);
                width: 260px;
                height: 260px;
                background: radial-gradient(circle, rgba(108,99,255,.1) 0%, transparent 65%);
                pointer-events: none;
            }

        /* macOS dots */
        .mac-dots {
            display: flex;
            gap: 6px;
            position: absolute;
            top: 14px;
            left: 18px;
        }

        .mac-dot {
            width: 10px;
            height: 10px;
            border-radius: 50%;
        }

        .mac-dot-r {
            background: #f43f5e;
        }

        .mac-dot-y {
            background: #f59e0b;
        }

        .mac-dot-g {
            background: #10b981;
        }

        /* Terminal label */
        .terminal-label {
            font-family: var(--font-m);
            font-size: 9.5px;
            color: var(--text3);
            letter-spacing: 1.5px;
            text-transform: uppercase;
            position: absolute;
            top: 16px;
            left: 50%;
            transform: translateX(-50%);
            white-space: nowrap;
        }

/*         .login-logo {
            width: 56px;
            height: 56px;
            background: linear-gradient(135deg, var(--accent) 0%, var(--accent2) 100%);
            border-radius: 16px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 16px;
            color: #fff;
            font-size: 22px;
            box-shadow: 0 6px 28px rgba(108,99,255,.45);
            position: relative;
            z-index: 1;
        } */

        .login-title {
            font-family: var(--font-h);
            font-size: 23px;
            font-weight: 800;
            color: var(--text);
            letter-spacing: -.4px;
            position: relative;
            z-index: 1;
        }

            .login-title span {
                color: var(--accent);
            }

        .login-sub {
            font-family: var(--font-m);
            font-size: 10px;
            color: var(--text3);
            letter-spacing: 1.5px;
            text-transform: uppercase;
            margin-top: 7px;
            position: relative;
            z-index: 1;
        }

        /* Accent bar */
        .accent-bar {
            display: flex;
            gap: 2px;
            height: 2px;
            margin: 14px auto 0;
            width: 80px;
            position: relative;
            z-index: 1;
        }

            .accent-bar span:nth-child(1) {
                flex: 2;
                background: var(--accent);
                border-radius: 2px;
            }

            .accent-bar span:nth-child(2) {
                flex: 1;
                background: var(--teal);
                border-radius: 2px;
                opacity: .6;
            }

            .accent-bar span:nth-child(3) {
                flex: 1;
                background: var(--border);
                border-radius: 2px;
            }

        /* Form */
        .login-form {
            padding: 26px 30px 30px;
        }

        .form-group {
            margin-bottom: 16px;
            animation: fadeIn .5s ease both;
            opacity: 0;
        }

            .form-group:nth-child(1) {
                animation-delay: .15s;
            }

            .form-group:nth-child(2) {
                animation-delay: .25s;
            }

        @@keyframes fadeIn {
            to {
                opacity: 1;
            }
        }

        /* Floating label inputs */
        .input-wrapper {
            position: relative;
        }

        .input-icon {
            position: absolute;
            left: 13px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--text3);
            font-size: 13px;
            transition: color .2s;
            pointer-events: none;
            z-index: 2;
        }

        .float-label {
            position: absolute;
            left: 40px;
            top: 50%;
            transform: translateY(-50%);
            font-family: var(--font-b);
            font-size: 13px;
            font-weight: 500;
            color: var(--text3);
            pointer-events: none;
            transition: top .18s, transform .18s, font-size .18s, color .18s, letter-spacing .18s;
            white-space: nowrap;
        }

        .form-input {
            width: 100%;
            padding: 21px 13px 7px 40px;
            border: 1px solid var(--border2);
            border-radius: 10px;
            font-size: 13.5px;
            font-family: var(--font-b);
            background: var(--bg2);
            color: #e8eaf2 !important;
            -webkit-text-fill-color: #e8eaf2 !important;
            caret-color: var(--accent);
            outline: none;
            transition: border-color .2s, box-shadow .2s, background .2s;
        }

            .form-input::placeholder {
                color: transparent;
                -webkit-text-fill-color: transparent;
            }

            .form-input:focus {
                border-color: var(--accent);
                box-shadow: 0 0 0 3px rgba(108,99,255,.14);
                background: var(--surface);
            }

            .form-input:-webkit-autofill,
            .form-input:-webkit-autofill:hover,
            .form-input:-webkit-autofill:focus {
                -webkit-text-fill-color: #e8eaf2 !important;
                -webkit-box-shadow: 0 0 0px 1000px var(--bg2) inset !important;
                transition: background-color 5000s ease-in-out 0s;
            }

            .form-input:focus ~ .float-label,
            .input-wrapper.has-value .float-label {
                top: 8px;
                transform: none;
                font-size: 9px;
                font-family: var(--font-m);
                color: var(--accent);
                letter-spacing: 1px;
                text-transform: uppercase;
                font-weight: 500;
            }

            .form-input:focus ~ .input-icon {
                color: var(--accent);
            }

        .input-wrapper.has-value .input-icon {
            color: var(--accent);
        }

        /* Login Button */
        .btn-login-wrap {
            margin-top: 22px;
            animation: fadeIn .5s ease .35s both;
            opacity: 0;
        }

        .btn-login {
            width: 100%;
            padding: 13px;
            background: linear-gradient(135deg, var(--accent) 0%, var(--accent2) 100%);
            color: #fff;
            border: none;
            border-radius: 10px;
            font-size: 14px;
            font-weight: 700;
            font-family: var(--font-b);
            cursor: pointer;
            letter-spacing: .2px;
            transition: all .2s ease;
            box-shadow: 0 4px 20px rgba(108,99,255,.45);
            position: relative;
            overflow: hidden;
        }

            .btn-login::before {
                content: '';
                position: absolute;
                top: 50%;
                left: 50%;
                width: 0;
                height: 0;
                background: rgba(255,255,255,.12);
                border-radius: 50%;
                transform: translate(-50%,-50%);
                transition: width .5s, height .5s;
            }

            .btn-login:hover::before {
                width: 340px;
                height: 340px;
            }

            .btn-login:hover:not(:disabled) {
                transform: translateY(-2px);
                box-shadow: 0 8px 28px rgba(108,99,255,.55);
            }

            .btn-login:active:not(:disabled) {
                transform: translateY(0);
            }

            .btn-login:disabled {
                opacity: .6;
                cursor: not-allowed;
                transform: none !important;
            }

            .btn-login span {
                position: relative;
                z-index: 1;
                display: flex;
                align-items: center;
                justify-content: center;
                gap: 8px;
            }

        /* Footer */
        .login-footer {
            margin-top: 20px;
            text-align: center;
            font-family: var(--font-m);
            font-size: 10px;
            color: var(--text3);
            letter-spacing: .4px;
            padding-top: 18px;
            border-top: 1px solid var(--border);
            animation: fadeIn .5s ease .45s both;
            opacity: 0;
        }

            .login-footer strong {
                color: var(--accent);
                font-weight: 500;
            }

            .login-footer .heart {
                color: var(--danger);
            }
    </style>

    <div class="orb orb-1"></div>
    <div class="orb orb-2"></div>
    <div class="particle" style="left:8%;animation-delay:0s;"></div>
    <div class="particle" style="left:22%;animation-delay:4s;"></div>
    <div class="particle" style="left:40%;animation-delay:8s;"></div>
    <div class="particle" style="left:57%;animation-delay:2s;"></div>
    <div class="particle" style="left:72%;animation-delay:6s;"></div>
    <div class="particle" style="left:88%;animation-delay:3s;"></div>

    <div class="login-container">
        <div class="login-card">

            <div class="login-header">
                <div class="mac-dots">
                    <div class="mac-dot mac-dot-r"></div>
                    <div class="mac-dot mac-dot-y"></div>
                    <div class="mac-dot mac-dot-g"></div>
                </div>
                @* <div class="terminal-label">auth.session</div> *@
                @* <div class="login-logo"><i class="fas fa-store-alt"></i></div> *@
                <div class="login-logo">
                    <img src="./images/logo.png" alt="Logo" style="width: 150px; height: auto;">
                </div>
                <div class="login-title"><span> Ecommerce Admin</span></div>
                @* <div class="login-sub">// sign in to continue</div> *@
                <div class="accent-bar"><span></span><span></span><span></span></div>
            </div>

            <div class="login-form">
                <form id="loginForm">
                    <div class="form-group">
                        <div class="input-wrapper" id="wrapUserId">
                            <input type="text" id="userId" class="form-input" placeholder=" " required autocomplete="username">
                            <i class="fas fa-user input-icon"></i>
                            <label class="float-label" for="userId">UserID</label>
                        </div>
                    </div>

                    <div class="form-group">
                        <div class="input-wrapper" id="wrapPassword">
                            <input type="password" id="password" class="form-input" placeholder=" " required autocomplete="current-password">
                            <i class="fas fa-lock input-icon"></i>
                            <label class="float-label" for="password">Password</label>
                        </div>
                    </div>

                    <div class="btn-login-wrap">
                        <button type="submit" id="loginBtn" class="btn-login">
                            <span><i class="fas fa-arrow-right-to-bracket"></i> Login</span>
                        </button>
                    </div>
                </form>

                <div class="login-footer">
                    Developed with </span> by <strong>UT Designer</strong>
                </div>
            </div>

        </div>
    </div>

    <script>
        const SW = { background:'#0f1220', color:'#e8eaf2', confirmButtonColor:'#6c63ff' };

        function checkIfLoggedIn() {
            if (localStorage.getItem("userId") && localStorage.getItem("password")) {
                window.location.href = '/Home'; return true;
            }
            return false;
        }

        function initLoginFloats() {
            ['wrapUserId','wrapPassword'].forEach(wid => {
                const wrap = document.getElementById(wid);
                if (!wrap) return;
                const inp = wrap.querySelector('input');
                if (!inp) return;
                const chk = () => wrap.classList.toggle('has-value', inp.value !== '');
                inp.addEventListener('input', chk); inp.addEventListener('change', chk); chk();
            });
        }

        $(document).ready(function() {
            if (checkIfLoggedIn()) return;
            $("#userId, #password").val("");
            initLoginFloats();
            $("#userId").focus();

            $("#loginForm").submit(function(e) {
                e.preventDefault();
                const userId = $("#userId").val().trim();
                const password = $("#password").val().trim();
                if (!userId || !password) {
                    Swal.fire({ icon:'warning', title:'Validation', text:'Please fill in all fields!', ...SW }); return;
                }
                $("#userId, #password, #loginBtn").prop("disabled", true);
                $("#loginBtn span").html('<i class="fas fa-spinner fa-spin"></i> Verifying...');
                Swal.fire({ title:'Please Wait', text:'Verifying credentials...', allowOutsideClick:false, allowEscapeKey:false, didOpen:()=>Swal.showLoading(), ...SW });
                $.ajax({
                    url: '@Url.Action("Verify", "Login")',
                    type: 'POST',
                    data: { userId, password },
                    success: function(response) {
                        if (response.success) {
                            localStorage.setItem("userId", response.userId);
                            localStorage.setItem("password", response.password);
                            Swal.fire({ icon:'success', title:'Login Successful!', text:'Redirecting...', timer:1800, timerProgressBar:true, showConfirmButton:false, allowOutsideClick:false, ...SW })
                                .then(() => { window.location.href='/Home'; });
                        } else {
                            $("#userId, #password, #loginBtn").prop("disabled", false);
                            $("#loginBtn span").html('<i class="fas fa-arrow-right-to-bracket"></i> Login');
                            $("#userId").focus();
                            Swal.fire({ icon:'error', title:'Login Failed', text:response.message||'Invalid credentials.', ...SW });
                        }
                    },
                    error: function() {
                        $("#userId, #password, #loginBtn").prop("disabled", false);
                        $("#loginBtn span").html('<i class="fas fa-arrow-right-to-bracket"></i> Login');
                        $("#userId").focus();
                        Swal.fire({ icon:'error', title:'Server Error', text:'Unable to connect. Please try again.', ...SW });
                    }
                });
            });

            $("#userId, #password").keypress(function(e) {
                if (e.which === 13) { $("#loginForm").submit(); }
            });
        });
    </script>

</body>
</html>
