@page
@model NormalAccountProject.Pages.LoginModel
@{
    Layout = null;
    ViewData["Title"] = "Login";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Login</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    @await Html.PartialAsync("_CommonScripts")
</head>
<body>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            background: linear-gradient(135deg, #2d2e31 0%, #68646d 100%);
            padding: 20px;
            position: relative;
            overflow: hidden;
        }

        /* Animated background particles */
        .particle {
            position: absolute;
            width: 20px;
            height: 20px;
            background: rgba(255, 255, 255, 0.1);
            border-radius: 50%;
            animation: float 15s infinite;
        }

        @@keyframes float {
            0%, 100% {
                transform: translateY(0) translateX(0);
                opacity: 0;
            }

            10% {
                opacity: 1;
            }

            90% {
                opacity: 1;
            }

            100% {
                transform: translateY(-100vh) translateX(100px);
                opacity: 0;
            }
        }

        .login-container {
            width: 100%;
            max-width: 450px;
            position: relative;
            z-index: 10;
            animation: slideInUp 0.8s cubic-bezier(0.68, -0.55, 0.265, 1.55);
        }

        @@keyframes slideInUp {
            from {
                opacity: 0;
                transform: translateY(100px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .login-card {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
            border-radius: 20px;
            box-shadow: 0 30px 80px rgba(0, 0, 0, 0.3);
            overflow: hidden;
            transition: transform 0.3s ease;
        }

            .login-card:hover {
                transform: translateY(-5px);
                box-shadow: 0 35px 90px rgba(0, 0, 0, 0.35);
            }

        .login-header {
            background: linear-gradient(135deg, #2d2e31 0%, #68646d 100%);
            padding: 50px 30px;
            text-align: center;
            position: relative;
            overflow: hidden;
        }

            .login-header::before {
                content: '';
                position: absolute;
                top: -50%;
                left: -50%;
                width: 200%;
                height: 200%;
                background: radial-gradient(circle, rgba(255,255,255,0.1) 0%, transparent 70%);
                animation: rotate 20s linear infinite;
            }

        @@keyframes rotate {
            from {
                transform: rotate(0deg);
            }

            to {
                transform: rotate(360deg);
            }
        }

        .login-header h1 {
            color: #ffffff;
            font-size: 32px;
            font-weight: 700;
            letter-spacing: 1px;
            margin-bottom: 10px;
            position: relative;
            z-index: 1;
            animation: fadeInDown 0.8s ease;
        }

        .login-header p {
            color: rgba(255, 255, 255, 0.9);
            font-size: 14px;
            text-transform: uppercase;
            letter-spacing: 2px;
            position: relative;
            z-index: 1;
            animation: fadeInUp 0.8s ease 0.2s both;
        }

        @@keyframes fadeInDown {
            from {
                opacity: 0;
                transform: translateY(-20px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @@keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(20px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .login-form {
            padding: 45px 35px;
        }

        .form-group {
            margin-bottom: 25px;
            position: relative;
            animation: fadeIn 0.6s ease forwards;
            opacity: 0;
        }

            .form-group:nth-child(1) {
                animation-delay: 0.3s;
            }

            .form-group:nth-child(2) {
                animation-delay: 0.4s;
            }

        @@keyframes fadeIn {
            to {
                opacity: 1;
            }
        }

        .form-group label {
            display: block;
            margin-bottom: 10px;
            color: #333333;
            font-size: 13px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            transition: color 0.3s ease;
        }

        .input-wrapper {
            position: relative;
        }

        .input-icon {
            position: absolute;
            left: 18px;
            top: 50%;
            transform: translateY(-50%);
            color: #999;
            font-size: 16px;
            transition: all 0.3s ease;
            pointer-events: none;
        }

        .form-group input {
            width: 100%;
            padding: 16px 18px 16px 50px;
            border: 2px solid #e0e0e0;
            border-radius: 12px;
            font-size: 15px;
            transition: all 0.3s ease;
            background: #f8f9fa;
            color: #333;
        }

            .form-group input::placeholder {
                color: #999999;
            }

            .form-group input:focus {
                outline: none;
                background: #ffffff;
                border-color: #2d2e31;
                box-shadow: 0 0 0 4px rgba(102, 126, 234, 0.1);
                transform: translateY(-2px);
            }

                .form-group input:focus + .input-icon {
                    color: #2d2e31;
                    transform: translateY(-50%) scale(1.1);
                }

        .form-options {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 30px;
            font-size: 13px;
            animation: fadeIn 0.6s ease 0.5s forwards;
            opacity: 0;
        }

        .remember-me {
            display: flex;
            align-items: center;
            cursor: pointer;
            user-select: none;
        }

            .remember-me input[type="checkbox"] {
                width: 18px;
                height: 18px;
                margin-right: 8px;
                cursor: pointer;
                accent-color: #2d2e31;
            }

            .remember-me span {
                color: #666;
                font-weight: 500;
            }

        .form-options a {
            color: #2d2e31;
            text-decoration: none;
            font-weight: 600;
            transition: all 0.3s;
            position: relative;
        }

            .form-options a::after {
                content: '';
                position: absolute;
                bottom: -2px;
                left: 0;
                width: 0;
                height: 2px;
                background: #2d2e31;
                transition: width 0.3s ease;
            }

            .form-options a:hover::after {
                width: 100%;
            }

        .btn-login {
            width: 100%;
            padding: 16px;
            background: linear-gradient(135deg, #2d2e31 0%, #68646d 100%);
            color: #ffffff;
            border: none;
            border-radius: 12px;
            font-size: 16px;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.3s ease;
            text-transform: uppercase;
            letter-spacing: 1px;
            position: relative;
            overflow: hidden;
            animation: fadeIn 0.6s ease 0.6s forwards;
            opacity: 0;
        }

            .btn-login::before {
                content: '';
                position: absolute;
                top: 50%;
                left: 50%;
                width: 0;
                height: 0;
                background: rgba(255, 255, 255, 0.2);
                border-radius: 50%;
                transform: translate(-50%, -50%);
                transition: width 0.6s, height 0.6s;
            }

            .btn-login:hover::before {
                width: 300px;
                height: 300px;
            }

            .btn-login:hover:not(:disabled) {
                transform: translateY(-3px);
                box-shadow: 0 15px 35px rgba(102, 126, 234, 0.4);
            }

            .btn-login:active:not(:disabled) {
                transform: translateY(-1px);
            }

            .btn-login:disabled {
                opacity: 0.7;
                cursor: not-allowed;
                transform: none !important;
            }

            .btn-login span {
                position: relative;
                z-index: 1;
            }

        .footer-text {
            text-align: center;
            margin-top: 30px;
            color: #999999;
            font-size: 12px;
            padding-top: 20px;
            border-top: 1px solid #e0e0e0;
            animation: fadeIn 0.6s ease 0.7s forwards;
            opacity: 0;
        }

            .footer-text span {
                background: linear-gradient(135deg, #2d2e31 0%, #68646d 100%);
                -webkit-background-clip: text;
                -webkit-text-fill-color: transparent;
                background-clip: text;
                font-weight: 700;
            }

        /* Pulse animation for loading state */
        @@keyframes pulse {
            0%, 100% {
                opacity: 1;
            }

            50% {
                opacity: 0.5;
            }
        }

        .btn-login.loading {
            animation: pulse 1.5s ease-in-out infinite;
        }

        /* Custom SweetAlert2 styling */
        .swal2-popup {
            border-radius: 20px;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .swal2-title {
            font-size: 24px;
            font-weight: 700;
        }

        .swal2-confirm {
            background: linear-gradient(135deg, #2d2e31 0%, #68646d 100%) !important;
            border-radius: 8px;
            padding: 12px 30px;
            font-weight: 600;
        }

        /* Responsive design */
        @@media (max-width: 480px) {
            .login-header h1 {
                font-size: 26px;
            }

            .login-form {
                padding: 35px 25px;
            }
        }
    </style>

    <!-- Animated background particles -->
    <div class="particle" style="left: 10%; animation-delay: 0s;"></div>
    <div class="particle" style="left: 20%; animation-delay: 2s;"></div>
    <div class="particle" style="left: 30%; animation-delay: 4s;"></div>
    <div class="particle" style="left: 40%; animation-delay: 1s;"></div>
    <div class="particle" style="left: 50%; animation-delay: 3s;"></div>
    <div class="particle" style="left: 60%; animation-delay: 5s;"></div>
    <div class="particle" style="left: 70%; animation-delay: 2.5s;"></div>
    <div class="particle" style="left: 80%; animation-delay: 4.5s;"></div>
    <div class="particle" style="left: 90%; animation-delay: 1.5s;"></div>

    <div class="login-container">
        <div class="login-card">
            <div class="login-header">
                <h1>Ecommerce Admin Portal</h1>
                @* <p>Sign in to continue</p> *@
            </div>

            <div class="login-form">
                <form id="loginForm">
                    <div class="form-group">
                        <label for="userId">UserId</label>
                        <div class="input-wrapper">
                            <input type="text"
                                   id="userId"
                                   placeholder="UserId"
                                   required />
                            <i class="fas fa-user input-icon"></i>
                        </div>
                    </div>

                    <div class="form-group">
                        <label for="password">Password</label>
                        <div class="input-wrapper">
                            <input type="password"
                                   id="password"
                                   placeholder="Enter your password"
                                   required />
                            <i class="fas fa-lock input-icon"></i>
                        </div>
                    </div>

@*                     <div class="form-options">
                        <label class="remember-me">
                            <input type="checkbox" id="rememberMe">
                            <span>Remember me</span>
                        </label>
                        <a href="#forgot-password">Forgot password?</a>
                    </div> *@

                    <button type="submit" id="loginBtn" class="btn-login">
                        <span>Login</span>
                    </button>
                </form>

                <div class="footer-text">
                    Software Developed By <span>UT Designer</span>
                </div>
            </div>
        </div>
    </div>

    <script>
        function checkIfLoggedIn() {
            const savedUserId = localStorage.getItem("userId");
            const savedPassword = localStorage.getItem("password");

            if (savedUserId && savedPassword) {
                window.location.href = '/Home';
                return true;
            }
            return false;
        }

        $(document).ready(function() {
            // Check if already logged in
            if (checkIfLoggedIn()) return;

            // Clear input fields
            $("#userId, #password").val("");
            $("#userId").focus();

            // Form submission
            $("#loginForm").submit(function (e) {
                e.preventDefault();

                const userId = $("#userId").val().trim();
                const password = $("#password").val().trim();

                // Validation
                if (!userId || !password) {
                    Swal.fire({
                        icon: 'warning',
                        title: 'Oops...',
                        text: 'Please fill in all fields!',
                        confirmButtonText: 'OK',
                        timer: 3000,
                        timerProgressBar: true
                    });
                    return;
                }

                // Disable inputs and show loading state
                $("#userId, #password, #loginBtn").prop("disabled", true);
                $("#loginBtn").addClass("loading");
                $("#loginBtn span").text("Verifying...");

                // Show loading alert
                Swal.fire({
                    title: 'Please Wait',
                    text: 'Verifying your credentials...',
                    allowOutsideClick: false,
                    allowEscapeKey: false,
                    didOpen: () => {
                        Swal.showLoading();
                    }
                });

                // AJAX call to server
                $.ajax({
                    url: '@Url.Action("Verify", "Login")',
                    type: 'POST',
                    data: {
                        userId: userId,
                        password: password
                    },
                    success: function (response) {
                        if (response.success) {
                            // Store credentials in localStorage
                            localStorage.setItem("userId", response.userId);
                            localStorage.setItem("password", response.password);

                            // Show success message
                            Swal.fire({
                                icon: 'success',
                                title: 'Login Successful!',
                                text: 'Redirecting to dashboard...',
                                timer: 2000,
                                timerProgressBar: true,
                                showConfirmButton: false,
                                allowOutsideClick: false
                            }).then(() => {
                                window.location.href = '/Home';
                            });
                        } else {
                            // Show error message
                            $("#userId, #password, #loginBtn").prop("disabled", false);
                            $("#loginBtn").removeClass("loading");
                            $("#loginBtn span").text("Login");
                            $("#userId").focus();

                            Swal.fire({
                                icon: 'error',
                                title: 'Login Failed',
                                text: response.message || 'Invalid credentials. Please try again.',
                                confirmButtonText: 'Try Again',
                                timer: 4000,
                                timerProgressBar: true
                            });
                        }
                    },
                    error: function (xhr, status, error) {
                        // Show server error
                        $("#userId, #password, #loginBtn").prop("disabled", false);
                        $("#loginBtn").removeClass("loading");
                        $("#loginBtn span").text("Login");
                        $("#userId").focus();

                        Swal.fire({
                            icon: 'error',
                            title: 'Server Error',
                            text: 'Unable to connect to server. Please try again later.',
                            confirmButtonText: 'OK',
                            timer: 4000,
                            timerProgressBar: true
                        });
                    }
                });
            });

            // Enter key trigger for inputs
            $("#userId, #password").keypress(function(e) {
                if (e.which === 13) {
                    $("#loginForm").submit();
                }
            });
        });
    </script>
</body>
</html>
