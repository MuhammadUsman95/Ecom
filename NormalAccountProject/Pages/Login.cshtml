@page
@model NormalAccountProject.Pages.LoginModel
@{
    Layout = null;
    ViewData["Title"] = "Login";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Login</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Syne:wght@700;800&family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,600;0,700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    @await Html.PartialAsync("_CommonScripts")
</head>
<body>

    <style>
        :root {
            --bg: #1a2030;
            --bg2: #151c2b;
            --surface: #252d3e;
            --surface2: #1e2535;
            --surface3: #2a3347;
            --border: rgba(255,255,255,.06);
            --border2: rgba(255,255,255,.12);
            --accent: #4f7cff;
            --accent-dim: rgba(79,124,255,.14);
            --accent-glow: rgba(79,124,255,.30);
            --active-nav: #2e4275;
            --text: #e4eaf5;
            --text2: #8d9bb5;
            --text3: #4a5878;
            --font-head: 'Syne', sans-serif;
            --font-body: 'Plus Jakarta Sans', sans-serif;
            --font-mono: 'JetBrains Mono', monospace;
        }

        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: var(--font-body);
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            background: var(--bg);
            padding: 20px;
            position: relative;
            overflow: hidden;
        }

            /* Ambient glows */
            body::before {
                content: '';
                position: fixed;
                top: -200px;
                left: -200px;
                width: 600px;
                height: 600px;
                background: radial-gradient(circle, rgba(79,124,255,.07) 0%, transparent 65%);
                pointer-events: none;
            }

            body::after {
                content: '';
                position: fixed;
                bottom: -200px;
                right: -200px;
                width: 600px;
                height: 600px;
                background: radial-gradient(circle, rgba(46,66,117,.08) 0%, transparent 65%);
                pointer-events: none;
            }

        /* Floating particles */
        .particle {
            position: fixed;
            width: 3px;
            height: 3px;
            background: rgba(79,124,255,.4);
            border-radius: 50%;
            animation: float 18s infinite;
            pointer-events: none;
        }
        @@keyframes float {
            0%,100%

        {
            transform: translateY(100vh) translateX(0);
            opacity: 0;
        }

        10% {
            opacity: 1;
        }

        90% {
            opacity: .4;
        }

        100% {
            transform: translateY(-10vh) translateX(60px);
            opacity: 0;
        }

        }

        .login-container {
            width: 100%;
            max-width: 420px;
            position: relative;
            z-index: 10;
            animation: slideUp .7s cubic-bezier(.22,1,.36,1) both;
        }
        @@keyframes slideUp {
            from

        {
            opacity: 0;
            transform: translateY(40px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }

        }

        .login-card {
            background: var(--surface);
            border: 1px solid var(--border2);
            border-radius: 18px;
            box-shadow: 0 30px 80px rgba(0,0,0,.5), 0 0 0 1px rgba(79,124,255,.06);
            overflow: hidden;
        }

        /* Header */
        .login-header {
            background: var(--surface2);
            padding: 36px 32px 28px;
            text-align: center;
            border-bottom: 1px solid var(--border);
            position: relative;
            overflow: hidden;
        }

            .login-header::before {
                content: '';
                position: absolute;
                top: -60px;
                left: 50%;
                transform: translateX(-50%);
                width: 200px;
                height: 200px;
                background: radial-gradient(circle, rgba(79,124,255,.12) 0%, transparent 70%);
                pointer-events: none;
            }

        .login-logo {
            width: 52px;
            height: 52px;
            background: var(--active-nav);
            border: 1px solid rgba(79,124,255,.35);
            border-radius: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 16px;
            color: var(--accent);
            font-size: 22px;
            box-shadow: 0 0 24px rgba(79,124,255,.22);
            position: relative;
            z-index: 1;
        }

        .login-title {
            font-family: var(--font-head);
            font-size: 22px;
            font-weight: 800;
            color: var(--text);
            letter-spacing: -.3px;
            position: relative;
            z-index: 1;
        }

            .login-title span {
                color: var(--accent);
            }

        .login-sub {
            font-family: var(--font-mono);
            font-size: 10px;
            color: var(--text3);
            letter-spacing: 1.5px;
            text-transform: uppercase;
            margin-top: 6px;
            position: relative;
            z-index: 1;
        }

        /* Form */
        .login-form {
            padding: 28px 32px 32px;
        }

        .form-group {
            margin-bottom: 18px;
            animation: fadeIn .5s ease both;
            opacity: 0;
        }

            .form-group:nth-child(1) {
                animation-delay: .15s;
            }

            .form-group:nth-child(2) {
                animation-delay: .25s;
            }
        @@keyframes fadeIn {
            to

        {
            opacity: 1;
        }

        }

        /* ── Floating Label (Login) ── */
        .input-wrapper {
            position: relative;
        }

        .input-icon {
            position: absolute;
            left: 14px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--text3);
            font-size: 14px;
            transition: color .2s;
            pointer-events: none;
            z-index: 2;
        }

        .float-label {
            position: absolute;
            left: 42px;
            top: 50%;
            transform: translateY(-50%);
            font-family: var(--font-body);
            font-size: 13.5px;
            font-weight: 500;
            color: var(--text3);
            pointer-events: none;
            transition: top .18s, transform .18s, font-size .18s, color .18s, letter-spacing .18s;
            white-space: nowrap;
        }

        .form-input {
            width: 100%;
            padding: 21px 14px 7px 42px;
            border: 1.5px solid var(--border2);
            border-radius: 9px;
            font-size: 14px;
            font-family: var(--font-body);
            background: var(--surface2);
            color: var(--text);
            outline: none;
            transition: border-color .2s, box-shadow .2s, background .2s;
        }

            .form-input::placeholder {
                color: transparent;
            }

            .form-input:focus {
                border-color: rgba(255,255,255,.7);
                box-shadow: 0 0 0 3px rgba(255,255,255,.08);
                background: var(--bg2);
            }
                /* Float up on focus or has value */
                .form-input:focus ~ .float-label,
                .input-wrapper.has-value .float-label {
                    top: 8px;
                    transform: none;
                    font-size: 9px;
                    font-family: var(--font-mono);
                    color: var(--accent);
                    letter-spacing: 1px;
                    text-transform: uppercase;
                    font-weight: 500;
                }

                .form-input:focus ~ .input-icon,
                .form-input:focus + .input-icon {
                    color: var(--accent);
                }

        /* Login Button */
        .btn-login-wrap {
            margin-top: 24px;
            animation: fadeIn .5s ease .35s both;
            opacity: 0;
        }

        .btn-login {
            width: 100%;
            padding: 13px;
            background: var(--active-nav);
            color: #c5d4ff;
            border: 1px solid rgba(79,124,255,.35);
            border-radius: 9px;
            font-size: 14px;
            font-weight: 700;
            font-family: var(--font-body);
            cursor: pointer;
            letter-spacing: .3px;
            transition: all .2s ease;
            box-shadow: 0 2px 16px rgba(46,66,117,.5);
            position: relative;
            overflow: hidden;
        }

            .btn-login::before {
                content: '';
                position: absolute;
                top: 50%;
                left: 50%;
                width: 0;
                height: 0;
                background: rgba(255,255,255,.1);
                border-radius: 50%;
                transform: translate(-50%,-50%);
                transition: width .5s, height .5s;
            }

            .btn-login:hover::before {
                width: 300px;
                height: 300px;
            }

            .btn-login:hover:not(:disabled) {
                background: #354e8a;
                transform: translateY(-2px);
                box-shadow: 0 6px 24px rgba(46,66,117,.6);
            }

            .btn-login:active:not(:disabled) {
                transform: translateY(0);
            }

            .btn-login:disabled {
                opacity: .6;
                cursor: not-allowed;
                transform: none !important;
            }

            .btn-login span {
                position: relative;
                z-index: 1;
                display: flex;
                align-items: center;
                justify-content: center;
                gap: 8px;
            }

        /* Footer */
        .login-footer {
            margin-top: 22px;
            text-align: center;
            font-family: var(--font-mono);
            font-size: 10px;
            color: var(--text3);
            letter-spacing: .4px;
            padding-top: 18px;
            border-top: 1px solid var(--border);
            animation: fadeIn .5s ease .45s both;
            opacity: 0;
        }

            .login-footer strong {
                color: var(--accent);
                font-weight: 500;
            }
    </style>

    <!-- Particles -->
    <div class="particle" style="left:8%;animation-delay:0s;"></div>
    <div class="particle" style="left:22%;animation-delay:3s;"></div>
    <div class="particle" style="left:38%;animation-delay:6s;"></div>
    <div class="particle" style="left:55%;animation-delay:1.5s;"></div>
    <div class="particle" style="left:70%;animation-delay:4.5s;"></div>
    <div class="particle" style="left:85%;animation-delay:2s;"></div>

    <div class="login-container">
        <div class="login-card">
            <div class="login-header">
                <div class="login-logo"><i class="fas fa-store-alt"></i></div>
                <div class="login-title">Ecommerce <span>Admin</span></div>
                <div class="login-sub">// sign in to continue</div>
            </div>

            <div class="login-form">
                <form id="loginForm">
                    <div class="form-group">
                        <div class="input-wrapper" id="wrapUserId">
                            <input type="text" id="userId" class="form-input" placeholder=" " required autocomplete="username">
                            <i class="fas fa-user input-icon"></i>
                            <label class="float-label" for="userId">User ID</label>
                        </div>
                    </div>

                    <div class="form-group">
                        <div class="input-wrapper" id="wrapPassword">
                            <input type="password" id="password" class="form-input" placeholder=" " required autocomplete="current-password">
                            <i class="fas fa-lock input-icon"></i>
                            <label class="float-label" for="password">Password</label>
                        </div>
                    </div>

                    <div class="btn-login-wrap">
                        <button type="submit" id="loginBtn" class="btn-login">
                            <span><i class="fas fa-arrow-right-to-bracket"></i> Login</span>
                        </button>
                    </div>
                </form>

                <div class="login-footer">
                    Software Developed By <strong>UT Designer</strong>
                </div>
            </div>
        </div>
    </div>

    <script>
        const SW = { background:'#252d3e', color:'#e4eaf5' };

        function checkIfLoggedIn() {
            if (localStorage.getItem("userId") && localStorage.getItem("password")) {
                window.location.href = '/Home'; return true;
            }
            return false;
        }

        /* Floating Labels */
        function initLoginFloats() {
            ['wrapUserId','wrapPassword'].forEach(wid => {
                const wrap = document.getElementById(wid);
                if (!wrap) return;
                const inp = wrap.querySelector('input');
                if (!inp) return;
                const chk = () => wrap.classList.toggle('has-value', inp.value !== '');
                inp.addEventListener('input', chk); inp.addEventListener('change', chk); chk();
            });
        }

        $(document).ready(function() {
            if (checkIfLoggedIn()) return;
            $("#userId, #password").val("");
            initLoginFloats();
            $("#userId").focus();

            $("#loginForm").submit(function (e) {
                e.preventDefault();
                const userId = $("#userId").val().trim();
                const password = $("#password").val().trim();

                if (!userId || !password) {
                    Swal.fire({ icon:'warning', title:'Validation', text:'Please fill in all fields!', ...SW }); return;
                }

                $("#userId, #password, #loginBtn").prop("disabled", true);
                $("#loginBtn span").html('<i class="fas fa-spinner fa-spin"></i> Verifying...');

                Swal.fire({ title:'Please Wait', text:'Verifying credentials...', allowOutsideClick:false, allowEscapeKey:false, didOpen:()=>Swal.showLoading(), ...SW });

                $.ajax({
                    url: '@Url.Action("Verify", "Login")',
                    type: 'POST',
                    data: { userId: userId, password: password },
                    success: function (response) {
                        if (response.success) {
                            localStorage.setItem("userId", response.userId);
                            localStorage.setItem("password", response.password);
                            Swal.fire({ icon:'success', title:'Login Successful!', text:'Redirecting...', timer:1800, timerProgressBar:true, showConfirmButton:false, allowOutsideClick:false, ...SW })
                                .then(() => { window.location.href='/Home'; });
                        } else {
                            $("#userId, #password, #loginBtn").prop("disabled", false);
                            $("#loginBtn span").html('<i class="fas fa-arrow-right-to-bracket"></i> Login');
                            $("#userId").focus();
                            Swal.fire({ icon:'error', title:'Login Failed', text:response.message||'Invalid credentials.', ...SW });
                        }
                    },
                    error: function () {
                        $("#userId, #password, #loginBtn").prop("disabled", false);
                        $("#loginBtn span").html('<i class="fas fa-arrow-right-to-bracket"></i> Login');
                        $("#userId").focus();
                        Swal.fire({ icon:'error', title:'Server Error', text:'Unable to connect. Please try again.', ...SW });
                    }
                });
            });

            $("#userId, #password").keypress(function(e) {
                if (e.which === 13) { $("#loginForm").submit(); }
            });
        });
    </script>

</body>
</html>
