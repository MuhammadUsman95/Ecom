@page
@model NormalAccountProject.Pages.LoginModel
@{
    Layout = null;
    ViewData["Title"] = "Login";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Login</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Syne:wght@600;700;800&family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    @await Html.PartialAsync("_CommonScripts")
</head>
<body>

    <style>
        :root {
            --bg: #f4f4f4;
            --bg2: #ffffff;
            --surface: #ffffff;
            --surface2: #f9f9f9;
            --surface3: #efefef;
            --border: rgba(0,0,0,.07);
            --border2: rgba(0,0,0,.12);
            --accent: #474544;
            --accent2: #2e2d2c;
            --accent-g: rgba(71,69,68,.10);
            --gold: #b08d57;
            --teal: #5a7a6e;
            --danger: #d94f4f;
            --text: #1a1a1a;
            --text2: #5c5a58;
            --text3: #9a9896;
            --font-h: 'Syne', sans-serif;
            --font-b: 'Plus Jakarta Sans', sans-serif;
            --font-m: 'JetBrains Mono', monospace;
        }

        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: var(--font-b);
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            background: url('./images/ERP_Solution.jpg') center center / cover no-repeat fixed;
            padding: 20px;
            position: relative;
            overflow: hidden;
        }

            /* Dark overlay for readability */
            body::before {
                content: '';
                position: fixed;
                inset: 0;
                background: linear-gradient( 135deg, rgba(10, 10, 10, 0.62) 0%, rgba(30, 28, 26, 0.55) 50%, rgba(10, 10, 10, 0.65) 100% );
                backdrop-filter: blur(1.5px);
                -webkit-backdrop-filter: blur(1.5px);
                pointer-events: none;
                z-index: 0;
            }

        .orb {
            position: fixed;
            border-radius: 50%;
            pointer-events: none;
            filter: blur(1px);
        }

        .orb-1 {
            width: 500px;
            height: 500px;
            top: -200px;
            right: -200px;
            background: radial-gradient(circle,rgba(71,69,68,.06) 0%,transparent 65%);
        }

        .orb-2 {
            width: 400px;
            height: 400px;
            bottom: -150px;
            left: -150px;
            background: radial-gradient(circle,rgba(90,122,110,.05) 0%,transparent 65%);
        }

        .particle {
            position: fixed;
            width: 2px;
            height: 2px;
            background: rgba(71,69,68,.25);
            border-radius: 50%;
            animation: floatUp 20s infinite linear;
            pointer-events: none;
            z-index: 0;
        }

        @@keyframes floatUp {
            0% {
                transform: translateY(100vh) translateX(0);
                opacity: 0;
            }

            5% {
                opacity: 1;
            }

            95% {
                opacity: .4;
            }

            100% {
                transform: translateY(-10vh) translateX(40px);
                opacity: 0;
            }
        }

        .login-container {
            width: 100%;
            max-width: 420px;
            position: relative;
            z-index: 10;
            animation: slideUp .65s cubic-bezier(.22,1,.36,1) both;
        }

        @@keyframes slideUp {
            from {
                opacity: 0;
                transform: translateY(40px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .login-card {
            background: var(--surface);
            border: 1px solid var(--border2);
            border-radius: 22px;
            box-shadow: 0 8px 40px rgba(0,0,0,.12), 0 0 0 1px rgba(71,69,68,.08);
            overflow: hidden;
        }

        .login-header {
            padding: 34px 32px 26px;
            text-align: center;
            background: linear-gradient(180deg, var(--surface2) 0%, var(--surface) 100%);
            border-bottom: 1px solid var(--border2);
            position: relative;
            overflow: hidden;
        }

            .login-header::before {
                content: '';
                position: absolute;
                top: -80px;
                left: 50%;
                transform: translateX(-50%);
                width: 260px;
                height: 260px;
                background: radial-gradient(circle, rgba(71,69,68,.07) 0%, transparent 65%);
                pointer-events: none;
            }

        .mac-dots {
            display: flex;
            gap: 6px;
            position: absolute;
            top: 14px;
            left: 18px;
        }

        .mac-dot {
            width: 10px;
            height: 10px;
            border-radius: 50%;
        }

        .mac-dot-r {
            background: #f43f5e;
        }

        .mac-dot-y {
            background: #f59e0b;
        }

        .mac-dot-g {
            background: #10b981;
        }

        .logo-skeleton {
            width: 150px;
            height: 50px;
            background: linear-gradient(90deg, var(--surface3) 25%, var(--surface2) 50%, var(--surface3) 75%);
            background-size: 200% 100%;
            animation: shimmer 1.4s infinite;
            border-radius: 8px;
            margin: 0 auto 4px;
        }

        @@keyframes shimmer {
            0% {
                background-position: 200% 0;
            }

            100% {
                background-position: -200% 0;
            }
        }

        .login-logo {
            margin-bottom: 4px;
            position: relative;
            z-index: 1;
            min-height: 54px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

            .login-logo img {
                width: 150px;
                height: auto;
                opacity: 0;
                transition: opacity .4s ease;
            }

        .login-title {
            font-family: var(--font-h);
            font-size: 23px;
            font-weight: 800;
            color: var(--text);
            letter-spacing: -.4px;
            position: relative;
            z-index: 1;
            min-height: 28px;
        }

            .login-title span {
                color: var(--accent);
            }

        .title-skeleton {
            width: 180px;
            height: 22px;
            background: linear-gradient(90deg, var(--surface3) 25%, var(--surface2) 50%, var(--surface3) 75%);
            background-size: 200% 100%;
            animation: shimmer 1.4s infinite;
            border-radius: 6px;
            margin: 0 auto;
        }

        .accent-bar {
            display: flex;
            gap: 2px;
            height: 2px;
            margin: 14px auto 0;
            width: 80px;
            position: relative;
            z-index: 1;
        }

            .accent-bar span:nth-child(1) {
                flex: 2;
                background: var(--accent);
                border-radius: 2px;
            }

            .accent-bar span:nth-child(2) {
                flex: 1;
                background: var(--teal);
                border-radius: 2px;
                opacity: .6;
            }

            .accent-bar span:nth-child(3) {
                flex: 1;
                background: var(--border2);
                border-radius: 2px;
            }

        .login-form {
            padding: 26px 30px 30px;
        }

        .form-group {
            margin-bottom: 16px;
            animation: fadeIn .5s ease both;
            opacity: 0;
        }

            .form-group:nth-child(1) {
                animation-delay: .15s;
            }

            .form-group:nth-child(2) {
                animation-delay: .25s;
            }

        @@keyframes fadeIn {
            to {
                opacity: 1;
            }
        }

        .input-wrapper {
            position: relative;
        }

        .input-icon {
            position: absolute;
            left: 13px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--text3);
            font-size: 13px;
            transition: color .2s;
            pointer-events: none;
            z-index: 2;
        }

        .float-label {
            position: absolute;
            left: 40px;
            top: 50%;
            transform: translateY(-50%);
            font-family: var(--font-b);
            font-size: 13px;
            font-weight: 500;
            color: var(--text3);
            pointer-events: none;
            transition: top .18s, transform .18s, font-size .18s, color .18s, letter-spacing .18s;
            white-space: nowrap;
        }

        .form-input {
            width: 100%;
            padding: 21px 13px 7px 40px;
            border: 1px solid var(--border2);
            border-radius: 10px;
            font-size: 13.5px;
            font-family: var(--font-b);
            background: var(--bg2);
            color: #1a1a1a !important;
            -webkit-text-fill-color: #1a1a1a !important;
            caret-color: var(--accent);
            outline: none;
            transition: border-color .2s, box-shadow .2s, background .2s;
        }

            .form-input::placeholder {
                color: transparent;
                -webkit-text-fill-color: transparent;
            }

            .form-input:focus {
                border-color: var(--accent);
                box-shadow: 0 0 0 3px rgba(71,69,68,.12);
                background: var(--surface);
            }

            .form-input:-webkit-autofill,
            .form-input:-webkit-autofill:hover,
            .form-input:-webkit-autofill:focus {
                -webkit-text-fill-color: #1a1a1a !important;
                -webkit-box-shadow: 0 0 0px 1000px #ffffff inset !important;
                transition: background-color 5000s ease-in-out 0s;
            }

            .form-input:focus ~ .float-label,
            .input-wrapper.has-value .float-label {
                top: 8px;
                transform: none;
                font-size: 9px;
                font-family: var(--font-m);
                color: var(--accent);
                letter-spacing: 1px;
                text-transform: uppercase;
                font-weight: 500;
            }

            .form-input:focus ~ .input-icon,
            .input-wrapper.has-value .input-icon {
                color: var(--accent);
            }

        .btn-login-wrap {
            margin-top: 22px;
            animation: fadeIn .5s ease .35s both;
            opacity: 0;
        }

        .btn-login {
            width: 100%;
            padding: 13px;
            background: linear-gradient(135deg, var(--accent) 0%, var(--accent2) 100%);
            color: #fff;
            border: none;
            border-radius: 10px;
            font-size: 14px;
            font-weight: 700;
            font-family: var(--font-b);
            cursor: pointer;
            letter-spacing: .2px;
            transition: all .2s ease;
            box-shadow: 0 4px 20px rgba(71,69,68,.30);
            position: relative;
            overflow: hidden;
        }

            .btn-login::before {
                content: '';
                position: absolute;
                top: 50%;
                left: 50%;
                width: 0;
                height: 0;
                background: rgba(255,255,255,.12);
                border-radius: 50%;
                transform: translate(-50%,-50%);
                transition: width .5s, height .5s;
            }

            .btn-login:hover::before {
                width: 340px;
                height: 340px;
            }

            .btn-login:hover:not(:disabled) {
                transform: translateY(-2px);
                box-shadow: 0 8px 28px rgba(71,69,68,.40);
            }

            .btn-login:active:not(:disabled) {
                transform: translateY(0);
            }

            .btn-login:disabled {
                opacity: .6;
                cursor: not-allowed;
                transform: none !important;
            }

            .btn-login span {
                position: relative;
                z-index: 1;
                display: flex;
                align-items: center;
                justify-content: center;
                gap: 8px;
            }

        .login-footer {
            margin-top: 20px;
            text-align: center;
            font-family: var(--font-m);
            font-size: 10px;
            color: var(--text3);
            letter-spacing: .4px;
            padding-top: 18px;
            border-top: 1px solid var(--border);
            animation: fadeIn .5s ease .45s both;
            opacity: 0;
        }

            .login-footer strong {
                color: var(--accent);
                font-weight: 500;
            }

            .login-footer .heart {
                color: var(--danger);
            }

        /* ── Body Entry Animation (Professional) ─────────── */
        @@keyframes bodyReveal {
            0% {
                opacity: 0;
            }

            100% {
                opacity: 1;
            }
        }

        body {
            animation: bodyReveal .5s ease both;
        }

        /* ── Toast Notification ───────────────────────────── */
        @@keyframes toastIn {
            0% {
                opacity: 0;
                transform: translateY(-18px) scale(.96);
            }

            60% {
                opacity: 1;
                transform: translateY(4px) scale(1.01);
            }

            100% {
                opacity: 1;
                transform: translateY(0) scale(1);
            }
        }

        @@keyframes toastOut {
            0% {
                opacity: 1;
                transform: translateY(0) scale(1);
            }

            100% {
                opacity: 0;
                transform: translateY(-14px) scale(.95);
            }
        }

        /* ── Toast Stack Container ────────────────────────── */
        #toastContainer {
            position: fixed;
            top: 20px;
            right: 20px;
            z-index: 9999;
            display: flex;
            flex-direction: column;
            gap: 10px;
            align-items: flex-end;
            pointer-events: none;
        }

        .toast-notify {
            pointer-events: all;
            background: #fff;
            border-radius: 12px;
            padding: 13px 15px 16px;
            box-shadow: 0 4px 6px rgba(0,0,0,.06), 0 12px 28px rgba(0,0,0,.14), 0 0 0 1px rgba(0,0,0,.06);
            display: flex;
            align-items: flex-start;
            gap: 11px;
            min-width: 270px;
            max-width: 340px;
            animation: toastIn .45s cubic-bezier(.22,1,.36,1) both;
            font-family: var(--font-b);
            position: relative;
            overflow: hidden;
        }

            .toast-notify.error {
                border-top: 3px solid #d94f4f;
            }

            .toast-notify.success {
                border-top: 3px solid #10b981;
            }

            .toast-notify.warning {
                border-top: 3px solid #f59e0b;
            }

            .toast-notify.info {
                border-top: 3px solid #474544;
            }

        .toast-icon {
            font-size: 17px;
            flex-shrink: 0;
            margin-top: 1px;
        }

        .toast-notify.error .toast-icon {
            color: #d94f4f;
        }

        .toast-notify.success .toast-icon {
            color: #10b981;
        }

        .toast-notify.warning .toast-icon {
            color: #f59e0b;
        }

        .toast-notify.info .toast-icon {
            color: #474544;
        }

        .toast-body {
            flex: 1;
            min-width: 0;
        }

        .toast-title {
            font-weight: 700;
            font-size: 12.5px;
            color: #1a1a1a;
            letter-spacing: -.1px;
            line-height: 1.3;
        }

        .toast-text {
            font-size: 11.5px;
            color: #5c5a58;
            margin-top: 3px;
            line-height: 1.45;
        }

        .toast-close {
            color: #c0bebb;
            cursor: pointer;
            font-size: 11px;
            flex-shrink: 0;
            background: none;
            border: none;
            padding: 0;
            line-height: 1;
            margin-top: 2px;
            transition: color .15s;
        }

            .toast-close:hover {
                color: #474544;
            }

        .toast-progress {
            position: absolute;
            bottom: 0;
            left: 0;
            height: 2.5px;
            border-radius: 0 2px 0 0;
            animation: toastProgress 3.5s linear forwards;
        }

        .toast-notify.error .toast-progress {
            background: #d94f4f;
        }

        .toast-notify.success .toast-progress {
            background: #10b981;
        }

        .toast-notify.warning .toast-progress {
            background: #f59e0b;
        }

        .toast-notify.info .toast-progress {
            background: #474544;
        }

        @@keyframes toastProgress {
            from {
                width: 100%;
            }

            to {
                width: 0%;
            }
        }
    </style>

    <div class="orb orb-1"></div>
    <div class="orb orb-2"></div>
    <div class="particle" style="left:8%;animation-delay:0s;"></div>
    <div class="particle" style="left:22%;animation-delay:4s;"></div>
    <div class="particle" style="left:40%;animation-delay:8s;"></div>
    <div class="particle" style="left:57%;animation-delay:2s;"></div>
    <div class="particle" style="left:72%;animation-delay:6s;"></div>
    <div class="particle" style="left:88%;animation-delay:3s;"></div>

    <div id="toastContainer"></div>

    <div class="login-container">
        <div class="login-card">

            <div class="login-header">
                <div class="mac-dots">
                    <div class="mac-dot mac-dot-r"></div>
                    <div class="mac-dot mac-dot-y"></div>
                    <div class="mac-dot mac-dot-g"></div>
                </div>

                <div class="login-logo">
                    <div class="logo-skeleton" id="logoSkeleton"></div>
                    <img id="companyLogo" src="" alt="Logo" style="display:none;">
                </div>

                <div class="login-title" id="companyNameWrap">
                    <div class="title-skeleton" id="titleSkeleton"></div>
                </div>

                <div class="accent-bar"><span></span><span></span><span></span></div>
            </div>

            <div class="login-form">
                <form id="loginForm">
                    <div class="form-group">
                        <div class="input-wrapper" id="wrapUserId">
                            <input type="text" id="userId" class="form-input" placeholder=" " required autocomplete="username">
                            <i class="fas fa-user input-icon"></i>
                            <label class="float-label" for="userId">UserID</label>
                        </div>
                    </div>

                    <div class="form-group">
                        <div class="input-wrapper" id="wrapPassword">
                            <input type="password" id="password" class="form-input" placeholder=" " required autocomplete="current-password">
                            <i class="fas fa-lock input-icon"></i>
                            <label class="float-label" for="password">Password</label>
                        </div>
                    </div>

                    <div class="btn-login-wrap">
                        <button type="submit" id="loginBtn" class="btn-login">
                            <span><i class="fas fa-arrow-right-to-bracket"></i> Login</span>
                        </button>
                    </div>
                </form>

                <div class="login-footer">
                    Developed with <span class="heart">♥</span> by <strong>UT Designer</strong>
                </div>
            </div>

        </div>
    </div>

    <script>
        const SW = { background: '#ffffff', color: '#1a1a1a', confirmButtonColor: '#474544' };

        // ── Toast Notification Function ────────────────────────
        function showToast(icon, title, text) {
            const iconMap = {
                error:   'fa-circle-xmark',
                success: 'fa-circle-check',
                warning: 'fa-triangle-exclamation',
                info:    'fa-circle-info'
            };

            const container = document.getElementById('toastContainer');

            const toast = document.createElement('div');
            toast.className = 'toast-notify ' + icon;
            toast.innerHTML =
                '<i class="fas ' + iconMap[icon] + ' toast-icon"></i>' +
                '<div class="toast-body">' +
                    '<div class="toast-title">' + title + '</div>' +
                    '<div class="toast-text">'  + text  + '</div>' +
                '</div>' +
                '<button class="toast-close" onclick="removeToast(this.closest(\'.toast-notify\'))"><i class="fas fa-xmark"></i></button>' +
                '<div class="toast-progress"></div>';

            container.appendChild(toast);
            setTimeout(function () { removeToast(toast); }, 3500);
        }

        function removeToast(toast) {
            if (!toast || toast._removing) return;
            toast._removing = true;
            toast.style.animation = 'toastOut .3s ease forwards';
            setTimeout(function () { if (toast.parentNode) toast.remove(); }, 300);
        }

        // ── Auth Check ─────────────────────────────────────────
        function checkIfLoggedIn() {
            if (localStorage.getItem("userId") && localStorage.getItem("password")) {
                window.location.href = '/Home'; return true;
            }
            return false;
        }

        // ── Floating Label Init ────────────────────────────────
        function initLoginFloats() {
            ['wrapUserId', 'wrapPassword'].forEach(function (wid) {
                const wrap = document.getElementById(wid);
                if (!wrap) return;
                const inp = wrap.querySelector('input');
                if (!inp) return;
                const chk = function () { wrap.classList.toggle('has-value', inp.value !== ''); };
                inp.addEventListener('input', chk);
                inp.addEventListener('change', chk);
                chk();
            });
        }

        // ── Load Company Info from DB ──────────────────────────
        function loadCompanyInfo() {
            $.ajax({
                url: '@Url.Action("GetCompanyInfo", "Login")',
                type: 'GET',
                success: function (res) {
                    const name = (res.success && res.companyName) ? res.companyName : 'Ecommerce Admin';
                    const logo = (res.success && res.companyLogo) ? res.companyLogo : 'logo.png';

                    $("#titleSkeleton").remove();
                    $("#companyNameWrap").html('<span>' + name + '</span>');
                    document.title = name + ' - Admin Login';

                    const img = $("#companyLogo");
                    img.attr("src", "./images/" + logo).show();
                    img.on("load", function () {
                        $("#logoSkeleton").remove();
                        $(this).css("opacity", 1);
                    }).on("error", function () {
                        $(this).attr("src", "./images/logo.png");
                        $("#logoSkeleton").remove();
                        $(this).css("opacity", 1);
                    });
                    if (img[0].complete && img[0].naturalWidth > 0) {
                        $("#logoSkeleton").remove();
                        img.css("opacity", 1);
                    }
                },
                error: function () {
                    $("#titleSkeleton").remove();
                    $("#companyNameWrap").html('<span>Ecommerce Admin</span>');
                    $("#logoSkeleton").remove();
                    $("#companyLogo").attr("src", "./images/logo.png").show().css("opacity", 1);
                }
            });
        }

        // ── Document Ready ─────────────────────────────────────
        $(document).ready(function () {
            if (checkIfLoggedIn()) return;

            $("#userId, #password").val("");
            initLoginFloats();
            loadCompanyInfo();
            $("#userId").focus();

            // ── Login Form Submit ──────────────────────────────
            $("#loginForm").submit(function (e) {
                e.preventDefault();
                const userId   = $("#userId").val().trim();
                const password = $("#password").val().trim();

                if (!userId || !password) {
                    showToast('warning', 'Validation', 'Please fill in all fields!');
                    return;
                }

                $("#userId, #password, #loginBtn").prop("disabled", true);
                $("#loginBtn span").html('<i class="fas fa-spinner fa-spin"></i> Verifying...');
                Swal.fire({
                    title: 'Please Wait', text: 'Verifying credentials...',
                    allowOutsideClick: false, allowEscapeKey: false,
                    didOpen: function () { Swal.showLoading(); }, ...SW
                });

                $.ajax({
                    url: '@Url.Action("Verify", "Login")',
                    type: 'POST',
                    data: { userId, password },
                    success: function (response) {
                        if (response.success) {
                            localStorage.setItem("userId",   response.userId);
                            localStorage.setItem("password", response.password);
                            Swal.close();
                            showToast('success', 'Login Successful!', 'Redirecting to dashboard...');
                            setTimeout(function () { window.location.href = '/Home'; }, 1600);
                        } else {
                            Swal.close();
                            $("#userId, #password, #loginBtn").prop("disabled", false);
                            $("#loginBtn span").html('<i class="fas fa-arrow-right-to-bracket"></i> Login');
                            $("#userId").focus();
                            showToast('error', 'Login Failed', response.message || 'Invalid username or password.');
                        }
                    },
                    error: function () {
                        Swal.close();
                        $("#userId, #password, #loginBtn").prop("disabled", false);
                        $("#loginBtn span").html('<i class="fas fa-arrow-right-to-bracket"></i> Login');
                        $("#userId").focus();
                        showToast('error', 'Server Error', 'Unable to connect. Please try again.');
                    }
                });
            });

            // Enter key support
            $("#userId, #password").keypress(function (e) {
                if (e.which === 13) { $("#loginForm").submit(); }
            });
        });
    </script>

</body>
</html>
